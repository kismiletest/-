local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

--------------------------------------------------
-- ESP UI
--------------------------------------------------

local function createBillboard(root,color)

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(0,170,0,50)
	gui.StudsOffset = Vector3.new(0,4,0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 999999
	gui.Parent = root

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1,0,1,0)
	label.BackgroundTransparency = 1
	label.TextColor3 = color
	label.TextStrokeTransparency = 0
	label.Font = Enum.Font.SourceSansBold
	label.TextScaled = true
	label.Parent = gui

	return label
end

--------------------------------------------------
-- 玩家见闻色ESP
--------------------------------------------------

local function createPlayerESP(target)

	if target == player then return end

	local function apply(char)

		if not char:FindFirstChild("HumanoidRootPart") then return end
		if char:FindFirstChild("ObservationESP") then return end

		local humanoid = char:FindFirstChild("Humanoid")
		if not humanoid then return end

		local highlight = Instance.new("Highlight")
		highlight.Name = "ObservationESP"
		highlight.FillTransparency = 0.5
		highlight.OutlineColor = Color3.new(1,1,1)
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Parent = char

		local label = createBillboard(char.HumanoidRootPart,Color3.fromRGB(0,255,0))

		task.spawn(function()

			while char.Parent do

				if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then

					local dist = (char.HumanoidRootPart.Position -
						player.Character.HumanoidRootPart.Position).Magnitude

					local hp = humanoid.Health
					local maxhp = humanoid.MaxHealth
					local percent = hp/maxhp

					local color = Color3.fromRGB(0,255,0)

					if percent < 0.6 then
						color = Color3.fromRGB(255,170,0)
					end

					if percent < 0.3 then
						color = Color3.fromRGB(255,0,0)
					end

					highlight.FillColor = color
					label.TextColor3 = color

					label.Text =
						target.Name..
						" ["..math.floor(dist).."m]\n"..
						"HP: "..math.floor(hp)

				end

				task.wait(0.1)

			end

		end)

	end

	if target.Character then
		apply(target.Character)
	end

	target.CharacterAdded:Connect(function(char)
		task.wait(1)
		apply(char)
	end)

end

--------------------------------------------------
-- 怪物ESP
--------------------------------------------------

local function createMonsterESP(model)

	if not model:FindFirstChild("Humanoid") then return end
	if Players:GetPlayerFromCharacter(model) then return end
	if not model:FindFirstChild("HumanoidRootPart") then return end
	if model:FindFirstChild("MonsterESP") then return end

	local highlight = Instance.new("Highlight")
	highlight.Name = "MonsterESP"
	highlight.FillColor = Color3.fromRGB(255,0,0)
	highlight.FillTransparency = 0.5
	highlight.OutlineColor = Color3.fromRGB(255,255,255)
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = model

	local label = createBillboard(model.HumanoidRootPart,Color3.fromRGB(255,0,0))

	task.spawn(function()

		while model.Parent do

			if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then

				local dist =
					(model.HumanoidRootPart.Position -
					player.Character.HumanoidRootPart.Position).Magnitude

				label.Text = model.Name.." ["..math.floor(dist).."m]"

			end

			task.wait(0.2)

		end

	end)

end

--------------------------------------------------
-- 扫描玩家
--------------------------------------------------

for _,p in pairs(Players:GetPlayers()) do
	createPlayerESP(p)
end

Players.PlayerAdded:Connect(function(p)
	createPlayerESP(p)
end)

--------------------------------------------------
-- 扫描怪物
--------------------------------------------------

for _,v in pairs(workspace:GetDescendants()) do
	if v:IsA("Model") then
		createMonsterESP(v)
	end
end

workspace.DescendantAdded:Connect(function(obj)
	if obj:IsA("Model") then
		createMonsterESP(obj)
	end
end)

