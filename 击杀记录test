-- 工具函数
local function formatNumber(n)
    if not n or type(n) ~= "number" then return "0" end
    if n >= 1e6 then return string.format("%.2fM", n / 1e6)
    elseif n >= 1e3 then return string.format("%.1fK", n / 1e3)
    else return tostring(math.floor(n)) end
end

local function getTimeString()
    local t = os.date("*t")
    return string.format("%02d:%02d:%02d", t.hour, t.min, t.sec)
end

local function getLocalBounty()
    local success, value = pcall(function()
        local data = LocalPlayer:FindFirstChild("Data")
        if data then
            if data:FindFirstChild("Bounty") then return data.Bounty.Value end
            if data:FindFirstChild("Honor") then return data.Honor.Value end
        end
        local ls = LocalPlayer:FindFirstChild("leaderstats")
        if ls then
            if ls:FindFirstChild("Bounty") then return ls.Bounty.Value end
            if ls:FindFirstChild("Honor") then return ls.Honor.Value end
        end
        return LocalPlayer:GetAttribute("Bounty") or LocalPlayer:GetAttribute("Honor") or 0
    end)
    return success and (value or 0) or 0
end

-- 获取/更新玩家击杀次数 (1/3 2/3 3/3)
local function getPlayerScore(playerName)
    if not playerKillCount[playerName] then
        playerKillCount[playerName] = 0
    end
    playerKillCount[playerName] = math.min(playerKillCount[playerName] + 1, 3)
    return playerKillCount[playerName] .. "/3"
end

-- 保存 / 加载
local function saveRecords()
    if writefile then
        pcall(function()
            writefile(SAVE_FILE, HttpService:JSONEncode({
                records = KillRecords,
                counts = playerKillCount
            }))
        end)
    end
end

local function loadRecords()
    if isfile and isfile(SAVE_FILE) and readfile then
        local success, data = pcall(function()
            return HttpService:JSONDecode(readfile(SAVE_FILE))
        end)
        if success and type(data) == "table" then
            if data.records then
                KillRecords = data.records
                playerKillCount = data.counts or {}
            else
                -- 兼容旧存档
                KillRecords = data
            end
            return true
        end
    end
    return false
end

