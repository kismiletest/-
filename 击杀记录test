-- ========== 核心检测 ==========

local function onPlayerDied(player)
    if player == LocalPlayer then return end
    table.insert(recentDeadPlayers, 1, {player = player, time = tick()})
    while #recentDeadPlayers > 0 and tick() - recentDeadPlayers[#recentDeadPlayers].time > 8 do
        table.remove(recentDeadPlayers)
    end
end

local function setupPlayer(player)
    if player == LocalPlayer then return end
    local function charAdded(char)
        local hum = char:WaitForChild("Humanoid", 8)
        if hum then
            hum.Died:Connect(function()
                onPlayerDied(player)
            end)
        end
    end
    if player.Character then charAdded(player.Character) end
    player.CharacterAdded:Connect(charAdded)
end

for _, p in ipairs(Players:GetPlayers()) do setupPlayer(p) end
Players.PlayerAdded:Connect(setupPlayer)

-- 掉赏检测
task.spawn(function()
    lastBounty = getLocalBounty()
    while task.wait(0.35) do
        local current = getLocalBounty()
        if current > lastBounty + 80 then
            local gained = current - lastBounty
            lastBounty = current

            local bestTarget = nil
            for _, dead in ipairs(recentDeadPlayers) do
                if dead.player and dead.player.Parent and tick() - dead.time < 6 then
                    bestTarget = dead.player
                    break
                end
            end

            if bestTarget then
                addKillRecord(bestTarget.Name, gained, false, lastScoreText)
            end
        elseif current < lastBounty then
            lastBounty = current
        end
    end
end)

-- 文本检测（可疑击杀 + 分數）
local function processText(text)
    if not text or type(text) ~= "string" then return end

    -- 提取 分數:1/3  2/3  3/3
    local score = text:match("分數[:：]%s*(%d+/%d+)") or text:match("Score[:：]%s*(%d+/%d+)")
    if score then
        lastScoreText = score
    end

    -- 可疑击杀
    local name = text:match("No reward from%s+([^,]+),%s*suspicious kill")
    if not name then
        name = text:match("No reward from%s+([^%s,]+)")
    end

    if name and name ~= "" then
        name = name:gsub("^%s+", ""):gsub("%s+$", "")
        addKillRecord(name, 0, true, lastScoreText)
    end
end

local function watchGui(parent)
    parent.DescendantAdded:Connect(function(desc)
        if desc:IsA("TextLabel") or desc:IsA("TextButton") then
            task.defer(function()
                processText(desc.Text)
            end)
            desc:GetPropertyChangedSignal("Text"):Connect(function()
                processText(desc.Text)
            end)
        end
    end)
end

