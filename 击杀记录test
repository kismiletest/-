-- 添加记录
local function addKillRecord(playerName, gainedAmount, isSuspicious, scoreFromGame)
    if not playerName or playerName == "" then return end
    if tick() - lastRecordTime < 0.8 then return end

    local key = playerName .. "_" .. math.floor(tick() / 2)
    if recordedKeys[key] then return end
    recordedKeys[key] = true

    -- 优先使用游戏显示的分数，没有就自己计算 1/3 2/3 3/3
    local finalScore = scoreFromGame
    if not finalScore or finalScore == "" then
        finalScore = getPlayerScore(playerName)
    else
        -- 同步游戏分数到本地计数
        local num = tonumber(finalScore:match("(%d+)/"))
        if num then
            playerKillCount[playerName] = num
        end
    end

    local record = {
        name = playerName,
        gained = gainedAmount or 0,
        suspicious = isSuspicious or false,
        score = finalScore,
        time = getTimeString(),
        timestamp = os.time()
    }

    table.insert(KillRecords, 1, record)
    while #KillRecords > MAX_RECORDS do
        table.remove(KillRecords)
    end

    lastRecordTime = tick()
    refreshUI()
    saveRecords()

    local typeStr = isSuspicious and "可疑击杀" or ("获得 +" .. formatNumber(gainedAmount))
    print(string.format("[击杀记录] %s → %s | %s", playerName, typeStr, finalScore))
end

