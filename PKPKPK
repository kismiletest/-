--// Rayfield Loader
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

--// 创建窗口
local Window = Rayfield:CreateWindow({
    Name = "嘉登 Hub",
    LoadingTitle = "嘉登 Hub",
    LoadingSubtitle = "Rayfield UI",

    ConfigurationSaving = {
        Enabled = true,
        FolderName = "嘉登Hub",
        FileName = "Config"
    },

    Discord = {
        Enabled = false
    },

    KeySystem = false
})

--// Main Tab
local MainTab = Window:CreateTab("主要", 4483362458)

--// 时间信息
local TimeParagraph = MainTab:CreateParagraph({
    Title = "当前北京时间",
    Content = "加载中..."
})

--// 变量
local AutoJoin = false
local TargetCrewID = nil

--// 时间列表
local timeOptions = {}

local currentUtcTime = os.time()
local beijingTimeSec = currentUtcTime + 8 * 3600
local baseTime = beijingTimeSec - (beijingTimeSec % 60)

for i = 1, 60 do

    local futureTime = baseTime + (i * 60)

    table.insert(
        timeOptions,
        os.date("!%H:%M:00", futureTime)
    )
end

local TargetTime = timeOptions[1] or "12:00:00"

--// 更新时间
task.spawn(function()

    while task.wait(1) do

        local utcTime = os.time()

        local beijingTime = os.date(
            "!%Y-%m-%d %H:%M:%S",
            utcTime + 8 * 3600
        )

        TimeParagraph:Set({
            Title = "当前北京时间",
            Content = "当前时间: " .. beijingTime
        })
    end
end)

--// 时间选择
MainTab:CreateDropdown({
    Name = "选择触发时间",
    Options = timeOptions,
    CurrentOption = TargetTime,

    Callback = function(Value)

        if typeof(Value) == "table" then
            TargetTime = Value[1]
        else
            TargetTime = Value
        end
    end
})

--// CrewID 输入
MainTab:CreateInput({
    Name = "自定义船员ID (CrewID)",
    PlaceholderText = "请输入你要加入的 CrewID",
    RemoveTextAfterFocusLost = false,

    Callback = function(Text)

        if Text and Text ~= "" then

            TargetCrewID = Text

            Rayfield:Notify({
                Title = "CrewID 已更新",
                Content = "目标 CrewID 设置为: " .. TargetCrewID,
                Duration = 3,
                Image = 4483362458
            })
        end
    end
})

--// 自动加入开关
local AutoJoinToggle = MainTab:CreateToggle({
    Name = "开启自动加入",
    CurrentValue = false,
    Flag = "AutoJoinCrew",

    Callback = function(Value)
        AutoJoin = Value
    end
})

--// 自动加入检测
task.spawn(function()

    while task.wait(1) do

        if AutoJoin then

            local utcTime = os.time()

            local currentHourMin = os.date(
                "!%H:%M",
                utcTime + 8 * 3600
            )

            local targetHourMin = string.sub(TargetTime, 1, 5)

            if currentHourMin == targetHourMin then

                if not TargetCrewID or TargetCrewID == "" then

                    Rayfield:Notify({
                        Title = "加入失败",
                        Content = "未设置 CrewID，请先输入 CrewID！",
                        Duration = 5,
                        Image = 4483362458
                    })

                    AutoJoin = false
                    AutoJoinToggle:Set(false)

                    continue
                end

                local args = {
                    "Join",
                    {
                        CrewID = TargetCrewID
                    }
                }

                pcall(function()

                    game:GetService("ReplicatedStorage")
                        :WaitForChild("Remotes")
                        :WaitForChild("Crew")
                        :InvokeServer(unpack(args))

                end)

                AutoJoin = false
                AutoJoinToggle:Set(false)

                Rayfield:Notify({
                    Title = "自动加入船员",
                    Content = "时间已到，已发送加入船员请求！",
                    Duration = 5,
                    Image = 4483362458
                })
            end
        end
    end
end)
