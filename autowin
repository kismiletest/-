-- The Mimic WindUI 辅助脚本
-- 自动加载 WindUI + 完整控制面板

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local RootPart = Character:WaitForChild("HumanoidRootPart")

-- ==================== WindUI 加载 ====================
local WindUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()

local Window = WindUI:CreateWindow({
    Title = "The Mimic 自动辅助",
    Icon = "skull",
    Theme = "Dark",           -- 可选: Dark, Light, Rose, Violet 等
    Folder = "TheMimicHub",   -- 保存配置用
    Size = UDim2.fromOffset(620, 460)
})

-- ==================== 主 Tab ====================
local MainTab = Window:Tab({
    Title = "主要功能",
    Icon = "home"
})

-- 状态变量
local flyEnabled = false
local bv, bg
local noclipConnection

-- 飞行
local function toggleFly()
    flyEnabled = not flyEnabled
    if flyEnabled then
        bv = Instance.new("BodyVelocity")
        bg = Instance.new("BodyGyro")
        bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
        bv.Parent = RootPart
        bg.Parent = RootPart

        spawn(function()
            while flyEnabled and RootPart do
                local cam = Workspace.CurrentCamera
                local moveDir = Vector3.new()
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir += cam.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir -= cam.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir -= cam.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir += cam.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.new(0,1,0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir -= Vector3.new(0,1,0) end
                
                bv.Velocity = moveDir.Unit * MainTab:GetValue("FlySpeed") or 100
                bg.CFrame = cam.CFrame
                RunService.Heartbeat:Wait()
            end
        end)
    else
        if bv then bv:Destroy() end
        if bg then bg:Destroy() end
    end
end

-- 无碰撞
local function toggleNoclip(state)
    if state then
        noclipConnection = RunService.Stepped:Connect(function()
            if Character then
                for _, part in pairs(Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        if noclipConnection then noclipConnection:Disconnect() end
    end
end

-- 添加怪物 ESP
local function addESP()
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:FindFirstChild("Humanoid") and v ~= Character and not v:FindFirstChild("Highlight") then
            local hl = Instance.new("Highlight")
            hl.FillColor = Color3.fromRGB(255, 0, 0)
            hl.OutlineColor = Color3.fromRGB(255, 100, 100)
            hl.Parent = v
        end
    end
    WindUI:Notify({Title = "ESP", Content = "怪物高亮已添加！", Duration = 3})
end

-- UI 控件
MainTab:Toggle({
    Title = "飞行模式 (F)",
    Value = false,
    Callback = toggleFly
})

MainTab:Slider({
    Title = "飞行速度",
    Value = {Min = 50, Max = 300, Default = 100},
    Step = 10,
    Callback = function(val) end  -- 实时读取
})

MainTab:Toggle({
    Title = "无碰撞 (Noclip)",
    Value = false,
    Callback = toggleNoclip
})

MainTab:Slider({
    Title = "行走速度",
    Value = {Min = 16, Max = 200, Default = 50},
    Step = 1,
    Callback = function(val)
        if Humanoid then Humanoid.WalkSpeed = val end
    end
})

MainTab:Button({
    Title = "添加怪物 ESP",
    Icon = "eye",
    Callback = addESP
})

MainTab:Button({
    Title = "God Mode (无敌)",
    Callback = function()
        if Humanoid then
            Humanoid.MaxHealth = 9e9
            Humanoid.Health = 9e9
        end
        WindUI:Notify({Title = "God Mode", Content = "已开启无敌！"})
    end
})

MainTab:Button({
    Title = "Full Bright (全亮)",
    Callback = function()
        game:GetService("Lighting").Brightness = 3
        game:GetService("Lighting").ClockTime = 14
        game:GetService("Lighting").FogEnd = 1e5
        game:GetService("Lighting").GlobalShadows = false
    end
})

-- 传送 Tab
local TeleportTab = Window:Tab({
    Title = "传送",
    Icon = "map"
})

TeleportTab:Button({
    Title = "传送到出生点",
    Callback = function()
        if RootPart then RootPart.CFrame = CFrame.new(0, 50, 0) end
    end
})

-- 提示
WindUI:Notify({
    Title = "The Mimic 脚本已加载",
    Content = "欢迎使用 WindUI 版本！按 F 飞行，N 无碰撞",
    Duration = 6
})

print("🎉 The Mimic WindUI 脚本加载成功！")
