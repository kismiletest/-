-- =============================================
-- WindUI + 自动通关脚本（通用跑酷/闯关）
-- =============================================

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

-- ================== 加载 WindUI ==================
local WindUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()

local Window = WindUI:CreateWindow({
    Title = "自动通关助手",
    Icon = "trophy",
    Author = "by Grok",
    Folder = "AutoWinHub",
    Theme = "Dark",
    Size = UDim2.fromOffset(700, 560),
    Resizable = true,
    ToggleKey = Enum.KeyCode.RightShift,
})

local MainTab = Window:Tab({
    Title = "自动通关",
    Icon = "play",
})

local SettingsTab = Window:Tab({
    Title = "设置",
    Icon = "settings",
})

-- ================== 配置 ==================
local CONFIG = {
    Speed = 60,
    UseTween = true,
    HeightOffset = 4,
    Delay = 0.4,
    AutoStart = false,
}

local autoRunning = false
local currentStage = 0

-- ================== 核心函数 ==================
local function findStageFolder()
    local names = {"Checkpoints", "Stages", "Spawns", "Levels", "Parts", "Map"}
    for _, name in ipairs(names) do
        local folder = Workspace:FindFirstChild(name, true)
        if folder then return folder end
    end
    return Workspace
end

local function getSortedStages(folder)
    local stages = {}
    for _, obj in ipairs(folder:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("SpawnLocation") then
            local num = tonumber(obj.Name:match("%d+")) or tonumber(obj.Name)
            if num then
                stages[num] = obj
            end
        end
    end
    
    local sorted = {}
    for i = 1, 500 do
        if stages[i] then table.insert(sorted, stages[i]) end
    end
    return sorted
end

local function teleportTo(part)
    local character = LocalPlayer.Character
    if not character then return end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local target = part.CFrame * CFrame.new(0, CONFIG.HeightOffset, 0)

    if CONFIG.UseTween then
        local dist = (root.Position - part.Position).Magnitude
        local tween = TweenService:Create(root, TweenInfo.new(dist / CONFIG.Speed, Enum.EasingStyle.Linear), {CFrame = target})
        tween:Play()
        tween.Completed:Wait()
    else
        root.CFrame = target
    end
    task.wait(CONFIG.Delay)
end

local function startAutoWin()
    if autoRunning then return end
    autoRunning = true

    local folder = findStageFolder()
    local stages = getSortedStages(folder)

    if #stages == 0 then
        WindUI:Notify({Title = "错误", Content = "未找到关卡点！", Type = "Error"})
        autoRunning = false
        return
    end

    WindUI:Notify({Title = "开始", Content = "找到 " .. #stages .. " 个关卡，开始自动通关...", Type = "Success"})

    for i, stage in ipairs(stages) do
        if not autoRunning then break end
        currentStage = i
        MainTab:Label({Title = "当前进度：第 " .. i .. " / " .. #stages .. " 关"})
        teleportTo(stage)
    end

    WindUI:Notify({Title = "完成", Content = "自动通关已结束！", Type = "Success"})
    autoRunning = false
end

-- ================== UI 控件 ==================
MainTab:Toggle({
    Title = "启用自动通关",
    Value = false,
    Callback = function(state)
        if state then
            task.spawn(startAutoWin)
        else
            autoRunning = false
        end
    end
})

MainTab:Button({
    Title = "立即开始",
    Callback = function()
        task.spawn(startAutoWin)
    end
})

MainTab:Button({
    Title = "停止",
    Callback = function()
        autoRunning = false
    end
})

-- 设置页面
SettingsTab:Slider({
    Title = "移动速度",
    Min = 20,
    Max = 120,
    Default = 60,
    Callback = function(v) CONFIG.Speed = v end
})

SettingsTab:Toggle({
    Title = "平滑移动 (Tween)",
    Value = true,
    Callback = function(v) CONFIG.UseTween = v end
})

SettingsTab:Slider({
    Title = "每关停顿时间",
    Min = 0.1,
    Max = 1.5,
    Default = 0.4,
    Callback = function(v) CONFIG.Delay = v end
})

SettingsTab:Slider({
    Title = "抬高高度",
    Min = 2,
    Max = 8,
    Default = 4,
    Callback = function(v) CONFIG.HeightOffset = v end
})

MainTab:Label({Title = "快捷键：RightShift 打开/关闭窗口"})

print("🎉 WindUI 自动通关助手已成功加载！")
