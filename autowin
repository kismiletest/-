-- ================= WindUI + 自动通关脚本 =================
-- 这是一个客户端脚本 (LocalScript)

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

-- ================= WindUI 加载 =================
local WindUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()

local Window = WindUI:CreateWindow({
    Title = "自动通关助手",
    Icon = "trophy",
    Author = "by Grok",
    Folder = "AutoWinHub",
    Theme = "Dark",
    Size = UDim2.fromOffset(680, 520),
    Resizable = true,
    ToggleKey = Enum.KeyCode.RightShift,
})

local MainTab = Window:Tab({
    Title = "自动通关",
    Icon = "play",
})

-- ================= 配置参数 =================
local TELEPORT_SPEED = 50
local TWEEN_MODE = true
local STAGE_FOLDER_NAMES = {"Checkpoints", "Stages", "Spawns", "Parts"}

-- 变量
local autoWinRunning = false
local currentStage = 0

-- ================= 自动寻找关卡 =================
local function findStagesFolder()
    for _, name in ipairs(STAGE_FOLDER_NAMES) do
        local folder = Workspace:FindFirstChild(name) or Workspace:FindFirstChild(name, true)
        if folder then return folder end
    end
    return nil
end

local function getSortedStages(folder)
    local stages = {}
    for _, part in ipairs(folder:GetChildren()) do
        if part:IsA("BasePart") or part:IsA("SpawnLocation") or part:IsA("Model") then
            local stageNumber = tonumber(part.Name) or (#stages + 1)
            stages[stageNumber] = part
        end
    end
    return stages
end

-- ================= 移动函数 =================
local function moveToPart(targetPart)
    local character = LocalPlayer.Character
    if not character then return false end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end

    local targetCFrame = targetPart.CFrame + Vector3.new(0, 4, 0)

    if TWEEN_MODE then
        local distance = (rootPart.Position - targetPart.Position).Magnitude
        local duration = distance / TELEPORT_SPEED
        local tween = TweenService:Create(rootPart, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
        tween:Play()
        tween.Completed:Wait()
    else
        rootPart.CFrame = targetCFrame
    end
    task.wait(0.3)
    return true
end

-- ================= 主自动通关函数 =================
local function startAutoWin()
    if autoWinRunning then return end
    autoWinRunning = true

    local stagesFolder = findStagesFolder()
    if not stagesFolder then
        WindUI:Notify({
            Title = "错误",
            Content = "未找到关卡文件夹！",
            Type = "Error"
        })
        autoWinRunning = false
        return
    end

    local sortedStages = getSortedStages(stagesFolder)
    WindUI:Notify({Title = "开始", Content = "找到 " .. #sortedStages .. " 个关卡，开始自动通关...", Type = "Success"})

    for stageNumber = 1, #sortedStages do
        if not autoWinRunning then break end
        
        local stagePart = sortedStages[stageNumber]
        currentStage = stageNumber
        
        if stagePart then
            MainTab:Label({Title = "当前进度: 第 " .. stageNumber .. " 关"})
            moveToPart(stagePart)
        end
    end

    WindUI:Notify({Title = "完成", Content = "已完成所有关卡！", Type = "Success"})
    autoWinRunning = false
end

-- ================= UI 控件 =================
MainTab:Toggle({
    Title = "启用自动通关",
    Value = false,
    Callback = function(state)
        if state then
            task.spawn(startAutoWin)
        else
            autoWinRunning = false
            WindUI:Notify({Title = "已停止", Content = "自动通关已停止", Type = "Warning"})
        end
    end
})

MainTab:Slider({
    Title = "移动速度",
    Min = 20,
    Max = 120,
    Default = 50,
    Callback = function(value)
        TELEPORT_SPEED = value
    end
})

MainTab:Toggle({
    Title = "平滑移动 (Tween)",
    Value = true,
    Callback = function(state)
        TWEEN_MODE = state
    end
})

MainTab:Button({
    Title = "立即开始自动通关",
    Callback = function()
        task.spawn(startAutoWin)
    end
})

MainTab:Button({
    Title = "停止",
    Callback = function()
        autoWinRunning = false
    end
})

MainTab:Label({Title = "提示：按 RightShift 切换窗口"})

print("🎮 WindUI 自动通关助手已加载！")
