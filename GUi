-- 可拖动主框架
local UserInputService = game:GetService("UserInputService")
local 鼠标按下 = false
local 偏移 = Vector2.new(0,0)

主框架.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        鼠标按下 = true
        local 鼠标位置 = UserInputService:GetMouseLocation()
        local 框架位置 = 主框架.Position
        偏移 = 鼠标位置 - Vector2.new(框架位置.X.Offset, 框架位置.Y.Offset)
    end
end)

主框架.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        鼠标按下 = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if 鼠标按下 and input.UserInputType == Enum.UserInputType.MouseMovement then
        local 鼠标位置 = UserInputService:GetMouseLocation()
        主框架.Position = UDim2.new(0, 鼠标位置.X - 偏移.X, 0, 鼠标位置.Y - 偏移.Y)
    end
end)
