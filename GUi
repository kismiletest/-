--// 创建按钮函数
local function 添加按钮(按钮名, 回调)
    local 按钮 = Instance.new("TextButton")
    按钮.Size = UDim2.new(1, -20, 0, 35)
    按钮.Position = UDim2.new(0, 10, 0, (#内容框:GetChildren())*40)
    按钮.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
    按钮.TextColor3 = Color3.new(1,1,1)
    按钮.Text = 按钮名
    按钮.Font = Enum.Font.SourceSans
    按钮.TextSize = 18
    按钮.Parent = 内容框

    按钮.MouseButton1Click:Connect(function()
        pcall(回调)
    end)
end

--// 创建开关按钮函数
local function 添加开关(名称, 初始状态, 回调)
    local 状态 = 初始状态
    local 框 = Instance.new("TextButton")
    框.Size = UDim2.new(1, -20, 0, 35)
    框.Position = UDim2.new(0, 10, 0, (#内容框:GetChildren())*40)
    框.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    框.TextColor3 = Color3.new(1,1,1)
    框.Font = Enum.Font.SourceSans
    框.TextSize = 18
    框.Text = 名称 .. ": " .. (状态 and "开启" or "关闭")
    框.Parent = 内容框

    框.MouseButton1Click:Connect(function()
        状态 = not 状态
        框.Text = 名称 .. ": " .. (状态 and "开启" or "关闭")
        pcall(function() 回调(状态) end)
    end)
end

