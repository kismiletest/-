-- 获取角色的HumanoidRootPart函数
local function 获取根部件()
    local 角色 = 玩家.Character or 玩家.CharacterAdded:Wait()
    return 角色:FindFirstChild("HumanoidRootPart")
end

-- 每秒删除熔岩的循环
local function 删除熔岩()
    while true do
        local 地图 = game.Workspace:FindFirstChild("Map")
        if 地图 then
            local 鬼船内部 = 地图:FindFirstChild("GhostShipInterior")
            if 鬼船内部 then
                local 熔岩部件组 = 鬼船内部:FindFirstChild("LavaParts")
                if 熔岩部件组 then
                    local 熔岩 = 熔岩部件组:FindFirstChild("Lava")
                    if 熔岩 then
                        熔岩:Destroy()
                        print("熔岩已删除")
                    end
                end
            end
        end
        task.wait(1)
    end
end

task.spawn(删除熔岩)

