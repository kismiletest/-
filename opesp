local Players = game:GetService("Players")
local player = Players.LocalPlayer

repeat task.wait() until player.Character
repeat task.wait() until player.Character:FindFirstChild("HumanoidRootPart")

local walkSpeed = 50
local flySpeed = 80
local flying = false
local bodyVel

local playerESP = true
local monsterESP = true

-------------------------------------------------
-- 获取Root
-------------------------------------------------

local function getRoot(model)

	return model:FindFirstChild("HumanoidRootPart")
	or model:FindFirstChild("Torso")
	or model:FindFirstChild("UpperTorso")

end

-------------------------------------------------
-- 创建ESP
-------------------------------------------------

local function createESP(model,color)

	local root = getRoot(model)
	if not root then return end
	if model:FindFirstChild("ESPHighlight") then return end

	local highlight = Instance.new("Highlight")
	highlight.Name = "ESPHighlight"
	highlight.FillColor = color
	highlight.FillTransparency = 0.5
	highlight.OutlineColor = Color3.new(1,1,1)
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = model

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(0,120,0,40)
	gui.StudsOffset = Vector3.new(0,3,0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 999999
	gui.Parent = root

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1,0,1,0)
	label.BackgroundTransparency = 1
	label.TextColor3 = color
	label.TextStrokeTransparency = 0
	label.Font = Enum.Font.SourceSansBold
	label.TextScaled = true
	label.Parent = gui

	task.spawn(function()

		while model.Parent do

			if player.Character then

				local dist =
				(root.Position - player.Character.HumanoidRootPart.Position).Magnitude

				label.Text = model.Name.." ["..math.floor(dist).."m]"

			end

			task.wait(0.2)

		end

	end)

end

-------------------------------------------------
-- 扫描ESP
-------------------------------------------------

local function scanESP()

	for _,v in pairs(workspace:GetDescendants()) do

		if v:IsA("Model") and v:FindFirstChild("Humanoid") then

			if Players:GetPlayerFromCharacter(v) then

				if playerESP then
					createESP(v,Color3.fromRGB(0,255,0))
				end

			else

				if monsterESP then
					createESP(v,Color3.fromRGB(255,0,0))
				end

			end

		end

	end

end

scanESP()

workspace.DescendantAdded:Connect(function(obj)

	if obj:IsA("Model") and obj:FindFirstChild("Humanoid") then
		task.wait(0.5)
		scanESP()
	end

end)

-------------------------------------------------
-- GUI
-------------------------------------------------

local gui = Instance.new("ScreenGui")
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0,220,0,220)
frame.Position = UDim2.new(0,50,0,200)
frame.BackgroundColor3 = Color3.fromRGB(30,30,30)
frame.Active = true
frame.Draggable = true
frame.Parent = gui

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1,0,0,30)
title.Text = "1.en Hub"
title.TextColor3 = Color3.new(1,1,1)
title.BackgroundTransparency = 1
title.Parent = frame

-------------------------------------------------
-- Speed
-------------------------------------------------

local speedBtn = Instance.new("TextButton")
speedBtn.Size = UDim2.new(0.9,0,0,30)
speedBtn.Position = UDim2.new(0.05,0,0,40)
speedBtn.Text = "Speed Boost"
speedBtn.Parent = frame

speedBtn.MouseButton1Click:Connect(function()

	if player.Character then
		player.Character.Humanoid.WalkSpeed = walkSpeed
	end

end)

-------------------------------------------------
-- Fly
-------------------------------------------------

local flyBtn = Instance.new("TextButton")
flyBtn.Size = UDim2.new(0.9,0,0,30)
flyBtn.Position = UDim2.new(0.05,0,0,80)
flyBtn.Text = "Toggle Fly"
flyBtn.Parent = frame

flyBtn.MouseButton1Click:Connect(function()

	flying = not flying

	if flying then

		local hrp = player.Character.HumanoidRootPart

		bodyVel = Instance.new("BodyVelocity")
		bodyVel.MaxForce = Vector3.new(9e9,9e9,9e9)
		bodyVel.Parent = hrp

		while flying do
			bodyVel.Velocity =
			workspace.CurrentCamera.CFrame.LookVector * flySpeed
			task.wait()
		end

	else

		if bodyVel then
			bodyVel:Destroy()
		end

	end

end)

-------------------------------------------------
-- ESP 开关
-------------------------------------------------

local playerBtn = Instance.new("TextButton")
playerBtn.Size = UDim2.new(0.9,0,0,30)
playerBtn.Position = UDim2.new(0.05,0,0,120)
playerBtn.Text = "Toggle Player ESP"
playerBtn.Parent = frame

playerBtn.MouseButton1Click:Connect(function()

	playerESP = not playerESP
	scanESP()

end)

local monsterBtn = Instance.new("TextButton")
monsterBtn.Size = UDim2.new(0.9,0,0,30)
monsterBtn.Position = UDim2.new(0.05,0,0,160)
monsterBtn.Text = "Toggle Monster ESP"
monsterBtn.Parent = frame

monsterBtn.MouseButton1Click:Connect(function()

	monsterESP = not monsterESP
	scanESP()

end)
