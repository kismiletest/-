------------------------------------------------
-- Toggle创建
------------------------------------------------

local function createToggle(name,callback)

	local enabled = false

	local button = Instance.new("TextButton")
	button.Size = UDim2.new(0,230,0,40)
	button.Text = name.." : OFF"
	button.BackgroundColor3 = Color3.fromRGB(45,45,45)
	button.TextColor3 = Color3.new(1,1,1)
	button.Parent = container

	button.MouseButton1Click:Connect(function()

		enabled = not enabled

		if enabled then
			button.Text = name.." : ON"
			button.BackgroundColor3 = Color3.fromRGB(60,180,60)
		else
			button.Text = name.." : OFF"
			button.BackgroundColor3 = Color3.fromRGB(45,45,45)
		end

		callback(enabled)

	end)

end

------------------------------------------------
-- ESP函数
------------------------------------------------

local function createESP(obj,color)

	if obj:FindFirstChild("Highlight") then return end

	local h = Instance.new("Highlight")
	h.FillColor = color
	h.OutlineColor = Color3.new(1,1,1)
	h.FillTransparency = 0.4
	h.Parent = obj

end

------------------------------------------------
-- Player ESP
------------------------------------------------

createToggle("Player ESP",function(state)

	if not state then return end

	for _,p in pairs(Players:GetPlayers()) do
		if p ~= player and p.Character then
			createESP(p.Character,Color3.fromRGB(255,0,0))
		end
	end

	Players.PlayerAdded:Connect(function(p)
		p.CharacterAdded:Connect(function(char)
			createESP(char,Color3.fromRGB(255,0,0))
		end)
	end)

end)

------------------------------------------------
-- Enemy ESP
------------------------------------------------

createToggle("Enemy ESP",function(state)

	task.spawn(function()

		while state do

			for _,v in pairs(workspace:GetDescendants()) do

				if v:FindFirstChild("Humanoid")
				and v ~= player.Character then

					createESP(v,Color3.fromRGB(255,120,0))

				end

			end

			task.wait(3)

		end

	end)

end)

