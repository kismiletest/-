            S_StatusLabel.Text = "🚀 尝试发送加入请求..."
            S_StatusLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
            fireJoinRequest(targetId)
        else
            S_StatusLabel.Text = "❌ 无效玩家，无法加入"
            S_StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        end
    end)
end)

-- [ 新增：快速扫描功能逻辑 (修复 Rate Limit 误判) ] --
ScanBtn.MouseButton1Click:Connect(function()
    if isScanning then return end
    isScanning = true

    -- 计算有效玩家数量，避免含有空白字串时导致无法完成扫描
    local validPlayers = {}
    for _, userName in ipairs(targetUsers) do
        if userName ~= "" then table.insert(validPlayers, userName) end
    end

    local totalPlayers = #validPlayers
    local processed = 0
    local onlineCount = 0
    local isFinished = false -- 防抖标记，避免同时多线程触发完成逻辑

    ScanBtn.Text = "🔄 扫描中... 0 / " .. totalPlayers
    ScanBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)

    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local getRemote = remotes and remotes:FindFirstChild("GetPlayerProfileData")

    if not getRemote then
        ScanBtn.Text = "❌ 找不到 Remote 服务"
        ScanBtn.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
        task.wait(2)
        ScanBtn.Text = "🚀 一键扫描名单在线状态"
        ScanBtn.BackgroundColor3 = Color3.fromRGB(138, 43, 226)
        isScanning = false
        return
    end

    task.spawn(function()
        for _, userName in ipairs(validPlayers) do
            task.spawn(function()
                local targetId = getUserId(userName)
                if targetId then
                    local success, data = pcall(function()
                        return getRemote:InvokeServer(targetId)
                    end)

                    -- 【重点修正】：只有在请求确实成功 (success == true) 的情況下，才去变更按钮状态
                    -- 如果 success == false，代表被 Roblox 限制请求 (Rate Limit)，此时不做任何变更，保留原本状态！
                    if success then
                        if data and checkOnlineData(data) then
                            onlineCount = onlineCount + 1
                            if listButtonsMap[userName] then
                                listButtonsMap[userName].TextColor3 = Color3.fromRGB(100, 255, 100)
                                listButtonsMap[userName].Text = "🟢 " .. userName
                            end

                            local joinServerSetting = type(data) == "table" and data.Settings and data.Settings.JoinServer
                            if joinServerSetting == "Everyone" then
                                addEveryoneRecord(userName, targetId)
                            end
                        else
                            -- 确实获取到资料，且玩家不在线，才变为灰色
                            if listButtonsMap[userName] then
                                listButtonsMap[userName].TextColor3 = Color3.fromRGB(150, 150, 150)
                                listButtonsMap[userName].Text = userName
                            end
                        end
                    end
                end

                processed = processed + 1
                
                -- 更新进度 (只在尚未结束时更新，避免 UI 闪烁)
                if not isFinished then
                    ScanBtn.Text = string.format("🔄 扫描中... %d / %d (发现 %d 人在线)", processed, totalPlayers, onlineCount)
                end

                -- 掃描完成處理
                if processed >= totalPlayers and not isFinished then
                    isFinished = true
                    ScanBtn.Text = string.format("✅ 扫描完成！共 %d 人在线上", onlineCount)
                    ScanBtn.BackgroundColor3 = Color3.fromRGB(60, 179, 113)
                    task.wait(3)
                    ScanBtn.Text = "🚀 一键扫描名单在线状态"
                    ScanBtn.BackgroundColor3 = Color3.fromRGB(138, 43, 226)
                    isScanning = false
                end
            end)
            task.wait(0.05) 
        end
    end)
end)
