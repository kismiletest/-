-- UI 拖拽逻辑
local dragging, dragInput, dragStart, startPos

TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

TitleBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

CloseButton.MouseButton1Click:Connect(function()
    ScreenGui:Destroy()
end)

-- 获取 UserId (带空白处理与快取)
local function getUserId(inputString)
    local cleanedInput = string.gsub(inputString, "^%s*(.-)%s*$", "%1")
    if cleanedInput == "" then return nil end
    
    local id = tonumber(cleanedInput)
    if id then return id end
    
    local lowerName = string.lower(cleanedInput)
    if userIdCache[lowerName] then return userIdCache[lowerName] end
    
    local success, result = pcall(function()
        return Players:GetUserIdFromNameAsync(cleanedInput)
    end)
    
    if success and result then 
        userIdCache[lowerName] = result
        return result 
    end
    return nil
end

-- 解析 Online 数据
local function checkOnlineData(data)
    if type(data) == "table" then
        return data.Online or data.IsOnline or (data.Server ~= nil) or false
    elseif data == true then
        return true
    end
    return false
end

-- 发送加入 Remote 请求
local function fireJoinRequest(id)
    pcall(function()
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        if remotes and remotes:FindFirstChild("JoinPlayerFromProfile") then
            remotes.JoinPlayerFromProfile:FireServer(id)
        end
    end)
end

-- [ 执行状态检查的主函数 ] --
function performCheck()
    if isBusy then return end
    
    local inputStr = InputBox.Text
    if inputStr == "" then
        S_StatusLabel.Text = "⚠️ 請輸入玩家名稱或 ID"
        S_StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 100)
        return
    end

    highlightByName(inputStr)

    isBusy = true
    S_NameLabel.Text = "玩家: " .. inputStr
    S_StatusLabel.Text = "🔄 获取 ID 中..."
    S_StatusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    S_JoinSettingLabel.Text = "加入权限: 查询中..."
    S_JoinSettingLabel.TextColor3 = Color3.fromRGB(180, 180, 180)

    task.spawn(function()
        local targetId = getUserId(inputStr)
        if not targetId then
            S_IDLabel.Text = "ID: 错误"
            S_StatusLabel.Text = "❌ 找不到该玩家"
            S_StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            S_JoinSettingLabel.Text = "加入权限: -"
            isBusy = false
            return
        end

        S_IDLabel.Text = "ID: " .. targetId
        S_StatusLabel.Text = "🔄 查询状态中..."

        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local getRemote = remotes and remotes:FindFirstChild("GetPlayerProfileData")
        
        if not getRemote then
            S_StatusLabel.Text = "❌ 游戏中找不到 Remote 服务"
            S_StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            isBusy = false
            return
        end

        local success, data = pcall(function()
            return getRemote:InvokeServer(targetId)
        end)
        
        if success then
            if data and checkOnlineData(data) then
                S_StatusLabel.Text = "🟢 状态: 在线 (Online)"
                S_StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
                
                if listButtonsMap[inputStr] then
                    listButtonsMap[inputStr].TextColor3 = Color3.fromRGB(100, 255, 100)
                    listButtonsMap[inputStr].Text = "🟢 " .. inputStr
                end
            else
                S_StatusLabel.Text = "🔴 状态: 离线 (Offline)"
                S_StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            end
            
            local joinServerSetting = "Unknown"
            if type(data) == "table" and data.Settings and data.Settings.JoinServer then
                joinServerSetting = data.Settings.JoinServer
            end
            
            if joinServerSetting == "Everyone" then
                S_JoinSettingLabel.Text = "🔓 权限: 所有人 (Everyone)"
                S_JoinSettingLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
                addEveryoneRecord(inputStr, targetId)
            elseif joinServerSetting == "FriendsOnly" then
                S_JoinSettingLabel.Text = "👥 权限: 仅限好友 (FriendsOnly)"
                S_JoinSettingLabel.TextColor3 = Color3.fromRGB(255, 170, 0)
            elseif joinServerSetting == "Nobody" then
                S_JoinSettingLabel.Text = "🔒 权限: 关闭 (Nobody)"
                S_JoinSettingLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            else
                S_JoinSettingLabel.Text = "❓ 權限: 未知/隐藏"
                S_JoinSettingLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
            end
        else
            S_StatusLabel.Text = "❌ 查询失敗 (无法获取资料)"
            S_StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            S_JoinSettingLabel.Text = "权限: 读取失败"
            S_JoinSettingLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        end
        
        isBusy = false
    end)
end

