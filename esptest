local Settings = {
    PlayerESP = false,
    MonsterESP = false,

    ShowDistance = true,
    ShowHealth = true,

    TextSize = 14
}

--------------------------------------------------
-- STORAGE
--------------------------------------------------

local Storage = {
    Players = {},
    Monsters = {}
}

--------------------------------------------------
-- CREATE DRAWING
--------------------------------------------------

local function CreateDrawing(Type)

    local text =
        Drawing.new("Text")

    text.Visible = false
    text.Center = true
    text.Outline = true
    text.Font = 2
    text.Size = Settings.TextSize

    if Type == "Player" then

        text.Color =
            Color3.new(
                0,
                1,
                0.5
            )

    else

        text.Color =
            Color3.new(
                1,
                0.2,
                0.2
            )

    end

    return text

end

--------------------------------------------------
-- PLAYER ESP
--------------------------------------------------

local function UpdatePlayers()

    for _, p in pairs(
        Players:GetPlayers()
    ) do

        if p ~= LocalPlayer then

            if not Storage.Players[p] then

                Storage.Players[p] =
                    CreateDrawing(
                        "Player"
                    )

            end

            local drawing =
                Storage.Players[p]

            local Character =
                p.Character

            local HRP =
                Character
                and Character
                :FindFirstChild(
                    "HumanoidRootPart"
                )

            local Humanoid =
                Character
                and Character
                :FindFirstChild(
                    "Humanoid"
                )

            local myChar =
                LocalPlayer.Character

            local myHRP =
                myChar
                and myChar
                :FindFirstChild(
                    "HumanoidRootPart"
                )

            if Settings.PlayerESP
            and HRP
            and Humanoid
            and Humanoid.Health > 0
            and myHRP then

                local pos, visible =
                    Camera
                    :WorldToViewportPoint(
                        HRP.Position
                    )

                if visible then

                    local dist =
                        math.floor(
                            (
                                myHRP.Position
                                -
                                HRP.Position
                            ).Magnitude
                        )

                    local content =
                        "[" ..
                        p.DisplayName ..
                        "]"

                    if Settings.ShowHealth then

                        content =
                            content
                            ..
                            "\nHP: "
                            ..
                            math.floor(
                                Humanoid.Health
                            )

                    end

                    if Settings.ShowDistance then

                        content =
                            content
                            ..
                            "\nDist: "
                            ..
                            dist

                    end

                    drawing.Position =
                        Vector2.new(
                            pos.X,
                            pos.Y
                        )

                    drawing.Text =
                        content

                    drawing.Size =
                        Settings.TextSize

                    drawing.Visible = true

                else

                    drawing.Visible = false

                end

            else

                drawing.Visible = false

            end

        end

    end

end

--------------------------------------------------
-- MONSTER ESP
--------------------------------------------------

local function UpdateMonsters()

    if not Settings.MonsterESP then

        for _, d in pairs(
            Storage.Monsters
        ) do

            d.Visible = false

        end

        return

    end

    local myChar =
        LocalPlayer.Character

    local myHRP =
        myChar
        and myChar
        :FindFirstChild(
            "HumanoidRootPart"
        )

    if not myHRP then
        return
    end

    for _, obj in pairs(
        workspace:GetChildren()
    ) do

        if obj:IsA("Model")
        and not Players
        :GetPlayerFromCharacter(
            obj
        )
        and obj:FindFirstChild(
            "HumanoidRootPart"
        ) then

            if not Storage.Monsters[obj] then

                Storage.Monsters[obj] =
                    CreateDrawing(
                        "Monster"
                    )

            end

            local drawing =
                Storage.Monsters[obj]

            local HRP =
                obj.HumanoidRootPart

            local Humanoid =
                obj
                :FindFirstChildOfClass(
                    "Humanoid"
                )

            local pos, visible =
                Camera
                :WorldToViewportPoint(
                    HRP.Position
                )

            if visible
            and (
                not Humanoid
                or Humanoid.Health > 0
            ) then

                local dist =
                    math.floor(
                        (
                            myHRP.Position
                            -
                            HRP.Position
                        ).Magnitude
                    )

                local content =
                    "[怪物: "
                    ..
                    obj.Name
                    ..
                    "]"

                if Humanoid
                and Settings.ShowHealth then

                    content =
                        content
                        ..
                        "\nHP: "
                        ..
                        math.floor(
                            Humanoid.Health
                        )

                end

                if Settings.ShowDistance then

                    content =
                        content
                        ..
                        "\nDist: "
                        ..
                        dist

                end

                drawing.Position =
                    Vector2.new(
                        pos.X,
                        pos.Y
                    )

                drawing.Text =
                    content

                drawing.Size =
                    Settings.TextSize

                drawing.Visible = true

            else

                drawing.Visible = false

            end

        end

    end

end

