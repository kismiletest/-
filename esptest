--------------------------------------------------
-- CREATE DRAWING
--------------------------------------------------

local function CreateDrawing(color)

    local text =
        Drawing.new("Text")

    text.Visible = false
    text.Center = true
    text.Outline = true
    text.Font = 2
    text.Size = 14
    text.Color = color

    return text

end

--------------------------------------------------
-- ENTITY FILTER
--------------------------------------------------

local function IsActiveEntity(obj)

    if Players
    :GetPlayerFromCharacter(obj)
    or obj == LocalPlayer.Character then

        return false

    end

    local HRP =
        obj:FindFirstChild(
            "HumanoidRootPart"
        )
        or
        obj:FindFirstChild(
            "PrimaryPart"
        )

    local Humanoid =
        obj:FindFirstChildOfClass(
            "Humanoid"
        )

    if not HRP then
        return false
    end

    --------------------------------------------------
    -- MOVEMENT CHECK
    --------------------------------------------------

    if Settings.OnlyMoving then

        local currentPos =
            HRP.Position

        local lastPos =
            LastPositions[obj]

        LastPositions[obj] =
            currentPos

        if not lastPos
        or (
            currentPos
            -
            lastPos
        ).Magnitude < 0.1 then

            if Humanoid
            and Humanoid
            .MoveDirection
            .Magnitude > 0 then

                return true

            end

            return false

        end

    end

    --------------------------------------------------
    -- HEALTH CHECK
    --------------------------------------------------

    if Humanoid
    and Humanoid.Health <= 0 then

        return false

    end

    return true

end

--------------------------------------------------
-- PLAYER ESP
--------------------------------------------------

local function UpdatePlayers()

    for _, p in pairs(
        Players:GetPlayers()
    ) do

        if p ~= LocalPlayer
        and p.Character
        and p.Character
        :FindFirstChild(
            "HumanoidRootPart"
        ) then

            if not Storage.Players[p] then

                Storage.Players[p] =
                    CreateDrawing(
                        Color3.new(
                            0,
                            1,
                            0.7
                        )
                    )

            end

            local drawing =
                Storage.Players[p]

            if Settings.PlayerESP then

                local pos, visible =
                    Camera
                    :WorldToViewportPoint(
                        p.Character
                        .HumanoidRootPart
                        .Position
                    )

                if visible then

                    drawing.Position =
                        Vector2.new(
                            pos.X,
                            pos.Y
                        )

                    drawing.Text =
                        string.format(
                            "[%s]",
                            p.DisplayName
                        )

                    drawing.Visible = true

                else

                    drawing.Visible = false

                end

            else

                drawing.Visible = false

            end

        end

    end

end

--------------------------------------------------
-- MONSTER ESP
--------------------------------------------------

local function UpdateMonsters()

    if not Settings.MonsterESP then

        for _, v in pairs(
            Storage.Monsters
        ) do

            v.Visible = false

        end

        return

    end

    local myChar =
        LocalPlayer.Character

    local myHRP =
        myChar
        and myChar
        :FindFirstChild(
            "HumanoidRootPart"
        )

    if not myHRP then
        return
    end

    for _, obj in pairs(
        workspace:GetDescendants()
    ) do

        if obj:IsA("Model")
        and IsActiveEntity(obj) then

            if not Storage.Monsters[obj] then

                Storage.Monsters[obj] =
                    CreateDrawing(
                        Color3.new(
                            1,
                            0.2,
                            0.2
                        )
                    )

            end

            local drawing =
                Storage.Monsters[obj]

            local root =
                obj:FindFirstChild(
                    "HumanoidRootPart"
                )
                or
                obj:FindFirstChild(
                    "PrimaryPart"
                )

            if root then

                local pos, visible =
                    Camera
                    :WorldToViewportPoint(
                        root.Position
                    )

                if visible then

                    local dist =
                        math.floor(
                            (
                                myHRP.Position
                                -
                                root.Position
                            ).Magnitude
                        )

                    drawing.Position =
                        Vector2.new(
                            pos.X,
                            pos.Y
                        )

                    drawing.Text =
                        string.format(
                            "⚠️ [危险实体]\n%s\n[%d m]",
                            obj.Name,
                            dist
                        )

                    drawing.Visible = true

                else

                    drawing.Visible = false

                end

            end

        elseif Storage.Monsters[obj] then

            Storage.Monsters[obj]
            .Visible = false

        end

    end

end

