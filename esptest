})

--------------------------------------------------
-- SETTINGS
--------------------------------------------------

local Settings = {
    AutoLevel = false,
    Distance = 5
}

--------------------------------------------------
-- AUTO FARM LOOP
--------------------------------------------------

task.spawn(function()

    while task.wait(0.5) do

        if Settings.AutoLevel then

            pcall(function()

                local Character =
                    LocalPlayer.Character

                if not Character then
                    return
                end

                local HRP =
                    Character
                    :FindFirstChild(
                        "HumanoidRootPart"
                    )

                local Humanoid =
                    Character
                    :FindFirstChild(
                        "Humanoid"
                    )

                if not HRP
                or not Humanoid then
                    return
                end

                --------------------------------------------------
                -- FIND CLOSEST MONSTER
                --------------------------------------------------

                local target = nil
                local dist = math.huge

                for _, v in pairs(
                    workspace:GetDescendants()
                ) do

                    if v:IsA("Humanoid")
                    and v.Parent ~= Character
                    and v.Health > 0 then

                        local enemyHRP =
                            v.Parent
                            :FindFirstChild(
                                "HumanoidRootPart"
                            )

                        if enemyHRP then

                            local distance =
                                (
                                    HRP.Position
                                    -
                                    enemyHRP.Position
                                ).Magnitude

                            if distance < dist then

                                target = enemyHRP
                                dist = distance

                            end

                        end

                    end

                end

                --------------------------------------------------
                -- TELEPORT + ATTACK
                --------------------------------------------------

                if target then

                    HRP.CFrame =
                        target.CFrame
                        * CFrame.new(
                            0,
                            Settings.Distance,
                            0
                        )

                    local Tool =
                        Character
                        :FindFirstChildOfClass(
                            "Tool"
                        )
                        or
                        LocalPlayer.Backpack
                        :FindFirstChildOfClass(
                            "Tool"
                        )

                    if Tool then

                        if Tool.Parent
                        ~= Character then

                            Humanoid:EquipTool(
                                Tool
                            )

                        end

                        Tool:Activate()

                    end

                end

            end)

        end

    end

end)

--------------------------------------------------
-- TOGGLE
--------------------------------------------------

FarmTab:Toggle({
    Title = "全自动练级",
    Desc = "自动寻找最近怪物并攻击",
    Value = false,

    Callback = function(state)

        Settings.AutoLevel = state

        if state then

            WindUI:Notify({
                Title = "Auto Farm",
                Content = "已开启自动挂机",
                Duration = 4
            })

        else

            WindUI:Notify({
                Title = "Auto Farm",
                Content = "已关闭自动挂机",
                Duration = 4
            })

        end

    end
})

