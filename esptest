--------------------------------------------------
-- TAB
--------------------------------------------------

local VisualTab = Window:Tab({
    Title = "视觉透视",
    Icon = "eye"
})

--------------------------------------------------
-- VARIABLES
--------------------------------------------------

local PlayerESPEnabled = false
local MonsterESPEnabled = false

local ESP_Storage = {
    Players = {},
    Monsters = {}
}

--------------------------------------------------
-- DRAWING
--------------------------------------------------

local function CreateDrawing()

    local text = Drawing.new("Text")

    text.Visible = false
    text.Center = true
    text.Outline = true
    text.Font = 2
    text.Size = 14

    return text

end

--------------------------------------------------
-- PLAYER ESP
--------------------------------------------------

local function UpdatePlayers()

    for _, player in pairs(Players:GetPlayers()) do

        if player ~= LocalPlayer then

            if not ESP_Storage.Players[player] then
                ESP_Storage.Players[player] =
                    CreateDrawing()
            end

            local draw =
                ESP_Storage.Players[player]

            local char = player.Character

            local hrp =
                char and
                char:FindFirstChild(
                    "HumanoidRootPart"
                )

            local myChar =
                LocalPlayer.Character

            local myHRP =
                myChar and
                myChar:FindFirstChild(
                    "HumanoidRootPart"
                )

            if PlayerESPEnabled
            and hrp
            and myHRP then

                local pos, visible =
                    Camera:WorldToViewportPoint(
                        hrp.Position
                    )

                if visible then

                    local dist = math.floor(
                        (myHRP.Position
                        - hrp.Position).Magnitude
                    )

                    draw.Position =
                        Vector2.new(pos.X, pos.Y)

                    draw.Text =
                        "[" ..
                        player.DisplayName ..
                        "]\n" ..
                        dist ..
                        " 距离"

                    draw.Color =
                        Color3.fromRGB(
                            0,
                            255,
                            140
                        )

                    draw.Visible = true

                else

                    draw.Visible = false

                end

            else

                draw.Visible = false

            end

        end

    end

end

--------------------------------------------------
-- MONSTER ESP
--------------------------------------------------

local function UpdateMonsters()

    if not MonsterESPEnabled then

        for _, draw in pairs(
            ESP_Storage.Monsters
        ) do

            draw.Visible = false

        end

        return
    end

    for _, obj in pairs(workspace:GetChildren()) do

        if obj:IsA("Model")
        and not Players:GetPlayerFromCharacter(obj)
        and obj:FindFirstChild(
            "HumanoidRootPart"
        ) then

            if not ESP_Storage.Monsters[obj] then

                ESP_Storage.Monsters[obj] =
                    CreateDrawing()

            end

            local draw =
                ESP_Storage.Monsters[obj]

            local hrp =
                obj.HumanoidRootPart

            local myChar =
                LocalPlayer.Character

            local myHRP =
                myChar and
                myChar:FindFirstChild(
                    "HumanoidRootPart"
                )

            if myHRP then

                local pos, visible =
                    Camera:WorldToViewportPoint(
                        hrp.Position
                    )

                if visible then

                    local dist = math.floor(
                        (myHRP.Position
                        - hrp.Position).Magnitude
                    )

                    draw.Position =
                        Vector2.new(pos.X, pos.Y)

                    draw.Text =
                        "[怪物]\n" ..
                        dist ..
                        " 距离"

                    draw.Color =
                        Color3.fromRGB(
                            255,
                            50,
                            50
                        )

                    draw.Visible = true

                else

                    draw.Visible = false

                end

            end

        end

    end

end

--------------------------------------------------
-- LOOP
--------------------------------------------------

RunService.RenderStepped:Connect(function()

    pcall(function()

        UpdatePlayers()
        UpdateMonsters()

    end)

end)

