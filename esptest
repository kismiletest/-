-- AUTO CLICKER
--------------------------------------------------

RunService.RenderStepped:Connect(function()

    if AutoClicker
    and PVP_Enabled then

        local Character =
            LocalPlayer.Character

        local Tool =
            Character
            and Character:FindFirstChildOfClass(
                "Tool"
            )

        if Tool then
            pcall(function()
                Tool:Activate()
            end)
        end

    end

end)

--------------------------------------------------
-- SILENT AIM
--------------------------------------------------

local oldNamecall

oldNamecall = hookmetamethod(
    game,
    "__namecall",
    function(self, ...)

        local method =
            getnamecallmethod()

        local args = {...}

        if SilentAim
        and method == "FireServer" then

            local target =
                GetClosestPlayer()

            if target
            and target.Character
            and target.Character
            :FindFirstChild(
                "HumanoidRootPart"
            ) then

                local hrp =
                    target.Character
                    .HumanoidRootPart

                for i,v in pairs(args) do

                    if typeof(v)
                    == "Vector3" then

                        args[i] =
                            hrp.Position

                    end

                end

                return oldNamecall(
                    self,
                    unpack(args)
                )

            end

        end

        return oldNamecall(
            self,
            ...
        )

    end
)

