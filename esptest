-- [[ 1. 初始化 WindUI ]]
local WindUI = loadstring(game:HttpGet("https://tree-hub.vercel.app/api/UI/WindUI"))()
if game.CoreGui:FindFirstChild("WindUI") then game.CoreGui.WindUI:Destroy() end

local Window = WindUI:CreateWindow({
    Title = "智能怪物过滤 (核心版)",
    Icon = "skull",
    Author = "Gemini",
    Folder = "AntiNPCE_Config"
})

local ESPTab = Window:CreateTab("视觉透视", "eye")

-- [[ 2. 配置项 ]]
local _G = {
    MonsterESP = false,
    PlayerESP = false,
    OnlyAggressive = true, -- 核心：只显示会动的/有威胁的
    MinDist = 5,           -- 距离太近（比如刚好重合的NPC）过滤掉
}

local Storage = {Monsters = {}, Players = {}}
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- [[ 3. 核心：智能识别“真怪物”逻辑 ]]
local function IsActiveMonster(obj)
    -- 必须是模型且不是玩家
    if not obj:IsA("Model") or Players:GetPlayerFromCharacter(obj) then return false end
    
    local hum = obj:FindFirstChildOfClass("Humanoid")
    local hrp = obj:FindFirstChild("HumanoidRootPart")
    
    if hum and hrp and hum.Health > 0 then
        -- 过滤 1: 名字过滤 (排除掉图片中那种明显的任务/商店 NPC)
        local name = obj.Name:lower()
        local blacklist = {"npc", "shop", "quest", "merchant", "guide", "click", "dialogue"}
        for _, word in pairs(blacklist) do
            if name:find(word) then return false end
        end

        -- 过滤 2: 动态检测 (只有正在动的才是会抓人的怪)
        if _G.OnlyAggressive then
            -- 如果它的移动向量是 0，且没有任何动画位移，则判定为静态 NPC
            local isMoving = (hum.MoveDirection.Magnitude > 0 or hum.WalkSpeed > 0)
            if not isMoving then return false end
        end

        return true
    end
    return false
end

-- [[ 4. 渲染循环 ]]
game:GetService("RunService").RenderStepped:Connect(function()
    -- 清理逻辑: 如果怪物被删除了，清理掉对应的 Drawing
    for obj, drawing in pairs(Storage.Monsters) do
        if not obj.Parent then
            drawing:Remove()
            Storage.Monsters[obj] = nil
        end
    end

    if not _G.MonsterESP then
        for _, d in pairs(Storage.Monsters) do d.Visible = false end
    else
        for _, obj in pairs(workspace:GetDescendants()) do
            -- 注意：为了更深层搜索，改用 GetDescendants，但配合 IsActiveMonster 过滤
            if IsActiveMonster(obj) then
                if not Storage.Monsters[obj] then
                    local t = Drawing.new("Text")
                    t.Center = true
                    t.Outline = true
                    t.Color = Color3.fromRGB(255, 0, 0) -- 真怪物显示红色
                    Storage.Monsters[obj] = t
                end
                
                local d = Storage.Monsters[obj]
                local pos, onScreen = Camera:WorldToViewportPoint(obj.HumanoidRootPart.Position)
                
                if onScreen then
                    local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - obj.HumanoidRootPart.Position).Magnitude)
                    d.Position = Vector2.new(pos.X, pos.Y)
                    d.Text = string.format("⚠️ [危险目标]\n%s\n[%d m]", obj.Name, dist)
                    d.Visible = true
                else d.Visible = false end
            elseif Storage.Monsters[obj] then
                Storage.Monsters[obj].Visible = false
            end
        end
    end
end)

