-- [[ 1. 初始化 WindUI ]]
local WindUI = loadstring(game:HttpGet("https://tree-hub.vercel.app/api/UI/WindUI"))()
local Window = WindUI:CreateWindow({
    Title = "Sailor Piece 全自动助手",
    Icon = "anchor",
    Author = "User",
    Folder = "SailorPiece_Config"
})

-- [[ 2. 核心状态控制 ]]
local _G = {
    AutoFarm = false,
    AutoQuest = false,
    AutoStats = false,
    AutoBuy = false,
    SelectedWeapon = "Combat", -- 默认武器
    TargetItem = "Log Pose"    -- 默认购买物品
}

-- [[ 3. 游戏服务引用 ]]
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RS = game:GetService("RunService")

-- [[ 4. 自动化逻辑函数 (简略框架) ]]

-- 自动接任务逻辑
local function CheckQuest()
    while _G.AutoQuest do
        -- 这里需要根据 Sailor Piece 的具体任务 NPC 路径修改
        -- 例如: game:GetService("ReplicatedStorage").Remotes.AcceptQuest:FireServer("QuestName")
        task.wait(1)
    end
end

-- 自动战斗逻辑
local function StartFarm()
    while _G.AutoFarm do
        pcall(function()
            local target = workspace.NPCs:FindFirstChildOfClass("Model") -- 需改为游戏实际NPC路径
            if target and target:FindFirstChild("HumanoidRootPart") then
                -- 自动瞬移到怪物后方
                LocalPlayer.Character.HumanoidRootPart.CFrame = target.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
                -- 自动攻击
                local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
                if tool then tool:Activate() end
            end
        end)
        task.wait()
    end
end

-- [[ 5. UI 标签页 ]]
local FarmTab = Window:CreateTab("自动挂机", "swords")
local ShopTab = Window:CreateTab("自动商店", "shopping-cart")
local MiscTab = Window:CreateTab("杂项设置", "settings")

-- [[ 6. UI 元件添加 ]]

-- --- 挂机页 ---
FarmTab:AddToggle({
    Title = "全自动练级 (Auto Farm)",
    Desc = "自动瞬移至怪物并攻击",
    Value = false,
    Callback = function(state)
        _G.AutoFarm = state
        if state then task.spawn(StartFarm) end
    end
})

FarmTab:AddToggle({
    Title = "自动接取/提交任务",
    Desc = "根据等级自动匹配对应任务",
    Value = false,
    Callback = function(state)
        _G.AutoQuest = state
        if state then task.spawn(CheckQuest) end
    end
})

FarmTab:AddDropdown({
    Title = "选择攻击武器",
    Options = {"Combat", "Sword", "Fruit", "Gun"},
    Callback = function(v) _G.SelectedWeapon = v end
})

-- --- 商店页 ---
ShopTab:AddDropdown({
    Title = "选择自动购买项",
    Options = {"Log Pose", "Black Leg", "Katana", "Fruit Box"},
    Callback = function(v) _G.TargetItem = v end
})

ShopTab:AddButton({
    Title = "开启全自动购买",
    Desc = "满足金钱条件时自动购买所选物品",
    Callback = function()
        WindUI:Notify({
            Title = "自动购买",
            Content = "已开始监控金钱并尝试购买: " .. _G.TargetItem,
            Type = "Info"
        })
        -- 这里放入购买远程事件 FireServer
    end
})

-- --- 杂项页 ---
MiscTab:AddButton({
    Title = "解锁所有东西 (Unlocks)",
    Desc = "尝试执行一键解锁/对话逻辑",
    Callback = function()
        -- 遍历场景中所有可交互物品
        WindUI:Notify({Title = "执行中", Content = "正在尝试自动交互所有解锁项", Type = "Success"})
    end
})

MiscTab:AddToggle({
    Title = "自动加点 (Melee)",
    Value = false,
    Callback = function(state) _G.AutoStats = state end
})

