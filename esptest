--------------------------------------------------
-- QUEST SYSTEM
--------------------------------------------------

local function GetQuest()

    local level = 1

    pcall(function()
        level =
            LocalPlayer.Data.Level.Value
    end)

    local questName = ""

    if level >= 1 and level < 15 then

        questName = "Bandit Quest"

    elseif level >= 15 and level < 30 then

        questName = "Pirate Quest"

    end

    return questName

end

--------------------------------------------------
-- AUTO FARM LOOP
--------------------------------------------------

task.spawn(function()

    while task.wait() do

        if Settings.AutoFarm then

            pcall(function()

                local Character =
                    LocalPlayer.Character

                if not Character then
                    return
                end

                local HRP =
                    Character:FindFirstChild(
                        "HumanoidRootPart"
                    )

                local Humanoid =
                    Character:FindFirstChild(
                        "Humanoid"
                    )

                if not HRP or not Humanoid then
                    return
                end

                local Weapon =
                    Character:FindFirstChild(
                        Settings.Weapon
                    )
                    or
                    LocalPlayer.Backpack
                    :FindFirstChild(
                        Settings.Weapon
                    )

                --------------------------------------------------
                -- EQUIP
                --------------------------------------------------

                if Weapon
                and not Character
                :FindFirstChild(
                    Settings.Weapon
                ) then

                    Humanoid:EquipTool(
                        Weapon
                    )

                end

                --------------------------------------------------
                -- NPC CHECK
                --------------------------------------------------

                local NPCFolder =
                    workspace:FindFirstChild(
                        "NPCs"
                    )

                if not NPCFolder then
                    return
                end

                for _, v in pairs(
                    NPCFolder:GetChildren()
                ) do

                    if v:FindFirstChild(
                        "Humanoid"
                    )
                    and v.Humanoid.Health > 0
                    and v:FindFirstChild(
                        "HumanoidRootPart"
                    ) then

                        --------------------------------------------------
                        -- BRING MOB
                        --------------------------------------------------

                        if Settings.BringMob then

                            v.HumanoidRootPart
                            .CFrame =
                                HRP.CFrame
                                * CFrame.new(
                                    0,
                                    0,
                                    -3
                                )

                            v.HumanoidRootPart
                            .CanCollide = false

                        end

                        --------------------------------------------------
                        -- TELEPORT
                        --------------------------------------------------

                        HRP.CFrame =
                            v.HumanoidRootPart
                            .CFrame
                            * CFrame.new(
                                0,
                                5,
                                0
                            )

                        --------------------------------------------------
                        -- ATTACK
                        --------------------------------------------------

                        if Weapon then

                            Weapon:Activate()

                        end

                    end

                end

            end)

        end

    end

end)

