pcall(function()
    game.CoreGui:FindFirstChild("WindUI"):Destroy()
end)

repeat task.wait() until game:IsLoaded()

--------------------------------------------------
-- LOAD WIND UI
--------------------------------------------------

local WindUI = loadstring(game:HttpGet(
"https://tree-hub.vercel.app/api/UI/WindUI"
))()

--------------------------------------------------
-- SERVICES
--------------------------------------------------

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

--------------------------------------------------
-- WINDOW
--------------------------------------------------

local Window = WindUI:CreateWindow({
    Title = "1.en Hub",
    Icon = "ghost",
    Author = "by 1.en",
    Folder = "1enHub",
    Size = UDim2.fromOffset(600,400),
    Transparent = true,
    Theme = "Dark",
    SideBarWidth = 180
})

--------------------------------------------------
-- TABS
--------------------------------------------------

local MainTab = Window:CreateTab(
    "Main",
    "home"
)

local VisualTab = Window:CreateTab(
    "视觉透视",
    "eye"
)

--------------------------------------------------
-- VARIABLES
--------------------------------------------------

local PlayerESPEnabled = false
local MonsterESPEnabled = false

local ESP_Storage = {
    Players = {},
    Monsters = {}
}

--------------------------------------------------
-- CREATE DRAWING
--------------------------------------------------

local function CreateDrawingText()

    local text = Drawing.new("Text")

    text.Visible = false
    text.Center = true
    text.Outline = true
    text.Font = 2
    text.Size = 14
    text.Color = Color3.new(1,1,1)

    return text

end

--------------------------------------------------
-- PLAYER ESP
--------------------------------------------------

local function HandlePlayerESP()

    for _, player in pairs(Players:GetPlayers()) do

        if player ~= LocalPlayer then

            if not ESP_Storage.Players[player] then

                ESP_Storage.Players[player] =
                    CreateDrawingText()

            end

            local drawing =
                ESP_Storage.Players[player]

            local char = player.Character

            local hrp =
                char and
                char:FindFirstChild(
                    "HumanoidRootPart"
                )

            local myChar =
                LocalPlayer.Character

            local myHRP =
                myChar and
                myChar:FindFirstChild(
                    "HumanoidRootPart"
                )

            if PlayerESPEnabled
            and hrp
            and myHRP then

                local pos, onScreen =
                    Camera:WorldToViewportPoint(
                        hrp.Position
                    )

                if onScreen then

                    local dist = math.floor(
                        (myHRP.Position
                        - hrp.Position).Magnitude
                    )

                    drawing.Position =
                        Vector2.new(pos.X, pos.Y)

                    drawing.Text =
                        string.format(
                            "[%s]\n%d 距离",
                            player.DisplayName,
                            dist
                        )

                    drawing.Color =
                        Color3.fromRGB(
                            0,
                            255,
                            140
                        )

                    drawing.Visible = true

                else

                    drawing.Visible = false

                end

            else

                drawing.Visible = false

            end

        end

    end

end

--------------------------------------------------
-- MONSTER ESP
--------------------------------------------------

local function HandleMonsterESP()

    if MonsterESPEnabled then

        for _, obj in pairs(workspace:GetChildren()) do

            if obj:IsA("Model")
            and not Players:GetPlayerFromCharacter(obj)
            and obj:FindFirstChild(
                "HumanoidRootPart"
            ) then

                if not ESP_Storage.Monsters[obj] then

                    ESP_Storage.Monsters[obj] =
                        CreateDrawingText()

                end

                local drawing =
                    ESP_Storage.Monsters[obj]

                local hrp =
                    obj.HumanoidRootPart

                local myChar =
                    LocalPlayer.Character

                local myHRP =
                    myChar and
                    myChar:FindFirstChild(
                        "HumanoidRootPart"
                    )

                if myHRP then

                    local pos, onScreen =
                        Camera:WorldToViewportPoint(
                            hrp.Position
                        )

                    if onScreen then

                        local dist = math.floor(
                            (myHRP.Position
                            - hrp.Position).Magnitude
                        )

                        drawing.Position =
                            Vector2.new(
                                pos.X,
                                pos.Y
                            )

                        drawing.Text =
                            string.format(
                                "[怪物/实体]\n%d 距离",
                                dist
                            )

                        drawing.Color =
                            Color3.fromRGB(
                                255,
                                50,
                                50
                            )

                        drawing.Visible = true

                    else

                        drawing.Visible = false

                    end

                end

            end

        end

    else

        for _, drawing in pairs(
            ESP_Storage.Monsters
        ) do

            drawing.Visible = false

        end

    end

end

--------------------------------------------------
-- RENDER LOOP
--------------------------------------------------

RunService.RenderStepped:Connect(function()

    pcall(function()

        HandlePlayerESP()
        HandleMonsterESP()

    end)

end)

--------------------------------------------------
-- PLAYER ESP TOGGLE
--------------------------------------------------

VisualTab:AddToggle({
    Title = "透视玩家",
    Desc = "显示其他玩家及距离",
    Value = false,

    Callback = function(state)

        PlayerESPEnabled = state

        WindUI:Notify({
            Title = "玩家 ESP",
            Content = state
                and "已开启"
                or "已关闭",
            Type = "Info"
        })

    end
})

--------------------------------------------------
-- MONSTER ESP TOGGLE
--------------------------------------------------

VisualTab:AddToggle({
    Title = "透视怪物",
    Desc = "自动识别怪物实体",
    Value = false,

    Callback = function(state)

        MonsterESPEnabled = state

        if state then

            WindUI:Notify({
                Title = "扫描中",
                Content = "正在识别场景中的怪物...",
                Type = "Info"
            })

        else

            for _, drawing in pairs(
                ESP_Storage.Monsters
            ) do

                drawing.Visible = false

            end

        end

    end
})

