--------------------------------------------------
-- QUEST DATA
--------------------------------------------------

local function GetQuestData()

    local level = 1

    pcall(function()
        level =
            LocalPlayer.Data.Level.Value
    end)

    if level < 20 then

        return {
            NPC = "Bandit NPC",
            Quest = "BanditQuest",
            Target = "Bandit"
        }

    elseif level < 50 then

        return {
            NPC = "Pirate NPC",
            Quest = "PirateQuest",
            Target = "Pirate"
        }

    else

        return {
            NPC = "Elite NPC",
            Quest = "EliteQuest",
            Target = "Elite"
        }

    end

end

--------------------------------------------------
-- AUTO LEVEL LOOP
--------------------------------------------------

task.spawn(function()

    while task.wait() do

        if Settings.AutoLevel then

            pcall(function()

                local data =
                    GetQuestData()

                local Character =
                    LocalPlayer.Character

                if not Character then
                    return
                end

                local HRP =
                    Character
                    :FindFirstChild(
                        "HumanoidRootPart"
                    )

                local Humanoid =
                    Character
                    :FindFirstChild(
                        "Humanoid"
                    )

                if not HRP
                or not Humanoid then
                    return
                end

                --------------------------------------------------
                -- QUEST CHECK
                --------------------------------------------------

                local hasQuest = false

                pcall(function()

                    hasQuest =
                        LocalPlayer
                        .PlayerGui
                        .MainGui
                        .QuestFrame
                        .Visible

                end)

                --------------------------------------------------
                -- TAKE QUEST
                --------------------------------------------------

                if not hasQuest then

                    local NPCFolder =
                        workspace
                        :FindFirstChild(
                            "NPCs"
                        )

                    if NPCFolder then

                        local npc =
                            NPCFolder
                            :FindFirstChild(
                                data.NPC
                            )

                        if npc
                        and npc
                        :FindFirstChild(
                            "HumanoidRootPart"
                        ) then

                            HRP.CFrame =
                                npc
                                .HumanoidRootPart
                                .CFrame
                                * CFrame.new(
                                    0,
                                    0,
                                    3
                                )

                            local Remotes =
                                ReplicatedStorage
                                :FindFirstChild(
                                    "Remotes"
                                )

                            if Remotes
                            and Remotes
                            :FindFirstChild(
                                "AcceptQuest"
                            ) then

                                Remotes
                                .AcceptQuest
                                :FireServer(
                                    data.Quest
                                )

                            end

                        end

                    end

                else

                    --------------------------------------------------
                    -- KILL MONSTER
                    --------------------------------------------------

                    local EnemyFolder =
                        workspace
                        :FindFirstChild(
                            "Enemies"
                        )

                    if not EnemyFolder then
                        return
                    end

                    for _, monster in pairs(
                        EnemyFolder
                        :GetChildren()
                    ) do

                        if monster.Name
                        == data.Target
                        and monster
                        :FindFirstChild(
                            "Humanoid"
                        )
                        and monster
                        .Humanoid.Health > 0
                        and monster
                        :FindFirstChild(
                            "HumanoidRootPart"
                        ) then

                            --------------------------------------------------
                            -- TELEPORT
                            --------------------------------------------------

                            HRP.CFrame =
                                monster
                                .HumanoidRootPart
                                .CFrame
                                * CFrame.new(
                                    0,
                                    Settings.Distance,
                                    0
                                )
                                * CFrame.Angles(
                                    math.rad(-90),
                                    0,
                                    0
                                )

                            --------------------------------------------------
                            -- EQUIP
                            --------------------------------------------------

                            local Tool =
                                LocalPlayer
                                .Backpack
                                :FindFirstChild(
                                    Settings.Weapon
                                )
                                or
                                Character
                                :FindFirstChild(
                                    Settings.Weapon
                                )

                            if Tool then

                                if not Character
                                :FindFirstChild(
                                    Settings.Weapon
                                ) then

                                    Humanoid
                                    :EquipTool(
                                        Tool
                                    )

                                end

                                --------------------------------------------------
                                -- ATTACK
                                --------------------------------------------------

                                Tool:Activate()

                            end

                            break

                        end

                    end

                end

            end)

        end

    end

end)

