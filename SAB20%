local animalCache = {}
local promptCache = {}
local stealCache = {}
local IsStealing = false
local STEAL_R = 7
local AnimalsData = {}

pcall(function()
    local rep = game:GetService("ReplicatedStorage")
    local datas = rep:FindFirstChild("Datas")
    if datas then
        local animals = datas:FindFirstChild("Animals")
        if animals then AnimalsData = require(animals) end
    end
end)

local function stealHRP()
    local c = player.Character
    return c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("UpperTorso"))
end

local function isMyBase(plotName)
    local plot = workspace.Plots and workspace.Plots:FindFirstChild(plotName)
    if not plot then return false end
    local sign = plot:FindFirstChild("PlotSign")
    if not sign then return false end
    local yb = sign:FindFirstChild("YourBase")
    return yb and yb:IsA("BillboardGui") and yb.Enabled == true
end

local function scanPlot(plot)
    if not plot or not plot:IsA("Model") or isMyBase(plot.Name) then return end
    local podiums = plot:FindFirstChild("AnimalPodiums")
    if not podiums then return end
    for _, pod in ipairs(podiums:GetChildren()) do
        if pod:IsA("Model") and pod:FindFirstChild("Base") then
            local name = "Unknown"
            local spawn = pod.Base:FindFirstChild("Spawn")
            if spawn then
                for _, child in ipairs(spawn:GetChildren()) do
                    if child:IsA("Model") and child.Name ~= "PromptAttachment" then
                        name = child.Name
                        local info = AnimalsData[name]
                        if info and info.DisplayName then name = info.DisplayName end
                        break
                    end
                end
            end
            table.insert(animalCache, {
                name = name,
                plot = plot.Name,
                slot = pod.Name,
                worldPosition = pod:GetPivot().Position,
                uid = plot.Name .. "*" .. pod.Name,
            })
        end
    end
end

local function findPrompt(ad)
    if not ad then return nil end
    if promptCache[ad.uid] and promptCache[ad.uid].Parent then return promptCache[ad.uid] end
    local plot = workspace.Plots:FindFirstChild(ad.plot)
    local pod = plot and plot.AnimalPodiums:FindFirstChild(ad.slot)
    local att = pod and pod.Base.Spawn:FindFirstChild("PromptAttachment")
    if att then
        for _, p in ipairs(att:GetChildren()) do
            if p:IsA("ProximityPrompt") then
                promptCache[ad.uid] = p
                return p
            end
        end
    end
end

local function buildCallbacks(prompt)
    if stealCache[prompt] then return end
    local data = { holdCallbacks = {}, triggerCallbacks = {}, ready = true }
    local ok1, c1 = pcall(getconnections, prompt.PromptButtonHoldBegan)
    if ok1 and type(c1) == "table" then
        for _, conn in ipairs(c1) do if type(conn.Function) == "function" then table.insert(data.holdCallbacks, conn.Function) end end
    end
    local ok2, c2 = pcall(getconnections, prompt.Triggered)
    if ok2 and type(c2) == "table" then
        for _, conn in ipairs(c2) do if type(conn.Function) == "function" then table.insert(data.triggerCallbacks, conn.Function) end end
    end
    if #data.holdCallbacks > 0 or #data.triggerCallbacks > 0 then stealCache[prompt] = data end
end

local function execSteal(prompt)
    local data = stealCache[prompt]
    if not data or not data.ready then return end
    data.ready = false; IsStealing = true
    task.spawn(function()
        for _, fn in ipairs(data.holdCallbacks) do task.spawn(fn) end
        task.wait(0.2)
        for _, fn in ipairs(data.triggerCallbacks) do task.spawn(fn) end
        task.wait(0.01)
        data.ready = true; IsStealing = false
    end)
end

local function nearestAnimal()
    local h = stealHRP(); if not h then return nil end
    local best, bestD = nil, math.huge
    for _, ad in ipairs(animalCache) do
        local d = (h.Position - ad.worldPosition).Magnitude
        if d < bestD then bestD = d; best = ad end
    end
    return best
end

local function silenceTool(tool)
    for _, v in ipairs(tool:GetDescendants()) do
        if v:IsA("Sound") then
            v.Volume = 0; v:Stop()
            v:GetPropertyChangedSignal("Playing"):Connect(function() if v.Playing then v.Playing = false; v:Stop() end end)
            v.SoundId = ""
        end
    end
end

local function toggleDrop(state)
    for _, c in ipairs(_wfConns) do if typeof(c) == "RBXScriptConnection" then c:Disconnect() end end
    _wfConns = {}
    if state then
        local colConn = RunService.Stepped:Connect(function()
            if not dropOn then return end
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player and p.Character then
                    for _, part in ipairs(p.Character:GetChildren()) do if part:IsA("BasePart") then part.CanCollide = false end end
                end
            end
        end)
        table.insert(_wfConns, colConn)
        task.spawn(function()
            while dropOn do
                RunService.Heartbeat:Wait()
                local root = stealHRP(); if not root then continue end
                local vel = root.Velocity
                root.Velocity = vel * 10000 + Vector3.new(0, 10000, 0)
                RunService.RenderStepped:Wait()
                if root and root.Parent then root.Velocity = vel end
                RunService.Stepped:Wait()
                if root and root.Parent then root.Velocity = vel + Vector3.new(0, 0.1, 0) end
            end
        end)
    end
end

UserInputService.JumpRequest:Connect(function()
    if infJumpOn then
        local root = stealHRP()
        if root then root.Velocity = Vector3.new(root.Velocity.X, jumpForce, root.Velocity.Z) end
    end
end)

task.spawn(function()
    local plots = workspace:WaitForChild("Plots", 10)
    if not plots then return end
    for _, plot in ipairs(plots:GetChildren()) do scanPlot(plot) end
    plots.ChildAdded:Connect(function(plot) task.wait(0.5); scanPlot(plot) end)
    while task.wait(5) do
        animalCache = {}
        for _, plot in ipairs(plots:GetChildren()) do scanPlot(plot) end
    end
end)

RunService.Heartbeat:Connect(function()
    if infJumpOn then
        local root = stealHRP()
        if root and root.Velocity.Y < -clampFallSpeed then root.Velocity = Vector3.new(root.Velocity.X, -clampFallSpeed, root.Velocity.Z) end
    end

    if instaGrabEnabled and not IsStealing then
        local target = nearestAnimal()
        local h = stealHRP()
        if target and h and (h.Position - target.worldPosition).Magnitude <= STEAL_R then
            local prompt = findPrompt(target)
            if prompt then buildCallbacks(prompt); execSteal(prompt) end
        end
    end

    if antiRagdollOn then
        local char = player.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 then
                local state = hum:GetState()
                if state == Enum.HumanoidStateType.Physics or state == Enum.HumanoidStateType.Ragdoll or state == Enum.HumanoidStateType.FallingDown then
                    hum:ChangeState(Enum.HumanoidStateType.Running)
                    pcall(function()
                        local PM = player.PlayerScripts:FindFirstChild("PlayerModule")
                        if PM then require(PM:FindFirstChild("ControlModule")):Enable() end
                    end)
                    if root then root.Velocity = Vector3.new(0,0,0) root.RotVelocity = Vector3.new(0,0,0) end
                end
                for _, obj in ipairs(char:GetDescendants()) do
                    if obj:IsA("Motor6D") and obj.Enabled == false then obj.Enabled = true end
                end
            end
        end
    end
end)

