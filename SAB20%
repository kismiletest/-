local function findMyTool(searchList)
    local function check(parent)
        for _, t in pairs(parent:GetChildren()) do if t:IsA("Tool") then for _, word in ipairs(searchList) do if t.Name:lower():find(word:lower()) then return t end end end end
    end
    return (player.Character and check(player.Character)) or check(player.Backpack)
end

local function createString(parent, att0, att1)
    local b = Instance.new("Beam", parent) b.Attachment0 = att0 b.Attachment1 = att1
    b.Width0, b.Width1 = 0.25, 0.25 b.LightEmission = 1 b.FaceCamera = true
    b.Texture = "rbxassetid://403444877" b.TextureSpeed = 4 return b
end

RunService.Stepped:Connect(function()
    local char = player.Character if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    angle += (0.15 * direction) if tick() - lastSwitch > 3 then direction *= -1 lastSwitch = tick() end

    local config = {
        {search = {"Bat"}, active = batOn, offset = 0},
        {search = {"Cape", "Laser"}, active = capeOn, offset = math.pi},
        {search = {"Coil Combo", "Combo"}, active = comboOn, offset = math.pi/2},
        -- {search = {"Carpet", "空飛ぶ"}, active = carpetOn, offset = -math.pi/2} -- コンフィグから削除
    }

    for _, data in ipairs(config) do
        local tool = findMyTool(data.search)
        if tool and tool:FindFirstChild("Handle") then
            local handle = tool.Handle
            if data.active then
                if tick() % 0.1 < 0.05 then
                    tool.Parent = char silenceTool(tool)
                    for _, v in pairs(char:GetDescendants()) do if v:IsA("Weld") and (v.Part0 == handle or v.Part1 == handle) then v:Destroy() end end
                    local curA = angle + data.offset
                    handle.CFrame = hrp.CFrame * CFrame.new(math.cos(curA)*15, 0, math.sin(curA)*15) * CFrame.Angles(math.rad(90), -curA, 0)
                    handle.Velocity = Vector3.new(0, 0, 0)
                    local a0 = hrp:FindFirstChild("StringAtt") or Instance.new("Attachment", hrp) a0.Name = "StringAtt"
                    local a1 = handle:FindFirstChild("StringAtt") or Instance.new("Attachment", handle) a1.Name = "StringAtt"
                    if not handle:FindFirstChild("StringBeam") then createString(handle, a0, a1).Name = "StringBeam" end
                    handle.StringBeam.Color = ColorSequence.new(Color3.fromHSV((tick() * 1.5) % 1, 1, 1))
                else tool.Parent = player.Backpack end
            elseif handle:FindFirstChild("StringBeam") then handle.StringBeam:Destroy() end
        end
    end
end)

