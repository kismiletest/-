end)

local function handleStealSequence(target)
    local uid = target.UserId
    local now = tick()
    if not Config.EntryTime[uid] then Config.EntryTime[uid] = now end
    local elapsed = now - Config.EntryTime[uid]

    fire(target, "balloon")
    if elapsed >= 10 and not Config.HasWarned[uid] then
        Config.HasWarned[uid] = true
        fire(target, "jumpscare")
    end
    if elapsed >= 15 then
        local lastB = (Config.LastExecuted[uid] and Config.LastExecuted[uid]["balloon"]) or 0
        if (now - lastB) < Config.Cooldown.balloon then fire(target, "ragdoll") end
    end
end

