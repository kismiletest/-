-- ========== ロジック (0.3秒間隔で2回タップ) ==========
local function smartAction()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local cloner = nil

    local function search(parent)
        if not parent then return nil end
        for _, item in ipairs(parent:GetChildren()) do
            if item:IsA("Tool") and (item.Name:find("クローナー") or item.Name:find("Cloner") or item.Name:find("量子")) then
                return item
            end
        end
    end

    cloner = search(char) or search(backpack)

    if cloner then
        btn.Text = "EQUIPPING..."
        if cloner.Parent == backpack then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum:EquipTool(cloner) end
            task.wait(0.2)
        end

        -- 座標: 中央から少し右(X+40)、下(Y-120)
        local view = workspace.CurrentCamera.ViewportSize
        local tx = (view.X / 2) + 40
        local ty = view.Y - 120

        local function tap()
            VirtualInputManager:SendMouseButtonEvent(tx, ty, 0, true, game, 0)
            task.wait(0.05)
            VirtualInputManager:SendMouseButtonEvent(tx, ty, 0, false, game, 0)
        end

        -- 0.3秒間隔で2回実行
        btn.Text = "FAST TAP..."
        tap()
        task.wait(0.3) -- ここを0.3秒に変更
        tap()

        btn.Text = "SUCCESS"
        btn.BackgroundColor3 = DEEP_GREEN
        task.wait(0.5)
        btn.Text = "DEPLOY"
        btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    else
        btn.Text = "NOT FOUND"
        btn.TextColor3 = Color3.fromRGB(255, 80, 80)
        task.wait(1)
        btn.Text = "DEPLOY"
        btn.TextColor3 = Color3.fromRGB(220, 220, 220)
    end
end

btn.MouseButton1Click:Connect(smartAction)


