-- ============================ 工具函数 ============================
local function FormatNumber(n)
    local s = tostring(math.floor(tonumber(n) or 0))
    local left, num, right = s:match("^([^%d]*%d)(%d*)(.-)$")
    return left .. (num:reverse():gsub("(%d%d%d)", "%1,"):reverse()) .. right
end

local function ApplyPlayerRange(label)
    _G.HopPlayerRange = label
    local minPlayers, maxPlayers = label:match("(%d+)%-(%d+)")
    if minPlayers and maxPlayers then
        _G.HopMinPlayers = tonumber(minPlayers)
        _G.HopMaxPlayers = tonumber(maxPlayers)
        return
    end
    _G.HopMinPlayers = 1
    _G.HopMaxPlayers = 12
end

-- 区间 100-200m / 下限 大于100m / 其它 = 不限
local function ParseBountyFilter(label)
    label = tostring(label or "")
    local lo, hi = label:match("([%d%.]+)%s*%-%s*([%d%.]+)[Mm]")
    if lo and hi then
        return (tonumber(lo) or 0) * 1000000, (tonumber(hi) or 0) * 1000000
    end
    local minOnly = label:match("大于([%d%.]+[Mm]?)")
    if minOnly then
        local num, unit = minOnly:match("([%d%.]+)([Mm]?)")
        local value = tonumber(num) or 0
        if unit and unit:lower() == "m" then value = value * 1000000 end
        return value + 1, 999999999999999
    end
    return 0, 999999999999999
end

ApplyPlayerRange(_G.HopPlayerRange)

-- ============================ 拉取全服列表 ============================
local ServerHopCache = { List = nil, Fetching = false }

local function FetchServerList(timeout)
    local browser = ReplicatedStorage:FindFirstChild("__ServerBrowser")
    if not browser then return nil end
    local servers = {}
    local pending = 0
    for page = 1, 100 do
        pending = pending + 1
        task.delay(page * 0.02, function()
            local ok, result = pcall(function()
                return browser:InvokeServer(page)
            end)
            if not ok then
                local tries = 0
                repeat
                    task.wait(0.5)
                    tries = tries + 1
                    ok, result = pcall(function()
                        return browser:InvokeServer(page)
                    end)
                until ok or tries >= 2
            end
            if ok and type(result) == "table" then
                for job, info in pairs(result) do
                    if type(info) == "table" then
                        servers[job] = {
                            Region = tostring(info.Region or "Unknown"),
                            Count = tonumber(info.Count) or 0,
                            Bounty = tonumber(info.Bounty) or 0,
                        }
                    end
                end
            end
            pending = pending - 1
        end)
    end
    local deadline = tick() + (timeout or 20)
    while pending > 0 and tick() < deadline do
        task.wait(0.1)
    end
    return servers
end

local function GetServerList()
    if ServerHopCache.List then
        return ServerHopCache.List
    end
    if ServerHopCache.Fetching then
        local deadline = tick() + 25
        while ServerHopCache.Fetching and tick() < deadline do
            task.wait(0.1)
        end
        return ServerHopCache.List
    end
    ServerHopCache.Fetching = true
    local ok, servers = pcall(FetchServerList, 20)
    ServerHopCache.Fetching = false
    if ok and type(servers) == "table" and next(servers) ~= nil then
        ServerHopCache.List = servers
    end
    return ServerHopCache.List
end

-- ============================ 传送 ============================
local function JoinServerJob(job)
    if type(job) ~= "string" or job == "" then return false end
    local ok = false
    local browser = ReplicatedStorage:FindFirstChild("__ServerBrowser")
    if browser then
        ok = pcall(function()
            browser:InvokeServer("teleport", job)
        end)
    end
    if not ok then
        ok = pcall(function()
            game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, job, LocalPlayer)
        end)
    end
    return ok
end

-- ============================ Webhook ============================
-- 优先用执行器的 request / http_request, 兜底 HttpService
local function HttpPost(url, body)
    if request then
        local ok = pcall(function()
            request({
                Url = url,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = body,
            })
        end)
        if ok then return true end
    end
    if http_request then
        local ok = pcall(function()
            http_request({
                Url = url,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = body,
            })
        end)
        if ok then return true end
    end
    return pcall(function()
        HttpService:PostAsync(url, body, Enum.HttpContentType.ApplicationJson)
    end)
end

-- 发送一条文本消息到 Discord webhook
local function SendWebhook(content)
    if not _G.WebhookEnabled then return false end
    local url = tostring(_G.WebhookURL or "")
    if url == "" then return false end
    local payload = HttpService:JSONEncode({
        content = tostring(content),
        username = tostring(_G.WebhookName or "Notifier"),
    })
    return HttpPost(url, payload)
end

-- 把服务器列表格式化成多行文本(加入代码用代码块包住, Discord 里高亮显示且可复制)
local function FormatServerLines(list, limit)
    local lines = {}
    for i = 1, math.min(#list, limit or 10) do
        local s = list[i]
        lines[#lines + 1] = string.format(
            "%d. **%s** | %s %d | %s %s\n%s:\n```\n%s\n```",
            i, s.Region, L("人数"), s.Count, L("赏金"), FormatNumber(s.Bounty), L("加入代码"), s.Job)
    end
    return table.concat(lines, "\n")
end

-- ============================ 手动进服列表 ============================
local ManualHopDropdown
local ManualHopMap = {}
local ManualHopScanning = false

-- 扫描服务器列表, 按 _G.ManualHopRange 过滤, 赏金从高到低排序后刷进下拉框
local function RefreshManualHopList(notify)
    if ManualHopScanning then return end
    ManualHopScanning = true

    ServerHopCache.List = nil
    local servers = GetServerList()

    local minBounty, maxBounty = ParseBountyFilter(_G.ManualHopRange)
    local list = {}
    if type(servers) == "table" then
        for job, info in pairs(servers) do
            if type(info) == "table" and job ~= game.JobId then
                local bounty = tonumber(info.Bounty) or 0
                local count = tonumber(info.Count) or 0
                if bounty >= minBounty and bounty <= maxBounty
                    and count >= _G.HopMinPlayers and count <= _G.HopMaxPlayers then
                    table.insert(list, {
                        Job = job,
                        Region = tostring(info.Region or "Unknown"),
                        Count = count,
                        Bounty = bounty,
                    })
                end
            end
        end
    end
    table.sort(list, function(a, b) return a.Bounty > b.Bounty end)

    ManualHopMap = {}
    local labels = {}
    for i, s in ipairs(list) do
        local label = string.format("%d. %s | %s", i, s.Region, FormatNumber(s.Bounty))
        ManualHopMap[label] = s
        table.insert(labels, label)
    end
    if #labels == 0 then
        labels = { L("（点刷新获取服务器列表）") }
    end

    if ManualHopDropdown and ManualHopDropdown.Refresh then
        pcall(function() ManualHopDropdown:Refresh(labels, false) end)
    end

    ManualHopScanning = false
    if notify then
        WindUI:Notify({
            Title = L("手动进服"),
            Content = L("已找到") .. " " .. #list .. " " .. L("个服务器"),
            Icon = "wind",
            Duration = 3
        })
        -- 刷新时推送服务器列表到 webhook
        if _G.WebhookEnabled and _G.WebhookOnFind and #list > 0 then
            local msg = string.format("%s [%s] %s %d %s (%s):\n%s",
                L("服务器扫描结果"), _G.ManualHopRange, L("共"), #list, L("个"), L("赏金从高到低"),
                FormatServerLines(list, 10))
            task.spawn(SendWebhook, msg)
        end
    end
end

