local CONFIG_FILE = "manual_server_hop.json"

local function SaveConfig()
    if not writefile then return end
    local ok, raw = pcall(function()
        return HttpService:JSONEncode({
            WebhookURL     = _G.WebhookURL,
            WebhookEnabled = _G.WebhookEnabled,
            WebhookName    = _G.WebhookName,
            WebhookOnFind  = _G.WebhookOnFind,
            ManualHopRange = _G.ManualHopRange,
            HopPlayerRange = _G.HopPlayerRange,
            ManualHopAuto  = _G.ManualHopAuto,
            JoinJobId      = _G.JoinJobId,
            Language       = _G.Language,
        })
    end)
    if ok and raw then pcall(writefile, CONFIG_FILE, raw) end
end

local function LoadConfig()
    if not (readfile and isfile) then return end
    pcall(function()
        if not isfile(CONFIG_FILE) then return end
        local raw = readfile(CONFIG_FILE)
        if not raw or raw == "" then return end
        local data = HttpService:JSONDecode(raw)
        if type(data) ~= "table" then return end
        for k, v in pairs(data) do
            if v ~= nil then _G[k] = v end
        end
    end)
end

