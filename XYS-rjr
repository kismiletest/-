-- 減畫質
tab_main:Button({
    Title = "減畫質",
    Icon = "monitor",
    Callback = function()
        for _, v in pairs(Workspace:GetDescendants()) do
            if v:IsA("ParticleEmitter") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") then
                v.Enabled = false
            end
        end
        WindUI:Notify({Duration = 2, Content = "已降低部分特效", Title = "減畫質"})
    end
})

-- 移除岩漿
tab_main:Button({
    Title = "移除岩漿",
    Icon = "flame",
    Callback = function()
        for _, v in pairs(Workspace:GetDescendants()) do
            if v.Name == "Lava" or v.Name == "Magma" then
                v:Destroy()
            end
        end
        WindUI:Notify({Duration = 2, Content = "已嘗試移除岩漿", Title = "移除岩漿"})
    end
})

-- 移除霧
tab_main:Button({
    Title = "移除霧",
    Icon = "cloud-off",
    Callback = function()
        Lighting.FogEnd = 100000
        if Lighting:FindFirstChild("LightingLayers") then
            Lighting.LightingLayers:Destroy()
        end
        if Lighting:FindFirstChild("Sky") then
            Lighting.Sky:Destroy()
        end
        WindUI:Notify({Duration = 2, Content = "已移除霧與天空特效", Title = "移除霧"})
    end
})

