-- 功能1 - 基本設定
tab_main:Slider({
    Title = "視角縮放距離",
    Min = 128,
    Max = 10000000000,
    Default = 128,
    Callback = function(value)
        LocalPlayer.CameraMaxZoomDistance = value
        WindUI:Notify({Duration = 2, Content = "已設為: " .. value, Title = "視角縮放"})
    end
})

tab_main:Divider()

tab_main:Input({
    Title = "速度",
    Placeholder = "輸入速度值 (建議 16~200)",
    Value = "16",
    Callback = function(value)
        local num = tonumber(value)
        if num and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid.WalkSpeed = num
            WindUI:Notify({Duration = 2, Content = "速度設為: " .. num, Title = "速度"})
        end
    end
})

-- 加速開關
local fastConn
tab_main:Toggle({
    Title = "加速開關",
    Value = false,
    Callback = function(state)
        if state then
            if fastConn then fastConn:Disconnect() end
            fastConn = RunService.Heartbeat:Connect(function()
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                    LocalPlayer.Character.Humanoid.WalkSpeed = 100
                end
            end)
            WindUI:Notify({Duration = 2, Content = "加速已開啟", Title = "加速"})
        else
            if fastConn then fastConn:Disconnect() end
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                LocalPlayer.Character.Humanoid.WalkSpeed = 16
            end
            WindUI:Notify({Duration = 2, Content = "加速已關閉", Title = "加速"})
        end
    end
})

