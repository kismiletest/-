task.spawn(function()
	task.wait(25) -- 等新服务器玩家列表加载完，别刚进来就跳走
	local emptySince = nil
	local emptyWaitCombat = false
	local emptyCombatSince = nil -- 从什么时候开始等战斗结束（等满 Hunt_HopCombatWait 秒就照跳）
	while task.wait(2) do
