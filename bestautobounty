-- ==================== 自动跳服务器 (1:1 移植自 WindUI 的服务器浏览器扫描) ====================
-- 真正的扫描逻辑：任何一步报错都由外层 serverHop 兜住，不会把 IsServerHopping 卡死

-- 传送 + 验证：发包成功 ≠ 真的换服，3 秒内 JobId 变了才算跳成功
local function teleportAndVerify(doTeleport)
	local jobBefore = game.JobId
	local ok = pcall(doTeleport)
	if not ok then return false end
	local t0 = tick()
	while tick() - t0 < 3 do
		if game.JobId ~= jobBefore then return true end
		task.wait(0.2)
	end
	return false
end

-- 兜底跳服：走 Roblox 公开服务器列表 + TeleportService，完全不依赖游戏内的 ServerBrowser 界面。
-- 用于「界面里扫不到服务器」或「点了传送但没真的换服」的情况
local function hopByApi()
	local url = "https://games.roblox.com/v1/games/" .. tostring(game.PlaceId)
		.. "/servers/Public?sortOrder=Asc&limit=100&excludeFullGames=true"

	local ok, body = pcall(function() return game:HttpGet(url) end)
	if not ok or type(body) ~= "string" or body == "" then
		print("[猎赏] HTTP 兜底: 拿服务器列表失败 -> " .. tostring(body))
		return false
	end

	local ok2, data = pcall(function() return HttpService:JSONDecode(body) end)
	if not ok2 or type(data) ~= "table" or type(data.data) ~= "table" then
		print("[猎赏] HTTP 兜底: 服务器列表解析失败")
		return false
	end

	local list, total = {}, 0
	for _, srv in ipairs(data.data) do
		local job = srv.id
		local playing = srv.playing or 0
		local maxP = srv.maxPlayers or 12
		if job and job ~= game.JobId and playing < maxP then
			total = total + 1
			if playing >= (_G.G_HopMinPlayers or 1) and playing <= (_G.G_HopMaxPlayers or 12) then
				table.insert(list, { Job = job, Players = playing })
			end
		end
	end

	if #list == 0 then
		print("[猎赏] HTTP 兜底: " .. total .. " 个有空位的服务器，但没有符合人数条件("
			.. _G.G_HopPlayerRange .. ")的")
		return false
	end

	-- 同样是从人数最少的开始逐个试，跳不进去就换下一个
	table.sort(list, function(a, b) return a.Players < b.Players end)
	print("[猎赏] HTTP 兜底: 找到 " .. #list .. " 个候选 | 这条路没有区域/赏金过滤")
	queueAutoReload() -- 先排队再传送

	local tried = 0
	for _, cand in ipairs(list) do
		tried = tried + 1
		print("[猎赏] HTTP 兜底 尝试第 " .. tried .. " 个: " .. cand.Job .. "（" .. cand.Players .. " 人）")
		if teleportAndVerify(function()
			TeleportService:TeleportToPlaceInstance(game.PlaceId, cand.Job, LocalPlayer)
		end) then
			print("[猎赏] HTTP 兜底传送成功，正在传送...")
			return true
		end
		print("[猎赏] HTTP 兜底: 这个也没跳进去 -> 换下一个服务器")
		if tried >= 5 then
			print("[猎赏] HTTP 兜底: 试了 " .. tried .. " 个都不行 -> 本轮放弃，稍后重试")
			break
		end
	end
	return false
end

local function doServerHop()
	if getgenv().IsServerHopping == true then return false end
	getgenv().IsServerHopping = true

	local PlayerGui = LocalPlayer.PlayerGui
	if not PlayerGui:FindFirstChild("ServerBrowser") then
		print("[猎赏] 没找到 ServerBrowser 界面 -> 改用 HTTP 服务器列表兜底")
		local apiOk = hopByApi()
		getgenv().IsServerHopping = false
		return apiOk
	end

	PlayerGui.ServerBrowser.Enabled = true
	task.wait(0.1)

	local Filters = PlayerGui.ServerBrowser.Frame:FindFirstChild("Filters")
	local SearchRegion = Filters and Filters:FindFirstChild("SearchRegion")
	local TextBox = SearchRegion and SearchRegion:FindFirstChild("TextBox")

	if not TextBox then
		print("[猎赏] ServerBrowser 里找不到区域输入框 -> 改用 HTTP 服务器列表兜底")
		local apiOk = hopByApi()
		getgenv().IsServerHopping = false
		return apiOk
	end

	TextBox.Text = _G.G_ServerRegion

	-- 展开完整列表
	local Full = Filters and Filters:FindFirstChild("Full")
	local FullCheck = Full and Full:FindFirstChild("Check")
	if FullCheck then
		FullCheck.Text = "\226\156\148\239\184\143"
		task.wait(0.1)
	end

	local ScrollingFrame = PlayerGui.ServerBrowser.Frame.ScrollingFrame
	local FakeScroll = PlayerGui.ServerBrowser.Frame.FakeScroll
	local Inside = FakeScroll.Inside

	-- 滚动列表，让所有服务器条目加载出来
	task.spawn(function()
		while getgenv().IsServerHopping do
			ScrollingFrame.CanvasPosition = Vector2.new(0, math.random(100, 7000))
			task.wait(0.3)
		end
	end)

	task.wait()

	local currentJobId = game.JobId
	local ServerBrowserRemote = ReplicatedStorage:WaitForChild("__ServerBrowser")

	print("[猎赏] 扫描服务器 | 区域: " .. _G.G_ServerRegion
		.. " | 人数: " .. _G.G_HopPlayerRange .. " | 赏金: " .. _G.G_HopBountyRange)

	-- 先滚动几轮把服务器列表尽量加载全，收集所有符合条件的候选，再挑「人数最少」的那个加入
	--（已满人的服务器在上面的 IsServerAllowed 里就被挡掉了，不会去挤）
	local candidates = {} -- jobId -> info
	local rounds = 0
	while getgenv().IsServerHopping and rounds < 12 do
		rounds = rounds + 1
		for _, template in ipairs(Inside:GetChildren()) do
			if template.Name == "Template" then
				local joinButton = template:FindFirstChild("Join")
				local textLabel = template:FindFirstChild("TextLabel")
				local info = textLabel and ParseServerInfo(textLabel.Text)

				if joinButton and info and IsServerAllowed(info) then
					local job = joinButton:GetAttribute("Job")
					if job then
						job = tostring(job)
						if job:find("-", 1, true) and job ~= currentJobId then
							local old = candidates[job]
							if not old or info.Players < old.Players then
								candidates[job] = info
							end
						end
					end
				end
			end
		end
		task.wait(0.3)
	end

	-- 选人数最少的那个
	local bestJob, bestInfo, candCount = nil, nil, 0
	for job, info in pairs(candidates) do
		candCount = candCount + 1
		if not bestInfo or info.Players < bestInfo.Players then
			bestJob, bestInfo = job, info
		end
	end

	if not bestJob then
		print("[猎赏] 界面里没扫到符合条件(人数/赏金/满人)的服务器 -> 改用 HTTP 服务器列表兜底")
		local apiOk = hopByApi()
		getgenv().IsServerHopping = false
		return apiOk
	end

	print("[猎赏] 扫到 " .. candCount .. " 个可用服务器 -> 选人数最少的: 地区 " .. tostring(bestInfo.Region)
		.. " | 人数 " .. bestInfo.Players .. "/" .. bestInfo.MaxPlayers
		.. " | 赏金 " .. FormatNumber(bestInfo.Bounty))

	-- 先把「传送后自动重跑脚本」排进队列，再发起传送
	queueAutoReload()

	local jobBefore = game.JobId
	local success = pcall(function()
		ServerBrowserRemote:InvokeServer("teleport", bestJob)
	end)
	if not success then
		success = pcall(function()
			ServerBrowserRemote:InvokeServer("teleport", bestJob)
		end)
	end

	-- 发包成功不代表真的换服：等 3 秒看 JobId 有没有变，没变就走 HTTP 兜底再传送一次
	if success then
		local t0 = tick()
		while tick() - t0 < 3 do
			if game.JobId ~= jobBefore then
				print("[猎赏] 跳服成功，正在传送...")
				return true
			end
			task.wait(0.2)
		end
		print("[猎赏] 游戏内跳服没生效（还停在原服务器）-> 改用 HTTP 服务器列表兜底")
	else
		print("[猎赏] 游戏内跳服发包失败 -> 改用 HTTP 服务器列表兜底")
	end

	local apiOk = hopByApi()
	getgenv().IsServerHopping = false
	task.wait(0.3)
	return apiOk
end

-- 外层包装：用 pcall 包住扫描，异常也不会把跳服功能卡死（换服后由执行器的自动执行重跑脚本）
local function serverHop()
	local ok, result = pcall(doServerHop)
	getgenv().IsServerHopping = false -- 无论成功还是报错都清掉，否则以后都跳不了服
	if not ok then
		print("[猎赏] 跳服异常: " .. tostring(result))
		return false
	end
	return result == true
end

-- 是否正在战斗中：逃生中 / 手动锁了人 / 刚出过手 / 30 秒内交手过的对手还活着在附近
-- 注意：不能用「锁定了目标」当战斗判据 —— 猎赏时永远都锁着人，会导致每次跳服都干等到超时
local function inCombat()
	if _G.Hunt_Fleeing then return true end
	if _G.Hunt_Target and _G.Hunt_Target ~= "" then return true end
	if tick() - lastAttack < 5 then return true end

	local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if myRoot then
		local now = tick()
		for name, t in pairs(recentFoes) do
			if now - t > RECENT_FOE_TIME then
				recentFoes[name] = nil -- 超过 30 秒没再交手，视为这场架结束
			else
				local plr = Players:FindFirstChild(name)
				if plr and isAlive(plr) then
					local root = getRoot(plr)
					if root and (root.Position - myRoot.Position).Magnitude <= (_G.Hunt_MaxDist or 10000) then
						return true
					end
				end
			end
		end
	end
	return false
end

-- 现在能不能跳服：手动跳服不等待；开了「等战斗结束」就先确认战斗真的结束了
-- （连查两次是为了避开目标扫描每秒一次的空档，避免刚打完一秒就被判定成结束）
-- waitSince：从什么时候开始等这场战斗结束；等满 Hunt_HopCombatWait 秒还没结束就照跳，
-- 避免碰上「一直被判定成战斗中」的情况（对手一直贴着）导致永远不跳服。
local function combatWaitExpired(waitSince)
	local limit = _G.Hunt_HopCombatWait or 60
	return waitSince ~= nil and limit > 0 and (tick() - waitSince) >= limit
end

local function canHopNow(force, waitSince)
	if force or not _G.Hunt_HopWaitCombat then return true end
	if combatWaitExpired(waitSince) then return true end
	if inCombat() then return false end
	task.wait(2)
	return not inCombat()
end

task.spawn(function()
	local waitingCombat = false
	local combatWaitSince = nil -- 从什么时候开始等战斗结束（等满 Hunt_HopCombatWait 秒就照跳）
	while task.wait(1) do
		local hop, force = false, false
		if _G.Hunt_ForceHop then
			-- 手动点「立即跳服务器」不等待，直接跳
			_G.Hunt_ForceHop = false
			hop, force = true, true
		elseif _G.Hunt_AutoHop then
			if not _G.Hunt_HopTimer then _G.Hunt_HopTimer = tick() end
			if tick() - _G.Hunt_HopTimer >= _G.Hunt_HopInterval then hop = true end
		else
			_G.Hunt_HopTimer = tick()
		end

		if hop then
			-- 要跳服了：先飞到天上等（躲开战斗，等这场架打完再跳）
			if _G.Hunt_HopSkyUp and not (_G.Hunt_HopSkyTimer or _G.Hunt_HopSkyEmpty) then
				_G.Hunt_HopSkyTimer = true
				skyBaseY = nil -- 让飞行循环重新记起始高度
				print("[猎赏] 准备跳服 -> 飞到天上 " .. _G.Hunt_HopSkyHeight .. " 米等待")
			end
			if canHopNow(force, combatWaitSince) then
				if combatWaitExpired(combatWaitSince) then
					print("[猎赏] 已等战斗结束 " .. (_G.Hunt_HopCombatWait or 60) .. " 秒仍未结束 -> 直接跳服")
				elseif waitingCombat then
					print("[猎赏] 战斗结束 -> 开始跳服")
				end
				waitingCombat = false
				combatWaitSince = nil
				print("[猎赏] 跳服务器中...")
				local hopOk = serverHop()
				if hopOk then
					_G.Hunt_HopTimer = tick()
				else
					-- 传送失败(含服务器拒绝 / 没找到空位)就 20 秒后重试，不用再干等一个完整间隔
					_G.Hunt_HopTimer = tick() - _G.Hunt_HopInterval + 20
				end
				-- 不管成功失败都先解除飞天等待：
				-- 传送成功的话马上就换服了；失败的话要下来继续猎赏，否则会一直挂在天上不干活
				if _G.Hunt_HopSkyTimer then
					_G.Hunt_HopSkyTimer = false
					if not hopOk then print("[猎赏] 这轮没跳成功 -> 从天上下来继续猎赏，稍后重试") end
				end
			elseif not waitingCombat then
				-- 到点了但还在打：不跳，等这场架打完再跳（提前跳会丢掉这单赏金）
				waitingCombat = true
				combatWaitSince = tick()
				print("[猎赏] 到跳服时间了，但战斗还没结束 -> 打完再跳，最多等 "
					.. (_G.Hunt_HopCombatWait or 60) .. " 秒")
			end
		else
			waitingCombat = false
			combatWaitSince = nil
			-- 没有待处理的跳服了（关掉了自动跳服 / 本轮已结束）：从天上下来继续猎赏
			if _G.Hunt_HopSkyTimer then
				_G.Hunt_HopSkyTimer = false
				print("[猎赏] 当前没有待跳服 -> 从天上下来继续猎赏")
			end
		end
	end
end)

