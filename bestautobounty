local buttonCache = {}
local buttonSearchTime = {}

-- 列出所有 BoundAction* 按钮（诊断用）
local function listBoundActions()
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if not pg then return {} end
	local mcb = pg:FindFirstChild("MobileContextButtons")
	local frame = mcb and mcb:FindFirstChild("ContextButtonFrame")
	if not frame then return {} end
	local list = {}
	for _, child in ipairs(frame:GetChildren()) do
		table.insert(list, child.ClassName .. ":" .. child.Name)
	end
	return list
end

-- 按关键字找 GuiButton（名字或父级名字包含关键字）
local function findButtonByKeyword(kw)
	local cached = buttonCache[kw]
	if cached and cached.Parent then return cached end
	if tick() - (buttonSearchTime[kw] or 0) < 2 then return buttonCache[kw] end
	buttonSearchTime[kw] = tick()

	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if not pg then return nil end

	local found = nil
	-- 已知路径: MobileContextButtons.ContextButtonFrame.BoundActionXXX.Button
	local mcb = pg:FindFirstChild("MobileContextButtons")
	local frame = mcb and mcb:FindFirstChild("ContextButtonFrame")
	if frame then
		for _, child in ipairs(frame:GetChildren()) do
			if child.Name:lower():find(kw) then
				found = child:FindFirstChild("Button") or child:FindFirstChildWhichIsA("GuiButton")
				if found then break end
			end
		end
	end

	-- 兜底：全量搜索
	if not found then
		for _, obj in ipairs(pg:GetDescendants()) do
			if obj:IsA("GuiButton") then
				local n = obj.Name:lower()
				local pn = obj.Parent and obj.Parent.Name:lower() or ""
				if n:find(kw) or pn:find(kw) then
					found = obj
					break
				end
			end
		end
	end

	-- 找不到就把现有的 BoundAction 列出来，方便定位真实名字
	if not found and not buttonCache["_reported_" .. kw] then
		buttonCache["_reported_" .. kw] = true
		local acts = listBoundActions()
		print("[猎赏] 没找到含「" .. kw .. "」的按钮 | ContextButtonFrame 里现有: "
			.. (#acts > 0 and table.concat(acts, ", ") or "空/不存在"))
	end

	buttonCache[kw] = found
	return found
end

-- 触发一个按钮：firesignal -> 鼠标点击，逐个降级
local function fireButton(btn)
	if not btn then return false end

	local ok = pcall(firesignal, btn.Activated)
	if ok then return true end
	ok = pcall(firesignal, btn.MouseButton1Click)
	if ok then return true end
	ok = pcall(firesignal, btn.MouseButton1Down)
	if ok then return true end
	ok = pcall(firesignal, btn.TouchTap)
	if ok then return true end

	task.spawn(function()
		pcall(function()
			local x = btn.AbsolutePosition.X + btn.AbsoluteSize.X / 2
			local y = btn.AbsolutePosition.Y + btn.AbsoluteSize.Y / 2
			VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
			task.wait(0.05)
			VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
		end)
	end)
	return true
end

