local function passFilter(plr)
	-- 1. 强制只猎开了战斗模式(PvP)的玩家
	if _G.Hunt_NoPvp and not hasPvpOn(plr) then return false end

	-- 2. 排除安全区的人
	if _G.Hunt_NoSafe and isSafeBlocked(plr) then return false end

	-- 3. 排除在竞技场(Colosseum)里的人
	if _G.Hunt_NoArena and isArenaBlocked(plr) then return false end

	-- 4. 排除本服务器里已经被我们打死 N 次的人（再打收益很低）
	if _G.Hunt_NoKilledEnough then
		local c = killCounts[plr.Name]
		if c and c >= (_G.Hunt_KillHopCount or 3) then return false end
	end

	-- 5. 排除海军盟友（自己是海军时，不打其他海军）
	if _G.Hunt_NoMarineAlly then
		local myTeam = LocalPlayer.Team
		local tTeam = plr.Team
		if myTeam and tTeam and myTeam.Name == "Marines" and tTeam.Name == "Marines" then
			return false
		end
	end

	-- 6. 等级过滤
	if not _G.Hunt_UseLevel then return true end
	local lv = getLevel(plr)
	if not lv then return _G.Hunt_AllowUnknown end
	return lv >= _G.Hunt_MinLevel
end

local function getRoot(plr)
	local char = plr.Character
	if not char then return nil end
	return char:FindFirstChild("HumanoidRootPart"), char
end

-- 自己到目标的直线距离（有一方没角色就返回 nil）
local function targetDistance(plr)
	local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	local root = getRoot(plr)
	if not myRoot or not root then return nil end
	return (root.Position - myRoot.Position).Magnitude
end

-- 超过换人距离就不打，换下一个
local function tooFar(plr)
	local d = targetDistance(plr)
	if not d then return false end
	return d > (_G.Hunt_MaxDist or 10000)
end

-- ==================== 目标选择 ====================
-- 锁定的目标只要还活着、没超距就继续锁着，不因为「别人更近」或「过滤抖了一下」中途换人。
-- 只有临时性原因（超距 / 过滤被挡）才给 LOCK_GRACE 秒缓冲，避免把锁定断掉。
local LOCK_GRACE = 3
local lockGraceSince = nil

-- 目标还能不能继续打：返回 (是否可用, 原因)
-- 原因 gone=不在服务器 dead=死了 far=超距 filter=被过滤挡下
local function targetUsable(plr)
	if not plr or not plr.Parent then return false, "gone" end
	local char = plr.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return false, "dead" end
	if tooFar(plr) then return false, "far" end
	if not passFilter(plr) then return false, "filter" end
	return true
end

-- 临时原因：先保持锁定缓冲一下，超过 LOCK_GRACE 秒才真的放弃
local function keepLockGrace()
	if not lockGraceSince then lockGraceSince = tick() end
	return tick() - lockGraceSince < LOCK_GRACE
end

local function resolveTarget()
	-- 1. 手动指定的人优先；只要不是「人没了/死了」，中途被挡也先锁着
	if _G.Hunt_Target and _G.Hunt_Target ~= "" then
		local plr = Players:FindFirstChild(_G.Hunt_Target)
		if plr and plr ~= LocalPlayer then
			local ok, why = targetUsable(plr)
			if ok then
				lockGraceSince = nil
				return plr, 1
			end
			if why ~= "gone" and why ~= "dead" and keepLockGrace() then return plr, 1 end
			lockGraceSince = nil
		end
	end

	-- 2. 已经锁定的目标：还有效就继续锁着，不因为别人更近就中途换人
	--（关掉「自动选择玩家」时不再续锁，行为和以前一样立刻放开）
	if _G.Hunt_AutoSelect and currentTarget and currentTarget ~= LocalPlayer then
		local ok, why = targetUsable(currentTarget)
		if ok then
			lockGraceSince = nil
			return currentTarget, 1
		end
		if why ~= "gone" and why ~= "dead" and keepLockGrace() then return currentTarget, 1 end
		lockGraceSince = nil
		if why == "dead" or why == "gone" then
			print("[猎赏] 目标 " .. currentTarget.Name .. (why == "dead" and " 已死亡" or " 已离开")
				.. " -> 解除锁定，换下一个")
		end
	end

	-- 3. 自动选择：过滤后最近的玩家（超过换人距离的直接跳过）
	if not _G.Hunt_AutoSelect then return nil, 0 end
	local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil, 0 end

	local best, bestDist, count = nil, math.huge, 0
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and isAlive(plr) and passFilter(plr) then
			local root = getRoot(plr)
			if root then
				count = count + 1
				local d = (root.Position - myRoot.Position).Magnitude
				if d <= _G.Hunt_MaxDist and d < bestDist then
					bestDist = d
					best = plr
				end
			end
		end
	end
	return best, count
end

