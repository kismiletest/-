local KEY_CODES = {
	Z = Enum.KeyCode.Z,
	X = Enum.KeyCode.X,
	C = Enum.KeyCode.C,
	V = Enum.KeyCode.V,
	F = Enum.KeyCode.F,
}

-- 手持武器的 ToolTip -> 武器类型
local TIP_TO_TYPE = {
	["Blox Fruit"] = "果实",
	["Melee"] = "拳法",
	["Fighting"] = "拳法",
	["Sword"] = "剑",
	["Gun"] = "枪",
}

-- 当前手持武器的类型名（拿不出来就返回 nil）
local function heldTypeName()
	local char = LocalPlayer.Character
	local held = char and char:FindFirstChildOfClass("Tool")
	if not held then return nil end
	return TIP_TO_TYPE[held.ToolTip]
end

-- 该类型下勾选要放的技能键
local function keysForType(typeName)
	local list = {}
	if not typeName or not TYPE_SKILL_KEYS[typeName] then return list end
	for _, k in ipairs(TYPE_SKILL_KEYS[typeName]) do
		if _G.Hunt_TypeSkills[typeName][k] then table.insert(list, k) end
	end
	return list
end

-- 汇总显示用
local function enabledSkillText()
	local parts = {}
	for _, tn in ipairs(WEAPON_TYPE_NAMES) do
		local ks = keysForType(tn)
		if #ks > 0 then
			table.insert(parts, tn .. ":" .. table.concat(ks, ""))
		end
	end
	if #parts == 0 then return "无" end
	return table.concat(parts, " ")
end

local lastSkill = 0
local lastSkillLog = 0
pressSkills = function(force)
	if not _G.Hunt_AutoSkill then return end
	if _G.Hunt_Fleeing then return end -- 逃生期间不放技能
	if not force and tick() - lastSkill < _G.Hunt_SkillInterval then return end
	lastSkill = tick()

	-- 保险：放技能前确保手上有东西
	ensureEquipped()

	local char = LocalPlayer.Character
	local typeName = heldTypeName()
	local held = char and char:FindFirstChildOfClass("Tool")
	-- 只放「当前手里这把武器」的技能
	local keys = keysForType(typeName)

	-- 手上拿着东西但 ToolTip 没映射到（例如改版过的新武器）：退回按 Z/X，别完全不放技能
	if #keys == 0 and typeName == nil and held then
		keys = { "Z", "X" }
	end

	if tick() - lastSkillLog > 5 then
		lastSkillLog = tick()
		print("[猎赏] 释放技能: " .. (typeName or "未知类型") .. " -> " .. (#keys > 0 and table.concat(keys, "") or "无")
			.. " | 手持: " .. (held and (held.Name .. " [" .. tostring(held.ToolTip) .. "]") or "空手"))
	end

	if #keys == 0 then return end

	task.spawn(function()
		for _, k in ipairs(keys) do
			pcall(function()
				VirtualInputManager:SendKeyEvent(true, KEY_CODES[k], false, game)
				task.wait(0.03)
				VirtualInputManager:SendKeyEvent(false, KEY_CODES[k], false, game)
			end)
			task.wait(0.05)
		end

		-- 这一轮技能放完了 -> 轮到下一把武器，并立刻换过去
		if _G.Hunt_RotateWeapon then
			_G.Hunt_RotateIndex = _G.Hunt_RotateIndex + 1
			ensureEquipped()
		end
	end)
end

