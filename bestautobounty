		local noTarget = false
		if _G.Hunt_HopIfEmpty and _G.Hunt_Auto and selfAlive then
			noTarget = (resolveTarget() == nil)
		end

		if noTarget then
			if not emptySince then
				emptySince = tick()
				print("[猎赏] 服务器里没有可猎目标（没开战斗模式/全被过滤），开始计时 " .. _G.Hunt_EmptyWait .. " 秒")
			elseif tick() - emptySince >= _G.Hunt_EmptyWait then
				-- 到期了 = 准备跳服：先飞到天上等
				if _G.Hunt_HopSkyUp and not (_G.Hunt_HopSkyTimer or _G.Hunt_HopSkyEmpty) then
					_G.Hunt_HopSkyEmpty = true
					skyBaseY = nil -- 让飞行循环重新记起始高度
					print("[猎赏] 准备跳服 -> 飞到天上 " .. _G.Hunt_HopSkyHeight .. " 米等待")
				end
				if canHopNow(false, emptyCombatSince) then
					if combatWaitExpired(emptyCombatSince) then
						print("[猎赏] 空服判定到期，已等战斗结束 " .. (_G.Hunt_HopCombatWait or 60) .. " 秒仍未结束 -> 直接跳服")
					end
					emptyWaitCombat = false
					emptyCombatSince = nil
					emptySince = nil
					print("[猎赏] 持续 " .. _G.Hunt_EmptyWait .. " 秒没有可猎目标 -> 切换服务器")
					local hopOk = serverHop()
					-- 不管成功失败都先解除飞天等待：跳成了马上换服；没跳成要下来继续猎，别一直挂天上
					if _G.Hunt_HopSkyEmpty then
						_G.Hunt_HopSkyEmpty = false
						if not hopOk then print("[猎赏] 这轮没跳成功 -> 从天上下来继续猎赏，稍后重试") end
					end
					task.wait(30) -- 等传送完成，避免重复触发
				elseif not emptyWaitCombat then
					-- 判定到期但还在打（或刚交手 30 秒内）：等这场架打完再跳，别提前跳走丢赏金
					emptyWaitCombat = true
					emptyCombatSince = tick()
					print("[猎赏] 空服判定到期，但战斗还没结束 -> 打完再跳，最多等 "
						.. (_G.Hunt_HopCombatWait or 60) .. " 秒")
				end
			end
		else
			if emptySince then
				print("[猎赏] 已经有可猎目标，取消跳服")
			end
			emptySince = nil
			emptyWaitCombat = false
			emptyCombatSince = nil
			-- 不跳服了就取消飞天等待，下去继续猎
			if _G.Hunt_HopSkyEmpty then
				_G.Hunt_HopSkyEmpty = false
				print("[猎赏] 取消跳服 -> 从天上下来继续猎赏")
			end
		end
	end
end)

