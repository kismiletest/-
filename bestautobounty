-- 这两个「全程开启」：每次加载强制打开，且不写入存档，不受任何开关联动
_G.G_RemoveLava = true
_G.G_WalkOnWater = true

local function CheckAndDestroyLava(v)
	if not v then return end
	local name = v.Name
	if name == "Lava" then
		pcall(function() v:Destroy() end)
	elseif name == "LavaParts" then
		local parent = v.Parent
		if parent then
			local pName = parent.Name
			if pName == "CircleIsland" or pName == "GhostShipInterior" then
				local grandParent = parent.Parent
				if grandParent and grandParent.Name == "Map" then
					pcall(function() v:Destroy() end)
				end
			end
		end
	end
end

-- 一次性扫描，把岩浆清掉（客户端本地，需重进恢复）
-- 放到 task.spawn 里分片执行，避免开局卡住主线程导致界面出不来
local function StartRemoveLava()
	task.spawn(function()
		pcall(function()
			local count = 0
			for _, v in pairs(Workspace:GetDescendants()) do
				CheckAndDestroyLava(v)
				count = count + 1
				if count % 500 == 0 then task.wait() end
			end
			for _, v in pairs(ReplicatedStorage:GetDescendants()) do
				CheckAndDestroyLava(v)
				count = count + 1
				if count % 500 == 0 then task.wait() end
			end
		end)
		print("[猎赏] 已移除岩浆 (需重进恢复)")
	end)
end

-- 水上行走：把海平面拉高，人就能在水上跑
local walkOnWaterRunning = false
local function StartWalkOnWater()
	if walkOnWaterRunning then return end
	walkOnWaterRunning = true
	task.spawn(function()
		while task.wait(0.2) do
			if not _G.G_WalkOnWater then break end
			pcall(function()
				local waterBase = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("WaterBase-Plane")
				if waterBase then
					waterBase.Size = Vector3.new(1000, 112, 1000)
				end
			end)
		end
		walkOnWaterRunning = false
	end)
end

local function StopWalkOnWater()
	_G.G_WalkOnWater = false
