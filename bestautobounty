	lastDiag = tick()

	local total, alive, noRoot, pvpBlocked, safeBlocked, marineBlocked, levelBlocked, farBlocked = 0, 0, 0, 0, 0, 0, 0, 0
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			total = total + 1
			if isAlive(plr) then
				alive = alive + 1
				if not getRoot(plr) then
					noRoot = noRoot + 1
				elseif _G.Hunt_NoPvp and not hasPvpOn(plr) then
					pvpBlocked = pvpBlocked + 1
				elseif _G.Hunt_NoSafe and isSafeBlocked(plr) then
					safeBlocked = safeBlocked + 1
				elseif _G.Hunt_NoMarineAlly and LocalPlayer.Team and plr.Team
					and LocalPlayer.Team.Name == "Marines" and plr.Team.Name == "Marines" then
					marineBlocked = marineBlocked + 1
				elseif _G.Hunt_UseLevel then
					local lv = getLevel(plr)
