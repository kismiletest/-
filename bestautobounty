local function getLevel(plr)
	local v
	local ok = pcall(function() v = plr:GetAttribute("Level") end)
	if ok and v then return tonumber(v) end
	ok = pcall(function() v = plr.Data.Level.Value end)
	if ok and v then return tonumber(v) end
	ok = pcall(function() v = plr.leaderstats["Level"].Value end)
	if ok and v then return tonumber(v) end
	return nil
end

local function getBounty(plr)
	local v
	local ok = pcall(function() v = plr.leaderstats["Bounty/Honor"].Value end)
	if ok and v then return tonumber(v) end
	return 0
end

local function isAlive(plr)
	local char = plr.Character
	if not char then return false end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return false end
	return true
end

