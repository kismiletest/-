-- ==================== 安全区检测 ====================
-- 优先读游戏属性；属性读不到时，靠「攻击目标被提示无法在安全区攻击」来临时拉黑
local safeBlacklist = {}

local function attrSafeZone(plr)
	local char = plr.Character
	local objs = { plr, char }
	if char then table.insert(objs, char:FindFirstChild("HumanoidRootPart")) end
	for _, obj in ipairs(objs) do
		if obj then
			local v = obj:GetAttribute("SafeZone")
			if v == nil then v = obj:GetAttribute("InSafeZone") end
			if v ~= nil then return v == true end
		end
	end
	return nil
end

local function isSafeBlocked(plr)
	if attrSafeZone(plr) == true then return true end
	local exp = safeBlacklist[plr.Name]
	if exp then
		if tick() < exp then return true end
		safeBlacklist[plr.Name] = nil
	end
	return false
end

-- ==================== 排除在竞技场(Colosseum)里的人 ====================
-- 竞技场里多为友好 PvP，打了不给赏金、追过去纯属浪费时间。
-- 不同版本能读到的字段不一样，这里用三个来源兜底，任一判定「在竞技场内」就排除。
local arenaBlacklist = {} -- 名字 -> 到期时间（游戏提示打不到时自动拉黑）
local ARENA_KEYWORDS = { "arena", "colosseum" }

local function nameLooksArena(s)
	if type(s) ~= "string" or s == "" then return false end
	s = string.lower(s)
	for _, kw in ipairs(ARENA_KEYWORDS) do
		if string.find(s, kw, 1, true) then return true end
	end
	return false
end

-- 来源1：属性。玩家 / 角色 / HumanoidRootPart 上找 Arena、InArena、Zone="Colosseum" 这类属性
local function attrArena(plr)
	local char = plr.Character
	local objs = { plr, char, char and char:FindFirstChild("HumanoidRootPart") }
	for _, obj in ipairs(objs) do
		if obj then
			local ok, attrs = pcall(function() return obj:GetAttributes() end)
			if ok and type(attrs) == "table" then
				for name, v in pairs(attrs) do
					if nameLooksArena(name) then
						if v == true then return true end
					elseif type(v) == "string" and nameLooksArena(v) then
						return true
					end
				end
			end
		end
	end
	return nil
end

-- 来源2：位置。目标周围的地图部件（竞技场建筑）名字里带 arena/colosseum
local ARENA_PART_RADIUS = 80
local ARENA_PART_CACHE = 3 -- 秒，避免每秒对每个候选都做一次空间查询
local arenaPartCache = {}  -- 名字 -> { v = 结果, t = 到期时间 }

local function partArena(plr)
	local char = plr.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return nil end

	local cached = arenaPartCache[plr.Name]
	if cached and tick() < cached.t then return cached.v end

	local found = nil
	local ok, parts = pcall(function()
		return Workspace:GetPartBoundsInRadius(root.Position, ARENA_PART_RADIUS)
	end)
	if ok and parts then
		for _, part in ipairs(parts) do
			local node = part
			for _ = 1, 4 do -- 顺着父级往上找几层，模型名也可能带竞技场字样
				if not node then break end
				if nameLooksArena(node.Name) then
					found = true
					break
				end
				node = node.Parent
			end
			if found then break end
		end
	end
	arenaPartCache[plr.Name] = { v = found, t = tick() + ARENA_PART_CACHE }
	return found
end

local function isArenaBlocked(plr)
	if attrArena(plr) == true then return true end
	local exp = arenaBlacklist[plr.Name]
	if exp then
		if tick() < exp then return true end
		arenaBlacklist[plr.Name] = nil
	end
	return partArena(plr) == true
end

