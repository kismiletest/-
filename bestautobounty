_G.G_HopMaxBounty = _G.G_HopMaxBounty or 999999999

local function FormatNumber(n)
	local s = tostring(math.floor(tonumber(n) or 0))
	local left, num, right = s:match("^([^%d]*%d)(%d*)(.-)$")
	return left .. (num:reverse():gsub("(%d%d%d)", "%1,"):reverse()) .. right
end

local function ApplyPlayerRange(label)
	_G.G_HopPlayerRange = label
	local minPlayers, maxPlayers = label:match("(%d+)%-(%d+)")
	if minPlayers and maxPlayers then
		_G.G_HopMinPlayers = tonumber(minPlayers)
		_G.G_HopMaxPlayers = tonumber(maxPlayers)
		return
	end
	_G.G_HopMinPlayers = 1
	_G.G_HopMaxPlayers = 12
end

local function ApplyBountyRange(label)
	_G.G_HopBountyRange = label
	local minOnly = label:match("大于([%d%.]+[Mm]?)")
	if minOnly then
		local num, unit = minOnly:match("([%d%.]+)([Mm]?)")
		local value = tonumber(num) or 0
		if unit and unit:lower() == "m" then value = value * 1000000 end
		_G.G_HopMinBounty = value + 1
		_G.G_HopMaxBounty = 999999999
		return
	end
	_G.G_HopMinBounty = 0
	_G.G_HopMaxBounty = 999999999
end

-- 服务器条目文本 -> 信息表（格式: Region: xxx - Players: 3/12 Bounty: 1,234,567）
local function ParseServerInfo(text)
	if type(text) ~= "string" or text == "" then return nil end
	local region = text:match("Region:%s*(.-)%s*%-%s*Players:")
	local cur, max = text:match("Players:%s*(%d+)%s*/%s*(%d+)")
	local bt = text:match("Bounty:%s*([%d,]+)")
	if not cur or not max or not bt then return nil end
	local bounty = tonumber((bt:gsub(",", "")))
	if not bounty then return nil end
	return { Region = region or "Unknown", Players = tonumber(cur), MaxPlayers = tonumber(max), Bounty = bounty }
end

local function IsServerAllowed(info)
	if not info then return false end
	-- 满人的服务器不加：进去要么进不去、要么被弹回大厅，白等一轮
	if info.MaxPlayers and info.Players >= info.MaxPlayers then return false end
	if info.Players < _G.G_HopMinPlayers or info.Players > _G.G_HopMaxPlayers then return false end
	if info.Bounty < _G.G_HopMinBounty or info.Bounty > _G.G_HopMaxBounty then return false end
	return true
end

ApplyPlayerRange(_G.G_HopPlayerRange)
ApplyBountyRange(_G.G_HopBountyRange)

-- ==================== 换服后自动重跑脚本 (queue_on_teleport) ====================
-- 跳服前把「传送完成后重新加载本脚本」排进执行器的传送队列，换服后执行器会自动执行一遍，
-- 这样换服后不需要手动重新注入脚本。开关状态存在 AutoBounty.file 里（内容 "true"/"false"）。
-- 注意：队列里加载的是下面这些地址上的脚本，所以本地改完必须同步更新到这些地址，
--       否则换服后跑起来的还是旧版。
local SCRIPT_URLS = {
	"https://raw.githubusercontent.com/kismiletest/-/refs/heads/main/bestautobounty",
	"https://cdn.jsdelivr.net/gh/kismiletest/-@main/bestautobounty",
}
local AUTOEXEC_FILE = "AutoBounty.file"

local queue_on_teleport = queue_on_teleport
	or queueonteleport
	or (syn and syn.queue_on_teleport)
	or (fluxus and fluxus.queue_on_teleport)

if isfile and isfile(AUTOEXEC_FILE) then
	local success, content = pcall(function() return readfile(AUTOEXEC_FILE) end)
	_G.AutoExecute = (success and content == "true")
else
	_G.AutoExecute = true
	-- 首次运行要把它落盘：排队里的那句判断读的就是这个文件，没文件的话换了服不会重跑
	if writefile then pcall(function() writefile(AUTOEXEC_FILE, "true") end) end
end

-- 把地址表写成 Lua 字面量，塞进排队脚本里（多地址兜底：raw 抓不到就换 jsDelivr）
local function luaStringList(t)
	local parts = {}
	for _, u in ipairs(t) do parts[#parts + 1] = '"' .. u .. '"' end
	return "{" .. table.concat(parts, ", ") .. "}"
end

-- 传送后执行的内容：抓取脚本 -> 纠正脚本名 -> 重新加载
-- 抓不到就 warn 出来，方便排查（否则会静默没反应）
local ScriptLoadstring = [[local NAME = "]] .. SCRIPT_NAME .. [["
local ok, err = pcall(function()
	if isfile and isfile("AutoBounty.file") and readfile("AutoBounty.file") ~= "true" then
		warn("[猎赏] 换服后自动重跑是关的（AutoBounty.file 不是 true）")
		return
	end
	local urls = ]] .. luaStringList(SCRIPT_URLS) .. [[
	local lastErr
	for _, u in ipairs(urls) do
		local got, src = pcall(function() return game:HttpGet(u) end)
		if got and src and src ~= "" then
			-- 线上那份可能是旧名字：把脚本名/面板标题强行改成 NAME，保证换服后名字不变
			src = src:gsub("local SCRIPT_NAME%s*=%s*\"[^\"]*\"", "local SCRIPT_NAME = \"" .. NAME .. "\"")
			src = src:gsub("(CreateWindow%s*%(%s*{%s*Title%s*=%s*)\"[^\"]*\"", "%1\"" .. NAME .. "\"")
			src = src:gsub("自动猎赏 已加载", NAME .. " 已加载")
			print("[猎赏] 传送完成，正在重新加载脚本: " .. u)
			loadstring(src)()
			return
		end
		lastErr = src
	end
	error("所有地址都加载失败，最后一个错误: " .. tostring(lastErr))
end)
if not ok then
	warn("[猎赏] 传送后自动重跑失败: " .. tostring(err) .. "（检查脚本地址是否可访问、是否已更新）")
end]]

-- 跳服前调用：把「传送后自动重跑脚本」排进队列
-- 注意：有的执行器是「累加」而不是「替换」，同一个会话里排队多次，传送后就会把脚本跑好几次
--（表现为同时出现 2 个面板 / 两套循环），所以这里保证一次会话只排一次
local autoReloadQueued = false
local function queueAutoReload()
	if autoReloadQueued then return end -- 已经排过了：不重复排，避免传送后执行多次
	if _G.AutoExecute ~= true then
		print("[猎赏] 换服后自动重跑: 关（AutoBounty.file 内容不是 true）")
		return
	end
	if type(queue_on_teleport) ~= "function" then
		warn("[猎赏] 当前执行器不支持 queue_on_teleport -> 换服后需手动重新注入（或把脚本放进执行器 autoexec 文件夹）")
		return
	end
	local ok, err = pcall(queue_on_teleport, ScriptLoadstring)
	if ok then
		autoReloadQueued = true
		print("[猎赏] 已排队 -> 传送完成后自动重新加载脚本（本次会话只排一次，不会跑两遍）")
	else
		warn("[猎赏] 排队自动重跑失败: " .. tostring(err))
	end
end

-- 重进当前服务器（WindUI「重进服务器」按钮同款）
local function rejoinServer()
	queueAutoReload()
	local args = {
		"teleport",
		game.JobId
	}
	local ok = pcall(function()
		ReplicatedStorage:WaitForChild("__ServerBrowser"):InvokeServer(unpack(args))
	end)
	print(ok and "[猎赏] 已请求重进当前服务器" or "[猎赏] 重进失败")
	return ok
end

