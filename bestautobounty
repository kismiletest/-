local hasFileAPI = (writefile ~= nil and readfile ~= nil and isfile ~= nil)

local function configToTable()
	local t = {}
	for _, k in ipairs(CONFIG_KEYS) do t[k] = _G[k] end
	t.Hunt_TypeSkills = {}
	for _, tn in ipairs(WEAPON_TYPE_NAMES) do
		t.Hunt_TypeSkills[tn] = {}
		for _, k in ipairs(TYPE_SKILL_KEYS[tn]) do
			t.Hunt_TypeSkills[tn][k] = _G.Hunt_TypeSkills[tn][k] ~= false
		end
	end
	t.Hunt_Weapons = {}
	for _, n in ipairs(WEAPON_TYPE_NAMES) do
		t.Hunt_Weapons[n] = _G.Hunt_Weapons[n] == true
	end
	return t
end

-- 序列化成字符串用于比对，键顺序固定，避免误判「有变化」
local function serializeConfig()
	local parts = {}
	for _, k in ipairs(CONFIG_KEYS) do
		table.insert(parts, k .. "=" .. tostring(_G[k]))
	end
	for _, tn in ipairs(WEAPON_TYPE_NAMES) do
		for _, k in ipairs(TYPE_SKILL_KEYS[tn]) do
			table.insert(parts, "Sk" .. tn .. k .. "=" .. tostring(_G.Hunt_TypeSkills[tn][k]))
		end
	end
	for _, n in ipairs(WEAPON_TYPE_NAMES) do
		table.insert(parts, "Weapon" .. n .. "=" .. tostring(_G.Hunt_Weapons[n]))
	end
	return table.concat(parts, "|")
end

local function saveConfig()
	if not hasFileAPI then return false end
	local ok = pcall(function()
		writefile(CONFIG_FILE, HttpService:JSONEncode(configToTable()))
	end)
	return ok
end

local function loadConfig()
	if not hasFileAPI then return false end
	local raw
	local ok = pcall(function()
		if isfile(CONFIG_FILE) then raw = readfile(CONFIG_FILE) end
	end)
	if not ok or not raw or raw == "" then return false end

	local data
	ok = pcall(function() data = HttpService:JSONDecode(raw) end)
	if not ok or type(data) ~= "table" then return false end

	for _, k in ipairs(CONFIG_KEYS) do
		if data[k] ~= nil then _G[k] = data[k] end
	end
	if type(data.Hunt_TypeSkills) == "table" then
		for _, tn in ipairs(WEAPON_TYPE_NAMES) do
			local saved = data.Hunt_TypeSkills[tn]
			if type(saved) == "table" then
				for _, k in ipairs(TYPE_SKILL_KEYS[tn]) do
					_G.Hunt_TypeSkills[tn][k] = saved[k] ~= false
				end
			end
		end
	end
	if type(data.Hunt_Weapons) == "table" then
		for _, n in ipairs(WEAPON_TYPE_NAMES) do
			_G.Hunt_Weapons[n] = data.Hunt_Weapons[n] == true
		end
	end
	return true
end

