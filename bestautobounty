				-- 过滤都过了，再看是不是太远
				if passFilter(plr) and tooFar(plr) then
					farBlocked = farBlocked + 1
				end
			end
		end
	end
	print(string.format("[猎赏] 排查 -> 其他玩家:%d 存活:%d | 无角色:%d PvP挡:%d 安全区挡:%d 海军挡:%d 等级挡:%d 超距挡:%d",
		total, alive, noRoot, pvpBlocked, safeBlocked, marineBlocked, levelBlocked, farBlocked))
end

