-- ==================== 飞行 + 低血逃生 + 贴身瞬步 ====================
local fleeing = false
local fleeBaseY = 0
local fleeStart = 0

RunService.Heartbeat:Connect(function(dt)
	local char = LocalPlayer.Character
	local myRoot = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not myRoot or not hum then return end

	-- 无碰撞，避免卡建筑/卡在目标身上
	for _, v in ipairs(char:GetDescendants()) do
		if v:IsA("BasePart") and v.CanCollide then v.CanCollide = false end
	end

	-- ===== 低血逃生：直线上飞，满血自动恢复狩猎 =====
	if _G.Hunt_AutoFlee and hum.Health > 0 then
		local hpPct = (hum.Health / hum.MaxHealth) * 100

		if not fleeing and hpPct <= _G.Hunt_FleeHP then
			fleeing = true
			_G.Hunt_Fleeing = true -- 广播给其他循环（瞬步/技能会暂停）
			fleeBaseY = myRoot.Position.Y
			fleeStart = tick()
			print("[猎赏] 血量 " .. math.floor(hpPct) .. "% -> 向上逃生 " .. _G.Hunt_FleeHeight .. " 米，暂停猎赏")
		elseif fleeing then
			local elapsed = tick() - fleeStart
			local recovered = hpPct >= _G.Hunt_FleeRecover
			-- 兜底1：飞够时间且血量高于触发线 -> 恢复猎赏
			local timeout = (elapsed >= _G.Hunt_FleeMaxTime) and hpPct > _G.Hunt_FleeHP
			-- 兜底2：再久也强制恢复（血量一直不涨时会永远挂在天上站着不动）
			local hardStop = elapsed >= _G.Hunt_FleeMaxTime * 3
			if recovered or timeout or hardStop then
				fleeing = false
				_G.Hunt_Fleeing = false
				print("[猎赏] 血量 " .. math.floor(hpPct) .. "% -> " .. (recovered and "已恢复，结束逃生，自动恢复猎赏"
					or (timeout and "逃生超时，恢复猎赏" or "逃生过久强制恢复猎赏（血量一直没涨）")))
			end
		end

		if fleeing then
			-- 从触发点往上飞 Hunt_FleeHeight 米，到顶就悬停
			local ceiling = fleeBaseY + _G.Hunt_FleeHeight
			if myRoot.Position.Y < ceiling then
				local rot = myRoot.CFrame - myRoot.Position
				local step = math.min(_G.Hunt_FlySpeed * dt, ceiling - myRoot.Position.Y)
				myRoot.CFrame = CFrame.new(myRoot.Position + Vector3.new(0, step, 0)) * rot
				myRoot.Velocity = Vector3.new(0, 0, 0)
				myRoot.RotVelocity = Vector3.new(0, 0, 0)
			end
			return -- 逃生期间不打、不放技能
		end
	else
		if fleeing then
			fleeing = false
			_G.Hunt_Fleeing = false
		end
	end

	-- ===== 正常狩猎 =====
	if not _G.Hunt_Auto or not currentTarget then return end

	local tRoot = getRoot(currentTarget)
	if not tRoot then return end

	local targetPos = tRoot.Position + Vector3.new(0, _G.Hunt_StopDist, 0)
	local dist = (targetPos - myRoot.Position).Magnitude

	if dist > 1 then
		local moveDist = math.min(_G.Hunt_FlySpeed * dt, dist)
		local dir = (targetPos - myRoot.Position).Unit
		local rot = myRoot.CFrame - myRoot.Position -- 保留当前朝向
		myRoot.CFrame = CFrame.new(myRoot.Position + dir * moveDist) * rot
		myRoot.Velocity = Vector3.new(0, 0, 0)
		myRoot.RotVelocity = Vector3.new(0, 0, 0)
	end

	-- 放技能/攻击的范围放宽一点：原来只在贴身 6 米内才放，追人途中经常一直不放技能
	if dist <= _G.Hunt_StopDist + 20 then
		pressSkills()
		attackTarget(currentTarget)
	end

	-- 贴到身边了才瞬步
	if dist <= _G.Hunt_StopDist + 6 then
		triggerSoru()
	end
end)

-- ==================== 自动跳服务器 (1:1 移植自 WindUI 的服务器浏览器扫描) ====================
-- 真正的扫描逻辑：任何一步报错都由外层 serverHop 兜住，不会把 IsServerHopping 卡死
local function doServerHop()
	if getgenv().IsServerHopping == true then return false end
	getgenv().IsServerHopping = true

	local PlayerGui = LocalPlayer.PlayerGui
	if not PlayerGui:FindFirstChild("ServerBrowser") then
		getgenv().IsServerHopping = false
		print("[猎赏] 没找到 ServerBrowser 界面，无法跳服")
		return false
	end

	PlayerGui.ServerBrowser.Enabled = true
	task.wait(0.1)

	local Filters = PlayerGui.ServerBrowser.Frame:FindFirstChild("Filters")
	local SearchRegion = Filters and Filters:FindFirstChild("SearchRegion")
	local TextBox = SearchRegion and SearchRegion:FindFirstChild("TextBox")

	if not TextBox then
		getgenv().IsServerHopping = false
		print("[猎赏] ServerBrowser 里找不到区域输入框")
		return false
	end

	TextBox.Text = _G.G_ServerRegion

	-- 展开完整列表
	local Full = Filters and Filters:FindFirstChild("Full")
	local FullCheck = Full and Full:FindFirstChild("Check")
	if FullCheck then
		FullCheck.Text = "\226\156\148\239\184\143"
		task.wait(0.1)
	end

	local ScrollingFrame = PlayerGui.ServerBrowser.Frame.ScrollingFrame
	local FakeScroll = PlayerGui.ServerBrowser.Frame.FakeScroll
	local Inside = FakeScroll.Inside

	-- 滚动列表，让所有服务器条目加载出来
	task.spawn(function()
		while getgenv().IsServerHopping do
			ScrollingFrame.CanvasPosition = Vector2.new(0, math.random(100, 7000))
			task.wait(0.3)
		end
	end)

	task.wait()

	local currentJobId = game.JobId
	local ServerBrowserRemote = ReplicatedStorage:WaitForChild("__ServerBrowser")

	print("[猎赏] 扫描服务器 | 区域: " .. _G.G_ServerRegion
		.. " | 人数: " .. _G.G_HopPlayerRange .. " | 赏金: " .. _G.G_HopBountyRange)

	while getgenv().IsServerHopping do
		for _, template in ipairs(Inside:GetChildren()) do
			if template.Name == "Template" then
				local joinButton = template:FindFirstChild("Join")
				local textLabel = template:FindFirstChild("TextLabel")
				local info = textLabel and ParseServerInfo(textLabel.Text)

				if joinButton and info and IsServerAllowed(info) then
					local job = joinButton:GetAttribute("Job")
					if job and tostring(job):find("-", 1, true) then
						job = tostring(job)

						if job ~= currentJobId then
							print("[猎赏] 匹配到服务器 -> 地区: " .. tostring(info.Region)
								.. " | 人数: " .. info.Players .. "/" .. info.MaxPlayers
								.. " | 赏金: " .. FormatNumber(info.Bounty))

							local success = pcall(function()
								ServerBrowserRemote:InvokeServer("teleport", job)
							end)
							if not success then
								local success2 = pcall(function()
									ServerBrowserRemote:InvokeServer("teleport", job)
								end)
								if not success2 then
									print("[猎赏] 跳服失败，请重新加入游戏")
								end
							end

							task.wait(0.3)
							getgenv().IsServerHopping = false
							return true
						end
					end
				end
			end
		end
		task.wait(3)
	end

	getgenv().IsServerHopping = false
	return false
end

-- 外层包装：用 pcall 包住扫描，异常也不会把跳服功能卡死（换服后由执行器的自动执行重跑脚本）
local function serverHop()
	local ok, result = pcall(doServerHop)
	getgenv().IsServerHopping = false -- 无论成功还是报错都清掉，否则以后都跳不了服
	if not ok then
		print("[猎赏] 跳服异常: " .. tostring(result))
		return false
	end
	return result == true
end

-- 是否正在战斗中：正在逃生 / 锁定了够近的目标 / 5 秒内攻击过
local function inCombat()
	if _G.Hunt_Fleeing then return true end
	if currentTarget and isAlive(currentTarget) then
		local d = targetDistance(currentTarget)
		if d and d <= (_G.Hunt_MaxDist or 10000) then return true end
	end
	if tick() - lastAttack < 5 then return true end
	return false
end

