-- ==================== 飞行 + 低血逃生 + 贴身瞬步 ====================
local fleeing = false
local fleeBaseY = 0
local fleeStart = 0
local skyBaseY = nil -- 「准备跳服 -> 飞天等待」时的起始高度

local lastHbErr = 0
local function huntTick(dt)
	local char = LocalPlayer.Character
	local myRoot = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not myRoot or not hum then return end

	-- 无碰撞，避免卡建筑/卡在目标身上
	for _, v in ipairs(char:GetDescendants()) do
		if v:IsA("BasePart") and v.CanCollide then v.CanCollide = false end
	end

	-- ===== 低血逃生：直线上飞，满血自动恢复狩猎 =====
	if _G.Hunt_AutoFlee and hum.Health > 0 then
		local hpPct = (hum.Health / hum.MaxHealth) * 100

		if not fleeing and hpPct <= _G.Hunt_FleeHP then
			fleeing = true
			_G.Hunt_Fleeing = true -- 广播给其他循环（瞬步/技能会暂停）
			fleeBaseY = myRoot.Position.Y
			fleeStart = tick()
			print("[猎赏] 血量 " .. math.floor(hpPct) .. "% -> 向上逃生 " .. _G.Hunt_FleeHeight .. " 米，暂停猎赏")
		elseif fleeing then
			local elapsed = tick() - fleeStart
			local recovered = hpPct >= _G.Hunt_FleeRecover
			-- 兜底1：飞够时间且血量高于触发线 -> 恢复猎赏
			local timeout = (elapsed >= _G.Hunt_FleeMaxTime) and hpPct > _G.Hunt_FleeHP
			-- 兜底2：再久也强制恢复（血量一直不涨时会永远挂在天上站着不动）
			local hardStop = elapsed >= _G.Hunt_FleeMaxTime * 3
			if recovered or timeout or hardStop then
				fleeing = false
				_G.Hunt_Fleeing = false
				print("[猎赏] 血量 " .. math.floor(hpPct) .. "% -> " .. (recovered and "已恢复，结束逃生，自动恢复猎赏"
					or (timeout and "逃生超时，恢复猎赏" or "逃生过久强制恢复猎赏（血量一直没涨）")))
			end
		end

		if fleeing then
			-- 从触发点往上飞 Hunt_FleeHeight 米，到顶就悬停
			local ceiling = fleeBaseY + _G.Hunt_FleeHeight
			if myRoot.Position.Y < ceiling then
				local rot = myRoot.CFrame - myRoot.Position
				local step = math.min(_G.Hunt_FlySpeed * dt, ceiling - myRoot.Position.Y)
				myRoot.CFrame = CFrame.new(myRoot.Position + Vector3.new(0, step, 0)) * rot
				myRoot.Velocity = Vector3.new(0, 0, 0)
				myRoot.RotVelocity = Vector3.new(0, 0, 0)
			end
			return -- 逃生期间不打、不放技能
		end
	else
		if fleeing then
			fleeing = false
			_G.Hunt_Fleeing = false
		end
	end

	-- ===== 准备跳服：先飞到天上等（躲开战斗，等这场架打完再跳） =====
	if not _G.Hunt_HopSkyUp then
		-- 功能被关掉了：立刻停止飞天等待
		_G.Hunt_HopSkyTimer = false
		_G.Hunt_HopSkyEmpty = false
	end
	local skyWaiting = _G.Hunt_HopSkyTimer or _G.Hunt_HopSkyEmpty
	if skyWaiting and not fleeing and hum.Health > 0 then
		if not skyBaseY then skyBaseY = myRoot.Position.Y end -- 记下起始高度，之后按它算上限
		local ceiling = skyBaseY + _G.Hunt_HopSkyHeight
		if myRoot.Position.Y < ceiling then
			local rot = myRoot.CFrame - myRoot.Position
			local step = math.min(_G.Hunt_FlySpeed * dt, ceiling - myRoot.Position.Y)
			myRoot.CFrame = CFrame.new(myRoot.Position + Vector3.new(0, step, 0)) * rot
			myRoot.Velocity = Vector3.new(0, 0, 0)
			myRoot.RotVelocity = Vector3.new(0, 0, 0)
		end
		return -- 在天上等待跳服期间：不放技能、不攻击（躲着等这场架打完再跳）
	end
	if not skyWaiting then skyBaseY = nil end

	-- ===== 正常狩猎 =====
	if not _G.Hunt_Auto or not currentTarget then return end

	local tRoot = getRoot(currentTarget)
	if not tRoot then return end

	local targetPos = tRoot.Position + Vector3.new(0, _G.Hunt_StopDist, 0)
	local dist = (targetPos - myRoot.Position).Magnitude

	if dist > 1 then
		local moveDist = math.min(_G.Hunt_FlySpeed * dt, dist)
		local dir = (targetPos - myRoot.Position).Unit
		local rot = myRoot.CFrame - myRoot.Position -- 保留当前朝向
		myRoot.CFrame = CFrame.new(myRoot.Position + dir * moveDist) * rot
		myRoot.Velocity = Vector3.new(0, 0, 0)
		myRoot.RotVelocity = Vector3.new(0, 0, 0)
	end

	-- 放技能/攻击的范围放宽一点：原来只在贴身 6 米内才放，追人途中经常一直不放技能
	if dist <= _G.Hunt_StopDist + 20 then
		pressSkills()
		attackTarget(currentTarget)
	end

	-- 贴到身边了才瞬步
	if dist <= _G.Hunt_StopDist + 6 then
		triggerSoru()
	end
end

-- 用 pcall 包住整帧逻辑：某一帧出错也不会把飞行/攻击/技能整条链停掉（出错限频打印，方便排查）
