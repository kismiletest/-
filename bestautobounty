local lastSoru = 0
triggerSoru = function()
	if tick() - lastSoru < 0.5 then return end
	lastSoru = tick()

	-- 瞬步自瞄：把角色水平朝向锁定目标，瞬步才会朝他冲过去
	if _G.Hunt_SoruAim and currentTarget then
		local tRoot = getRoot(currentTarget)
		local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		if tRoot and myRoot then
			local flat = Vector3.new(tRoot.Position.X, myRoot.Position.Y, tRoot.Position.Z)
			if (flat - myRoot.Position).Magnitude > 1 then
				myRoot.CFrame = CFrame.new(myRoot.Position, flat)
			end
		end
	end

	-- 通道1: CommE 发包（BF 瞬步真正的入口，参数: 名称/起点/终点/服务器时间/随机id）
	local char = LocalPlayer.Character
	local myRoot = char and char:FindFirstChild("HumanoidRootPart")
	if myRoot then
		local dest
		local tRoot = currentTarget and getRoot(currentTarget)
		if tRoot then
			dest = (tRoot.CFrame * CFrame.new(0, 0, 3)).Position -- 冲到目标身前 3 格
		else
			dest = myRoot.Position + myRoot.CFrame.LookVector * 40 -- 没目标就往前冲一段
		end

		local startCFrame = myRoot.CFrame
		local finalCFrame = (startCFrame - startCFrame.Position) + dest + Vector3.new(0, myRoot.Size.Y * 1.5, 0)

		pcall(function()
			local remotes = ReplicatedStorage:FindFirstChild("Remotes")
			local commE = remotes and remotes:FindFirstChild("CommE")
			if commE then
				commE:FireServer("Soru", startCFrame, finalCFrame, workspace:GetServerTimeNow(), math.random(1, 999999999))
			end
		end)
	end

	-- 通道2: 兜底触发游戏内瞬步按钮（移动端/PC 的 BoundActionSoru）
	fireButton(findSoruButton())
end

