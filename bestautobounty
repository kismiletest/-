-- ---- 通道1: ReplicatedStorage.Mouse 模块 ----
local mouseModuleHooked = false
local MouseModuleInstance = ReplicatedStorage:FindFirstChild("Mouse")
local MouseModule = nil
if MouseModuleInstance then
	pcall(function() MouseModule = require(MouseModuleInstance) end)
end

if MouseModule and typeof(MouseModule) == "table" then
	pcall(function()
		local realStore = { Hit = rawget(MouseModule, "Hit"), Target = rawget(MouseModule, "Target") }
		local mmt = getrawmetatable(MouseModule)
		if mmt then setreadonly(mmt, false) else mmt = {}; setmetatable(MouseModule, mmt) end

		local origIndex = mmt.__index

		-- 先装好 __index，再清掉原字段：万一中途出错，模块也不会被搞坏
		mmt.__index = function(self, key)
			local part = getAimPart()
			if part then
				if key == "Hit" then return CFrame.new(part.Position) end
				if key == "Target" then return part end
			end
			-- 其余 key 交还原版逻辑
			if type(origIndex) == "function" then return origIndex(self, key) end
			if type(origIndex) == "table" then return origIndex[key] end
			return realStore[key]
		end

		mmt.__newindex = function(self, key, value)
			if key == "Hit" or key == "Target" then
				realStore[key] = value
			else
				rawset(self, key, value)
			end
		end
		setreadonly(mmt, true)

		rawset(MouseModule, "Hit", nil)
		rawset(MouseModule, "Target", nil)
		mouseModuleHooked = true
	end)
end

-- ---- 通道2: 标准 Mouse 对象 ----
local hasCheckCaller = (type(checkcaller) == "function")
local oldIndex
pcall(function()
	oldIndex = hookmetamethod(game, "__index", function(self, key)
		if _G.Hunt_SkillAim and currentTarget and self == Mouse then
			if hasCheckCaller and checkcaller() then
				return oldIndex(self, key)
			end
			local part = getAimPart()
			if part then
				local tp = part.Position
				local cp = Camera.CFrame.Position
				if key == "Hit" then
					return CFrame.new(tp)
				elseif key == "Target" then
					return part
				elseif key == "UnitRay" then
					return Ray.new(cp, (tp - cp).Unit)
				elseif key == "Origin" then
					return cp
				elseif key == "Direction" then
					return (tp - cp).Unit
				end
			end
		end
		return oldIndex(self, key)
	end)
end)

