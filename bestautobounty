-- 反向：下拉框显示的是翻译后的文案，回调里要换回内部真正判断用的值
local function unL(text)
	if _G.G_Language == "English" then
		for k, v in pairs(Translations["English"]) do
			if v == text then return k end
		end
	end
	return text
end

