	if held and toolMatches(held, types) then return end

	-- 从背包装一个匹配的类型
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	if not backpack then return end

	for _, item in ipairs(backpack:GetChildren()) do
		if toolMatches(item, types) then
			local ok = pcall(function() hum:EquipTool(item) end)
			-- 只在真正换了一把的时候打印，不刷屏
			if item.Name ~= lastEquipName then
				lastEquipName = item.Name
				print("[猎赏] 切换装备: " .. item.Name .. " (" .. tostring(item.ToolTip) .. ")"
					.. (desiredType and (" <-轮换:" .. desiredType) or "") .. (ok and "" or " EquipTool报错"))
			end
			return
		end
	end

	if tick() - lastEquipLog > 10 then
		lastEquipLog = tick()
		print("[猎赏] 自动装备失败: 背包里没有「" .. (desiredType or weaponTypeText()) .. "」类型的武器")
	end
end

