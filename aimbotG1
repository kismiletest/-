-- 这是一个客户端脚本 (LocalScript)
-- 放置位置: StarterPlayer -> StarterPlayerScripts

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

-- ================= 配置参数 =================
local AIM_KEY = Enum.UserInputType.MouseButton2 -- 右键瞄准 (可以改为 Enum.KeyCode.E 等)
local FOV_RADIUS = 200 -- 自瞄的范围（屏幕像素半径），只有在这个圆圈内的敌人会被锁定
local LOCK_PART = "Head" -- 锁头 ("Head") 或 锁胸口 ("UpperTorso" / "Torso")
local SMOOTHNESS = 0.2 -- 平滑度 (0-1)，数值越小越平滑/慢，1为瞬间锁定（防抖/防封微调）
local TEAM_CHECK = true -- 是否开启队友检查 (true = 不锁队友)
-- =============================================

local isAiming = false
local currentTarget = nil

-- 获取屏幕中心点
local function getScreenCenter()
	return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
end

-- 检查目标是否合法且存活
local function isValidTarget(player)
	if not player or player == LocalPlayer then return false end
	if TEAM_CHECK and player.Team == LocalPlayer.Team then return false end
	
	local character = player.Character
	if not character or not character:FindFirstChild(LOCK_PART) or not character:FindFirstChildOfClass("Humanoid") then 
		return false 
	end
	
	if character:FindFirstChildOfClass("Humanoid").Health <= 0 then return false end
	
	-- 检查目标是否在掩体后面（可选射线检测，这里留空以保持核心逻辑清晰）
	return true
end

-- 获取距离准星最近的合法敌人
local function getClosestPlayerToCrosshair()
	local closestPlayer = nil
	local shortestDistance = FOV_RADIUS
	local center = getScreenCenter()

	for _, player in ipairs(Players:GetPlayers()) do
		if isValidTarget(player) then
			local targetPart = player.Character[LOCK_PART]
			-- 将敌人的3D坐标转换为2D屏幕坐标
			local screenPosition, onScreen = Camera:WorldToViewportPoint(targetPart.Position)

			if onScreen then
				-- 计算敌人与屏幕中心的距离
				local distance = (Vector2.new(screenPosition.X, screenPosition.Y) - center).Magnitude
				if distance < shortestDistance then
					shortestDistance = distance
					closestPlayer = player
				end
			end
		end
	end

	return closestPlayer
end

-- 监听按键按下
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.UserInputType == AIM_KEY or input.KeyCode == AIM_KEY then
		isAiming = true
	end
end)

-- 监听按键释放
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == AIM_KEY or input.KeyCode == AIM_KEY then
		isAiming = false
		currentTarget = nil
	end
end)

-- 每帧渲染前执行自瞄逻辑
RunService.RenderStepped:Connect(function()
	if not isAiming then return end
	
	-- 如果当前没有目标，或者当前目标死掉了/跑远了，重新寻找目标
	if not currentTarget or not isValidTarget(currentTarget) then
		currentTarget = getClosestPlayerToCrosshair()
	end

	-- 如果找到目标，将摄像机转向目标
	if currentTarget and currentTarget.Character and currentTarget.Character:FindFirstChild(LOCK_PART) then
		local targetPosition = currentTarget.Character[LOCK_PART].Position
		
		-- 计算摄像机需要朝向的新 CFrame
		local targetCFrame = CFrame.new(Camera.CFrame.Position, targetPosition)
		
		-- 使用 Lerp（线性插值）实现平滑转向，防止画面瞬间瞬移显得太假
		Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, SMOOTHNESS)
	end
end)
