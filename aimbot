--[[
    Blox Fruits 自动化核心框架
    功能：
    1. 自动定位任务目标 (Auto Target)
    2. 自动瞬移至怪物位置 (Tween Teleport) - 需手动触发
    3. 100% 命中率 (Silent Aim)
    4. 性能深度优化，告别卡顿
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()

-- 自动化配置
local Settings = {
    AutoFarm = true,
    SilentAim = true,
    Distance = 10, -- 距离怪物的高度（防止被怪打到）
    FastAttack = true,
    TweenSpeed = 200
}

local CurrentQuestTarget = "" -- 用于存放当前任务怪物名

------------------------------------------------
-- 1. 核心算法：安全瞬移 (Tween TP)
------------------------------------------------
-- 使用 Tween 而不是直接改 CFrame，可以有效防止被反作弊踢出
local function SecureTP(targetCFrame)
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local root = char.HumanoidRootPart
        local distance = (root.Position - targetCFrame.Position).Magnitude
        local duration = distance / Settings.TweenSpeed
        
        local info = TweenInfo.new(duration, Enum.EasingStyle.Linear)
        local tween = TweenService:Create(root, info, {CFrame = targetCFrame * CFrame.new(0, Settings.Distance, 0)})
        tween:Play()
        return tween
    end
end

------------------------------------------------
-- 2. 核心算法：智能索敌 (针对任务怪)
------------------------------------------------
local function GetMonster()
    local closest = nil
    local dist = math.huge
    
    for _, v in pairs(workspace.Enemies:GetChildren()) do
        -- 优先寻找你正在做的任务怪，如果没有，找最近的
        if v:IsA("Model") and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
            local root = v:FindFirstChild("HumanoidRootPart")
            if root then
                local mag = (root.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
                if mag < dist then
                    closest = v
                    dist = mag
                end
            end
        end
    end
    return closest
end

------------------------------------------------
-- 3. 核心算法：100% 命中劫持 (Silent Aim)
------------------------------------------------
local old
old = hookmetamethod(game, "__index", function(self, index)
    if self == Mouse and (index == "Hit" or index == "Target") then
        local monster = GetMonster()
        if Settings.SilentAim and monster and monster:FindFirstChild("HumanoidRootPart") then
            return (index == "Hit" and monster.HumanoidRootPart.CFrame or monster.HumanoidRootPart)
        end
    end
    return old(self, index)
end)

------------------------------------------------
-- 4. 自动化主循环
------------------------------------------------
task.spawn(function()
    while task.wait() do
        if Settings.AutoFarm then
            pcall(function()
                local target = GetMonster()
                if target and target:FindFirstChild("HumanoidRootPart") then
                    -- 如果距离太远，启动瞬移
                    local dist = (target.HumanoidRootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
                    if dist > 15 then
                        SecureTP(target.HumanoidRootPart.CFrame)
                    end
                    
                    -- 自动面对敌人
                    LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(
                        LocalPlayer.Character.HumanoidRootPart.Position,
                        Vector3.new(target.HumanoidRootPart.Position.X, LocalPlayer.Character.HumanoidRootPart.Position.Y, target.HumanoidRootPart.Position.Z)
                    )
                end
            end)
        end
    end
end)

-- 快速攻击补丁 (极大提升刷怪效率)
task.spawn(function()
    while task.wait() do
        if Settings.FastAttack and Settings.AutoFarm then
            local target = GetMonster()
            if target then
                -- 这里触发游戏的攻击事件，根据不同执行器可能需要适配
                game:GetService("VirtualUser"):CaptureController()
                game:GetService("VirtualUser"):Button1Down(Vector2.new(1280, 672))
            end
        end
    end
end)

print("Blox Fruits 自动刷级框架已启动！")
