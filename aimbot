   Flag = "TeamCheck",
   Callback = function(Value)
      AimbotConfig.TeamCheck = Value
   end,
})

AimbotTab:CreateToggle({
   Name = "存活检查 (Alive Check)",
   CurrentValue = AimbotConfig.AliveCheck,
   Flag = "AliveCheck",
   Callback = function(Value)
      AimbotConfig.AliveCheck = Value
   end,
})

-- 3. 精细调节分组
local AdjustSection = AimbotTab:CreateSection("高级参数调节")

AimbotTab:CreateDropdown({
   Name = "瞄准部位",
   Options = {"Head", "UpperTorso", "HumanoidRootPart"},
   CurrentOption = {AimbotConfig.TargetPart},
   MultipleOptions = false,
   Flag = "TargetPart",
   Callback = function(Option)
      AimbotConfig.TargetPart = Option[1] -- Rayfield 返回的是一个包含选中项的数组
   end,
})

AimbotTab:CreateSlider({
   Name = "平滑度 (Smoothness)",
   Range = {5, 100}, -- Rayfield 滑动条不支持浮点数步长，这里用整数放大100倍处理
   Increment = 5,
   CurrentValue = AimbotConfig.Smoothness * 100,
   Flag = "Smoothness",
   Callback = function(Value)
      AimbotConfig.Smoothness = Value / 100 -- 实际应用时再缩小回去
   end,
})

AimbotTab:CreateSlider({
   Name = "自瞄范围 (FOV)",
   Range = {50, 800},
   Increment = 10,
   CurrentValue = AimbotConfig.FOV,
   Flag = "AimbotFOV",
   Callback = function(Value)
      AimbotConfig.FOV = Value
   end,
})

-- ==========================================
-- 帧循环驱动自瞄 (RunService)
-- ==========================================
game:GetService("RunService").RenderStepped:Connect(function()
    if AimbotConfig.Enabled then
        local targetPlayer = GetClosestPlayer()
        if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild(AimbotConfig.TargetPart) then
            local targetPos = targetPlayer.Character[AimbotConfig.TargetPart].Position
            
            -- 使用 CFrame.lookAt 实现平滑插值移动视角 (Lerp)
            Camera.CFrame = Camera.CFrame:Lerp(
                CFrame.lookAt(Camera.CFrame.Position, targetPos), 
                AimbotConfig.Smoothness
            )
        end
    end
end)

