-- ==========================================
-- 变量与配置初始化
-- ==========================================
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local AimbotConfig = {
    Enabled = false,
    TeamCheck = true,
    AliveCheck = true,
    TargetPart = "Head",    -- 默认锁头
    Smoothness = 0.2,       -- 平滑度 (0-1)
    FOV = 150               -- 瞄准范围大小
}

-- ==========================================
-- 核心逻辑：获取最近的敌人
-- ==========================================
local function GetClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local isValid = true
            
            -- 团队检查
            if AimbotConfig.TeamCheck and player.Team == LocalPlayer.Team then
                isValid = false
            end
            
            -- 存活检查
            if AimbotConfig.AliveCheck then
                local character = player.Character
                if not character or not character:FindFirstChild("Humanoid") or character.Humanoid.Health <= 0 then
                    isValid = false
                end
            end
            
            -- 计算屏幕距离与 FOV 检查
            if isValid and player.Character and player.Character:FindFirstChild(AimbotConfig.TargetPart) then
                local targetPart = player.Character[AimbotConfig.TargetPart]
                local screenPosition, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                
                if onScreen then
                    -- 计算鼠标指针到敌人屏幕位置的距离
                    local mousePos = game:GetService("UserInputService"):GetMouseLocation()
                    local distance = (Vector2.new(screenPosition.X, screenPosition.Y) - mousePos).Magnitude
                    
                    -- 判断是否在自瞄范围内，且是最近的目标
                    if distance < AimbotConfig.FOV and distance < shortestDistance then
                        closestPlayer = player
                        shortestDistance = distance
                    end
                end
            end
        end
    end
    return closestPlayer
end

