local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local localPlayer = Players.LocalPlayer
local mouse = localPlayer:GetMouse()

-- [[ 配置面板 ]]
local SETTINGS = {
    SilentAim = true,
    ESP = true,
    TeamCheck = false, -- 是否攻击同阵营
    TargetPart = "HumanoidRootPart", -- 锁定躯干命中率更高
    Range = 1000 -- 索敌范围
}

-- 存储 UI 对象以便清理
local _espStorage = {}

------------------------------------------------
-- 核心：获取最近的敌人（怪物或玩家）
------------------------------------------------
local function getClosestTarget()
    local target = nil
    local dist = SETTINGS.Range

    -- Blox Fruits 的怪物通常在 workspace.NPCs 或直接在 workspace
    -- 我们采用最通用的判定方式
    for _, v in pairs(workspace:GetChildren()) do
        if v:IsA("Model") and v ~= localPlayer.Character then
            local hum = v:FindFirstChildOfClass("Humanoid")
            local root = v:FindFirstChild(SETTINGS.TargetPart)
            
            if hum and hum.Health > 0 and root then
                local magnitude = (root.Position - localPlayer.Character.HumanoidRootPart.Position).Magnitude
                if magnitude < dist then
                    -- 检查是否是玩家，如果是玩家则进行阵营检查
                    local p = Players:GetPlayerFromCharacter(v)
                    if not p or (SETTINGS.TeamCheck or p.Team ~= localPlayer.Team) then
                        target = root
                        dist = magnitude
                    end
                end
            end
        end
    end
    return target
end

------------------------------------------------
-- 核心：静默自瞄 (劫持射击逻辑)
------------------------------------------------
local oldIndex
oldIndex = hookmetamethod(game, "__index", function(self, index)
    if self == mouse and (index == "Hit" or index == "Target") then
        if SETTINGS.SilentAim then
            local target = getClosestTarget()
            if target then
                return (index == "Hit" and target.CFrame or target)
            end
        end
    end
    return oldIndex(self, index)
end)

------------------------------------------------
-- 核心：ESP 透视 (防止卡顿版)
------------------------------------------------
local function createESP(model)
    if not SETTINGS.ESP then return end
    local root = model:FindFirstChild("HumanoidRootPart")
    if not root or root:FindFirstChild("BF_ESP") then return end

    local gui = Instance.new("BillboardGui")
    gui.Name = "BF_ESP"
    gui.Size = UDim2.new(0, 100, 0, 40)
    gui.AlwaysOnTop = true
    gui.ExtentsOffset = Vector3.new(0, 3, 0)
    gui.Parent = root

    local label = Instance.new("TextLabel")
    label.Parent = gui
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextScaled = true
    label.Font = Enum.Font.SourceSansBold
    
    -- 颜色判定
    if Players:GetPlayerFromCharacter(model) then
        label.TextColor3 = Color3.fromRGB(255, 255, 0) -- 玩家为黄色
    else
        label.TextColor3 = Color3.fromRGB(255, 0, 0) -- 怪物为红色
    end

    task.spawn(function()
        while model.Parent and SETTINGS.ESP do
            local myPos = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
            if myPos then
                local d = math.floor((root.Position - myPos.Position).Magnitude)
                label.Text = model.Name .. "\n[" .. d .. "m]"
            end
            task.wait(0.5)
        end
        gui:Destroy()
    end)
end

