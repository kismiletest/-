-- [[ 确保 LocalPlayer 已加载 ]]
local Players = game:GetService("Players")
repeat task.wait() until Players.LocalPlayer
local lp = Players.LocalPlayer
local mouse = lp:GetMouse()
local camera = workspace.CurrentCamera

print(">>> 正在启动加固版辅助...")

-- 配置
local _G.Toggle = true
local _G.Aimbot = true
local _G.ESP = true

------------------------------------------------
-- 1. 最稳健的索敌函数 (直接锁定视角)
------------------------------------------------
local function getTarget()
    local closest = nil
    local dist = 1000 -- 索敌范围

    -- 遍历整个 Workspace 的模型，兼容性最高
    for _, v in pairs(workspace:GetChildren()) do
        if v:IsA("Model") and v ~= lp.Character then
            local hum = v:FindFirstChildOfClass("Humanoid")
            local root = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Head")
            
            if hum and hum.Health > 0 and root then
                local mag = (root.Position - lp.Character.HumanoidRootPart.Position).Magnitude
                if mag < dist then
                    closest = root
                    dist = mag
                end
            end
        end
    end
    return closest
end

------------------------------------------------
-- 2. 强力自瞄 (采用平滑转向，防止被踢)
------------------------------------------------
RunService = game:GetService("RunService")
RunService.RenderStepped:Connect(function()
    if _G.Toggle and _G.Aimbot then
        local target = getTarget()
        if target then
            -- 强制让相机的 CFrame 指向目标，这不需要高级权限
            local targetPos = CFrame.new(camera.CFrame.Position, target.Position)
            camera.CFrame = camera.CFrame:Lerp(targetPos, 0.2) -- 0.2 为平滑度
        end
    end
end)

------------------------------------------------
-- 3. 基础版 ESP (不卡顿)
------------------------------------------------
local function makeESP(model)
    if model:FindFirstChild("SimpleESP") then return end
    local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")
    if not root then return end

    local gui = Instance.new("BillboardGui", root)
    gui.Name = "SimpleESP"
    gui.Size = UDim2.new(0, 100, 0, 50)
    gui.AlwaysOnTop = true
    
    local label = Instance.new("TextLabel", gui)
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = model.Name
    label.TextColor3 = Color3.new(1, 0, 0)
    label.TextScaled = true
end

-- 持续刷新渲染
task.spawn(function()
    while _G.Toggle do
        for _, v in pairs(workspace:GetChildren()) do
            if v:IsA("Model") and v:FindFirstChildOfClass("Humanoid") and v ~= lp.Character then
                makeESP(v)
            end
        end
        task.wait(2)
    end
end)

------------------------------------------------
-- 4. 简易功能菜单 (直接显示在屏幕左侧)
------------------------------------------------
local sg = Instance.new("ScreenGui", lp.PlayerGui)
local btn = Instance.new("TextButton", sg)
btn.Size = UDim2.new(0, 120, 0, 40)
btn.Position = UDim2.new(0, 10, 0.5, 0)
btn.Text = "功能: 开启"
btn.BackgroundColor3 = Color3.new(0, 0.5, 0)
btn.TextColor3 = Color3.new(1, 1, 1)

btn.MouseButton1Click:Connect(function()
    _G.Toggle = not _G.Toggle
    btn.Text = _G.Toggle and "功能: 开启" or "功能: 关闭"
    btn.BackgroundColor3 = _G.Toggle and Color3.new(0, 0.5, 0) or Color3.new(0.5, 0, 0)
end)

print(">>> 加固版辅助启动成功！")
