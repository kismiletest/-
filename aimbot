local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local localPlayer = Players.LocalPlayer
local mouse = localPlayer:GetMouse()

-- [[ 优化配置 ]]
local SETTINGS = {
    Aimbot = true,
    ESP = true,
    Range = 2000, -- 建议不要设为无限，2000足够覆盖极远距离
    ScanRate = 1.5, -- 每1.5秒扫描一次环境（防卡顿关键）
    UpdateRate = 0.1 -- 坐标更新频率
}

local currentTarget = nil

------------------------------------------------
-- 1. 极其轻量的索敌逻辑 (降低扫描深度)
------------------------------------------------
local function updateTarget()
    local closest = nil
    local dist = SETTINGS.Range
    local myRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    
    if not myRoot then return end

    -- 只扫描工作区的一级目录（NPC通常在这里），避开地图细碎零件
    for _, v in pairs(workspace:GetChildren()) do
        if v:IsA("Model") and v ~= localPlayer.Character then
            local hum = v:FindFirstChildOfClass("Humanoid")
            local root = v:FindFirstChild("HumanoidRootPart")
            
            if hum and hum.Health > 0 and root then
                local mag = (root.Position - myRoot.Position).Magnitude
                if mag < dist then
                    closest = root
                    dist = mag
                end
            end
        end
    end
    currentTarget = closest
end

-- 独立线程每秒更新一次目标，不占用渲染帧
task.spawn(function()
    while true do
        updateTarget()
        task.wait(SETTINGS.ScanRate)
    end
end)

------------------------------------------------
-- 2. 命中劫持 (只在射击时计算)
------------------------------------------------
local oldIndex
oldIndex = hookmetamethod(game, "__index", function(self, index)
    if self == mouse and (index == "Hit" or index == "Target") then
        if SETTINGS.Aimbot and currentTarget then
            return (index == "Hit" and currentTarget.CFrame or currentTarget)
        end
    end
    return oldIndex(self, index)
end)

------------------------------------------------
-- 3. 极简 ESP (仅在目标靠近时创建)
------------------------------------------------
local function applyESP(model)
    if not SETTINGS.ESP or model:FindFirstChild("OptimizedESP") then return end
    
    local root = model:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local gui = Instance.new("BillboardGui")
    gui.Name = "OptimizedESP"
    gui.Size = UDim2.new(0, 80, 0, 30)
    gui.AlwaysOnTop = true
    gui.Parent = root

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255, 0, 0)
    label.TextScaled = true
    label.Parent = gui

    task.spawn(function()
        while model.Parent and SETTINGS.ESP do
            local myRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
            if myRoot then
                local d = (root.Position - myRoot.Position).Magnitude
                label.Text = string.format("%s\n%dm", model.Name, math.floor(d))
                -- 如果太远，隐藏文字以节省渲染开销
                label.Visible = (d < 1000) 
            end
            task.wait(0.3)
        end
        gui:Destroy()
    end)
end

-- 持续监听
workspace.ChildAdded:Connect(function(child)
    task.wait(1)
    if child:IsA("Model") and child:FindFirstChildOfClass("Humanoid") then
        applyESP(child)
    end
end)

-- 初始化
for _, v in pairs(workspace:GetChildren()) do
    if v:IsA("Model") and v:FindFirstChildOfClass("Humanoid") and v ~= localPlayer.Character then
        applyESP(v)
    end
end

print("丝滑版脚本已加载，已自动平衡性能与精度")
