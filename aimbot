-- [[ 警告：范围无限制会导致极高封号风险 ]]

local SETTINGS = {
    AimbotEnabled = true,
    ESPEnabled = true,
    TargetPart = "Head",
    MaxDistance = math.huge -- 无限制范围
}

-- 1. 静默自瞄逻辑 (Silent Aim)
local oldIndex
oldIndex = hookmetamethod(game, "__index", function(self, index)
    if self == game:GetService("Players").LocalPlayer:GetMouse() and (index == "Hit" or index == "Target") then
        if SETTINGS.AimbotEnabled then
            local target = getClosestTarget() -- 调用寻找目标的函数
            if target then
                return (index == "Hit" and target.CFrame or target)
            end
        end
    end
    return oldIndex(self, index)
end)

