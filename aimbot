local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local localPlayer = Players.LocalPlayer
local camera = workspace.CurrentCamera

-- 状态控制
local AIMBOT_ENABLED = false
local AIM_KEY = Enum.UserInputType.MouseButton2 -- 默认右键自瞄
local SMOOTHNESS = 0.2 -- 平滑度 (0.01 到 1，越小越平滑/慢)

------------------------------------------------
-- 核心自瞄逻辑
------------------------------------------------

-- 获取距离准心最近的目标
local function getClosestTarget()
    local closestTarget = nil
    local shortestDistance = math.huge

    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= localPlayer.Character then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local head = obj:FindFirstChild("Head") or obj:FindFirstChild("HumanoidRootPart")
            
            -- 必须活着且有头部
            if hum and hum.Health > 0 and head then
                -- 将物体的世界坐标转换到屏幕坐标
                local pos, onScreen = camera:WorldToViewportPoint(head.Position)
                
                if onScreen then
                    -- 计算目标点与屏幕中心（准心）的距离
                    local mousePos = UserInputService:GetMouseLocation()
                    local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                    
                    if dist < shortestDistance then
                        closestTarget = head
                        shortestDistance = dist
                    end
                end
            end
        end
    end
    return closestTarget
end

-- 实时锁定
RunService.RenderStepped:Connect(function()
    if AIMBOT_ENABLED and UserInputService:IsMouseButtonPressed(AIM_KEY) then
        local target = getClosestTarget()
        if target then
            -- 平滑转动相机
            local targetPos = CFrame.new(camera.CFrame.Position, target.Position)
            camera.CFrame = camera.CFrame:Lerp(targetPos, SMOOTHNESS)
        end
    end
end)

