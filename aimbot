local ScreenGui = Instance.new("ScreenGui", localPlayer.PlayerGui)
local MainFrame = Instance.new("Frame", ScreenGui)
MainFrame.Size = UDim2.new(0, 150, 0, 110)
MainFrame.Position = UDim2.new(0.1, 0, 0.4, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
MainFrame.Active = true
MainFrame.Draggable = true

local function createBtn(text, pos, callback)
    local btn = Instance.new("TextButton", MainFrame)
    btn.Size = UDim2.new(0.9, 0, 0, 30)
    btn.Position = pos
    btn.Text = text
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.MouseButton1Click:Connect(callback)
    return btn
end

local aimBtn = createBtn("静默自瞄: 开启", UDim2.new(0.05, 0, 0.1, 0), function()
    SETTINGS.SilentAim = not SETTINGS.SilentAim
    ScreenGui.MainFrame.TextButton.Text = SETTINGS.SilentAim and "静默自瞄: 开启" or "静默自瞄: 关闭"
end)

local espBtn = createBtn("透视显示: 开启", UDim2.new(0.05, 0, 0.5, 0), function()
    SETTINGS.ESP = not SETTINGS.ESP
end)

------------------------------------------------
-- 循环监听
------------------------------------------------
task.spawn(function()
    while true do
        for _, v in pairs(workspace:GetChildren()) do
            if v:IsA("Model") and v:FindFirstChildOfClass("Humanoid") and v ~= localPlayer.Character then
                createESP(v)
            end
        end
        task.wait(2) -- 每2秒刷新一次环境，防止卡顿
    end
end)

