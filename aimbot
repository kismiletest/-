-- ==========================================
-- 变量与配置初始化
-- ==========================================
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Config = {
    Enabled = false,
    TargetMode = "Smart",            -- Smart(智能识别), Murderer(只锁杀手), Everyone(所有人)
    TargetPart = "HumanoidRootPart", -- 决斗游戏建议锁躯干，命中率最高
    Smoothness = 0.15,               -- 平滑度
    
    -- FOV 圈配置
    FOV = 150,
    ShowFOV = true,
    FOVColor = Color3.fromRGB(0, 255, 120), -- 翠绿色圈
    FOVThickness = 2
}

-- ==========================================
-- 创建可视化 FOV 圆圈 (Drawing API)
-- ==========================================
local FOVCircle = Drawing.new("Circle")
FOVCircle.Filled = false
FOVCircle.Transparency = 1

local function UpdateFOVCircle()
    if Config.ShowFOV and Config.Enabled then
        local mousePos = UserInputService:GetMouseLocation()
        FOVCircle.Position = Vector2.new(mousePos.X, mousePos.Y)
        FOVCircle.Radius = Config.FOV
        FOVCircle.Color = Config.FOVColor
        FOVCircle.Thickness = Config.FOVThickness
        FOVCircle.Visible = true
    else
        FOVCircle.Visible = false
    end
end

-- ==========================================
-- 决斗游戏专属：身份与状态检查
-- ==========================================
local function IsMurderer(player)
    local backpack = player:FindFirstChild("Backpack")
    local character = player.Character
    
    local function checkKnife(container)
        if container then
            if container:FindFirstChild("Knife") or container:FindFirstChild("KnifeTool") or container:FindFirstChild("刀") then
                return true
            end
        end
        return false
    end

    if checkKnife(backpack) or checkKnife(character) then return true end
    
    if player:FindFirstChild("Role") and player.Role.Value == "Murderer" then return true end
    if player:FindFirstChild("tempRole") and player.tempRole.Value == "Murderer" then return true end
    
    return false
end

local function IsValidTarget(player)
    if player == LocalPlayer then return false end
    
    local char = player.Character
    if not char or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then
        return false
    end
    
    if Config.TargetMode == "Murderer" then
        return IsMurderer(player)
    elseif Config.TargetMode == "Smart" then
        local amIMurderer = IsMurderer(LocalPlayer)
        if amIMurderer then
            return true
        else
            return IsMurderer(player)
        end
    end
    
    return true
end

-- ==========================================
-- 获取 FOV 圈内最近的合法目标
-- ==========================================
local function GetClosestTarget()
    local closestPlayer = nil
    local shortestDistance = math.huge
    local mousePos = UserInputService:GetMouseLocation()

    for _, player in ipairs(Players:GetPlayers()) do
        if IsValidTarget(player) and player.Character and player.Character:FindFirstChild(Config.TargetPart) then
            local part = player.Character[Config.TargetPart]
            local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
            
            if onScreen then
                local distance = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                if distance < Config.FOV and distance < shortestDistance then
                    closestPlayer = player
                    shortestDistance = distance
                end
            end
        end
    end
    return closestPlayer
end

