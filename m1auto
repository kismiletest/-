-- =========================
-- 自动攻击核心
-- =========================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer

-- 开关 & 设置
getgenv().AutoAttack = false
getgenv().AttackDistance = 25 -- 可调

-- 获取角色
local function getChar()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

-- 是否存活
local function isAlive(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

-- 获取最近敌人
local function getNearestEnemy()
    local char = getChar()
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local closest, dist = nil, math.huge

    -- 怪物
    for _, mob in pairs(workspace.Enemies:GetChildren()) do
        if isAlive(mob) and mob:FindFirstChild("HumanoidRootPart") then
            local d = (mob.HumanoidRootPart.Position - hrp.Position).Magnitude
            if d < dist and d <= getgenv().AttackDistance then
                dist = d
                closest = mob
            end
        end
    end

    -- 玩家（PVP）
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and isAlive(plr.Character) then
            local ehrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if ehrp then
                local d = (ehrp.Position - hrp.Position).Magnitude
                if d < dist and d <= getgenv().AttackDistance then
                    dist = d
                    closest = plr.Character
                end
            end
        end
    end

    return closest
end

-- 装备武器
local function equipWeapon()
    local char = getChar()
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
        if tool:IsA("Tool") and tool:FindFirstChild("Handle") then
            hum:EquipTool(tool)
            break
        end
    end
end

-- 攻击
local function attack(target)
    local char = getChar()
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local thrp = target:FindFirstChild("HumanoidRootPart")
    if not (hrp and thrp) then return end

    -- 面向敌人（不锁镜头）
    hrp.CFrame = CFrame.new(hrp.Position, thrp.Position)

    -- 挥刀
    pcall(function()
        ReplicatedStorage.Remotes.Combat:FireServer("Attack")
    end)
end

-- =========================
-- 主循环
-- =========================
task.spawn(function()
    while task.wait(0.15) do
        if getgenv().AutoAttack then
            equipWeapon()
            local enemy = getNearestEnemy()
            if enemy then
                attack(enemy)
            end
        end
    end
end)
