-- Services
local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- 等待角色
local function getCharacter()
    return player.Character or player.CharacterAdded:Wait()
end

-- TP 坐标（你给的）
local TP_POSITION = CFrame.new(-345, 74, 297)

-- GUI
local gui = Instance.new("ScreenGui")
gui.Name = "TP_GUI"
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 260, 0, 160)
frame.Position = UDim2.new(0.5, -130, 0.5, -80)
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
frame.Parent = gui
frame.Active = true
frame.Draggable = true

-- 标题
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 40)
title.BackgroundTransparency = 1
title.Text = "TP GUI (Demo)"
title.TextColor3 = Color3.new(1,1,1)
title.Font = Enum.Font.GothamBold
title.TextSize = 16
title.Parent = frame

-- TP 按钮
local tpButton = Instance.new("TextButton")
tpButton.Size = UDim2.new(0.8, 0, 0, 40)
tpButton.Position = UDim2.new(0.1, 0, 0.4, 0)
tpButton.Text = "TP : OFF"
tpButton.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
tpButton.TextColor3 = Color3.new(1,1,1)
tpButton.Font = Enum.Font.Gotham
tpButton.TextSize = 14
tpButton.Parent = frame

-- 最小化按钮
local miniButton = Instance.new("TextButton")
miniButton.Size = UDim2.new(0, 40, 0, 40)
miniButton.Position = UDim2.new(1, -40, 0, 0)
miniButton.Text = "-"
miniButton.BackgroundColor3 = Color3.fromRGB(60,60,60)
miniButton.TextColor3 = Color3.new(1,1,1)
miniButton.Parent = frame

-- 状态
local tpEnabled = false
local minimized = false

-- TP 逻辑
tpButton.MouseButton1Click:Connect(function()
    tpEnabled = not tpEnabled

    if tpEnabled then
        tpButton.Text = "TP : ON"
        tpButton.BackgroundColor3 = Color3.fromRGB(60, 200, 60)

        local char = getCharacter()
        local hrp = char:WaitForChild("HumanoidRootPart")
        hrp.CFrame = TP_POSITION
    else
        tpButton.Text = "TP : OFF"
        tpButton.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
    end
end)

-- 最小化逻辑
miniButton.MouseButton1Click:Connect(function()
    minimized = not minimized

    for _, v in pairs(frame:GetChildren()) do
        if v ~= miniButton then
            v.Visible = not minimized
        end
    end

    frame.Size = minimized and UDim2.new(0, 260, 0, 40)
        or UDim2.new(0, 260, 0, 160)
end)
