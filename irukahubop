-- 主要功能循环
RunService.Heartbeat:Connect(function()
    local character = LocalPlayer.Character
    if not character then return end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChild("Humanoid")
    if not hrp or not humanoid then return end
    
    -- Cam Lock
    if States.CamLock and Config.SelectedPlayer and Config.SelectedPlayer.Character then
        local targetHead = Config.SelectedPlayer.Character:FindFirstChild(Config.LookPart)
        if targetHead then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)
        end
    end
    
    -- Player View
    if States.PlayerView and Config.SelectedPlayer and Config.SelectedPlayer.Character then
        local targetHumanoid = Config.SelectedPlayer.Character:FindFirstChild("Humanoid")
        if targetHumanoid then
            Camera.CameraSubject = targetHumanoid
        end
    else
        Camera.CameraSubject = humanoid
    end
    
    -- NoClip
    if States.NoClip then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
    
    -- Walk on Water (Blox Fruits)
    if States.WalkWater then
        local pos = hrp.Position
        if pos.Y < 0 then -- 海平面以下
            hrp.Velocity = Vector3.new(hrp.Velocity.X, 0, hrp.Velocity.Z)
            hrp.CFrame = CFrame.new(pos.X, 0, pos.Z)
        end
    end
end)

