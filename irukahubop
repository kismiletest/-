local ContentFrames = {}
local function CreateContentFrame(name, hasLeftPanel)
    local frame = Instance.new("Frame")
    frame.Parent = MainFrame
    frame.Size = UDim2.new(1, 0, 1, -35)
    frame.Position = UDim2.new(0, 0, 0, 35)
    frame.BackgroundTransparency = 1
