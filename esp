-- [[ 1.en Hub - 高级透视管理系统 ]] --

local Players = game:GetService("Players")
local RS = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local TS = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer

-- 配置表
local Settings = {
    ESP_Enabled = false,
    Show_Players = false,
    Show_Monsters = false,
    Show_Names = true,
    Show_Dist = true,
    UI_Rainbow = true
}

-- [[ UI 界面构建 ]] --
local ScreenGui = Instance.new("ScreenGui", (gethui and gethui()) or game:GetService("CoreGui"))
ScreenGui.Name = "1enHub_Premium"
ScreenGui.ResetOnSpawn = false

local MainFrame = Instance.new("Frame", ScreenGui)
MainFrame.Size = UDim2.new(0, 260, 0, 320)
MainFrame.Position = UDim2.new(0.5, -130, 0.5, -160)
MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
MainFrame.BorderSizePixel = 0
MainFrame.ClipsDescendants = true

local MainCorner = Instance.new("UICorner", MainFrame)
MainCorner.CornerRadius = UDim.new(0, 15)

local MainStroke = Instance.new("UIStroke", MainFrame)
MainStroke.Thickness = 2.5
MainStroke.Color = Color3.fromRGB(0, 255, 255)
MainStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

local Title = Instance.new("TextLabel", MainFrame)
Title.Size = UDim2.new(1, 0, 0, 50)
Title.Text = "1.en Hub"
Title.TextColor3 = Color3.new(1, 1, 1)
Title.Font = Enum.Font.GothamBold
Title.TextSize = 22
Title.BackgroundTransparency = 1

-- [[ 拖动逻辑 ]] --
local dragging, dragInput, dragStart, startPos
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

-- [[ UI 内容 ]] --
local Container = Instance.new("ScrollingFrame", MainFrame)
Container.Size = UDim2.new(1, -20, 1, -70)
Container.Position = UDim2.new(0, 10, 0, 60)
Container.BackgroundTransparency = 1
Container.CanvasSize = UDim2.new(0, 0, 1.2, 0)
Container.ScrollBarThickness = 0

local Layout = Instance.new("UIListLayout", Container)
Layout.Padding = UDim.new(0, 8)
Layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

local function AddToggle(text, configKey)
    local Btn = Instance.new("TextButton", Container)
    Btn.Size = UDim2.new(1, 0, 0, 40)
    Btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    Btn.Text = text .. " : OFF"
    Btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    Btn.Font = Enum.Font.GothamSemibold
    Btn.TextSize = 13
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 8)

    Btn.MouseButton1Click:Connect(function()
        Settings[configKey] = not Settings[configKey]
        Btn.Text = text .. " : " .. (Settings[configKey] and "ON" or "OFF")
        
        local targetColor = Settings[configKey] and Color3.fromRGB(0, 180, 120) or Color3.fromRGB(30, 30, 40)
        TS:Create(Btn, TweenInfo.new(0.3), {BackgroundColor3 = targetColor}):Play()
        Btn.TextColor3 = Settings[configKey] and Color3.new(1, 1, 1) or Color3.fromRGB(200, 200, 200)
    end)
end

AddToggle("开启透视总开关", "ESP_Enabled")
AddToggle("玩家透视 (蓝色)", "Show_Players")
AddToggle("怪物透视 (红色)", "Show_Monsters")
AddToggle("显示名字", "Show_Names")
AddToggle("显示距离", "Show_Dist")

-- [[ ESP 核心渲染引擎 ]] --
local function ApplyESP(obj, color)
    local high = obj:FindFirstChild("1en_High") or Instance.new("Highlight", obj)
    high.Name = "1en_High"
    high.FillColor = color
    high.FillTransparency = 0.5
    high.OutlineColor = Color3.new(1, 1, 1)
    high.Enabled = true

    local bill = obj:FindFirstChild("1en_Tag") or Instance.new("BillboardGui", obj)
    bill.Name = "1en_Tag"
    bill.Size = UDim2.new(0, 200, 0, 50)
    bill.Adornee = obj:FindFirstChild("Head") or obj.PrimaryPart
    bill.AlwaysOnTop = true
    bill.ExtentsOffset = Vector3.new(0, 3, 0)

    local label = bill:FindFirstChild("TextLabel") or Instance.new("TextLabel", bill)
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = color
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.TextStrokeTransparency = 0
    
    return high, label
end

RS.RenderStepped:Connect(function()
    -- UI 彩虹特效
    if Settings.UI_Rainbow then
        local hue = tick() % 5 / 5
        MainStroke.Color = Color3.fromHSV(hue, 0.8, 1)
        Title.TextColor3 = Color3.fromHSV(hue, 0.6, 1)
    end

    -- 清理逻辑与渲染
    for _, v in pairs(workspace:GetChildren()) do
        local isPlayer = Players:GetPlayerFromCharacter(v)
        local isMonster = v:FindFirstChild("Humanoid") and not isPlayer
        
        -- 基础过滤：如果名字包含 NPC 字样通常过滤掉
        if isMonster and (v.Name:lower():find("npc") or v.Name:lower():find("quest")) then
            isMonster = false
        end

        local shouldShow = false
        local espColor = Color3.new(1, 1, 1)

        if Settings.ESP_Enabled then
            if isPlayer and Settings.Show_Players and v ~= LocalPlayer.Character then
                shouldShow = true
                espColor = Color3.fromRGB(0, 160, 255)
            elseif isMonster and Settings.Show_Monsters then
                shouldShow = true
                espColor = Color3.fromRGB(255, 45, 45)
            end
        end

        if shouldShow and v:FindFirstChild("HumanoidRootPart") then
            local high, label = ApplyESP(v, espColor)
            local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - v.HumanoidRootPart.Position).Magnitude)
            
            local namePart = Settings.Show_Names and v.Name or ""
            local distPart = Settings.Show_Dist and (" [" .. dist .. "m]") or ""
            label.Text = namePart .. distPart
            label.Visible = true
        else
            if v:FindFirstChild("1en_High") then v["1en_High"]:Destroy() end
            if v:FindFirstChild("1en_Tag") then v["1en_Tag"]:Destroy() end
        end
    end
end)

-- 隐藏/显示快捷键
UIS.InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == Enum.KeyCode.RightControl then
        ScreenGui.Enabled = not ScreenGui.Enabled
    end
end)

