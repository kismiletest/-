-- 交互逻辑
------------------------------------------------
EspBtn.MouseButton1Click:Connect(function()
    local newState = not ESP_ENABLED
    toggleAllESP(newState)
    EspBtn.Text = newState and "ESP 透视: 开" or "ESP 透视: 关"
    EspBtn.BackgroundColor3 = newState and Color3.fromRGB(40, 160, 40) or Color3.fromRGB(160, 40, 40)
end)

-- 快捷键
UserInputService.InputBegan:Connect(function(i, p)
    if not p and i.KeyCode == TOGGLE_KEY then
        MainFrame.Visible = not MainFrame.Visible
    end
end)

-- 监听新玩家进入
Players.PlayerAdded:Connect(applyESP)
for _, p in pairs(Players:GetPlayers()) do applyESP(p) end

