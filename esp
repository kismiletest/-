-- 交互绑定
------------------------------------------------
EspBtn.MouseButton1Click:Connect(function()
    ESP_ENABLED = not ESP_ENABLED
    EspBtn.Text = ESP_ENABLED and "ESP 透视: 开" or "ESP 透视: 关"
    EspBtn.BackgroundColor3 = ESP_ENABLED and Color3.fromRGB(40, 160, 40) or Color3.fromRGB(160, 40, 40)
    if ESP_ENABLED then for _,v in pairs(workspace:GetChildren()) do createESP(v) end else clearESP() end
end)

-- 快捷键切换显隐
UserInputService.InputBegan:Connect(function(i, p)
    if not p and i.KeyCode == TOGGLE_KEY then
        MainFrame.Visible = not MainFrame.Visible
    end
end)

workspace.ChildAdded:Connect(function(c) if ESP_ENABLED then task.wait(0.1) createESP(c) end end)

print("1.en Hub V7 加载成功！点击 ✖ 或按右Ctrl隐藏。")
