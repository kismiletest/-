local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

--------------------------------------------------
-- ESP UI
--------------------------------------------------

local function createBillboard(root, name, color)

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(0,140,0,40)
	gui.StudsOffset = Vector3.new(0,4,0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 999999
	gui.Parent = root

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1,0,1,0)
	label.BackgroundTransparency = 1
	label.TextColor3 = color
	label.TextStrokeTransparency = 0
	label.Font = Enum.Font.SourceSansBold
	label.TextScaled = true
	label.Parent = gui

	return label
end

--------------------------------------------------
-- 玩家ESP
--------------------------------------------------

local function createPlayerESP(target)

	if target == player then return end
	if not target.Character then return end

	local char = target.Character
	if not char:FindFirstChild("HumanoidRootPart") then return end
	if char:FindFirstChild("PlayerESP") then return end

	local highlight = Instance.new("Highlight")
	highlight.Name = "PlayerESP"
	highlight.FillColor = Color3.fromRGB(0,255,0)
	highlight.FillTransparency = 0.5
	highlight.OutlineColor = Color3.fromRGB(255,255,255)
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = char

	local label = createBillboard(char.HumanoidRootPart, target.Name, Color3.fromRGB(0,255,0))

	task.spawn(function()
		while char.Parent do
			if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
				local dist = (char.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
				label.Text = target.Name.." ["..math.floor(dist).."m]"
			end
			task.wait(0.2)
		end
	end)
end

--------------------------------------------------
-- 怪物ESP
--------------------------------------------------

local function createMonsterESP(model)

	if not model:FindFirstChild("Humanoid") then return end
	if Players:GetPlayerFromCharacter(model) then return end
	if not model:FindFirstChild("HumanoidRootPart") then return end
	if model:FindFirstChild("MonsterESP") then return end

	local highlight = Instance.new("Highlight")
	highlight.Name = "MonsterESP"
	highlight.FillColor = Color3.fromRGB(255,0,0)
	highlight.FillTransparency = 0.5
	highlight.OutlineColor = Color3.fromRGB(255,255,255)
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = model

	local label = createBillboard(model.HumanoidRootPart, model.Name, Color3.fromRGB(255,0,0))

	task.spawn(function()
		while model.Parent do
			if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
				local dist = (model.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
				label.Text = model.Name.." ["..math.floor(dist).."m]"
			end
			task.wait(0.2)
		end
	end)
end

--------------------------------------------------
-- 玩家检测
--------------------------------------------------

for _,p in pairs(Players:GetPlayers()) do
	createPlayerESP(p)
end

Players.PlayerAdded:Connect(function(p)
	p.CharacterAdded:Connect(function()
		task.wait(1)
		createPlayerESP(p)
	end)
end)

--------------------------------------------------
-- 怪物扫描
--------------------------------------------------

for _,v in pairs(workspace:GetDescendants()) do
	if v:IsA("Model") then
		createMonsterESP(v)
	end
end

workspace.DescendantAdded:Connect(function(obj)
	if obj:IsA("Model") then
		createMonsterESP(obj)
	end
end)

--------------------------------------------------
-- 飞行系统
--------------------------------------------------

local flying = false
local speed = 60

local bodyVelocity
local bodyGyro

local function startFly()

	local char = player.Character
	if not char then return end
	local root = char:WaitForChild("HumanoidRootPart")

	bodyVelocity = Instance.new("BodyVelocity")
	bodyVelocity.MaxForce = Vector3.new(9e9,9e9,9e9)
	bodyVelocity.Velocity = Vector3.zero
	bodyVelocity.Parent = root

	bodyGyro = Instance.new("BodyGyro")
	bodyGyro.MaxTorque = Vector3.new(9e9,9e9,9e9)
	bodyGyro.P = 1000
	bodyGyro.Parent = root

	flying = true

	RunService.RenderStepped:Connect(function()

		if not flying then return end

		local cam = workspace.CurrentCamera
		local move = Vector3.zero

		if UIS:IsKeyDown(Enum.KeyCode.W) then
			move += cam.CFrame.LookVector
		end

		if UIS:IsKeyDown(Enum.KeyCode.S) then
			move -= cam.CFrame.LookVector
		end

		if UIS:IsKeyDown(Enum.KeyCode.A) then
			move -= cam.CFrame.RightVector
		end

		if UIS:IsKeyDown(Enum.KeyCode.D) then
			move += cam.CFrame.RightVector
		end

		if UIS:IsKeyDown(Enum.KeyCode.Space) then
			move += Vector3.new(0,1,0)
		end

		if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
			move -= Vector3.new(0,1,0)
		end

		bodyVelocity.Velocity = move * speed
		bodyGyro.CFrame = cam.CFrame

	end)
end

local function stopFly()

	flying = false

	if bodyVelocity then
		bodyVelocity:Destroy()
	end

	if bodyGyro then
		bodyGyro:Destroy()
	end
end

-- F键开关飞行
UIS.InputBegan:Connect(function(input,gp)

	if gp then return end

	if input.KeyCode == Enum.KeyCode.F then
		if flying then
			stopFly()
		else
			startFly()
		end
	end

end)
