    return btn, s
end

local PBtn, PS = makeBtn("真玩家透视: 关", Color3.fromRGB(0, 255, 255))
local MBtn, MS = makeBtn("真怪物透视: 关", Color3.fromRGB(255, 50, 50))

------------------------------------------------
-- 【5. 交互逻辑】
------------------------------------------------
PBtn.MouseButton1Click:Connect(function()
    ESP_PLAYER_ENABLED = not ESP_PLAYER_ENABLED
    PBtn.Text = ESP_PLAYER_ENABLED and "真玩家透视: 开" or "真玩家透视: 关"
    PBtn.TextColor3 = ESP_PLAYER_ENABLED and Color3.new(1,1,1) or Color3.new(0.6,0.6,0.6)
    PS.Color = ESP_PLAYER_ENABLED and Color3.fromRGB(0, 255, 255) or Color3.fromRGB(60,60,60)
    if ESP_PLAYER_ENABLED then
        for _, p in pairs(Players:GetPlayers()) do if p.Character then createESP(p.Character, true) end end
    end
end)

MBtn.MouseButton1Click:Connect(function()
    ESP_MOB_ENABLED = not ESP_MOB_ENABLED
    MBtn.Text = ESP_MOB_ENABLED and "真怪物透视: 开" or "真怪物透视: 关"
    MBtn.TextColor3 = ESP_MOB_ENABLED and Color3.new(1,1,1) or Color3.new(0.6,0.6,0.6)
    MS.Color = ESP_MOB_ENABLED and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(60,60,60)
    if ESP_MOB_ENABLED then
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Model") and v:FindFirstChildOfClass("Humanoid") then createESP(v, false) end
        end
    end
end)

-- 快捷键显示/隐藏面板
UserInputService.InputBegan:Connect(function(i, g)
    if not g and i.KeyCode == TOGGLE_KEY then MainFrame.Visible = not MainFrame.Visible end
end)

-- 自动监听新加入的玩家或怪物
workspace.DescendantAdded:Connect(function(v)
    if v:IsA("Model") then
        task.wait(0.5)
        local p = Players:GetPlayerFromCharacter(v)
        createESP(v, p ~= nil)
    end
end)

