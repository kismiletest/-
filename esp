-- 全局变量
local ESP_PLAYER_ENABLED = false
local ESP_MOB_ENABLED = false
local TOGGLE_KEY = Enum.KeyCode.RightControl
local _espStorage = {}

------------------------------------------------
-- 核心逻辑：透视系统 (保持 V15 的强大过滤)
------------------------------------------------
local function createESP(model, isPlayer)
    if not model then return end
    local root = model:WaitForChild("HumanoidRootPart", 5) or model:FindFirstChild("Head")
    if not root then return end

    local uiName = isPlayer and "PlayerESP_UI" or "MobESP_UI"
    if root:FindFirstChild(uiName) then return end

    local gui = Instance.new("BillboardGui", root)
    gui.Name = uiName
    gui.Size = UDim2.new(0, 100, 0, 40)
    gui.AlwaysOnTop = true
    gui.MaxDistance = 999999
    gui.ExtentsOffset = Vector3.new(0, 3, 0)
    table.insert(_espStorage, gui)

    local label = Instance.new("TextLabel", gui)
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = isPlayer and Color3.fromRGB(0, 255, 255) or Color3.fromRGB(255, 100, 0)
    label.TextStrokeTransparency = 0.5
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold

    task.spawn(function()
        local tag = isPlayer and "ESP_PLAYER_ENABLED" or "ESP_MOB_ENABLED"
        while getfenv()[tag] and model.Parent and root.Parent do
            local myRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
            if myRoot then
                local dist = (root.Position - myRoot.Position).Magnitude
                local name = isPlayer and (Players:GetPlayerFromCharacter(model) and Players:GetPlayerFromCharacter(model).DisplayName or model.Name) or model.Name
                label.Text = string.format("%s\n%dm", name, math.floor(dist))
            end
            task.wait(0.5)
        end
        if gui then gui:Destroy() end
    end)
end

