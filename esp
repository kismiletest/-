-- 功能按钮工厂函数
local function createButton(txt, color)
    local btn = Instance.new("TextButton", MainFrame)
    btn.Size = UDim2.new(0.9, 0, 0, 40)
    btn.BackgroundColor3 = color
    btn.Text = txt
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 14
    Instance.new("UICorner", btn)
    return btn
end

local EspBtn = createButton("真玩家透视: 关", Color3.fromRGB(160, 40, 40))
local FlyBtn = createButton("1.en Fly: 关", Color3.fromRGB(60, 60, 160))
local SpeedBtn = createButton("飞行速度: 1", Color3.fromRGB(100, 40, 160))

------------------------------------------------
-- 按钮交互
------------------------------------------------
-- 透视开关
EspBtn.MouseButton1Click:Connect(function()
    ESP_ENABLED = not ESP_ENABLED
    EspBtn.Text = ESP_ENABLED and "真玩家透视: 开" or "真玩家透视: 关"
    EspBtn.BackgroundColor3 = ESP_ENABLED and Color3.fromRGB(40, 160, 40) or Color3.fromRGB(160, 40, 40)
    if ESP_ENABLED then
        for _, p in pairs(Players:GetPlayers()) do applyESP(p) end
    else
        for _, v in pairs(_espStorage) do if v then v:Destroy() end end
        _espStorage = {}
    end
end)

-- 飞行开关
FlyBtn.MouseButton1Click:Connect(function()
    FLYING = not FLYING
    FlyBtn.Text = FLYING and "1.en Fly: 开" or "1.en Fly: 关"
    FlyBtn.BackgroundColor3 = FLYING and Color3.fromRGB(40, 160, 40) or Color3.fromRGB(60, 60, 160)
    if FLYING then startFly() end
end)

-- 速度调节
SpeedBtn.MouseButton1Click:Connect(function()
    flySpeed = flySpeed + 1
    if flySpeed > 5 then flySpeed = 1 end
    SpeedBtn.Text = "飞行速度: " .. flySpeed
end)

-- 隐藏/显示快捷键
UserInputService.InputBegan:Connect(function(i, p)
    if not p and i.KeyCode == TOGGLE_KEY then MainFrame.Visible = not MainFrame.Visible end
end)

Players.PlayerAdded:Connect(applyESP)
print("1.en Hub V14 集成版已加载！")
