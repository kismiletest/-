local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local localPlayer = Players.LocalPlayer

-- 状态控制
local ESP_ENABLED = false
local TOGGLE_KEY = Enum.KeyCode.RightControl
local _espStorage = {}

-- 核心参数：距离
local MAX_DISTANCE = 999999 -- 将距离设为几乎无限

------------------------------------------------
-- 逻辑：全图透视 (ESP)
------------------------------------------------
local function clearESP()
    for _, item in pairs(_espStorage) do
        if item and item.Parent then item:Destroy() end
    end
    _espStorage = {}
end

local function createESP(model)
    if not ESP_ENABLED or model == localPlayer.Character then return end
    
    -- 尝试寻找核心零件
    local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head") or model.PrimaryPart
    if root and not root:FindFirstChild("ESP_UI") then
        local isPlayer = Players:GetPlayerFromCharacter(model)
        
        local gui = Instance.new("BillboardGui", root)
        gui.Name = "ESP_UI"
        gui.Size = UDim2.new(0, 100, 0, 40)
        gui.AlwaysOnTop = true -- 确保穿墙可见
        gui.MaxDistance = MAX_DISTANCE -- 关键：设置 UI 最大可见距离
        gui.ExtentsOffset = Vector3.new(0, 3, 0)
        table.insert(_espStorage, gui)

        local label = Instance.new("TextLabel", gui)
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextColor3 = isPlayer and Color3.new(0, 1, 0) or Color3.new(1, 1, 1)
        label.TextStrokeTransparency = 0 -- 描边增加远距离辨识度
        label.TextScaled = true
        label.Font = Enum.Font.SourceSansBold

        task.spawn(function()
            while ESP_ENABLED and model.Parent and root.Parent do
                local myRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
                if myRoot then
                    local dist = (root.Position - myRoot.Position).Magnitude
                    label.Text = string.format("%s\n%dm", model.Name, math.floor(dist))
                end
                task.wait(0.5) -- 远距离刷新率无需太高，节省性能
            end
            if gui then gui:Destroy() end
        end)
    end
end

-- 全局扫描 (深度扫描)
local function refreshAll()
    if not ESP_ENABLED then return end
    -- 扫描 Players 里的所有玩家
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character then createESP(p.Character) end
    end
    -- 扫描 Workspace 里的所有模型 (包含怪物)
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Model") and v:FindFirstChildOfClass("Humanoid") then
            createESP(v)
        end
    end
end

