local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local localPlayer = Players.LocalPlayer

-- 状态控制
local ESP_ENABLED = false
local TOGGLE_KEY = Enum.KeyCode.RightControl
local _espStorage = {}

------------------------------------------------
-- 逻辑：深度玩家验证
------------------------------------------------
local function isRealPlayer(player)
    -- 验证是否为 Players 里的对象，且 UserId 正常（NPC 通常为负数或 0）
    if player:IsA("Player") and player.UserId > 0 then
        return true
    end
    return false
end

local function clearESP()
    for _, item in pairs(_espStorage) do
        if item and item.Parent then item:Destroy() end
    end
    _espStorage = {}
end

local function applyESP(player)
    -- 双重过滤：必须是真实玩家，且不是自己
    if not isRealPlayer(player) or player == localPlayer then return end

    local function createUI(character)
        if not character then return end
        local root = character:WaitForChild("HumanoidRootPart", 10)
        if not root then return end

        -- 彻底清理旧的标记
        for _, old in pairs(root:GetChildren()) do
            if old.Name == "PlayerESP_UI" then old:Destroy() end
        end

        local gui = Instance.new("BillboardGui")
        gui.Name = "PlayerESP_UI"
        gui.Parent = root
        gui.Size = UDim2.new(0, 100, 0, 40)
        gui.AlwaysOnTop = true
        gui.MaxDistance = 999999
        gui.ExtentsOffset = Vector3.new(0, 3, 0)
        table.insert(_espStorage, gui)

        local label = Instance.new("TextLabel", gui)
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.fromRGB(0, 255, 120) -- 亮绿色
        label.TextStrokeTransparency = 0
        label.TextScaled = true
        label.Font = Enum.Font.SourceSansBold

        task.spawn(function()
            while ESP_ENABLED and player.Parent and character.Parent and root.Parent do
                local myChar = localPlayer.Character
                if myChar and myChar:FindFirstChild("HumanoidRootPart") then
                    local dist = (root.Position - myChar.HumanoidRootPart.Position).Magnitude
                    label.Text = string.format("%s\n%dm", player.DisplayName or player.Name, math.floor(dist))
                end
                task.wait(0.5)
            end
            if gui then gui:Destroy() end
        end)
    end

    player.CharacterAdded:Connect(createUI)
    if player.Character then createUI(player.Character) end
end

