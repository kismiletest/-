------------------------------------------------
-- 事件绑定
------------------------------------------------
EspBtn.MouseButton1Click:Connect(function()
    ESP_ENABLED = not ESP_ENABLED
    EspBtn.Text = ESP_ENABLED and "ESP 透视: 开" or "ESP 透视: 关"
    EspBtn.BackgroundColor3 = ESP_ENABLED and Color3.fromRGB(40, 160, 40) or Color3.fromRGB(160, 40, 40)
    if ESP_ENABLED then for _,v in pairs(workspace:GetChildren()) do createESP(v) end else clearESP() end
end)

FlyBtn.MouseButton1Click:Connect(function()
    FLYING_ENABLED = not FLYING_ENABLED
    FlyBtn.Text = FLYING_ENABLED and "FlyV3 飞行: 开" or "FlyV3 飞行: 关"
    FlyBtn.BackgroundColor3 = FLYING_ENABLED and Color3.fromRGB(40, 160, 40) or Color3.fromRGB(160, 40, 40)
    if FLYING_ENABLED then startFlying() else stopFlying() end
end)

UserInputService.InputBegan:Connect(function(i, p)
    if not p and i.KeyCode == TOGGLE_KEY then
        MainFrame.Visible = not MainFrame.Visible
    end
end)

workspace.ChildAdded:Connect(createESP)
print("1.en Hub V6 已加载 - 原飞行脚本已移除，FlyGuiV3 逻辑已植入")
