local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local localPlayer = Players.LocalPlayer

-- 状态控制
local ESP_ENABLED = false
local TOGGLE_KEY = Enum.KeyCode.RightControl
local _espStorage = {}

-- 距离参数
local MAX_DISTANCE = 999999 

------------------------------------------------
-- 逻辑：纯玩家透视 (过滤 NPC)
------------------------------------------------
local function clearESP()
    for _, item in pairs(_espStorage) do
        if item and item.Parent then item:Destroy() end
    end
    _espStorage = {}
end

local function createPlayerESP(player)
    -- 核心过滤：只针对玩家，且不是自己
    if not ESP_ENABLED or player == localPlayer then return end

    local function apply(character)
        if not character then return end
        local root = character:WaitForChild("HumanoidRootPart", 10)
        if not root then return end

        -- 清除可能存在的旧 UI
        if root:FindFirstChild("PlayerESP_UI") then root["PlayerESP_UI"]:Destroy() end

        local gui = Instance.new("BillboardGui", root)
        gui.Name = "PlayerESP_UI"
        gui.Size = UDim2.new(0, 100, 0, 40)
        gui.AlwaysOnTop = true
        gui.MaxDistance = MAX_DISTANCE
        gui.ExtentsOffset = Vector3.new(0, 3, 0)
        table.insert(_espStorage, gui)

        local label = Instance.new("TextLabel", gui)
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.new(0, 1, 0) -- 玩家统一显示绿色
        label.TextStrokeTransparency = 0
        label.TextScaled = true
        label.Font = Enum.Font.SourceSansBold

        task.spawn(function()
            while ESP_ENABLED and player.Parent and character.Parent and root.Parent do
                local myRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
                if myRoot then
                    local dist = (root.Position - myRoot.Position).Magnitude
                    label.Text = string.format("%s\n%dm", player.Name, math.floor(dist))
                end
                task.wait(0.5)
            end
            if gui then gui:Destroy() end
        end)
    end

    player.CharacterAdded:Connect(apply)
    if player.Character then apply(player.Character) end
end

