local function CreateToggle(text, settingName)
    local Btn = Instance.new("TextButton", Container)
    Btn.Size = UDim2.new(0.9, 0, 0, 40)
    Btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    Btn.Text = text .. ": OFF"
    Btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    Btn.Font = Enum.Font.GothamSemibold
    Btn.TextSize = 14
    Btn.AutoButtonColor = true
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 8)

    Btn.MouseButton1Click:Connect(function()
        Settings[settingName] = not Settings[settingName]
        Btn.Text = text .. ": " .. (Settings[settingName] and "ON" or "OFF")
        
        -- 视觉反馈
        local targetColor = Settings[settingName] and Color3.fromRGB(0, 200, 150) or Color3.fromRGB(30, 30, 40)
        game:GetService("TweenService"):Create(Btn, TweenInfo.new(0.3), {BackgroundColor3 = targetColor}):Play()
        Btn.TextColor3 = Settings[settingName] and Color3.new(1, 1, 1) or Color3.fromRGB(200, 200, 200)
    end)
end

CreateToggle("启用全局 ESP", "ESP_Enabled")
