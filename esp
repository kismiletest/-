-- 漂亮按钮生成器
local function createStyledButton(txt, color)
    local btn = Instance.new("TextButton", MainFrame)
    btn.Size = UDim2.new(0.85, 0, 0, 35)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    btn.Text = txt
    btn.TextColor3 = Color3.new(0.8, 0.8, 0.8)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 13
    btn.AutoButtonColor = false
    
    local corner = Instance.new("UICorner", btn)
    corner.CornerRadius = UDim.new(0, 6)
    
    local stroke = Instance.new("UIStroke", btn)
    stroke.Thickness = 1.5
    stroke.Color = Color3.fromRGB(50, 50, 50)
    stroke.Transparency = 0.5

    -- 悬停动画
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(45, 45, 45)}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.3), {Color = color}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(30, 30, 30)}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.3), {Color = Color3.fromRGB(50, 50, 50)}):Play()
    end)
    
    return btn, stroke
end

local PlayerBtn, PlayerStroke = createStyledButton("PLAYER ESP", Color3.fromRGB(0, 255, 150))
local MobBtn, MobStroke = createStyledButton("MOB ESP", Color3.fromRGB(255, 80, 80))

------------------------------------------------
-- 交互逻辑
------------------------------------------------
PlayerBtn.MouseButton1Click:Connect(function()
    ESP_PLAYER_ENABLED = not ESP_PLAYER_ENABLED
    getfenv().ESP_PLAYER_ENABLED = ESP_PLAYER_ENABLED
    PlayerBtn.TextColor3 = ESP_PLAYER_ENABLED and Color3.new(1, 1, 1) or Color3.new(0.6, 0.6, 0.6)
    PlayerStroke.Color = ESP_PLAYER_ENABLED and Color3.fromRGB(0, 255, 150) or Color3.fromRGB(50, 50, 50)
    if ESP_PLAYER_ENABLED then
        for _, p in pairs(Players:GetPlayers()) do if p.Character then createESP(p.Character, true) end end
    end
end)

MobBtn.MouseButton1Click:Connect(function()
    ESP_MOB_ENABLED = not ESP_MOB_ENABLED
    getfenv().ESP_MOB_ENABLED = ESP_MOB_ENABLED
    MobBtn.TextColor3 = ESP_MOB_ENABLED and Color3.new(1, 1, 1) or Color3.new(0.6, 0.6, 0.6)
    MobStroke.Color = ESP_MOB_ENABLED and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(50, 50, 50)
    if ESP_MOB_ENABLED then
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Model") and v:FindFirstChildOfClass("Humanoid") and not Players:GetPlayerFromCharacter(v) then
                createESP(v, false)
            end
        end
    end
end)

-- 快捷键：隐藏面板
UserInputService.InputBegan:Connect(function(i, p)
    if not p and i.KeyCode == TOGGLE_KEY then
        MainFrame.Visible = not MainFrame.Visible
    end
end)

