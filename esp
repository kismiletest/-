-- 按钮创建器
local function MakeToggle(name, key)
    local btn = Instance.new("TextButton", Container)
    btn.Size = UDim2.new(1, 0, 0, 35)
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    btn.Text = name .. ": OFF"
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 12
    Instance.new("UICorner", btn)

    btn.MouseButton1Click:Connect(function()
        Settings[key] = not Settings[key]
        btn.Text = name .. ": " .. (Settings[key] and "ON" or "OFF")
        btn.BackgroundColor3 = Settings[key] and Color3.fromRGB(0, 150, 100) or Color3.fromRGB(40, 40, 40)
    end)
end

MakeToggle("透视总开关", "ESP")
MakeToggle("玩家透视", "Players")
MakeToggle("怪物透视", "Monsters")
MakeToggle("显示距离", "Dist")
MakeToggle("显示名称", "Names")

-- [[ ESP 系统 ]] --
local function UpdateESP(obj, color)
    local high = obj:FindFirstChild("High1en")
    if not high then
        high = Instance.new("Highlight")
        high.Name = "High1en"
        high.Parent = obj
    end
    high.FillColor = color
    high.Enabled = Settings.ESP
    high.FillTransparency = 0.5

    local tag = obj:FindFirstChild("Tag1en")
    if not tag then
        tag = Instance.new("BillboardGui")
        tag.Name = "Tag1en"
        tag.Size = UDim2.new(0, 100, 0, 40)
        tag.AlwaysOnTop = true
        tag.ExtentsOffset = Vector3.new(0, 3, 0)
        local l = Instance.new("TextLabel", tag)
        l.Size = UDim2.new(1, 0, 1, 0)
        l.BackgroundTransparency = 1
        l.Font = Enum.Font.GothamBold
        l.TextSize = 12
        tag.Parent = obj
    end
    
    local label = tag:FindFirstChildOfClass("TextLabel")
    label.TextColor3 = color
    label.Visible = Settings.ESP
    
    local dist = (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")) and 
        math.floor((LocalPlayer.Character.HumanoidRootPart.Position - obj.HumanoidRootPart.Position).Magnitude) or 0
    
    local str = ""
    if Settings.Names then str = obj.Name end
    if Settings.Dist then str = str .. " [" .. dist .. "]" end
    label.Text = str
end

RS.RenderStepped:Connect(function()
    -- 彩虹边框
    Stroke.Color = Color3.fromHSV(tick() % 5 / 5, 0.8, 1)
    
    if not Settings.ESP then
        -- 隐藏所有
        for _, v in pairs(workspace:GetDescendants()) do
            if v.Name == "High1en" or v.Name == "Tag1en" then v:Destroy() end
        end
        return 
    end

    for _, v in pairs(workspace:GetChildren()) do
        local isPlayer = Players:GetPlayerFromCharacter(v)
        local isMonster = v:FindFirstChild("Humanoid") and not isPlayer
        
        -- 过滤 NPC (跳过没有 HRP 的或者名字含 NPC 的)
        if isMonster and (v.Name:lower():find("npc") or not v:FindFirstChild("HumanoidRootPart")) then
            isMonster = false
        end

        if isPlayer and Settings.Players and v ~= LocalPlayer.Character and v:FindFirstChild("HumanoidRootPart") then
            UpdateESP(v, Color3.fromRGB(0, 255, 255))
        elseif isMonster and Settings.Monsters and v:FindFirstChild("HumanoidRootPart") then
            UpdateESP(v, Color3.fromRGB(255, 50, 50))
        else
            if v:FindFirstChild("High1en") then v.High1en:Destroy() end
            if v:FindFirstChild("Tag1en") then v.Tag1en:Destroy() end
        end
    end
end)

-- 快捷键：RightShift (考虑到部分执行器拦截了 Ctrl)
UIS.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.RightShift or input.KeyCode == Enum.KeyCode.RightControl then
        ScreenGui.Enabled = not ScreenGui.Enabled
    end
end)

print("1.en Hub 强力版已就绪 - 按右 Shift 或右 Ctrl 切换")
