-- =============================================
--  Roblox Luau 自动通关脚本 + WindUI
-- =============================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

-- ================== WindUI 加载 ==================
local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()

local Window = WindUI:CreateWindow({
    Title = "自动通关助手",
    Icon = "rocket",
    Theme = "Dark",        -- 可选: Dark / Light / Violet / Ocean 等
})

local MainTab = Window:Tab({
    Title = "主控制",
    Icon = "home"
})

local SettingsTab = Window:Tab({
    Title = "设置",
    Icon = "settings"
})
-- =============================================

-- ================== 配置区 ==================
local LEVELS_FOLDER_NAME = "Levels"   -- 修改成你游戏里的关卡文件夹名
local TELEPORT_OFFSET = Vector3.new(0, 5, 0)

local autoEnabled = false
local currentLevel = 1

local levelOrder = {
    "Level1", "Level2", "Level3", "Level4", "Level5", "Boss"
}
-- =============================================

local function findCurrentLevel()
    if not humanoidRootPart then return nil end
    local folder = Workspace:FindFirstChild(LEVELS_FOLDER_NAME)
    if not folder then return nil end

    for _, obj in ipairs(folder:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local dist = (obj:GetPivot().Position - humanoidRootPart.Position).Magnitude
            if dist < 60 then
                return obj.Name
            end
        end
    end
    return nil
end

local function teleportToLevel(levelName: string)
    local folder = Workspace:FindFirstChild(LEVELS_FOLDER_NAME)
    if not folder then return end

    local target = folder:FindFirstChild(levelName, true)
    if target then
        humanoidRootPart.CFrame = target:GetPivot() + TELEPORT_OFFSET
        WindUI:Notify({
            Title = "传送成功",
            Content = "已传送到 " .. levelName,
            Duration = 3
        })
    else
        WindUI:Notify({
            Title = "传送失败",
            Content = "未找到关卡: " .. levelName,
            Duration = 4
        })
    end
end

-- ================== UI 控件 ==================
MainTab:Toggle({
    Title = "启用自动通关",
    Default = false,
    Callback = function(value)
        autoEnabled = value
        if value then
            WindUI:Notify({Title = "自动模式", Content = "已开启，正在检测关卡...", Duration = 3})
        end
    end
})

MainTab:Button({
    Title = "立即传送到下一个关卡",
    Callback = function()
        local current = findCurrentLevel()
        if current then
            local nextLevel = nil
            for i, lvl in ipairs(levelOrder) do
                if lvl == current then
                    nextLevel = levelOrder[i + 1]
                    break
                end
            end
            if not nextLevel then
                nextLevel = tonumber(current:match("%d+")) and "Level_" .. (tonumber(current:match("%d+")) + 1) or "NextLevel"
            end
            teleportToLevel(nextLevel or "Level1")
        else
            WindUI:Notify({Title = "错误", Content = "未检测到当前关卡位置", Duration = 3})
        end
    end
})

MainTab:Slider({
    Title = "传送偏移高度 (Y轴)",
    Min = 0,
    Max = 20,
    Default = 5,
    Callback = function(value)
        TELEPORT_OFFSET = Vector3.new(0, value, 0)
    end
})

SettingsTab:Textbox({
    Title = "关卡文件夹名称",
    Default = LEVELS_FOLDER_NAME,
    Callback = function(text)
        LEVELS_FOLDER_NAME = text
        WindUI:Notify({Title = "设置更新", Content = "关卡文件夹已改为: " .. text, Duration = 3})
    end
})

SettingsTab:Button({
    Title = "重置所有设置",
    Callback = function()
        autoEnabled = false
        LEVELS_FOLDER_NAME = "Levels"
        WindUI:Notify({Title = "已重置", Content = "所有设置已恢复默认", Duration = 3})
    end
})

-- ================== 自动循环 ==================
task.spawn(function()
    while true do
        RunService.Heartbeat:Wait()
        
        if autoEnabled and humanoidRootPart then
            local current = findCurrentLevel()
            if current then
                -- 查找下一个关卡
                local nextLevel = nil
                for i, lvl in ipairs(levelOrder) do
                    if lvl == current then
                        nextLevel = levelOrder[i + 1]
                        break
                    end
                end
                
                if nextLevel then
                    teleportToLevel(nextLevel)
                    task.wait(2)  -- 防止刷屏传送
                end
            end
        end
        
        task.wait(0.8)
    end
end)

-- 角色重生处理
player.CharacterAdded:Connect(function(newChar)
    character = newChar
    humanoidRootPart = newChar:WaitForChild("HumanoidRootPart")
end)

print("🚀 自动通关脚本 + WindUI 已成功加载！")
WindUI:Notify({
    Title = "欢迎使用",
    Content = "自动通关助手已准备就绪",
    Duration = 5
})
