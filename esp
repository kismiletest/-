local Players = game:GetService("Players")
local player = Players.LocalPlayer

print("ESP 启动成功")

------------------------------------------------
-- 创建UI
------------------------------------------------

local function createBillboard(root, color)

	local gui = Instance.new("BillboardGui")
	gui.Name = "ESP_UI"
	gui.Size = UDim2.new(0,200,0,50)
	gui.StudsOffset = Vector3.new(0,2,0)
	gui.AlwaysOnTop = true -- 提高可见性
	gui.MaxDistance = 1000
	gui.Parent = root

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1,0,1,0)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = Enum.Font.SourceSansBold
	label.TextStrokeTransparency = 0
	label.TextColor3 = color
	label.Parent = gui

	return label
end

------------------------------------------------
-- 获取Root（通用）
------------------------------------------------

local function getRoot(model)
	return model:FindFirstChild("HumanoidRootPart")
		or model:FindFirstChild("Torso")
		or model:FindFirstChild("UpperTorso")
		or model.PrimaryPart
end

------------------------------------------------
-- 玩家ESP
------------------------------------------------

local function addPlayerESP(p)

	if p == player then return end

	local function apply(char)

		local root = getRoot(char)
		if not root then return end

		if root:FindFirstChild("ESP_UI") then return end

		local label = createBillboard(root, Color3.fromRGB(0,255,0))

		task.spawn(function()
			while char.Parent do

				local myChar = player.Character
				if myChar and getRoot(myChar) then

					local dist =
						(root.Position -
						getRoot(myChar).Position).Magnitude

					label.Text =
						p.Name ..
						"\n" .. math.floor(dist) .. "m"

				end

				task.wait(0.2)
			end
		end)

	end

	if p.Character then
		apply(p.Character)
	end

	p.CharacterAdded:Connect(function(char)
		task.wait(1)
		apply(char)
	end)

end

------------------------------------------------
-- 怪物ESP（高兼容）
------------------------------------------------

local function addMonsterESP(obj)

	if not obj:IsA("Model") then return end

	-- 排除玩家
	if Players:GetPlayerFromCharacter(obj) then return end

	local root = getRoot(obj)
	if not root then return end

	if root:FindFirstChild("ESP_UI") then return end

	local label = createBillboard(root, Color3.fromRGB(255,0,0))

	task.spawn(function()
		while obj.Parent do

			local myChar = player.Character
			if myChar and getRoot(myChar) then

				local dist =
					(root.Position -
					getRoot(myChar).Position).Magnitude

				label.Text =
					obj.Name ..
					"\n" .. math.floor(dist) .. "m"

			end

			task.wait(0.3)
		end
	end)

end

------------------------------------------------
-- 玩家加载
------------------------------------------------

for _,p in pairs(Players:GetPlayers()) do
	addPlayerESP(p)
end

Players.PlayerAdded:Connect(addPlayerESP)

------------------------------------------------
-- 怪物循环扫描（核心）
------------------------------------------------

task.spawn(function()
	while true do

		for _,obj in pairs(workspace:GetDescendants()) do
			addMonsterESP(obj)
		end

		task.wait(2) -- 每2秒扫描一次
	end
end)
