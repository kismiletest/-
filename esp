-- [[ 1.en Hub - 核心功能强制版 ]] --

local Players = game:GetService("Players")
local RS = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- 尝试在不同的地方创建 UI，直到成功为止
local UI_Container = nil
pcall(function() UI_Container = gethui() end)
if not UI_Container then pcall(function() UI_Container = game:GetService("CoreGui") end) end
if not UI_Container then UI_Container = LocalPlayer:WaitForChild("PlayerGui") end

-- 状态
_G.ESP_Active = false
_G.Show_Players = false
_G.Show_Monsters = false

-- [[ 极简 UI 按钮 ]] --
local Folder = Instance.new("ScreenGui", UI_Container)
Folder.Name = "OneEnHub_Simple"

local function CreateMiniBtn(name, pos, callback)
    local btn = Instance.new("TextButton", Folder)
    btn.Size = UDim2.new(0, 100, 0, 30)
    btn.Position = pos
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    btn.Text = name .. ": OFF"
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.SourceSansBold
    btn.BorderSizePixel = 2
    btn.BorderColor3 = Color3.fromRGB(0, 255, 255)
    btn.ZIndex = 10
    
    btn.MouseButton1Click:Connect(function()
        local state = callback()
        btn.Text = name .. ": " .. (state and "ON" or "OFF")
        btn.BackgroundColor3 = state and Color3.fromRGB(0, 100, 0) or Color3.fromRGB(30, 30, 30)
    end)
    return btn
end

-- 创建控制按钮（位于左上角）
CreateMiniBtn("总开关", UDim2.new(0, 10, 0, 50), function() _G.ESP_Active = not _G.ESP_Active return _G.ESP_Active end)
CreateMiniBtn("透视玩家", UDim2.new(0, 10, 0, 90), function() _G.Show_Players = not _G.Show_Players return _G.Show_Players end)
CreateMiniBtn("透视怪物", UDim2.new(0, 10, 0, 130), function() _G.Show_Monsters = not _G.Show_Monsters return _G.Show_Monsters end)

-- [[ ESP 渲染代码 ]] --
RS.RenderStepped:Connect(function()
    if not _G.ESP_Active then
        for _, v in pairs(workspace:GetDescendants()) do
            if v.Name == "1en_ESP" then v:Destroy() end
        end
        return
    end

    for _, v in pairs(workspace:GetChildren()) do
        local isPlayer = Players:GetPlayerFromCharacter(v)
        local isMonster = v:FindFirstChild("Humanoid") and not isPlayer
        
        -- 过滤 NPC
        if isMonster and (v.Name:lower():find("npc") or v.Name:lower():find("quest")) then
            isMonster = false
        end

        local show = false
        local color = Color3.new(1, 1, 1)

        if isPlayer and _G.Show_Players and v ~= LocalPlayer.Character then
            show = true; color = Color3.fromRGB(0, 200, 255)
        elseif isMonster and _G.Show_Monsters then
            show = true; color = Color3.fromRGB(255, 50, 50)
        end

        if show and v:FindFirstChild("HumanoidRootPart") then
            -- 绘制名字标签
            local tag = v:FindFirstChild("1en_ESP")
            if not tag then
                tag = Instance.new("BillboardGui", v)
                tag.Name = "1en_ESP"
                tag.Size = UDim2.new(0, 100, 0, 30)
                tag.AlwaysOnTop = true
                tag.ExtentsOffset = Vector3.new(0, 3, 0)
                local l = Instance.new("TextLabel", tag)
                l.Size = UDim2.new(1, 0, 1, 0)
                l.BackgroundTransparency = 1
                l.Font = Enum.Font.SourceSansBold
                l.TextSize = 14
            end
            local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - v.HumanoidRootPart.Position).Magnitude)
            tag.TextLabel.Text = v.Name .. " [" .. dist .. "m]"
            tag.TextLabel.TextColor3 = color
        else
            if v:FindFirstChild("1en_ESP") then v["1en_ESP"]:Destroy() end
        end
    end
end)

print("1.en Hub Simple Loaded. Look at the left top corner.")
