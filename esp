------------------------------------------------
-- 绑定
------------------------------------------------
EspBtn.MouseButton1Click:Connect(function()
    ESP_ENABLED = not ESP_ENABLED
    EspBtn.Text = ESP_ENABLED and "全图透视: 开" or "全图透视: 关"
    EspBtn.BackgroundColor3 = ESP_ENABLED and Color3.fromRGB(40, 160, 40) or Color3.fromRGB(160, 40, 40)
    if ESP_ENABLED then refreshAll() else clearESP() end
end)

UserInputService.InputBegan:Connect(function(i, p)
    if not p and i.KeyCode == TOGGLE_KEY then
        MainFrame.Visible = not MainFrame.Visible
    end
end)

-- 持续监听新怪物/玩家生成
workspace.DescendantAdded:Connect(function(v)
    if ESP_ENABLED then
        task.wait(0.5) -- 等待模型完全加载
        if v:IsA("Model") and v:FindFirstChildOfClass("Humanoid") then
            createESP(v)
        end
    end
end)

print("1.en Hub V11 加载成功！已开启无限距离透视。")
