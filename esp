-- 全局变量
local ESP_PLAYER_ENABLED = false
local ESP_MOB_ENABLED = false
local TOGGLE_KEY = Enum.KeyCode.RightControl
local _espStorage = {}

------------------------------------------------
-- 核心逻辑：极简+精准过滤
------------------------------------------------
local function isRealMonster(model)
    if Players:GetPlayerFromCharacter(model) then return false end -- 排除玩家
    
    local name = model.Name:lower()
    local hum = model:FindFirstChildOfClass("Humanoid")
    
    -- 1. 名字关键词黑名单 (如果包含这些，绝对是NPC)
    local npcNames = {"shop", "merchant", "guide", "quest", "npc", "bank", "worker", "job", "owner", "teleport", "dummy"}
    for _, word in pairs(npcNames) do
        if name:find(word) then return false end
    end
    
    -- 2. 行为特征过滤
    if hum then
        -- 如果怪物的血量被设为 0 或者没有最大血量，通常是装饰品
        if hum.MaxHealth <= 0 then return false end
        -- 许多NPC被设为 100 且无法受伤，而怪物通常会走动 (这里只做基础判断)
    else
        return false -- 没有 Humanoid 的模型不标记
    end
    
    return true
end

local function createESP(model, isPlayer)
    if not model then return end
    if isPlayer and model == localPlayer.Character then return end -- 排除自己
    if not isPlayer and not isRealMonster(model) then return end -- 核心过滤：NPC拦截

    local root = model:WaitForChild("HumanoidRootPart", 5) or model:FindFirstChild("Head")
    if not root then return end

    local uiName = isPlayer and "P_ESP" or "M_ESP"
    if root:FindFirstChild(uiName) then return end

    local gui = Instance.new("BillboardGui", root)
    gui.Name = uiName
    gui.Size = UDim2.new(0, 100, 0, 40)
    gui.AlwaysOnTop = true
    gui.MaxDistance = 9999
    gui.ExtentsOffset = Vector3.new(0, 3, 0)
    table.insert(_espStorage, gui)

    local label = Instance.new("TextLabel", gui)
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = isPlayer and Color3.fromRGB(0, 255, 255) or Color3.fromRGB(255, 40, 40)
    label.TextStrokeTransparency = 0.2
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold

    task.spawn(function()
        while model.Parent and root.Parent do
            local active = isPlayer and ESP_PLAYER_ENABLED or ESP_MOB_ENABLED
            label.Visible = active
            
            if active and localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local dist = (root.Position - localPlayer.Character.HumanoidRootPart.Position).Magnitude
                label.Text = string.format("%s\n%dm", model.Name, math.floor(dist))
            end
            task.wait(0.5)
        end
        gui:Destroy()
    end)
end

