-- ==================== 自瞄核心逻辑 ====================
local function getClosestTarget()
    local closest = nil
    local shortest = math.huge
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") then
            local hum = player.Character.Humanoid
            if hum.Health > 0 and (not TEAM_CHECK or player.Team ~= LocalPlayer.Team) then
                local part = player.Character:FindFirstChild(aimPart) or player.Character:FindFirstChild("HumanoidRootPart")
                if part then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
                        if dist < FOV and dist < shortest then
                            shortest = dist
                            closest = part
                        end
                    end
                end
            end
        end
    end
    return closest
end

-- Hook (静默自瞄)
local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if aimEnabled and target and (method == "Fire" or method == "FireServer") then
        if string.find(self.Name:lower(), "fire") or string.find(self.Name:lower(), "shoot") or self.Parent.Name:find("Gun") then
            if args[1] and typeof(args[1]) == "Vector3" then
                args[1] = target.Position + (target.Velocity * 0.04)  -- 轻微预判
            end
        end
    end
    return oldNamecall(self, unpack(args))
end)

setreadonly(mt, true)

-- 更新目标
RunService.Heartbeat:Connect(function()
    target = aimEnabled and getClosestTarget() or nil
end)

-- ==================== UI 交互 ====================
local function updateUI()
    ToggleBtn.Text = "自瞄状态: " .. (aimEnabled and "已开启" or "已关闭")
    ToggleBtn.BackgroundColor3 = aimEnabled and Color3.fromRGB(0, 170, 80) or Color3.fromRGB(45, 45, 45)
end

ToggleBtn.MouseButton1Click:Connect(function()
    aimEnabled = not aimEnabled
    updateUI()
end)

PartBtn.MouseButton1Click:Connect(function()
    if aimPart == "Head" then
        aimPart = "UpperTorso"
        PartBtn.Text = "UpperTorso"
    else
        aimPart = "Head"
        PartBtn.Text = "Head"
    end
end)

CloseBtn.MouseButton1Click:Connect(function()
    ScreenGui.Enabled = false
end)

-- 快捷键
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        ScreenGui.Enabled = not ScreenGui.Enabled
    elseif input.KeyCode == Enum.KeyCode.E then
        aimEnabled = not aimEnabled
        updateUI()
    elseif input.KeyCode == Enum.KeyCode.F then
        if aimPart == "Head" then
            aimPart = "UpperTorso"
        else
            aimPart = "Head"
        end
        PartBtn.Text = aimPart
    end
end)

updateUI()
print("WinUI 静默自瞄已加载！按 RightShift 打开菜单")
