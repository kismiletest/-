local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local localPlayer = Players.LocalPlayer

-- 状态控制
local ESP_ENABLED = false
local TOGGLE_KEY = Enum.KeyCode.RightControl

------------------------------------------------
-- 逻辑：最稳定的 Highlight 透视
------------------------------------------------
local function applyESP(player)
    if player == localPlayer then return end

    local function setupHighlight(character)
        if not character then return end
        
        -- 删除旧的透视防止重叠
        local old = character:FindFirstChild("1en_ESP")
        if old then old:Destroy() end

        -- 创建新的高亮组件
        local highlight = Instance.new("Highlight")
        highlight.Name = "1en_ESP"
        highlight.Parent = character
        highlight.FillColor = player.TeamColor.Color or Color3.new(1, 0, 0) -- 队友颜色或红色
        highlight.FillTransparency = 0.5
        highlight.OutlineColor = Color3.new(1, 1, 1)
        highlight.OutlineTransparency = 0
        highlight.Enabled = ESP_ENABLED
    end

    -- 监听角色生成
    player.CharacterAdded:Connect(setupHighlight)
    if player.Character then setupHighlight(player.Character) end
end

local function toggleAllESP(state)
    ESP_ENABLED = state
    for _, player in pairs(Players:GetPlayers()) do
        if player.Character then
            local hl = player.Character:FindFirstChild("1en_ESP")
            if hl then
                hl.Enabled = state
            elseif state then
                applyESP(player) -- 如果没有则创建
            end
        end
    end
end

