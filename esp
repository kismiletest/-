-- 核心功能：世界清晰 (Full Bright)
------------------------------------------------
local function toggleFullBright()
    if BRIGHT_ENABLED then
        -- 强制明亮逻辑
        RunService:BindToRenderStep("FullBright", 1, function()
            Lighting.Brightness = 2
            Lighting.ClockTime = 14
            Lighting.FogEnd = 100000
            Lighting.GlobalShadows = false
            Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        end)
    else
        -- 恢复原始状态
        RunService:UnbindFromRenderStep("FullBright")
        Lighting.Brightness = originalSettings.Brightness
        Lighting.ClockTime = originalSettings.ClockTime
        Lighting.FogEnd = originalSettings.FogEnd
        Lighting.GlobalShadows = originalSettings.GlobalShadows
        Lighting.Ambient = originalSettings.Ambient
    end
end

------------------------------------------------
-- 核心功能：精准透视 (玩家 & 怪物)
------------------------------------------------
local function isRealMonster(model)
    if Players:GetPlayerFromCharacter(model) then return false end
    local name = model.Name:lower()
    local npcNames = {"shop", "merchant", "guide", "quest", "npc", "bank", "worker", "job", "owner", "teleport", "dummy"}
    for _, word in pairs(npcNames) do if name:find(word) then return false end end
    local hum = model:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.MaxHealth > 0
end

local function createESP(model, isPlayer)
    if not model or (isPlayer and model == localPlayer.Character) then return end
    if not isPlayer and not isRealMonster(model) then return end

    local root = model:WaitForChild("HumanoidRootPart", 5) or model:FindFirstChild("Head")
    if not root then return end

    local uiName = isPlayer and "P_ESP" or "M_ESP"
    if root:FindFirstChild(uiName) then return end

    local gui = Instance.new("BillboardGui", root)
    gui.Name = uiName; gui.Size = UDim2.new(0, 100, 0, 40); gui.AlwaysOnTop = true; gui.MaxDistance = 9999; gui.ExtentsOffset = Vector3.new(0, 3, 0)
    table.insert(_espStorage, gui)

    local label = Instance.new("TextLabel", gui)
    label.Size = UDim2.new(1, 0, 1, 0); label.BackgroundTransparency = 1; label.TextStrokeTransparency = 0.2; label.TextScaled = true; label.Font = Enum.Font.GothamBold
    label.TextColor3 = isPlayer and Color3.fromRGB(0, 255, 255) or Color3.fromRGB(255, 40, 40)

    task.spawn(function()
        while model.Parent and root.Parent do
            local active = isPlayer and ESP_PLAYER_ENABLED or ESP_MOB_ENABLED
            label.Visible = active
            if active and localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local dist = (root.Position - localPlayer.Character.HumanoidRootPart.Position).Magnitude
                label.Text = string.format("%s\n%dm", model.Name, math.floor(dist))
            end
            task.wait(0.5)
        end
        gui:Destroy()
    end)
end

