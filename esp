--========== 设置 =========--
local ESP_ENABLED = true
local SHOW_NAME = true
local SHOW_DISTANCE = true
local SHOW_HEALTH = true
local SHOW_TRACER = true

--========== 服务 =========--
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

local ESP_CACHE = {}

--========== 清理 =========--
local function clearESP(player)
    if ESP_CACHE[player] then
        for _, v in pairs(ESP_CACHE[player]) do
            if typeof(v) == "RBXScriptConnection" then
                v:Disconnect()
            elseif typeof(v) == "Instance" then
                v:Destroy()
            elseif typeof(v) == "table" and v.Remove then
                v:Remove()
            end
        end
        ESP_CACHE[player] = nil
    end
end

--========== 创建ESP =========--
local function createESP(player)
    if player == LocalPlayer then return end
    if not player.Character then return end
    if not player.Character:FindFirstChild("Head") then return end

    clearESP(player)
    ESP_CACHE[player] = {}

    local head = player.Character.Head

    -- Billboard
    local gui = Instance.new("BillboardGui")
    gui.Name = "ESP"
    gui.Adornee = head
    gui.Size = UDim2.new(0, 140, 0, 50)
    gui.StudsOffset = Vector3.new(0, 3.5, 0)
    gui.AlwaysOnTop = true
    gui.Parent = head

    local label = Instance.new("TextLabel", gui)
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 1, 0)
    label.TextColor3 = Color3.new(1,1,1)
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold

    -- Tracer
    local tracer
    if SHOW_TRACER then
        tracer = Drawing.new("Line")
        tracer.Thickness = 2
        tracer.Color = Color3.fromRGB(255,0,0)
        tracer.Transparency = 0.8
        tracer.Visible = false
    end

    -- 更新
    local conn = RunService.RenderStepped:Connect(function()
        if not ESP_ENABLED then
            gui.Enabled = false
            if tracer then tracer.Visible = false end
            return
        end

        if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
            clearESP(player)
            return
        end

        gui.Enabled = true
        local hrp = player.Character.HumanoidRootPart
        local hum = player.Character:FindFirstChildOfClass("Humanoid")

        local text = ""

        if SHOW_NAME then
            text ..= player.Name
        end

        if SHOW_DISTANCE and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude
            text ..= string.format("\n%.0f m", dist)
        end

        if SHOW_HEALTH and hum then
            text ..= string.format("\nHP: %d", hum.Health)
        end

        label.Text = text

        -- Tracer 更新
        if tracer then
            local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            if onScreen then
                tracer.Visible = true
                tracer.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                tracer.To = Vector2.new(screenPos.X, screenPos.Y)
            else
                tracer.Visible = false
            end
        end
    end)

    ESP_CACHE[player] = {gui, tracer, conn}
end

--========== 玩家管理 =========--
local function loadPlayer(player)
    player.CharacterAdded:Connect(function()
        task.wait(1)
        createESP(player)
    end)
    if player.Character then
        task.wait(1)
        createESP(player)
    end
end

for _, p in pairs(Players:GetPlayers()) do
    loadPlayer(p)
end

Players.PlayerAdded:Connect(loadPlayer)
Players.PlayerRemoving:Connect(clearESP)

--========== 键盘开关（V） =========--
game:GetService("UserInputService").InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.V then
        ESP_ENABLED = not ESP_ENABLED
        warn("👁️ ESP:", ESP_ENABLED and "开启" or "关闭")
    end
end)
