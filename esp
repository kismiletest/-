-- 漂亮按钮生成器
local function createButton(txt, activeColor)
    local btn = Instance.new("TextButton", MainFrame)
    btn.Size = UDim2.new(0.85, 0, 0, 35)
    btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    btn.Text = txt
    btn.TextColor3 = Color3.new(0.6, 0.6, 0.6)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 12
    btn.AutoButtonColor = false
    
    local s = Instance.new("UIStroke", btn)
    s.Thickness = 1.2; s.Color = Color3.fromRGB(60, 60, 60); s.Transparency = 0.5
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    -- 点击动画效果
    btn.MouseButton1Down:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.1), {Size = UDim2.new(0.8, 0, 0, 32)}):Play()
    end)
    btn.MouseButton1Up:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.1), {Size = UDim2.new(0.85, 0, 0, 35)}):Play()
    end)

    return btn, s
end

local PBtn, PS = createButton("真玩家透视: 关", Color3.fromRGB(0, 255, 255))
local MBtn, MS = createButton("真怪物透视: 关", Color3.fromRGB(255, 50, 50))

------------------------------------------------
-- 【5. 交互绑定】
------------------------------------------------
PBtn.MouseButton1Click:Connect(function()
    ESP_PLAYER_ENABLED = not ESP_PLAYER_ENABLED
    PBtn.Text = ESP_PLAYER_ENABLED and "真玩家透视: 开" or "真玩家透视: 关"
    PBtn.TextColor3 = ESP_PLAYER_ENABLED and Color3.new(1,1,1) or Color3.new(0.6,0.6,0.6)
    PS.Color = ESP_PLAYER_ENABLED and Color3.fromRGB(0, 255, 255) or Color3.fromRGB(60,60,60)
    PS.Thickness = ESP_PLAYER_ENABLED and 2 or 1.2
    if ESP_PLAYER_ENABLED then
        for _, p in pairs(Players:GetPlayers()) do if p.Character then createESP(p.Character, true) end end
    end
end)

MBtn.MouseButton1Click:Connect(function()
    ESP_MOB_ENABLED = not ESP_MOB_ENABLED
    MBtn.Text = ESP_MOB_ENABLED and "真怪物透视: 开" or "真怪物透视: 关"
    MBtn.TextColor3 = ESP_MOB_ENABLED and Color3.new(1,1,1) or Color3.new(0.6,0.6,0.6)
    MS.Color = ESP_MOB_ENABLED and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(60,60,60)
    MS.Thickness = ESP_MOB_ENABLED and 2 or 1.2
    if ESP_MOB_ENABLED then
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Model") and v:FindFirstChildOfClass("Humanoid") then createESP(v, false) end
        end
    end
end)

-- 面板显隐
UserInputService.InputBegan:Connect(function(i, g)
    if not g and i.KeyCode == TOGGLE_KEY then MainFrame.Visible = not MainFrame.Visible end
end)

-- 实时更新监听
workspace.DescendantAdded:Connect(function(v)
    if v:IsA("Model") then
        task.wait(0.5)
        local p = Players:GetPlayerFromCharacter(v)
        createESP(v, p ~= nil)
    end
end)

