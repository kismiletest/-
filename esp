ScreenGui.Name = "1enHub_V4"
ScreenGui.ResetOnSpawn = false

local MainFrame = Instance.new("Frame", ScreenGui)
MainFrame.Size = UDim2.new(0, 180, 0, 190)
MainFrame.Position = UDim2.new(0.1, 0, 0.1, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
MainFrame.Active = true
MainFrame.Draggable = true

Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 10)

-- 标题
local Title = Instance.new("TextLabel", MainFrame)
Title.Size = UDim2.new(1, 0, 0, 35)
Title.Text = "1.en Hub V4"
Title.TextColor3 = Color3.new(1, 1, 1)
Title.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
Title.Font = Enum.Font.SourceSansBold
Title.TextSize = 18
Instance.new("UICorner", Title)

-- 布局容器
local Container = Instance.new("Frame", MainFrame)
Container.Size = UDim2.new(1, 0, 1, -40)
Container.Position = UDim2.new(0, 0, 0, 40)
Container.BackgroundTransparency = 1

local Layout = Instance.new("UIListLayout", Container)
Layout.Padding = UDim.new(0, 10)
Layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

-- 按钮创建
local function makeBtn(txt)
    local b = Instance.new("TextButton", Container)
    b.Size = UDim2.new(0.85, 0, 0, 40)
    b.BackgroundColor3 = Color3.fromRGB(160, 40, 40)
    b.Text = txt .. ": 关"
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.SourceSansBold
    b.TextSize = 15
    Instance.new("UICorner", b)
    return b
end

local EspBtn = makeBtn("透视显示")
local FlyBtn = makeBtn("飞行脚本")

local Hint = Instance.new("TextLabel", Container)
Hint.Size = UDim2.new(1, 0, 0, 20)
Hint.Text = "右Ctrl 隐藏面板"
Hint.TextColor3 = Color3.new(0.7, 0.7, 0.7)
Hint.BackgroundTransparency = 1
Hint.TextSize = 11

------------------------------------------------
-- 交互绑定
------------------------------------------------
EspBtn.MouseButton1Click:Connect(function()
    ESP_ENABLED = not ESP_ENABLED
    if ESP_ENABLED then
        EspBtn.Text = "透视显示: 开"
        EspBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 40)
        for _, v in pairs(workspace:GetChildren()) do createESP(v) end
    else
        EspBtn.Text = "透视显示: 关"
        EspBtn.BackgroundColor3 = Color3.fromRGB(160, 40, 40)
        clearESP()
    end
end)

FlyBtn.MouseButton1Click:Connect(function()
    FLYING_ENABLED = not FLYING_ENABLED
    if FLYING_ENABLED then
        FlyBtn.Text = "飞行脚本: 开"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 40)
        startFlying()
    else
        FlyBtn.Text = "飞行脚本: 关"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(160, 40, 40)
        stopFlying()
    end
end)

UserInputService.InputBegan:Connect(function(i, p)
    if not p and i.KeyCode == TOGGLE_KEY then
        PANEL_VISIBLE = not PANEL_VISIBLE
        MainFrame.Visible = PANEL_VISIBLE
    end
end)

workspace.ChildAdded:Connect(createESP)
print("1.en Hub V4 加载完毕：按右侧Ctrl隐藏")
