local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local localPlayer = Players.LocalPlayer

-- 状态控制
local ESP_ENABLED = false
local _storage = {} -- 用于记录创建的物体，方便一键删除

------------------------------------------------
-- 核心透视逻辑
------------------------------------------------

-- 清除所有透视
local function clearESP()
    for _, item in pairs(_storage) do
        if item then item:Destroy() end
    end
    _storage = {}
end

-- 为单个模型创建透视
local function createESP(model)
    if not ESP_ENABLED then return end
    local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    if not root then return end

    local isPlayer = Players:GetPlayerFromCharacter(model)
    local color = isPlayer and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)

    -- 文字 UI
    local gui = Instance.new("BillboardGui")
    gui.Name = "ESP_UI"
    gui.Size = UDim2.new(0, 100, 0, 40)
    gui.AlwaysOnTop = true
    gui.ExtentsOffset = Vector3.new(0, 3, 0)
    gui.Adornee = root
    gui.Parent = root
    table.insert(_storage, gui)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = color
    label.TextStrokeTransparency = 0
    label.TextScaled = true
    label.Font = Enum.Font.SourceSansBold
    label.Parent = gui

    -- 动态刷新
    task.spawn(function()
        while ESP_ENABLED and model.Parent and root.Parent do
            if localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local dist = (root.Position - localPlayer.Character.HumanoidRootPart.Position).Magnitude
                label.Text = string.format("%s\n%dm", model.Name, math.floor(dist))
            end
            task.wait(0.2)
        end
        gui:Destroy()
    end)
end

-- 全局扫描
local function refreshESP()
    if not ESP_ENABLED then 
        clearESP()
        return 
    end
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= localPlayer.Character then
            if obj:FindFirstChildOfClass("Humanoid") then
                createESP(obj)
            end
        end
    end
end

------------------------------------------------
-- UI 面板创建
------------------------------------------------

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "ControlPanel"
ScreenGui.ResetOnSpawn = false
-- 尝试放入 PlayerGui，如果是在 Executor 运行，建议放入 CoreGui
ScreenGui.Parent = localPlayer:WaitForChild("PlayerGui")

local Frame = Instance.new("Frame")
Frame.Size = UDim2.new(0, 150, 0, 100)
Frame.Position = UDim2.new(0.1, 0, 0.1, 0)
Frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
Frame.BorderSizePixel = 2
Frame.Active = true
Frame.Draggable = true -- 允许鼠标拖动面板
Frame.Parent = ScreenGui

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 30)
Title.Text = "1.en Hub"
Title.TextColor3 = Color3.new(1, 1, 1)
Title.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
Title.Parent = Frame

local ToggleBtn = Instance.new("TextButton")
ToggleBtn.Size = UDim2.new(0.8, 0, 0, 40)
ToggleBtn.Position = UDim2.new(0.1, 0, 0.45, 0)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
ToggleBtn.Text = "透视: 关闭"
ToggleBtn.TextColor3 = Color3.new(1, 1, 1)
ToggleBtn.Font = Enum.Font.SourceSansBold
ToggleBtn.TextSize = 18
ToggleBtn.Parent = Frame

-- 按钮逻辑
ToggleBtn.MouseButton1Click:Connect(function()
    ESP_ENABLED = not ESP_ENABLED
    
    if ESP_ENABLED then
        ToggleBtn.Text = "透视: 开逼"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        refreshESP()
    else
        ToggleBtn.Text = "透视: 关逼"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        clearESP()
    end
end)

-- 监听新生成的怪物 (当开启时有效)
workspace.DescendantAdded:Connect(function(obj)
    if ESP_ENABLED then
        task.wait(0.5)
        if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
            createESP(obj)
        end
    end
end)

print("UI 面板已加载，左上角点击切换")
