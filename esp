local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local localPlayer = Players.LocalPlayer

-- 【1. 安全清理】防止重复加载卡死
local old = localPlayer.PlayerGui:FindFirstChild("1enHub_V19")
if old then old:Destroy() end

-- 【2. 全局配置】
local ESP_PLAYER_ENABLED = false
local ESP_MOB_ENABLED = false
local TOGGLE_KEY = Enum.KeyCode.RightControl
local _espStorage = {}

------------------------------------------------
-- 【3. 核心逻辑：精准过滤透视】
------------------------------------------------
local function isMonster(model)
    if Players:GetPlayerFromCharacter(model) then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.MaxHealth <= 0 then return false end
    
    -- NPC 黑名单过滤
    local n = model.Name:lower()
    local ignore = {"shop","merchant","guide","quest","npc","bank","job","dummy"}
    for _, word in pairs(ignore) do if n:find(word) then return false end end
    
    return true
end

local function createESP(model, isPlayer)
    if not model or (isPlayer and model == localPlayer.Character) then return end
    if not isPlayer and not isMonster(model) then return end

    -- 使用 FindFirstChild 替代 WaitForChild 防止卡死
    local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")
    if not root then return end

    local tag = isPlayer and "P_Tag" or "M_Tag"
    if root:FindFirstChild(tag) then return end

    local gui = Instance.new("BillboardGui", root)
    gui.Name = tag
    gui.Size = UDim2.new(0, 100, 0, 40)
    gui.AlwaysOnTop = true
    gui.MaxDistance = 9999
    gui.ExtentsOffset = Vector3.new(0, 3, 0)
    table.insert(_espStorage, gui)

    local label = Instance.new("TextLabel", gui)
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = isPlayer and Color3.fromRGB(0, 255, 255) or Color3.fromRGB(255, 50, 50)
    label.TextStrokeTransparency = 0.2
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold

    task.spawn(function()
        while model.Parent and root.Parent and gui.Parent do
            local active = isPlayer and ESP_PLAYER_ENABLED or ESP_MOB_ENABLED
            label.Visible = active
            if active and localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local d = (root.Position - localPlayer.Character.HumanoidRootPart.Position).Magnitude
                label.Text = string.format("%s\n%dm", model.Name, math.floor(d))
            end
            task.wait(0.5)
        end
    end)
end

