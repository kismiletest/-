------------------------------------------------
-- 逻辑绑定
------------------------------------------------

-- 透视开关
EspBtn.MouseButton1Click:Connect(function()
    ESP_ENABLED = not ESP_ENABLED
    if ESP_ENABLED then
        EspBtn.Text = "透视: 开"
        EspBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        refreshESP()
    else
        EspBtn.Text = "透视: 关"
        EspBtn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        clearESP()
    end
end)

-- 飞行开关
FlyBtn.MouseButton1Click:Connect(function()
    FLYING_ENABLED = not FLYING_ENABLED
    if FLYING_ENABLED then
        FlyBtn.Text = "飞行: 开"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        startFlying()
    else
        FlyBtn.Text = "飞行: 关"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        stopFlying()
    end
end)

-- 持续监听新物体
workspace.ChildAdded:Connect(function(obj)
    if ESP_ENABLED then
        task.wait(1)
        if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
            createESP(obj)
        end
    end
end)

print("1.en Hub 加载成功：透视与飞行已整合")
