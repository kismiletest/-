local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local localPlayer = Players.LocalPlayer

-- 状态控制
local PANEL_VISIBLE = true
local ESP_ENABLED = false
local FLYING_ENABLED = false
local _espStorage = {}

-- FlyGuiV3 核心参数
local flySpeed = 70
local bv, bg = nil, nil
local TOGGLE_KEY = Enum.KeyCode.RightControl

------------------------------------------------
-- 逻辑：透视 (ESP)
------------------------------------------------
local function clearESP()
    for _, item in pairs(_espStorage) do
        if item and item.Parent then item:Destroy() end
    end
    _espStorage = {}
end

local function createESP(model)
    if not ESP_ENABLED or model == localPlayer.Character then return end
    local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    if root and not root:FindFirstChild("ESP_UI") then
        local gui = Instance.new("BillboardGui", root)
        gui.Name = "ESP_UI"
        gui.Size = UDim2.new(0, 100, 0, 40)
        gui.AlwaysOnTop = true
        gui.ExtentsOffset = Vector3.new(0, 3, 0)
        table.insert(_espStorage, gui)

        local label = Instance.new("TextLabel", gui)
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextColor3 = Players:GetPlayerFromCharacter(model) and Color3.new(0, 1, 0) or Color3.new(1, 0, 0)
        label.TextStrokeTransparency = 0
        label.TextScaled = true
        label.Font = Enum.Font.SourceSansBold

        task.spawn(function()
            while ESP_ENABLED and model.Parent and root.Parent do
                local myRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
                if myRoot then
                    label.Text = string.format("%s\n%dm", model.Name, math.floor((root.Position - myRoot.Position).Magnitude))
                end
                task.wait(0.3)
            end
            if gui then gui:Destroy() end
        end)
    end
end

------------------------------------------------
-- 核心：FlyGuiV3 飞行逻辑 (替换了原本的旧脚本)
------------------------------------------------
local function stopFlying()
    FLYING_ENABLED = false
    if bv then bv:Destroy() bv = nil end
    if bg then bg:Destroy() bg = nil end
    pcall(function()
        local char = localPlayer.Character
        char.Humanoid.PlatformStand = false
        char.HumanoidRootPart.Velocity = Vector3.new(0,0,0)
        char.HumanoidRootPart.RotVelocity = Vector3.new(0,0,0)
    end)
end

local function startFlying()
    local char = localPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    stopFlying() 
    FLYING_ENABLED = true

    -- FlyGuiV3 核心：使用 BodyVelocity 实现无重力悬停
    bv = Instance.new("BodyVelocity", root)
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.new(0, 0, 0)
    
    -- FlyGuiV3 核心：使用 BodyGyro 锁定身体不乱晃
    bg = Instance.new("BodyGyro", root)
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.P = 9000 
    
    char.Humanoid.PlatformStand = true

    task.spawn(function()
        while FLYING_ENABLED and root.Parent do
            local camera = workspace.CurrentCamera
            local dir = Vector3.new(0, 0, 0)
            
            -- 读取输入
            local f = (UserInputService:IsKeyDown(Enum.KeyCode.W) and 1 or 0) + (UserInputService:IsKeyDown(Enum.KeyCode.S) and -1 or 0)
            local r = (UserInputService:IsKeyDown(Enum.KeyCode.D) and 1 or 0) + (UserInputService:IsKeyDown(Enum.KeyCode.A) and -1 or 0)
            local u = (UserInputService:IsKeyDown(Enum.KeyCode.Space) and 1 or 0) + (UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) and -1 or 0)

            -- 关键：FlyGuiV3 风格的相机坐标转换
            -- 按 W 会朝相机看向的方向飞行（包括仰角）
            dir = (camera.CFrame.LookVector * f) + (camera.CFrame.RightVector * r) + (Vector3.new(0, 1, 0) * u)
            
            if dir.Magnitude > 0 then
                bv.Velocity = dir.Unit * flySpeed
            else
                bv.Velocity = Vector3.new(0, 0, 0) -- 完美静止悬停
            end
            
            bg.CFrame = camera.CFrame
            RunService.RenderStepped:Wait()
        end
        stopFlying()
    end)
end

