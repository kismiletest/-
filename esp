-- [[ ESP 系统核心逻辑 ]] --
local function GetESPObjects(obj, color)
    local highlight = obj:FindFirstChild("HubHighlight")
    local billboard = obj:FindFirstChild("HubTag")
    
    if not highlight and Settings.ESP_Enabled then
        highlight = Instance.new("Highlight", obj)
        highlight.Name = "HubHighlight"
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
    end
    
    if not billboard and Settings.ESP_Enabled then
        billboard = Instance.new("BillboardGui", obj)
        billboard.Name = "HubTag"
        billboard.Size = UDim2.new(0, 200, 0, 50)
        billboard.AlwaysOnTop = true
        billboard.ExtentsOffset = Vector3.new(0, 3, 0)
        local label = Instance.new("TextLabel", billboard)
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextStrokeTransparency = 0.5
        label.Font = Enum.Font.GothamBold
        label.TextSize = 14
    end
    
    return highlight, billboard and billboard:FindFirstChildOfClass("TextLabel")
end

RS.RenderStepped:Connect(function()
    -- 彩虹 UI 特效
    if Settings.Rainbow_UI then
        local hue = tick() % 5 / 5
        MainStroke.Color = Color3.fromHSV(hue, 0.8, 1)
        Title.TextColor3 = Color3.fromHSV(hue, 0.6, 1)
    end

    -- 核心遍历
    for _, v in pairs(workspace:GetChildren()) do
        local isPlayer = Players:GetPlayerFromCharacter(v)
        local isMonster = v:FindFirstChild("Humanoid") and not isPlayer
        
        local shouldShow = false
        local color = Color3.new(1, 1, 1)

        if Settings.ESP_Enabled then
            if isPlayer and Settings.Show_Players and v ~= LocalPlayer.Character then
                shouldShow = true
                color = Color3.fromRGB(0, 170, 255)
            elseif isMonster and Settings.Show_Monsters then
                shouldShow = true
                color = Color3.fromRGB(255, 50, 50)
            end
        end

        if shouldShow and v:FindFirstChild("HumanoidRootPart") then
            local high, label = GetESPObjects(v, color)
            if high and label then
                high.FillColor = color
                high.Enabled = true
                
                local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - v.HumanoidRootPart.Position).Magnitude)
                local txt = ""
                if Settings.Show_Name then txt = v.Name end
                if Settings.Show_Distance then txt = txt .. " [" .. dist .. "m]" end
                label.Text = txt
                label.TextColor3 = color
            end
        else
            -- 清理无效 ESP
            if v:FindFirstChild("HubHighlight") then v.HubHighlight:Destroy() end
            if v:FindFirstChild("HubTag") then v.HubTag:Destroy() end
        end
    end
end)

