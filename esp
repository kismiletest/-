-- =============================================
--  调试版 + WindUI 自动通关脚本
-- =============================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()

local Window = WindUI:CreateWindow({Title = "自动通关调试版", Icon = "magnifying-glass", Theme = "Dark"})
local Tab = Window:Tab({Title = "调试", Icon = "bug"})

local character = player.Character or player.CharacterAdded:Wait()
local root = character:WaitForChild("HumanoidRootPart")

local autoEnabled = false
local folderName = "Levels"

Tab:Toggle({
    Title = "启用自动通关",
    Default = false,
    Callback = function(v) autoEnabled = v end
})

Tab:Textbox({
    Title = "关卡文件夹名称",
    Default = "Levels",
    Callback = function(text)
        folderName = text
        WindUI:Notify({Title = "已更新", Content = "文件夹名称 → " .. text})
    end
})

Tab:Button({
    Title = "🔍 扫描 Workspace 结构",
    Callback = function()
        print("=== Workspace 子对象扫描 ===")
        for _, obj in ipairs(Workspace:GetChildren()) do
            print(obj.Name, "->", obj.ClassName)
            WindUI:Notify({Title = obj.Name, Content = obj.ClassName, Duration = 2})
        end
    end
})

Tab:Button({
    Title = "📍 显示我当前位置",
    Callback = function()
        if root then
            print("当前位置:", root.Position)
            WindUI:Notify({
                Title = "当前位置",
                Content = string.format("X: %.1f, Y: %.1f, Z: %.1f", root.Position.X, root.Position.Y, root.Position.Z),
                Duration = 5
            })
        end
    end
})

-- 自动检测附近对象
task.spawn(function()
    while true do
        if autoEnabled and root then
            local found = false
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("BasePart") or obj:IsA("Model") then
                    local dist = (obj:GetPivot().Position - root.Position).Magnitude
                    if dist < 100 and dist > 1 then
                        if not found then
                            WindUI:Notify({
                                Title = "附近物体",
                                Content = obj.Name .. " (" .. math.floor(dist) .. " studs)",
                                Duration = 3
                            })
                            print("附近:", obj.Name, obj.ClassName, dist)
                            found = true
                        end
                    end
                end
            end
        end
        task.wait(2)
    end
end)

player.CharacterAdded:Connect(function(ch)
    character = ch
    root = ch:WaitForChild("HumanoidRootPart")
end)

print("调试脚本已加载，请点击 '扫描 Workspace 结构'")
