------------------------------------------------
-- 交互与初始化
------------------------------------------------
EspBtn.MouseButton1Click:Connect(function()
    ESP_ENABLED = not ESP_ENABLED
    EspBtn.Text = ESP_ENABLED and "玩家透视: 开" or "玩家透视: 关"
    EspBtn.BackgroundColor3 = ESP_ENABLED and Color3.fromRGB(40, 160, 40) or Color3.fromRGB(160, 40, 40)
    
    if ESP_ENABLED then
        for _, p in pairs(Players:GetPlayers()) do
            createPlayerESP(p)
        end
    else
        clearESP()
    end
end)

UserInputService.InputBegan:Connect(function(i, p)
    if not p and i.KeyCode == TOGGLE_KEY then
        MainFrame.Visible = not MainFrame.Visible
    end
end)

-- 仅监听玩家加入
Players.PlayerAdded:Connect(createPlayerESP)

print("1.en Hub V12 加载成功：NPC 已过滤，仅保留玩家透视。")
