-- Roblox Luau 飞行脚本 (WindUI) - 最终修复版
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")

local WindUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()

local Window = WindUI:CreateWindow({
    Title = "飞行脚本 | Fly Script",
    Icon = "plane",
    Theme = "Dark",
})

local Tab = Window:Tab({ Title = "飞行控制", Icon = "plane" })

-- 变量
local isFlying = false
local flySpeed = 60
local connection
local bv, bg

local function startFlying()
    if isFlying then return end
    isFlying = true
    
    humanoid.PlatformStand = true
    
    -- 使用更强的参数
    bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(400000, 400000, 400000)
    bv.Velocity = Vector3.new(0, 0, 0)
    bv.Parent = rootPart
    
    bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(400000, 400000, 400000)
    bg.P = 15000
    bg.D = 500
    bg.Parent = rootPart
    
    print("✅ 飞行已开启 | Speed: " .. flySpeed)
end

local function stopFlying()
    if not isFlying then return end
    isFlying = false
    humanoid.PlatformStand = false
    
    if bv then bv:Destroy() end
    if bg then bg:Destroy() end
    bv = nil
    bg = nil
    
    print("❌ 飞行已关闭")
end

-- 主飞行循环
connection = RunService.Heartbeat:Connect(function()
    if not isFlying or not bv or not bg or not rootPart then return end
    
    local cam = workspace.CurrentCamera
    local dir = Vector3.new(0,0,0)
    
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0,1,0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.new(0,1,0) end
    
    if dir.Magnitude > 0 then
        dir = dir.Unit
    end
    
    bv.Velocity = dir * flySpeed
    bg.CFrame = cam.CFrame
end)

-- ==================== UI ====================
local speedSlider

Tab:Toggle({
    Title = "启用飞行",
    Value = false,
    Callback = function(state)
        if state then
            startFlying()
        else
            stopFlying()
        end
    end
})

speedSlider = Tab:Slider({
    Title = "飞行速度",
    Min = 20,
    Max = 300,
    Default = 60,
    Step = 5,
    Callback = function(value)
        flySpeed = value
        print("速度已设置为: " .. value)
    end
})

Tab:Button({
    Title = "重置速度为 60",
    Callback = function()
        flySpeed = 60
        if speedSlider then
            speedSlider:Set(60)
        end
    end
})

Tab:Button({
    Title = "重置角色",
    Callback = function()
        stopFlying()
        if humanoid then humanoid.Health = 0 end
    end
})

-- F 键快捷键
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.F then
        local newState = not isFlying
        -- 直接切换
        if newState then
            startFlying()
        else
            stopFlying()
        end
    end
end)

print("🚀 飞行脚本加载完成！按 F 键快速开关")
