local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local localPlayer = Players.LocalPlayer

-- 状态变量
local PANEL_VISIBLE = true
local ESP_ENABLED = false
local FLYING_ENABLED = false
local _espStorage = {}

-- 飞行配置
local flySpeed = 70
local bv, bg = nil, nil
local TOGGLE_KEY = Enum.KeyCode.RightControl -- 隐藏面板键

------------------------------------------------
-- 逻辑部分：透视 (ESP)
------------------------------------------------
local function clearESP()
    for _, item in pairs(_espStorage) do
        if item then item:Destroy() end
    end
    _espStorage = {}
end

local function createESP(model)
    if not ESP_ENABLED or model == localPlayer.Character then return end
    local hum = model:FindFirstChildOfClass("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    
    if hum and root and not root:FindFirstChild("ESP_UI") then
        local gui = Instance.new("BillboardGui", root)
        gui.Name = "ESP_UI"
        gui.Size = UDim2.new(0, 100, 0, 40)
        gui.AlwaysOnTop = true
        gui.ExtentsOffset = Vector3.new(0, 3, 0)
        table.insert(_espStorage, gui)

        local label = Instance.new("TextLabel", gui)
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextColor3 = Players:GetPlayerFromCharacter(model) and Color3.new(0, 1, 0) or Color3.new(1, 0, 0)
        label.TextStrokeTransparency = 0
        label.TextScaled = true
        label.Font = Enum.Font.SourceSansBold

        task.spawn(function()
            while ESP_ENABLED and model.Parent and root.Parent do
                local myRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
                if myRoot then
                    label.Text = string.format("%s\n%dm", model.Name, math.floor((root.Position - myRoot.Position).Magnitude))
                end
                task.wait(0.3)
            end
            if gui then gui:Destroy() end
        end)
    end
end

------------------------------------------------
-- 逻辑部分：飞行 (Fly)
------------------------------------------------
local function stopFlying()
    if bv then bv:Destroy() bv = nil end
    if bg then bg:Destroy() bg = nil end
    pcall(function()
        localPlayer.Character.Humanoid.PlatformStand = false
    end)
end

local function startFlying()
    local char = localPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    stopFlying()
    bv = Instance.new("BodyVelocity", root)
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bg = Instance.new("BodyGyro", root)
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.P = 9000
    
    char.Humanoid.PlatformStand = true

    task.spawn(function()
        while FLYING_ENABLED and root.Parent do
            local camera = workspace.CurrentCamera
            local dir = Vector3.new(0, 0, 0)

            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0, 1, 0) end

            bv.Velocity = dir * flySpeed
            bg.CFrame = camera.CFrame
            RunService.RenderStepped:Wait()
        end
        stopFlying()
    end)
end

------------------------------------------------
-- UI 构造部分 (自动布局)
------------------------------------------------
