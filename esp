local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

-- 确保 LocalPlayer 已加载
if not player then
    Players:GetPropertyChangedSignal("LocalPlayer"):Wait()
    player = Players.LocalPlayer
end

print("ESP 核心启动中...")

------------------------------------------------
-- 工具函数
------------------------------------------------
local function getRoot(model)
	return model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
end

-- 创建 UI 的函数
local function createESP(model, color)
    local root = getRoot(model)
    if not root or root:FindFirstChild("ESP_UI") then return end

    local gui = Instance.new("BillboardGui")
    gui.Name = "ESP_UI"
    gui.Size = UDim2.new(0, 100, 0, 40)
    gui.AlwaysOnTop = true
    gui.DistanceLowerLimit = 0
    gui.MaxDistance = 2000
    gui.ExtentsOffset = Vector3.new(0, 3, 0)
    gui.Parent = root

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = color
    label.TextStrokeTransparency = 0
    label.TextScaled = true
    label.Font = Enum.Font.SourceSansBold
    label.Parent = gui

    -- 实时更新距离
    task.spawn(function()
        while model.Parent and root.Parent do
            local myChar = player.Character
            if myChar and getRoot(myChar) then
                local dist = (root.Position - getRoot(myChar).Position).Magnitude
                label.Text = string.format("%s\n%dm", model.Name, math.floor(dist))
            end
            task.wait(0.1)
        end
    end)
end

------------------------------------------------
-- 核心判定函数
------------------------------------------------
local function checkAndApply(obj)
    if not obj:IsA("Model") then return end
    if obj == player.Character then return end

    -- 关键：通过 Humanoid 判定是否为生物（玩家或怪物）
    local hum = obj:FindFirstChildOfClass("Humanoid")
    if hum then
        -- 区分颜色
        local isPlayer = Players:GetPlayerFromCharacter(obj)
        local color = isPlayer and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
        createESP(obj, color)
    end
end

------------------------------------------------
-- 启动监听
------------------------------------------------

-- 1. 扫描当前已经在场的所有模型
for _, desc in pairs(workspace:GetDescendants()) do
    checkAndApply(desc)
end

-- 2. 监听新生成的模型 (关键：解决动态刷怪不显示问题)
workspace.DescendantAdded:Connect(function(desc)
    -- 延迟一瞬确保模型内部件（如Humanoid）已加载
    task.delay(0.5, function()
        checkAndApply(desc)
    end)
end)

print("ESP 扫描监听已激活")
