local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local localPlayer = Players.LocalPlayer

-- 状态控制
local ESP_ENABLED = false
local _espStorage = {}
local TOGGLE_KEY = Enum.KeyCode.RightControl

------------------------------------------------
-- 逻辑：透视 (ESP)
------------------------------------------------
local function clearESP()
    for _, item in pairs(_espStorage) do
        if item and item.Parent then item:Destroy() end
    end
    _espStorage = {}
end

local function createESP(model)
    if not ESP_ENABLED or model == localPlayer.Character then return end
    local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    
    if root and not root:FindFirstChild("ESP_UI") then
        local gui = Instance.new("BillboardGui", root)
        gui.Name = "ESP_UI"
        gui.Size = UDim2.new(0, 100, 0, 40)
        gui.AlwaysOnTop = true
        gui.ExtentsOffset = Vector3.new(0, 3, 0)
        table.insert(_espStorage, gui)

        local label = Instance.new("TextLabel", gui)
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextColor3 = Players:GetPlayerFromCharacter(model) and Color3.new(0, 1, 0) or Color3.new(1, 0, 0)
        label.TextStrokeTransparency = 0
        label.TextScaled = true
        label.Font = Enum.Font.SourceSansBold

        task.spawn(function()
            while ESP_ENABLED and model.Parent and root.Parent do
                local myRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
                if myRoot then
                    label.Text = string.format("%s\n%dm", model.Name, math.floor((root.Position - myRoot.Position).Magnitude))
                end
                task.wait(0.3)
            end
            if gui then gui:Destroy() end
        end)
    end
end

