-- 基础变量获取
local Players = game:GetService("Players")
local RS = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- 尝试获取最安全的 UI 存放路径（防止被游戏检测或拦截）
local TargetParent = nil
if gethui then TargetParent = gethui()
elseif syn and syn.protect_gui then 
    local g = Instance.new("ScreenGui")
    syn.protect_gui(g)
    TargetParent = g
elseif game:GetService("CoreGui"):FindFirstChild("RobloxGui") then
    TargetParent = game:GetService("CoreGui").RobloxGui
else
    TargetParent = game:GetService("CoreGui")
end

-- 如果已经存在，先销毁旧的
if TargetParent:FindFirstChild("1enHub_Universal") then
    TargetParent:FindFirstChild("1enHub_Universal"):Destroy()
end

local ScreenGui = Instance.new("ScreenGui", TargetParent)
ScreenGui.Name = "1enHub_Universal"
ScreenGui.IgnoreGuiInset = true

-- 配置
local Settings = {
    ESP = false,
    Players = false,
    Monsters = false,
    Dist = true,
    Names = true
}

