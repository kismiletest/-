-- [[ 1.en Hub - 最终兼容修复版 ]] --

local Players = game:GetService("Players")
local RS = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- 1. 尝试寻找最稳定的 UI 父级
local function GetSafeParent()
    local success, target = pcall(function() return gethui() end)
    if success and target then return target end
    success, target = pcall(function() return game:GetService("CoreGui") end)
    if success and target then return target end
    return LocalPlayer:WaitForChild("PlayerGui")
end

local SafeParent = GetSafeParent()

-- 清理旧脚本
if SafeParent:FindFirstChild("OneEnHub_Main") then 
    SafeParent:FindFirstChild("OneEnHub_Main"):Destroy() 
end

-- 2. 状态配置
local Settings = {
    Enabled = false,
    Players = false,
    Monsters = false,
    Names = true,
    Dist = true
}

-- 3. 构建基础 UI
local SG = Instance.new("ScreenGui", SafeParent)
SG.Name = "OneEnHub_Main"
SG.IgnoreGuiInset = true

local Main = Instance.new("Frame", SG)
Main.Size = UDim2.new(0, 200, 0, 260)
Main.Position = UDim2.new(0.5, -100, 0.5, -130)
Main.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
Main.BorderSizePixel = 2
Main.BorderColor3 = Color3.fromRGB(0, 255, 255)
Main.Active = true
Main.Draggable = true -- 强制开启旧版拖拽，兼容性最强

-- 标题
local T = Instance.new("TextLabel", Main)
T.Size = UDim2.new(1, -30, 0, 30)
T.Text = " 1.en Hub"
T.TextColor3 = Color3.new(1, 1, 1)
T.BackgroundTransparency = 1
T.TextXAlignment = "Left"
T.Font = "SourceSansBold"
T.TextSize = 18

-- ✖ 关闭按钮
local X = Instance.new("TextButton", Main)
X.Size = UDim2.new(0, 25, 0, 25)
X.Position = UDim2.new(1, -28, 0, 3)
X.Text = "X"
X.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
X.TextColor3 = Color3.new(1, 1, 1)
X.MouseButton1Click:Connect(function()
    Settings.Enabled = false
    task.wait(0.1)
    SG:Destroy()
end)

-- 按钮创建
local offset = 40
local function AddBtn(txt, key)
    local b = Instance.new("TextButton", Main)
    b.Size = UDim2.new(1, -20, 0, 35)
    b.Position = UDim2.new(0, 10, 0, offset)
    b.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    b.Text = txt .. ": OFF"
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = "SourceSans"
    b.TextSize = 14
    
    b.MouseButton1Click:Connect(function()
        Settings[key] = not Settings[key]
        b.Text = txt .. ": " .. (Settings[key] and "ON" or "OFF")
        b.BackgroundColor3 = Settings[key] and Color3.fromRGB(0, 120, 80) or Color3.fromRGB(50, 50, 50)
    end)
    offset = offset + 40
end

AddBtn("总开关", "Enabled")
AddBtn("透视玩家", "Players")
AddBtn("透视怪物", "Monsters")
AddBtn("显示名字", "Names")
AddBtn("显示距离", "Dist")

-- 4. ESP 逻辑
RS.RenderStepped:Connect(function()
    if not Settings.Enabled then
        for _, v in pairs(workspace:GetDescendants()) do
            if v.Name == "1enTag" or v.Name == "1enHigh" then v:Destroy() end
        end
        return
    end

    for _, v in pairs(workspace:GetChildren()) do
        local isP = Players:GetPlayerFromCharacter(v)
        local isM = v:FindFirstChild("Humanoid") and not isP
        
        -- 基础过滤
        if isM and (v.Name:lower():find("npc") or v.Name:lower():find("quest")) then isM = false end

        local show = false
        local col = Color3.new(1,1,1)

        if isP and Settings.Players and v ~= LocalPlayer.Character then
            show = true; col = Color3.fromRGB(0, 200, 255)
        elseif isM and Settings.Monsters then
            show = true; col = Color3.fromRGB(255, 50, 50)
        end

        if show and v:FindFirstChild("HumanoidRootPart") then
            -- 绘制文字
            local t = v:FindFirstChild("1enTag")
            if not t then
                t = Instance.new("BillboardGui", v)
                t.Name = "1enTag"
                t.Size = UDim2.new(0, 100, 0, 20)
                t.AlwaysOnTop = true
                t.ExtentsOffset = Vector3.new(0, 3, 0)
                local l = Instance.new("TextLabel", t)
                l.Size = UDim2.new(1, 0, 1, 0)
                l.BackgroundTransparency = 1
                l.Font = "SourceSansBold"
                l.TextSize = 14
            end
            local d = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - v.HumanoidRootPart.Position).Magnitude)
            t.TextLabel.Text = (Settings.Names and v.Name or "") .. (Settings.Dist and " ["..d.."m]" or "")
            t.TextLabel.TextColor3 = col
            
            -- 绘制高亮 (如果执行器不支持则会自动跳过)
            if not v:FindFirstChild("1enHigh") then
                pcall(function()
                    local h = Instance.new("Highlight", v)
                    h.Name = "1enHigh"
                    h.FillTransparency = 0.5
                    h.FillColor = col
                end)
            end
        else
            if v:FindFirstChild("1enTag") then v["1enTag"]:Destroy() end
            if v:FindFirstChild("1enHigh") then v["1enHigh"]:Destroy() end
        end
    end
end)

-- 快捷键：Right Control 隐藏/显示
UIS.InputBegan:Connect(function(i)
    if i.KeyCode == Enum.KeyCode.RightControl then Main.Visible = not Main.Visible end
end)

print("1.en Hub Ready! If no UI appears, check F9 Console.")
