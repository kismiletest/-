local Players = game:GetService("Players")
local player = Players.LocalPlayer

print("ESP 系统已优化：仅显示玩家与怪物")

------------------------------------------------
-- 核心配置
------------------------------------------------
local SETTINGS = {
    PlayerColor = Color3.fromRGB(0, 255, 0), -- 玩家绿色
    MonsterColor = Color3.fromRGB(255, 0, 0), -- 怪物红色
    UpdateRate = 0.2, -- 距离刷新频率
    ScanRate = 3 -- 场景扫描频率
}

------------------------------------------------
-- 创建 UI
------------------------------------------------
local function createBillboard(root, color, name)
    -- 清理旧的 UI 防止重复
    if root:FindFirstChild("ESP_UI") then
        root.ESP_UI:Destroy()
    end

    local gui = Instance.new("BillboardGui")
    gui.Name = "ESP_UI"
    gui.Size = UDim2.new(0, 200, 0, 50)
    gui.StudsOffset = Vector3.new(0, 3, 0)
    gui.AlwaysOnTop = true
    gui.MaxDistance = 1000
    gui.Parent = root

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextScaled = true
    label.Font = Enum.Font.SourceSansBold
    label.TextColor3 = color
    label.TextStrokeTransparency = 0
    label.Parent = gui

    return label
end

------------------------------------------------
-- 获取 Root 节点
------------------------------------------------
local function getRoot(model)
    return model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
end

------------------------------------------------
-- 核心刷新逻辑
------------------------------------------------
local function startTracker(model, label, isPlayer)
    task.spawn(function()
        while model.Parent and label.Parent do
            local myChar = player.Character
            local root = getRoot(model)
            
            if myChar and getRoot(myChar) and root then
                local dist = (root.Position - getRoot(myChar).Position).Magnitude
                local displayName = isPlayer and model.Name or (model.Name or "Monster")
                label.Text = string.format("%s\n[%d m]", displayName, math.floor(dist))
            end
            task.wait(SETTINGS.UpdateRate)
        end
    end)
end

------------------------------------------------
-- 智能判定与添加
------------------------------------------------
local function applyESP(obj)
    -- 1. 必须是模型
    if not obj:IsA("Model") then return end
    -- 2. 必须含有 Humanoid (这是判断是否为生物的关键)
    local hum = obj:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    -- 3. 必须有根节点
    local root = getRoot(obj)
    if not root or root:FindFirstChild("ESP_UI") then return end

    -- 区分玩家和怪物
    local charPlayer = Players:GetPlayerFromCharacter(obj)
    if charPlayer then
        if charPlayer == player then return end -- 跳过自己
        local label = createBillboard(root, SETTINGS.PlayerColor)
        startTracker(obj, label, true)
    else
        -- 如果是带有 Humanoid 但不是玩家的模型，统一视为怪物
        local label = createBillboard(root, SETTINGS.MonsterColor)
        startTracker(obj, label, false)
    end
end

------------------------------------------------
-- 初始化与循环扫描
------------------------------------------------

-- 监听新玩家
Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function(char)
        task.wait(1)
        applyESP(char)
    end)
end)

-- 持续扫描工作区（捕获动态生成的怪物）
task.spawn(function()
    while true do
        for _, child in pairs(workspace:GetChildren()) do
            -- 仅扫描工作区根目录下的模型，提高效率
            if child:IsA("Model") then
                applyESP(child)
            end
        end
        task.wait(SETTINGS.ScanRate)
    end
end)
