-- [[ 功能切换按钮 ]] --
local function CreateToggle(text, settingName)
    local Btn = Instance.new("TextButton", Container)
    Btn.Size = UDim2.new(1, 0, 0, 40)
    Btn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    Btn.Text = text .. ": OFF"
    Btn.TextColor3 = Color3.fromRGB(180, 180, 180)
    Btn.Font = Enum.Font.Gotham
    Instance.new("UICorner", Btn)

    Btn.MouseButton1Click:Connect(function()
        Settings[settingName] = not Settings[settingName]
        Btn.Text = text .. ": " .. (Settings[settingName] and "ON" or "OFF")
        Btn.TextColor3 = Settings[settingName] and Color3.fromRGB(0, 255, 127) or Color3.fromRGB(180, 180, 180)
    end)
end

CreateToggle("启用自瞄锁定", "Aimbot_Enabled")
CreateToggle("显示自瞄范围", "Show_FOV")

ToggleButton.MouseButton1Click:Connect(function() MainFrame.Visible = not MainFrame.Visible end)

-- [[ 核心逻辑 ]] --

-- 寻找屏幕内最靠近准星的目标
local function GetClosestTarget()
    local target = nil
    local shortestDistance = Settings.FOV_Radius
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local part = player.Character:FindFirstChild(Settings.Aim_Bone)
            if part then
                local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local distance = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if distance < shortestDistance then
                        target = part
                        shortestDistance = distance
                    end
                end
            end
        end
    end
    
    -- 如果玩家中没目标，可以扫描工作区的 NPC (可选)
    if not target then
        for _, obj in pairs(workspace:GetChildren()) do
            if obj:FindFirstChildOfClass("Humanoid") and obj ~= LocalPlayer.Character then
                local part = obj:FindFirstChild(Settings.Aim_Bone) or obj.PrimaryPart
                if part then
                    local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local distance = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                        if distance < shortestDistance then
                            target = part
                            shortestDistance = distance
                        end
                    end
                end
            end
        end
    end
    
    return target
end

-- 渲染每帧执行
RS.RenderStepped:Connect(function()
    -- 彩虹特效
    if Settings.Rainbow_UI then
        local color = Color3.fromHSV(tick() % 5 / 5, 0.8, 1)
        MainStroke.Color = color
        BtnStroke.Color = color
        Title.TextColor3 = color
        FOVCircle.Color = color
    end

    -- 更新 FOV 圆圈位置和状态
    FOVCircle.Visible = Settings.Aimbot_Enabled and Settings.Show_FOV
    FOVCircle.Radius = Settings.FOV_Radius
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    -- 执行自瞄
    if Settings.Aimbot_Enabled then
        local target = GetClosestTarget()
        if target then
            -- 使用 CFrame:Lerp 实现手机平滑锁头，防止被反作弊封号
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, target.Position), Settings.Smoothness)
        end
    end
end)

print("1.en Hub: Aimbot Mode Loaded!")
