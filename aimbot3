local Settings = {
    Aimbot_Enabled = false,
    Aim_Bone = "Head",       -- 瞄准部位: "Head" 或 "HumanoidRootPart"
    Smoothness = 0.15,       -- 平滑度: 越小越平滑，0.1-0.2 适合手机
    FOV_Radius = 150,        -- 锁定范围半径
    Show_FOV = true,         -- 是否显示圆圈
    Rainbow_UI = true        -- UI 彩虹特效
}

-- [[ UI 基础构建 ]] --
local ScreenGui = Instance.new("ScreenGui", (gethui and gethui()) or game:GetService("CoreGui"))

-- 悬浮控制按钮
