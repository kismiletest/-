-- 4. 自動監聽與填入序號邏輯 (Auto Redeem)
local listenerConnection = nil

local function startListening()
    listenerConnection = topNotificationGui.ChildAdded:Connect(function(child)
        if child.Name == "Template" then
            task.wait(0.05)
            local codeText = ""
            
            if child:IsA("TextLabel") then
                codeText = child.Text
            elseif child:FindFirstChildOfClass("TextLabel") then
                codeText = child:FindFirstChildOfClass("TextLabel").Text
            else
                pcall(function() codeText = child.Text end)
            end

            if codeText and codeText ~= "" then
                updateTargetTextBox(codeText)
                addHistory(codeText)
            end
        end
    end)
end

local function stopListening()
    if listenerConnection then
        listenerConnection:Disconnect()
        listenerConnection = nil
    end
end

-- 開關切換
ToggleBtn.MouseButton1Click:Connect(function()
    autoRedeemEnabled = not autoRedeemEnabled
    if autoRedeemEnabled then
        ToggleBtn.Text = "Auto Redeem: ON"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
        startListening()
    else
        ToggleBtn.Text = "Auto Redeem: OFF"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        stopListening()
    end
end)

