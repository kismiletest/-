-- 全域開關變數
local autoRedeemEnabled = false

-- 核心文字填入處理函數
local function updateTargetTextBox(newText)
    if not newText or newText == "" then return end
    
    -- 去除前後空格，並強制轉換為大寫
    newText = string.gsub(newText, "^%s*(.-)%s*$", "%1")
    newText = string.upper(newText)
    
    local currentText = codeRedeemTextBox.Text
    if currentText == "" then
        codeRedeemTextBox.Text = newText
    else
        codeRedeemTextBox.Text = currentText .. " " .. newText
    end
end

-- 歷史紀錄紀錄防重複快取
local recordedCodes = {}

-- 歷史紀錄添加函數
local historyCount = 0
local function addHistory(text)
    if not text or text == "" then return end
    
    -- 去除前後空格，並強制轉換為大寫
    text = string.gsub(text, "^%s*(.-)%s*$", "%1")
    text = string.upper(text)
    
    if recordedCodes[text] then return end 
    recordedCodes[text] = true -- 標記已記錄
    
    historyCount = historyCount + 1
    
    local LogBtn = Instance.new("TextButton")
    LogBtn.Size = UDim2.new(1, -8, 0, 28)
    LogBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
    LogBtn.BorderSizePixel = 0
    LogBtn.Text = "  " .. text
    LogBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    LogBtn.TextXAlignment = Enum.TextXAlignment.Left
    LogBtn.Font = Enum.Font.SourceSans
    LogBtn.TextSize = 14
    LogBtn.LayoutOrder = -historyCount -- 最新的排最上面
    LogBtn.Parent = HistoryScroll
    
    local LogCorner = Instance.new("UICorner")
    LogCorner.CornerRadius = UDim.new(0, 4)
    LogCorner.Parent = LogBtn
    
    -- 點擊歷史紀錄行為
    LogBtn.MouseButton1Click:Connect(function()
        -- 點擊歷史紀錄直接填入（不受 ON/OFF 開關限制）
        updateTargetTextBox(text) 
        if setclipboard then
            setclipboard(text)
        end
    end)
end

-- 1. 拖曳功能 (Drag)
local dragging, dragInput, dragStart, startPos
local function update(input)
    local delta = input.Position - dragStart
    MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

TitleBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        update(input)
    end
end)

