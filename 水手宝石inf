-- [[ 1.en Hub: 水手宝石 范围调节绕过版 ]] --

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RS = game:GetService("RunService")
local Player = Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local RootPart = Character:WaitForChild("HumanoidRootPart")

-- 配置存储
local Settings = {
    Enabled = false,
    AttackRange = 300, -- 默认范围
    AttackDelay = 0.03,
    MaxRange = 2000    -- 最大可调范围
}

-- [[ UI 构建 ]] --
local ScreenGui = Instance.new("ScreenGui", Player.PlayerGui)
ScreenGui.Name = "SailorRange_SliderUI"
ScreenGui.ResetOnSpawn = false

local MainFrame = Instance.new("Frame", ScreenGui)
MainFrame.Size = UDim2.new(0, 200, 0, 130)
MainFrame.Position = UDim2.new(0.05, 0, 0.4, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
Instance.new("UICorner", MainFrame)

-- 标题
local Title = Instance.new("TextLabel", MainFrame)
Title.Size = UDim2.new(1, 0, 0, 35)
Title.Text = "水手宝石 范围调节"
Title.TextColor3 = Color3.new(1, 1, 1)
Title.Font = Enum.Font.GothamBold
Title.BackgroundTransparency = 1

-- 状态开关
local ToggleBtn = Instance.new("TextButton", MainFrame)
ToggleBtn.Size = UDim2.new(1, -20, 0, 30)
ToggleBtn.Position = UDim2.new(0, 10, 0, 40)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
ToggleBtn.Text = "功能: 关闭"
ToggleBtn.TextColor3 = Color3.new(1, 1, 1)
Instance.new("UICorner", ToggleBtn)

-- 范围显示
local RangeLabel = Instance.new("TextLabel", MainFrame)
RangeLabel.Size = UDim2.new(1, -20, 0, 20)
RangeLabel.Position = UDim2.new(0, 10, 0, 75)
RangeLabel.Text = "范围: " .. Settings.AttackRange
RangeLabel.TextColor3 = Color3.fromRGB(0, 255, 255)
RangeLabel.BackgroundTransparency = 1
RangeLabel.TextSize = 14

-- 滑动条背景
local SliderBack = Instance.new("Frame", MainFrame)
SliderBack.Size = UDim2.new(1, -20, 0, 10)
SliderBack.Position = UDim2.new(0, 10, 0, 100)
SliderBack.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
Instance.new("UICorner", SliderBack)

-- 滑动块
local SliderFill = Instance.new("Frame", SliderBack)
SliderFill.Size = UDim2.new(Settings.AttackRange / Settings.MaxRange, 0, 1, 0)
SliderFill.BackgroundColor3 = Color3.fromRGB(0, 170, 127)
Instance.new("UICorner", SliderFill)

-- [[ 滑动条逻辑逻辑 ]] --
local isDragging = false

local function UpdateSlider(input)
    local relativeX = math.clamp((input.Position.X - SliderBack.AbsolutePosition.X) / SliderBack.AbsoluteSize.X, 0, 1)
    Settings.AttackRange = math.floor(relativeX * Settings.MaxRange)
    SliderFill.Size = UDim2.new(relativeX, 0, 1, 0)
    RangeLabel.Text = "范围: " .. Settings.AttackRange
end

SliderBack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = true
        UpdateSlider(input)
    end
end)

UIS.InputChanged:Connect(function(input)
    if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        UpdateSlider(input)
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = false
    end
end)

-- 开关逻辑
ToggleBtn.MouseButton1Click:Connect(function()
    Settings.Enabled = not Settings.Enabled
    ToggleBtn.Text = "功能: " .. (Settings.Enabled and "开启" or "关闭")
    ToggleBtn.BackgroundColor3 = Settings.Enabled and Color3.fromRGB(0, 170, 127) or Color3.fromRGB(45, 45, 50)
end)

-- [[ 攻击逻辑 ]] --
local function PerformAttack()
    if not Settings.Enabled then return end
    
    local oldCFrame = RootPart.CFrame
    local center = RootPart.Position
    
    -- 查找符合范围的目标
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= Player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local tRoot = p.Character.HumanoidRootPart
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            
            if hum and hum.Health > 0 then
                local dist = (center - tRoot.Position).Magnitude
                if dist <= Settings.AttackRange then
                    -- 瞬移欺骗：闪现到目标重合
                    RootPart.CFrame = tRoot.CFrame
                    task.wait(Settings.AttackDelay) -- 停留微秒触发判定
                end
            end
        end
    end
    -- 返回
    RootPart.CFrame = oldCFrame
end

-- 按键 E 触发
UIS.InputBegan:Connect(function(input, processed)
    if processed or not Settings.Enabled then return end
    if input.KeyCode == Enum.KeyCode.E then
        task.spawn(PerformAttack)
    end
end)

-- 角色重生支持
Player.CharacterAdded:Connect(function(newChar)
    Character = newChar
    RootPart = Character:WaitForChild("HumanoidRootPart")
end)

print("✅ 水手宝石滑动条版加载成功 - 范围上限: " .. Settings.MaxRange)
