--【水手宝石 无限范围 UI面板 开关版】
local Players = game:GetService("Players")
local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")
local Character = Player.Character or Player.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local RootPart = Character:WaitForChild("HumanoidRootPart")

-- 开关状态
local enableInfiniteRange = false
local InfiniteRangeVal = 999999

-- ========== 创建UI ==========
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "SailorGemUI"
ScreenGui.Parent = PlayerGui
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 180, 0, 80)
MainFrame.Position = UDim2.new(0.05,0,0.3,0)
MainFrame.BackgroundColor3 = Color3.new(0.15,0.15,0.15)
MainFrame.BorderSizePixel = 2
MainFrame.Parent = ScreenGui

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1,0,0.4,0)
Title.BackgroundTransparency = 1
Title.Text = "水手宝石功能"
Title.TextColor3 = Color3.new(1,1,1)
Title.Font = Enum.Font.SourceSansBold
Title.TextSize = 18
Title.Parent = MainFrame

local ToggleBtn = Instance.new("TextButton")
ToggleBtn.Size = UDim2.new(0.7,0,0.45,0)
ToggleBtn.Position = UDim2.new(0.15,0,0.5,0)
ToggleBtn.BackgroundColor3 = Color3.new(0.3,0.3,0.3)
ToggleBtn.Text = "关闭"
ToggleBtn.TextColor3 = Color3.new(1,1,1)
ToggleBtn.Font = Enum.Font.SourceSans
ToggleBtn.TextSize = 16
ToggleBtn.Parent = MainFrame

-- ========== 切换开关逻辑 ==========
local function UpdateUI()
    if enableInfiniteRange then
        ToggleBtn.Text = "开启"
        ToggleBtn.BackgroundColor3 = Color3.new(0.2,0.6,0.2)
    else
        ToggleBtn.Text = "关闭"
        ToggleBtn.BackgroundColor3 = Color3.new(0.3,0.3,0.3)
    end
end

ToggleBtn.MouseButton1Click:Connect(function()
    enableInfiniteRange = not enableInfiniteRange
    UpdateUI()
end)

-- ========== 无限范围核心逻辑 ==========
task.spawn(function()
    while task.wait(0.1) do
        if not enableInfiniteRange then continue end
        pcall(function()
            for _,v in pairs(getgc(true)) do
                if type(v) == "table" and v.Range then
                    v.Range = InfiniteRangeVal
                end
            end
        end)
    end
end)

-- 技能远程命中补充
Humanoid.InputBegan:Connect(function(Key)
    if not enableInfiniteRange then return end
    if Key.KeyCode == Enum.KeyCode.E then -- 你的宝石技能按键
        task.spawn(function()
            for _,Target in pairs(workspace:GetDescendants()) do
                if Target:IsA("Model") and Target:FindFirstChild("Humanoid") 
                and Target.Humanoid.Health > 0 and Target ~= Character then
                    local TRoot = Target:FindFirstChild("HumanoidRootPart")
                    if TRoot then
                        RootPart.CFrame = TRoot.CFrame
                        task.wait(0.01)
                        RootPart.CFrame = Character.HumanoidRootPart.CFrame
                    end
                end
            end
        end)
    end
end)

-- 角色重生重载
Player.CharacterAdded:Connect(function(newChar)
    Character = newChar
    Humanoid = Character:WaitForChild("Humanoid")
    RootPart = Character:WaitForChild("HumanoidRootPart")
end)

UpdateUI()
print("✅ 水手宝石UI面板 + 范围开关 加载完成")
