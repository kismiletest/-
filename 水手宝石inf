-- [[ 1.en Hub: 水手宝石 范围修正版 ]] --

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

-- 变量初始化
local Character = Player.Character or Player.CharacterAdded:Wait()
local RootPart = Character:WaitForChild("HumanoidRootPart")

local enableInfiniteRange = false
local InfiniteRangeVal = 999999

-- ========== 1. UI 面板构建 ==========
local ScreenGui = Instance.new("ScreenGui", PlayerGui)
ScreenGui.Name = "SailorGemUI_V2"
ScreenGui.ResetOnSpawn = false

local MainFrame = Instance.new("Frame", ScreenGui)
MainFrame.Size = UDim2.new(0, 180, 0, 90)
MainFrame.Position = UDim2.new(0.05, 0, 0.4, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
MainFrame.BorderSizePixel = 0
Instance.new("UICorner", MainFrame)

local Title = Instance.new("TextLabel", MainFrame)
Title.Size = UDim2.new(1, 0, 0, 40)
Title.Text = "水手宝石 (修正版)"
Title.TextColor3 = Color3.new(1, 1, 1)
Title.Font = Enum.Font.GothamBold
Title.TextSize = 16
Title.BackgroundTransparency = 1

local ToggleBtn = Instance.new("TextButton", MainFrame)
ToggleBtn.Size = UDim2.new(0, 140, 0, 35)
ToggleBtn.Position = UDim2.new(0.5, -70, 0.5, 0)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
ToggleBtn.Text = "功能: 关闭"
ToggleBtn.TextColor3 = Color3.new(1, 1, 1)
ToggleBtn.Font = Enum.Font.Gotham
Instance.new("UICorner", ToggleBtn)

-- ========== 2. 核心逻辑优化 ==========

-- 更新按钮显示
local function UpdateUI()
    if enableInfiniteRange then
        ToggleBtn.Text = "功能: 开启"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 127)
    else
        ToggleBtn.Text = "功能: 关闭"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
    end
end

ToggleBtn.MouseButton1Click:Connect(function()
    enableInfiniteRange = not enableInfiniteRange
    UpdateUI()
end)

-- 优化内存扫描 (这是之前卡机的元凶)
task.spawn(function()
    while true do
        task.wait(3) -- 每3秒扫描一次内存，足以维持范围，且不会让手机卡死
        if enableInfiniteRange then
            pcall(function()
                local objects = getgc(true)
                for i = 1, #objects do
                    local v = objects[i]
                    if type(v) == "table" and rawget(v, "Range") then
                        v.Range = InfiniteRangeVal
                    end
                end
            end)
        end
    end
end)

-- 优化攻击逻辑 (防止暴力瞬移崩服)
local function PerformAttack()
    if not enableInfiniteRange then return end
    
    local originalPos = RootPart.CFrame
    -- 仅扫描玩家或具有 Humanoid 的 Model，而不是整个 Workspace 的碎片
    for _, targetPlayer in pairs(Players:GetPlayers()) do
        if targetPlayer ~= Player and targetPlayer.Character then
            local tRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
            local tHum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
            
            if tRoot and tHum and tHum.Health > 0 then
                -- 进行快速打击
                RootPart.CFrame = tRoot.CFrame * CFrame.new(0, 0, 2)
                task.wait(0.05) -- 给物理引擎喘息时间
            end
        end
    end
    -- 返回原位
    RootPart.CFrame = originalPos
end

-- 按键绑定
UIS.InputBegan:Connect(function(input, processed)
    if processed or not enableInfiniteRange then return end
    if input.KeyCode == Enum.KeyCode.E then
        task.spawn(PerformAttack)
    end
end)

-- 角色刷新处理
Player.CharacterAdded:Connect(function(newChar)
    Character = newChar
    RootPart = Character:WaitForChild("HumanoidRootPart")
end)

UpdateUI()
print("✅ 优化版水手宝石加载完成，已移除卡顿逻辑")
