-- AUTO V3
--------------------------------------------------

local function StartAutoV3()

    if AutoV3.Running then
        return
    end

    AutoV3.Running = true

    task.spawn(function()

        while AutoV3.Enabled do

            pcall(function()

                local Remotes =
                    ReplicatedStorage:FindFirstChild("Remotes")

                if Remotes and Remotes:FindFirstChild("CommE") then

                    Remotes.CommE:FireServer(
                        "ActivateAbility"
                    )

                end

            end)

            task.wait(0.5)

        end

        AutoV3.Running = false

    end)

end

Tabs.Main:Toggle({
    Title = "Auto V3",
    Value = false,

    Callback = function(state)

        AutoV3.Enabled = state

        if state then
            StartAutoV3()
        end

    end
})

--------------------------------------------------
-- AUTO V4
--------------------------------------------------

local function startV4Loop()

    if autoV4Connection then
        autoV4Connection:Disconnect()
    end

    local last = 0

    autoV4Connection =
        RunService.Heartbeat:Connect(function()

        if not AutoV4 then
            return
        end

        if tick() - last < 1 then
            return
        end

        last = tick()

        pcall(function()

            local Remotes =
                ReplicatedStorage:FindFirstChild("Remotes")

            if Remotes and Remotes:FindFirstChild("CommF_") then

                Remotes.CommF_:InvokeServer(
                    "ActivateRace"
                )

            end

        end)

    end)

end

Tabs.Main:Toggle({
    Title = "Auto V4",
    Value = false,

    Callback = function(state)

        AutoV4 = state

        if AutoV4 then

            startV4Loop()

        else

            if autoV4Connection then
                autoV4Connection:Disconnect()
                autoV4Connection = nil
            end

        end

    end
})

