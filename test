local function StartAutoV3()

    task.spawn(function()

        while AutoV3.Enabled do

            pcall(function()

                local Remotes =
                    ReplicatedStorage:FindFirstChild("Remotes")

                if Remotes and Remotes:FindFirstChild("CommE") then

                    Remotes.CommE:FireServer(
                        "ActivateAbility"
                    )

                end

            end)

            task.wait(0.5)

        end

    end)

end

local function StopAutoV3()
    AutoV3.Enabled = false
end

Tabs.Main:Toggle({ 
    Title = "Auto V3",
    Value = false,

    Callback = function(state)

        AutoV3.Enabled = state

        if state then
            StartAutoV3()
        else
            StopAutoV3()
        end

    end
})

