local SelectedPlayerName = nil
local IsSpectating = false

local function GetPlayerList()

    local list = {}

    for _, player in pairs(Players:GetPlayers()) do

        if player ~= LocalPlayer then
            table.insert(list, player.Name)
        end

    end

    return list

end

local PlayerDropdown = Tabs.Player:Dropdown({
    Title = "选择目标玩家",
    Values = GetPlayerList(),
    Value = nil,

    Callback = function(value)

        SelectedPlayerName = value

        if IsSpectating and SelectedPlayerName then

            local target =
                Players:FindFirstChild(SelectedPlayerName)

            if target
            and target.Character
            and target.Character:FindFirstChild("Humanoid") then

                Camera.CameraSubject =
                    target.Character.Humanoid

            end

        end

    end
})

Tabs.Player:Button({
    Title = "刷新玩家列表",
    Desc = "更新在线玩家",

    Callback = function()

        PlayerDropdown:Refresh(GetPlayerList())

        WindUI:Notify({
            Title = "列表已更新",
            Content = "已重新获取房间玩家名单",
            Duration = 3
        })

    end
})

Tabs.Player:Toggle({
    Title = "观看视角",
    Desc = "锁定目标玩家视角",
    Value = false,

    Callback = function(state)

        IsSpectating = state

        if IsSpectating then

            if SelectedPlayerName then

                local target =
                    Players:FindFirstChild(
                        SelectedPlayerName
                    )

                if target
                and target.Character
                and target.Character
                    :FindFirstChild("Humanoid") then

                    Camera.CameraSubject =
                        target.Character.Humanoid

                    WindUI:Notify({
                        Title = "视角切换",
                        Content = "正在观看: "
                            .. SelectedPlayerName,
                        Duration = 3
                    })

                else

                    WindUI:Notify({
                        Title = "错误",
                        Content = "无法找到玩家",
                        Duration = 3
                    })

                end

            else

                WindUI:Notify({
                    Title = "提示",
                    Content = "请先选择玩家",
                    Duration = 3
                })

            end

        else

            local char = LocalPlayer.Character

            if char and char:FindFirstChild("Humanoid") then

                Camera.CameraSubject =
                    char.Humanoid

            end

            WindUI:Notify({
                Title = "视角恢复",
                Content = "已返回自己的视角",
                Duration = 3
            })

        end

    end
})

Players.PlayerRemoving:Connect(function(player)

    if player.Name == SelectedPlayerName
    and IsSpectating then

        local char = LocalPlayer.Character

        if char and char:FindFirstChild("Humanoid") then

            Camera.CameraSubject =
                char.Humanoid

        end

        IsSpectating = false

        WindUI:Notify({
            Title = "目标已离开",
            Content = "已恢复自己的视角",
            Duration = 3
        })

    end

    PlayerDropdown:Refresh(GetPlayerList())

end)

