local BusoEnabled = false
local Player = game.Players.LocalPlayer

Tabs.Main:Toggle({
    Title = "Auto Buso",
    Value = false,

    Callback = function(state)
        BusoEnabled = state
        print("自動武裝色狀態:", state)
    end
})

local function ToggleBuso()

    if BusoEnabled then

        local Character = Player.Character
        if not Character then
            return
        end

        if not Character:FindFirstChild("HasBuso") then

            local remote =
                game:GetService("ReplicatedStorage")
                :WaitForChild("Remotes")
                :FindFirstChild("CommF_")

            if remote then
                remote:InvokeServer("Buso")
            end

        end

    end

end

task.spawn(function()

    while true do

        if BusoEnabled then
            pcall(ToggleBuso)
        end

        task.wait(1)

    end

end)

