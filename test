--------------------------------------------------
-- PLAYER TAB
--------------------------------------------------

local SelectedPlayerName = nil
local IsSpectating = false

local function GetPlayerList()

    local list = {}

    for _, player in pairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer then
            table.insert(list, player.Name)
        end

    end

    return list

end

local PlayerDropdown =
    PlayerTab:AddDropdown({

    Title = "选择目标玩家",
    Desc = "选择观看目标",
    Multi = false,
    Options = GetPlayerList(),

    Callback = function(value)

        SelectedPlayerName = value

        if IsSpectating
        and SelectedPlayerName then

            local target =
                Players:FindFirstChild(
                    SelectedPlayerName
                )

            if target
            and target.Character
            and target.Character
                :FindFirstChild("Humanoid") then

                Camera.CameraSubject =
                    target.Character.Humanoid

            end

        end

    end
})

PlayerTab:AddButton({
    Title = "刷新玩家列表",
    Desc = "更新在线玩家",

    Callback = function()

        PlayerDropdown:Refresh(
            GetPlayerList(),
            true
        )

        WindUI:Notify({
            Title = "刷新成功",
            Content = "玩家列表已更新"
        })

    end
})

PlayerTab:AddToggle({
    Title = "观看视角",
    Desc = "锁定目标玩家视角",
    Value = false,

    Callback = function(state)

        IsSpectating = state

        if state then

            if SelectedPlayerName then

                local target =
                    Players:FindFirstChild(
                        SelectedPlayerName
                    )

                if target
                and target.Character
                and target.Character
                    :FindFirstChild("Humanoid") then

                    Camera.CameraSubject =
                        target.Character.Humanoid

                    WindUI:Notify({
                        Title = "观看玩家",
                        Content =
                            SelectedPlayerName
                    })

                end

            end

        else

            local char =
                LocalPlayer.Character

            if char
            and char:FindFirstChild(
                "Humanoid"
            ) then

                Camera.CameraSubject =
                    char.Humanoid

            end

        end

    end
})

Players.PlayerRemoving:Connect(function(player)

    PlayerDropdown:Refresh(
        GetPlayerList(),
        true
    )

    if player.Name
    == SelectedPlayerName then

        local char =
            LocalPlayer.Character

        if char
        and char:FindFirstChild(
            "Humanoid"
        ) then

            Camera.CameraSubject =
                char.Humanoid

        end

    end

end)
