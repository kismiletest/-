local player = game:GetService("Players").LocalPlayer
local RunService = game:GetService("RunService")
local VirtualInputManager = game:GetService("VirtualInputManager")

local voidCharacter
local voidRoot

local function SetupCharacter(char)
    voidCharacter = char
    voidRoot = char:WaitForChild("HumanoidRootPart")
end

if player.Character then
    SetupCharacter(player.Character)
end

player.CharacterAdded:Connect(function(char)
    SetupCharacter(char)
end)

local VoidState = {
    VoidTime = 0.55,
    TP_Pos = Vector3.new(0, -200000, 0),
    IsTeleporting = false
}

local function TPVoid(preSavedCFrame)
    if VoidState.IsTeleporting then return end
    if not voidRoot or not voidCharacter then return end

    local humanoid = voidCharacter:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    
    -- Check for any teleport configurations and stop follow if needed
    if _G.Config and _G.Config.Teleport and _G.Config.Teleport.Enabled then
        if _G.Config.Teleport.Enabled.ToPlayer or _G.Config.Teleport.Enabled.Bypass then 
            if stopFollow then stopFollow() end
        end
    end

    VoidState.IsTeleporting = true

    local heartbeatConn
    heartbeatConn = RunService.Heartbeat:Connect(function()
        if voidRoot then
            local pos = voidRoot.Position
            voidRoot.CFrame = CFrame.new(pos.X, VoidState.TP_Pos.Y, pos.Z)
            voidRoot.AssemblyLinearVelocity = Vector3.zero
        end
    end)

    task.wait(VoidState.VoidTime)

    if heartbeatConn then
        heartbeatConn:Disconnect()
    end
    
    local TPbackConn

    if voidRoot and humanoid.Health > 0 then
        TPbackConn = RunService.Heartbeat:Connect(function()
            voidRoot.CFrame = preSavedCFrame + Vector3.new(0, 0.5, 0)
            voidRoot.AssemblyLinearVelocity = Vector3.zero
            voidRoot.AssemblyAngularVelocity = Vector3.zero
        end)
    end

    task.wait(0.4)

    if TPbackConn then
        TPbackConn:Disconnect()
    end

    VoidState.IsTeleporting = false
    
    -- Resume follow if needed
    if _G.Config and _G.Config.Teleport and _G.Config.Teleport.Enabled then
        if _G.Config.Teleport.Enabled.ToPlayer or _G.Config.Teleport.Enabled.Bypass then 
            if startFollow then startFollow() end
        end
    end
end

local function ListenForHits()
    local soundsFolder = workspace:WaitForChild("_WorldOrigin"):WaitForChild("Sounds")
    local trackedSounds = {}

    RunService.RenderStepped:Connect(function()
        if not voidRoot then return end

        for _, obj in ipairs(soundsFolder:GetDescendants()) do
            if obj:IsA("Sound") and not trackedSounds[obj] then
                -- Always listen for these sounds (no config checks)
                if obj.Name == "SaddiHit" then
                    trackedSounds[obj] = true
                    TPVoid(voidRoot.CFrame)
                elseif obj.Name == "DoughDrip" then
                    trackedSounds[obj] = true
                    TPVoid(voidRoot.CFrame)
                end
            end
        end

        -- Clean up tracked sounds that no longer exist
        for soundObj in pairs(trackedSounds) do
            if not soundObj:IsDescendantOf(soundsFolder) then
                trackedSounds[soundObj] = nil
            end
        end
    end)
end

-- Initialize the listener
ListenForHits()

-- Optional: Keep these functions if you need them for other purposes
local function equipByType(toolType)
    local char = player.Character or player.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid")

    for _, tool in ipairs(player.Backpack:GetChildren()) do
        if tool:IsA("Tool") and tool.ToolTip == toolType then
            hum:EquipTool(tool)
            break
        end
    end
end

local function pressZ()
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Z, false, game)
    task.wait(0.08)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Z, false, game)
end
