repeat task.wait() until game:IsLoaded()

--// Rayfield Loader
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

--------------------------------------------------
-- SERVICES
--------------------------------------------------

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local VirtualInputManager = game:GetService("VirtualInputManager")

local LocalPlayer = Players.LocalPlayer

--------------------------------------------------
-- VARIABLES & LOGIC
--------------------------------------------------

-- Auto V3
local AutoV3 = false
local AutoV3Task = nil

local function StartAutoV3()
    if AutoV3Task then return end

    AutoV3Task = task.spawn(function()
        while AutoV3 do
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.T, false, game)
            task.wait(1)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.T, false, game)
            task.wait(1)
        end

        AutoV3Task = nil
    end)
end

-- Auto V4
local AutoV4 = false
local autoV4Connection = nil

local function getAwakeningRemote()
    local backpack = LocalPlayer:FindFirstChild("Backpack")

    if backpack then
        local awakening = backpack:FindFirstChild("Awakening")

        if awakening then
            return awakening:FindFirstChild("RemoteFunction")
        end
    end

    return nil
end

local function startV4Loop()
    if autoV4Connection then
        autoV4Connection:Disconnect()
    end

    pcall(function()
        local r = getAwakeningRemote()

        if r then
            r:InvokeServer(true)
        end
    end)

    autoV4Connection = RunService.Heartbeat:Connect(function()
        if not AutoV4 then return end

        local r = getAwakeningRemote()

        if r then
            pcall(function()
                r:InvokeServer(true)
            end)
        end
    end)
end

