--// 高级玩家列表
local PlayerItems = {}

local function CreatePlayerEntry(player)

    local thumb, isReady = game.Players:GetUserThumbnailAsync(
        player.UserId,
        Enum.ThumbnailType.HeadShot,
        Enum.ThumbnailSize.Size150x150
    )

    local level = 0

    local stats = player:FindFirstChild("leaderstats")

    if stats then

        local lObj =
            stats:FindFirstChild("Level")
            or stats:FindFirstChild("Lv")
            or stats:FindFirstChild("等级")

        if lObj then
            level = lObj.Value
        end
    end

    local function getDesc()

        local char = player.Character
        local hum = char and char:FindFirstChild("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")

        local lpRoot =
            game.Players.LocalPlayer.Character
            and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

        local hp = hum and math.floor(hum.Health) or 0

        local dist =
            (root and lpRoot)
            and math.floor((root.Position - lpRoot.Position).Magnitude)
            or 0

        return string.format(
            "等级: %d | 血量: %d | 距离: %d studs",
            level,
            hp,
            dist
        )
    end

    local entry = PlayerTab:CreateButton({
        Name = player.DisplayName .. " (@" .. player.Name .. ")",

        Callback = function()

            Rayfield:Notify({
                Title = "玩家操作",
                Content = "已选择玩家: " .. player.Name,
                Duration = 3,
                Image = 4483362458
            })
        end
    })

    if entry.SetImage then
        entry:SetImage(isReady and thumb or "rbxassetid://15124031024")
    end

    if entry.SetDesc then
        entry:SetDesc(getDesc())
    end

    PlayerItems[player.UserId] = {
        UI = entry,
        Player = player
    }
end

local function Synchronize()

    -- 删除离开的玩家
    for userId, data in pairs(PlayerItems) do

        if not game.Players:FindFirstChild(data.Player.Name) then

            data.UI:Destroy()
            PlayerItems[userId] = nil
        end
    end

    -- 添加/更新玩家
    for _, player in pairs(game.Players:GetPlayers()) do

        if not PlayerItems[player.UserId] then

            CreatePlayerEntry(player)

        else

            local data = PlayerItems[player.UserId]

            local char = player.Character
            local hum = char and char:FindFirstChild("Humanoid")
            local root = char and char:FindFirstChild("HumanoidRootPart")

            local lpRoot =
                game.Players.LocalPlayer.Character
                and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

            local hp = hum and math.floor(hum.Health) or 0

            local dist =
                (root and lpRoot)
                and math.floor((root.Position - lpRoot.Position).Magnitude)
                or 0

            if data.UI.SetDesc then

                data.UI:SetDesc(string.format(
                    "血量: %d | 距离: %d studs | 更新时间: %s",
                    hp,
                    dist,
                    os.date("%X")
                ))
            end
        end
    end
end

Synchronize()

game.Players.PlayerAdded:Connect(function()
    task.wait(1)
    Synchronize()
end)

game.Players.PlayerRemoving:Connect(function()
    Synchronize()
end)

task.spawn(function()

    while true do

        Synchronize()

        task.wait(5)
    end
end)

--// 玩家ESP
local ESP_Enabled = false

MainTab:CreateToggle({
    Name = "开启玩家透视",
    CurrentValue = false,
    Flag = "PlayerESP",

    Callback = function(State)
        ESP_Enabled = State
    end
})

local function updateESP(player)

    if player == game.Players.LocalPlayer then
        return
    end

    local function setupCharacter(char)

        local root = char:WaitForChild("HumanoidRootPart", 10)
        local hum = char:WaitForChild("Humanoid", 10)

        if not root or not hum then
            return
        end

        local highlight = char:FindFirstChild("WindHighlight")
            or Instance.new("Highlight")

        highlight.Name = "WindHighlight"
        highlight.Parent = char
        highlight.FillColor = Color3.fromRGB(0,255,255)
        highlight.OutlineColor = Color3.fromRGB(255,255,255)

        local head = char:WaitForChild("Head")

        local billboard = head:FindFirstChild("WindESP_Tag")
            or Instance.new("BillboardGui")

        billboard.Name = "WindESP_Tag"
        billboard.Parent = head
        billboard.Size = UDim2.new(0,150,0,70)
        billboard.StudsOffset = Vector3.new(0,3,0)
        billboard.AlwaysOnTop = true

        local infoLabel = billboard:FindFirstChild("Info")
            or Instance.new("TextLabel")

        infoLabel.Name = "Info"
        infoLabel.Parent = billboard
        infoLabel.Size = UDim2.new(1,0,0.4,0)
        infoLabel.BackgroundTransparency = 1
        infoLabel.TextColor3 = Color3.new(1,1,1)
        infoLabel.TextStrokeTransparency = 0
        infoLabel.TextSize = 13
        infoLabel.Font = Enum.Font.GothamBold

        local healthBarBG = billboard:FindFirstChild("HealthBG")
            or Instance.new("Frame")

        healthBarBG.Name = "HealthBG"
        healthBarBG.Parent = billboard
        healthBarBG.Position = UDim2.new(0.25,0,0.5,0)
        healthBarBG.Size = UDim2.new(0.5,0,0.1,0)
        healthBarBG.BackgroundColor3 = Color3.new(0,0,0)
        healthBarBG.BorderSizePixel = 0

        local healthBar = healthBarBG:FindFirstChild("Bar")
            or Instance.new("Frame")

        healthBar.Name = "Bar"
        healthBar.Parent = healthBarBG
        healthBar.Size = UDim2.new(1,0,1,0)
        healthBar.BackgroundColor3 = Color3.new(0,1,0)
        healthBar.BorderSizePixel = 0

        task.spawn(function()

            while char and char.Parent and billboard.Parent do

                if ESP_Enabled then

                    local LocalCharacter = game.Players.LocalPlayer.Character
                    local LocalRoot = LocalCharacter and LocalCharacter:FindFirstChild("HumanoidRootPart")

                    local dist = 0

                    if LocalRoot then
                        dist = (root.Position - LocalRoot.Position).Magnitude
                    end

                    highlight.Enabled = true
                    billboard.Enabled = true

                    infoLabel.Text = string.format(
                        "%s\n[%d m]",
                        player.Name,
                        math.floor(dist)
                    )

                    local hpPercent = hum.Health / hum.MaxHealth

                    healthBar.Size = UDim2.new(hpPercent,0,1,0)

                    healthBar.BackgroundColor3 = Color3.fromHSV(
                        hpPercent * 0.3,
                        1,
                        1
                    )

                else

                    highlight.Enabled = false
                    billboard.Enabled = false
                end

                task.wait(0.1)
            end
        end)
    end

    if player.Character then
        setupCharacter(player.Character)
    end

    player.CharacterAdded:Connect(setupCharacter)
end

for _, p in pairs(game.Players:GetPlayers()) do
    updateESP(p)
end

game.Players.PlayerAdded:Connect(updateESP)
