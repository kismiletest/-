--// 超高空传送
MainTab:CreateButton({
    Name = "超高空传送",
    Callback = function()
        local char = game.Players.LocalPlayer.Character
        if not char then return end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        hrp.CFrame = CFrame.new(
            hrp.Position.X,
            hrp.Position.Y + 5000,
            hrp.Position.Z
        )

        Rayfield:Notify({
            Title = "传送成功",
            Content = "已移动到高空",
            Duration = 3,
            Image = 4483362458
        })
    end
})

--// Auto Buso
local Player = game.Players.LocalPlayer
local BusoEnabled = false

local function ToggleBuso()
    if BusoEnabled then
        if not Player.Character:FindFirstChild("HasBuso") then
            local remote = game:GetService("ReplicatedStorage")
                :WaitForChild("Remotes")
                :FindFirstChild("CommF_")

            if remote then
                remote:InvokeServer("Buso")
            end
        end
    end
end

task.spawn(function()
    while true do
        if BusoEnabled then
            pcall(ToggleBuso)
        end
        task.wait(1)
    end
end)

MainTab:CreateToggle({
    Name = "Auto Buso",
    CurrentValue = false,
    Flag = "AutoBuso",
    Callback = function(state)
        BusoEnabled = state
        print("自动武装色状态:", state)
    end
})

--// Auto V3
MainTab:CreateToggle({
    Name = "Auto V3",
    CurrentValue = false,
    Flag = "AutoV3",
    Callback = function(state)
        AutoV3.Enabled = state

        if state then
            StartAutoV3()
        else
            StopAutoV3()
        end
    end
})

