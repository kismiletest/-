--// WindUI Loader
local WindUI = loadstring(game:HttpGet("https://tree-hub.vercel.app/api/UI/WindUI"))()

pcall(function()
    if game.CoreGui:FindFirstChild("WindUI") then
        game.CoreGui.WindUI:Destroy()
    end
end)

--// Window
local Window = WindUI:CreateWindow({
    Title = "Sailor Piece",
    Icon = "anchor",
    Author = "OpenAI",
    Folder = "SailorPiece",
    Size = UDim2.fromOffset(520, 420),
    Transparent = true,
    Theme = "Dark"
})

--// Tab
local MainTab = Window:CreateTab("复制材料", "package")

--// 材料数据
local MaterialText = [[
WOOD_LOG x99
IRON_ORE x50
RUM_BOTTLE x5
]]

--// Sailor Piece 风格标题
MainTab:AddParagraph({
    Title = "⚓ Sailor Piece Material Card",
    Desc = "物资补给清单"
})

--// 材料显示元件
local MaterialParagraph = MainTab:AddParagraph({
    Title = " 当前材料",
    Desc = MaterialText
})

--// 复制材料按钮
MainTab:AddButton({
    Title = "📋 复制材料",
    Desc = "点击复制全部材料",
    Callback = function()

        if setclipboard then
            setclipboard(MaterialText)
        end

        WindUI:Notify({
            Title = "复制成功",
            Content = "材料已复制到剪贴板",
            Type = "Success"
        })
    end
})

--// 更新材料按钮
MainTab:AddButton({
    Title = "🔄 刷新材料",
    Desc = "随机刷新 Sailor Piece 材料",
    Callback = function()

        local Materials = {
            [[
WOOD_LOG x120
SEA_CRYSTAL x15
RUM_BOTTLE x3
            ]],

            [[
GOLD_COIN x50
DEVIL_FRUIT x1
IRON_ORE x80
            ]],

            [[
SHARK_FIN x20
TREASURE_MAP x5
WOOD_LOG x60
            ]]
        }

        MaterialText = Materials[math.random(1, #Materials)]

        if MaterialParagraph and MaterialParagraph.Set then
            MaterialParagraph:Set({
                Title = " 当前材料",
                Desc = MaterialText
            })
        end

        WindUI:Notify({
            Title = "库存已更新",
            Content = "新的 Sailor Piece 材料已生成",
            Type = "Info"
        })
    end
})

--// 状态
MainTab:AddParagraph({
    Title = " 在线状态",
    Desc = "航向：伟大航道"
})

--// 加载通知
WindUI:Notify({
    Title = "Sailor Piece",
    Content = "复制材料元件加载完成",
    Type = "Success"
})
