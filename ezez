--// WindUI Loader
local WindUI = loadstring(game:HttpGet("https://tree-hub.vercel.app/api/UI/WindUI"))()

pcall(function()
    if game.CoreGui:FindFirstChild("WindUI") then
        game.CoreGui.WindUI:Destroy()
    end
end)

--// Window
local Window = WindUI:CreateWindow({
    Title = "Blox Fruits",
    Icon = "star",
    Author = "OpenAI",
    Folder = "BloxFruits_Materials",
    Size = UDim2.fromOffset(540, 430),
    Transparent = true,
    Theme = "Dark"
})

--// Tab
local MainTab = Window:CreateTab("自动材料", "package")

--// 材料文本
local MaterialText = [[
✦ Bones: 5,000
✦ Ectoplasm: 150
✦ Dragon Scale: 10
✦ Conjured Cocoa: 25
]]

--// 顶部状态
MainTab:AddParagraph({
    Title = "🍈 BLOX FRUITS",
    Desc = "Auto Collecting..."
})

--// 等级信息
MainTab:AddParagraph({
    Title = "📊 玩家状态",
    Desc = "LV.2550 | Sea 3"
})

--// 材料列表
MainTab:AddParagraph({
    Title = "📦 已收集材料清单",
    Desc = MaterialText
})

--// 复制按钮
MainTab:AddButton({
    Title = "📋 复制所有材料文本",
    Desc = "复制当前全部材料",
    Callback = function()

        if setclipboard then
            setclipboard(MaterialText)
        end

        WindUI:Notify({
            Title = "✨ 霸气加载完成！",
            Content = "材料文本已复制",
            Type = "Success"
        })
    end
})

--// 自动刷新材料
MainTab:AddButton({
    Title = "🔄 自动刷新材料",
    Desc = "随机生成新的材料库存",
    Callback = function()

        local RandomMaterials = {
            [[
✦ Bones: 9000
✦ Ectoplasm: 500
✦ Dragon Scale: 45
✦ Conjured Cocoa: 120
            ]],

            [[
✦ Mystic Droplet: 300
✦ Gunpowder: 80
✦ Mini Tusk: 20
✦ Fish Tail: 55
            ]],

            [[
✦ Scrap Metal: 1500
✦ Angel Wing: 35
✦ Vampire Fang: 18
✦ Leather: 999
            ]]
        }

        MaterialText = RandomMaterials[math.random(1,#RandomMaterials)]

        WindUI:Notify({
            Title = "⚡ 自动收集更新",
            Content = "新的材料库存已生成",
            Type = "Info"
        })
    end
})

--// 底部状态
MainTab:AddParagraph({
    Title = "🟢 系统状态",
    Desc = "Auto Farming Materials..."
})

--// 启动通知
WindUI:Notify({
    Title = "Blox Fruits",
    Content = "Auto-Material Component 已加载",
    Type = "Success"
})
