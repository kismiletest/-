--// 玩家列表系统
local PlayerUIEntries = {}

local function UpdatePlayerEntry(player)

    if not player or not player.Parent then

        if PlayerUIEntries[player.UserId] then
            PlayerUIEntries[player.UserId]:Destroy()
            PlayerUIEntries[player.UserId] = nil
        end

        return
    end

    if PlayerUIEntries[player.UserId] then

        local entry = PlayerUIEntries[player.UserId]

        local hum = player.Character and player.Character:FindFirstChild("Humanoid")

        local hp = hum and math.floor(hum.Health) or 0
        local maxHp = hum and math.floor(hum.MaxHealth) or 100

        entry:SetDesc(string.format(
            "血量: %d/%d | 状态: %s",
            hp,
            maxHp,
            (hp > 0 and "存活" or "死亡")
        ))

        return
    end

    local thumb, isReady = game.Players:GetUserThumbnailAsync(
        player.UserId,
        Enum.ThumbnailType.HeadShot,
        Enum.ThumbnailSize.Size150x150
    )

    local newEntry = PlayerTab:CreateButton({
        Name = player.DisplayName .. " (@" .. player.Name .. ")",

        Callback = function()

            Rayfield:Notify({
                Title = "玩家信息",
                Content = "选中了 " .. player.Name,
                Duration = 3,
                Image = 4483362458
            })
        end
    })

    if newEntry.SetImage then
        newEntry:SetImage(isReady and thumb or "rbxassetid://15124031024")
    end

    if newEntry.SetDesc then
        newEntry:SetDesc("正在获取状态...")
    end

    PlayerUIEntries[player.UserId] = newEntry
end

local function ScanPlayers()

    for _, player in pairs(game.Players:GetPlayers()) do
        UpdatePlayerEntry(player)
    end

    for userId, uiInstance in pairs(PlayerUIEntries) do

        local isStillHere = false

        for _, p in pairs(game.Players:GetPlayers()) do

            if p.UserId == userId then
                isStillHere = true
                break
            end
        end

        if not isStillHere then

            uiInstance:Destroy()
            PlayerUIEntries[userId] = nil
        end
    end
end

ScanPlayers()

game.Players.PlayerAdded:Connect(function()
    task.wait(1)
    ScanPlayers()
end)

game.Players.PlayerRemoving:Connect(function()
    ScanPlayers()
end)

task.spawn(function()

    while true do

        ScanPlayers()

        task.wait(2)
    end
end)

--// 玩家ESP
local ESP_Enabled = false

MainTab:CreateToggle({
    Name = "开启玩家透视",
    CurrentValue = false,
    Flag = "PlayerESP",

    Callback = function(State)
        ESP_Enabled = State
    end
})

--// ESP 核心
local function updateESP(player)

    if player == game.Players.LocalPlayer then
        return
    end

    local function setupCharacter(char)

        local root = char:WaitForChild("HumanoidRootPart", 10)
        local hum = char:WaitForChild("Humanoid", 10)

        if not root or not hum then
            return
        end

        local highlight = char:FindFirstChild("WindHighlight")
            or Instance.new("Highlight")

        highlight.Name = "WindHighlight"
        highlight.Parent = char
        highlight.FillColor = Color3.fromRGB(0,255,255)
        highlight.OutlineColor = Color3.fromRGB(255,255,255)

        local head = char:WaitForChild("Head")

        local billboard = head:FindFirstChild("WindESP_Tag")
            or Instance.new("BillboardGui")

        billboard.Name = "WindESP_Tag"
        billboard.Parent = head
        billboard.Size = UDim2.new(0,150,0,70)
        billboard.StudsOffset = Vector3.new(0,3,0)
        billboard.AlwaysOnTop = true

        local infoLabel = billboard:FindFirstChild("Info")
            or Instance.new("TextLabel")

        infoLabel.Name = "Info"
        infoLabel.Parent = billboard
        infoLabel.Size = UDim2.new(1,0,0.4,0)
        infoLabel.BackgroundTransparency = 1
        infoLabel.TextColor3 = Color3.new(1,1,1)
        infoLabel.TextStrokeTransparency = 0
        infoLabel.TextSize = 13
        infoLabel.Font = Enum.Font.GothamBold

        local healthBarBG = billboard:FindFirstChild("HealthBG")
            or Instance.new("Frame")

        healthBarBG.Name = "HealthBG"
        healthBarBG.Parent = billboard
        healthBarBG.Position = UDim2.new(0.25,0,0.5,0)
        healthBarBG.Size = UDim2.new(0.5,0,0.1,0)
        healthBarBG.BackgroundColor3 = Color3.new(0,0,0)
        healthBarBG.BorderSizePixel = 0

        local healthBar = healthBarBG:FindFirstChild("Bar")
            or Instance.new("Frame")

        healthBar.Name = "Bar"
        healthBar.Parent = healthBarBG
        healthBar.Size = UDim2.new(1,0,1,0)
        healthBar.BackgroundColor3 = Color3.new(0,1,0)
        healthBar.BorderSizePixel = 0

        task.spawn(function()

            while char and char.Parent and billboard.Parent do

                if ESP_Enabled then

                    local LocalCharacter = game.Players.LocalPlayer.Character
                    local LocalRoot = LocalCharacter and LocalCharacter:FindFirstChild("HumanoidRootPart")

                    local dist = 0

                    if LocalRoot then
                        dist = (root.Position - LocalRoot.Position).Magnitude
                    end

                    highlight.Enabled = true
                    billboard.Enabled = true

                    infoLabel.Text = string.format(
                        "%s\n[%d m]",
                        player.Name,
                        math.floor(dist)
                    )

                    local hpPercent = hum.Health / hum.MaxHealth

                    healthBar.Size = UDim2.new(hpPercent,0,1,0)

                    healthBar.BackgroundColor3 = Color3.fromHSV(
                        hpPercent * 0.3,
                        1,
                        1
                    )

                else

                    highlight.Enabled = false
                    billboard.Enabled = false
                end

                task.wait(0.1)
            end
        end)
    end

    if player.Character then
        setupCharacter(player.Character)
    end

    player.CharacterAdded:Connect(setupCharacter)
end

for _, p in pairs(game.Players:GetPlayers()) do
    updateESP(p)
end

game.Players.PlayerAdded:Connect(updateESP)
