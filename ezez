local MainTab = Window:CreateTab("Main", 4483362458)

--------------------------------------------------
-- SECTION
--------------------------------------------------

MainTab:CreateParagraph({
    Title = "PVP",
    Content = "Combat Functions"
})

--------------------------------------------------
-- BUTTON
--------------------------------------------------

MainTab:CreateButton({
    Name = "全圖秒殺",
    Callback = function()
        local char = LocalPlayer.Character
