local WindUI = loadstring(game:HttpGet("https://tree-hub.vercel.app/api/UI/WindUI"))()

local Window = WindUI:CreateWindow({
    Title = "Advanced Player List",
    Icon = "rbxassetid://10734951102",
    Author = "Gemini Editor",
    Folder = "Custom_PlayerList"
})

local MainTab = Window:Tab({
    Title = "玩家管理",
    Icon = "users"
})

-- 存储 UI 实例，避免重复
local PlayerItems = {}

-- 核心：创建/更新单个玩家条目
local function CreatePlayerEntry(player)
    -- 1. 获取头像 (HeadShot)
    local thumb, isReady = game.Players:GetUserThumbnailAsync(
        player.UserId,
        Enum.ThumbnailType.HeadShot,
        Enum.ThumbnailSize.Size150x150
    )

    -- 2. 获取等级 (兼容常见游戏 leaderstats)
    local level = 0
    local stats = player:FindFirstChild("leaderstats")
    if stats then
        local lObj = stats:FindFirstChild("Level") or stats:FindFirstChild("Lv") or stats:FindFirstChild("等级")
        if lObj then level = lObj.Value end
    end

    -- 3. 构建描述信息 (血量、等级、距离)
    local function getDesc()
        local char = player.Character
        local hum = char and char:FindFirstChild("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local lpRoot = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        
        local hp = hum and math.floor(hum.Health) or 0
        local dist = (root and lpRoot) and math.floor((root.Position - lpRoot.Position).Magnitude) or 0
        
        return string.format("等级: %d | 血量: %d | 距离: %d studs", level, hp, dist)
    end

    -- 4. 创建 WindUI 元件
    local entry = MainTab:Button({
        Title = player.DisplayName .. " (@" .. player.Name .. ")",
        Desc = getDesc(),
        Image = isReady and thumb or "rbxassetid://15124031024",
        Callback = function()
            -- 模拟高级脚本的点击操作菜单
            WindUI:Notify({
                Title = "玩家操作: " .. player.Name,
                Content = "已选择该玩家，你可以添加传送、追踪等功能",
                Duration = 3
            })
            -- 示例操作：传送到该玩家
            -- if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            --    game.Players.LocalPlayer.Character:MoveTo(player.Character.HumanoidRootPart.Position)
            -- end
        end
    })

    PlayerItems[player.UserId] = {
        UI = entry,
        Player = player
    }
end

-- 扫描并同步函数
local function Synchronize()
    -- 清理已经离开的人
    for userId, data in pairs(PlayerItems) do
        if not game.Players:FindFirstChild(data.Player.Name) then
            data.UI:Destroy()
            PlayerItems[userId] = nil
        end
    end

    -- 添加新人或更新旧人描述
    for _, player in pairs(game.Players:GetPlayers()) do
        if not PlayerItems[player.UserId] then
            CreatePlayerEntry(player)
        else
            -- 仅更新描述，不重建 UI，防止闪烁
            local data = PlayerItems[player.UserId]
            local char = player.Character
            local hum = char and char:FindFirstChild("Humanoid")
            local hp = hum and math.floor(hum.Health) or 0
            
            -- 这里由于 WindUI 限制，通常直接更新文字可能需要封装
            -- 如果你的 WindUI 版本支持 SetDesc，可以调用：
            if data.UI.SetDesc then
                data.UI:SetDesc(string.format("更新时间: %s | 血量: %d", os.date("%X"), hp))
            end
        end
    end
end

-- --- 自动化执行 ---

-- 初始化加载
Synchronize()

-- 监听事件
game.Players.PlayerAdded:Connect(function(p)
    task.wait(1)
    Synchronize()
end)

game.Players.PlayerRemoving:Connect(Synchronize)

-- 持续后台静默刷新 (每 5 秒刷新一次数据，保持流畅)
task.spawn(function()
    while true do
        Synchronize()
        task.wait(5)
    end
end)
