--// WindUI 初始化
local WindUI = loadstring(game:HttpGet("https://tree-hub.vercel.app/api/UI/WindUI"))()

pcall(function()
    if game.CoreGui:FindFirstChild("WindUI") then
        game.CoreGui.WindUI:Destroy()
    end
end)

--// 创建窗口
local Window = WindUI:CreateWindow({
    Title = "Universal Hub",
    Icon = "gem",
    Author = "OpenAI",
    Folder = "UniversalHub_Config",
    Size = UDim2.fromOffset(580, 460),
    Transparent = true,
    Theme = "Dark"
})

--// 空白 Tabs
local MainTab = Window:CreateTab("主页", "home")
local PlayerTab = Window:CreateTab("玩家", "user")
local ESPTab = Window:CreateTab("ESP", "eye")
local TeleportTab = Window:CreateTab("传送", "map")
local CombatTab = Window:CreateTab("战斗", "sword")
local MiscTab = Window:CreateTab("杂项", "settings")

--// 示例 UI
MainTab:AddParagraph({
    Title = "空白 WindUI",
    Desc = "这是一个干净的 WindUI 模板，可自行添加功能。"
})

MainTab:AddButton({
    Title = "测试通知",
    Desc = "点击测试 WindUI",
    Callback = function()
        WindUI:Notify({
            Title = "WindUI",
            Content = "运行成功",
            Type = "Success"
        })
    end
})

--// 状态
local PlayerESP = false
local MonsterESP = false

--// ESP 开关
ESPTab:AddToggle({
    Title = "玩家 ESP",
    Value = false,
    Callback = function(v)
        PlayerESP = v
        print("Player ESP:", v)
    end
})

ESPTab:AddToggle({
    Title = "怪物 ESP",
    Value = false,
    Callback = function(v)
        MonsterESP = v
        print("Monster ESP:", v)
    end
})

--// 玩家 Tab
PlayerTab:AddSlider({
    Title = "移动速度",
    Min = 16,
    Max = 200,
    Default = 16,
    Callback = function(v)
        local char = game.Players.LocalPlayer.Character
        if char and char:FindFirstChildOfClass("Humanoid") then
            char:FindFirstChildOfClass("Humanoid").WalkSpeed = v
        end
    end
})

PlayerTab:AddSlider({
    Title = "跳跃高度",
    Min = 50,
    Max = 250,
    Default = 50,
    Callback = function(v)
        local char = game.Players.LocalPlayer.Character
        if char and char:FindFirstChildOfClass("Humanoid") then
            char:FindFirstChildOfClass("Humanoid").JumpPower = v
        end
    end
})

--// 战斗 Tab
CombatTab:AddButton({
    Title = "测试攻击",
    Desc = "这里只是占位功能",
    Callback = function()
        WindUI:Notify({
            Title = "Combat",
            Content = "功能待添加",
            Type = "Info"
        })
    end
})

--// 传送 Tab
TeleportTab:AddButton({
    Title = "回到出生点",
    Callback = function()
        local char = game.Players.LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = CFrame.new(0,10,0)
        end
    end
})

--// 杂项 Tab
MiscTab:AddButton({
    Title = "销毁 UI",
    Desc = "关闭整个 WindUI",
    Callback = function()
        pcall(function()
            game.CoreGui.WindUI:Destroy()
        end)
    end
})

--// 加载通知
WindUI:Notify({
    Title = "Universal Hub",
    Content = "空白 WindUI 已加载",
    Type = "Success"
})
