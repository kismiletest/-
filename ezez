--// EN Hub x Rayfield UI

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

--// Window
local Window = Rayfield:CreateWindow({
    Name = "1.en Hub",
    LoadingTitle = "1.en Hub Loading...",
    LoadingSubtitle = "Rayfield Interface",
    
    ConfigurationSaving = {
        Enabled = true,
        FolderName = "1enHub",
        FileName = "1enHubConfig"
    },

    Discord = {
        Enabled = false,
        Invite = "",
        RememberJoins = false
    },

    KeySystem = false
})

--// Main Tab
local MainTab = Window:CreateTab("Main", 4483362458)

--// Paragraph
MainTab:CreateParagraph({
    Title = "1.en Hub",
    Content = "欢迎使用 1.en Hub"
})

--// Button
MainTab:CreateButton({
    Name = "超高空传送",
    Callback = function()
        local char = game.Players.LocalPlayer.Character
        if not char then return end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        hrp.CFrame = CFrame.new(
            hrp.Position.X,
            hrp.Position.Y + 5000,
            hrp.Position.Z
        )

        Rayfield:Notify({
            Title = "传送成功",
            Content = "已移动到高空",
            Duration = 3,
            Image = 4483362458
        })
    end
})
