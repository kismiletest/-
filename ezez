# WindUI 集成 Sailor Piece Material Card

```lua
--// WindUI Loader
local WindUI = loadstring(game:HttpGet("https://tree-hub.vercel.app/api/UI/WindUI"))()

pcall(function()
    if game.CoreGui:FindFirstChild("WindUI") then
        game.CoreGui.WindUI:Destroy()
    end
end)

--// 创建窗口
local Window = WindUI:CreateWindow({
    Title = "Sailor Piece",
    Icon = "anchor",
    Author = "OpenAI",
    Folder = "SailorPiece_Config",
    Size = UDim2.fromOffset(540, 420),
    Transparent = true,
    Theme = "Dark"
})

--// 创建 Tab
local MainTab = Window:CreateTab("物资补给", "package")

--// 材料内容
local MaterialText = "WOOD_LOG x99, IRON_ORE x50, RUM_BOTTLE x5"

--// 标题
MainTab:AddParagraph({
    Title = "⚓ 物资补给清单",
    Desc = "Sailor Piece Stock"
})

--// 显示材料
MainTab:AddParagraph({
    Title = "当前材料",
    Desc = MaterialText
})

--// 复制按钮
MainTab:AddButton({
    Title = "📋 复制材料代码",
    Desc = "点击复制全部材料",
    Callback = function()
        setclipboard(MaterialText)

        WindUI:Notify({
            Title = "复制成功",
            Content = "材料代码已复制到剪贴板",
            Type = "Success"
        })
    end
})

--// 在线状态
MainTab:AddParagraph({
    Title = "状态",
    Desc = "🟢 航向：伟大航道"
})

--// 示例：动态修改材料
MainTab:AddButton({
    Title = "🔄 更新材料",
    Desc = "随机刷新材料内容",
    Callback = function()
        MaterialText = "GOLD_COIN x25, SEA_CRYSTAL x12, DEVIL_FRUIT x1"

        WindUI:Notify({
            Title = "材料已更新",
            Content = MaterialText,
            Type = "Info"
        })
    end
})

--// 通知
WindUI:Notify({
    Title = "Sailor Piece",
    Content = "Material Card 已成功加载",
    Type = "Success"
})
```

## 说明

你发的 HTML + Tailwind 是网页 UI，不能直接放进 Roblox WindUI。

上面的代码已经：

* 保留 Sailor Piece 风格
* 加入复制材料功能
* 加入状态显示
* 加入动态刷新
* 完全兼容 Roblox Lua + WindUI
