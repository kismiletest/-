--// WindUI Loader
local WindUI = loadstring(game:HttpGet("https://tree-hub.vercel.app/api/UI/WindUI"))()

pcall(function()
    if game.CoreGui:FindFirstChild("WindUI") then
        game.CoreGui.WindUI:Destroy()
    end
end)

--// 创建窗口
local Window = WindUI:CreateWindow({
    Title = "Sailor Piece",
    Icon = "gift",
    Author = "OpenAI",
    Folder = "Treasure_Copy",
    Size = UDim2.fromOffset(500, 360),
    Transparent = true,
    Theme = "Dark"
})

--// 创建 Tab
local MainTab = Window:CreateTab("Treasure", "gift")

--// 宝箱复制内容
local CopyValue = "Sailor_Piece_Secret_Code_2026"

--// 标题
MainTab:AddParagraph({
    Title = "🎁 Sailor Treasure Chest",
    Desc = "点击开启宝箱并复制秘密代码"
})

--// 当前内容
MainTab:AddParagraph({
    Title = "📜 Secret Treasure",
    Desc = CopyValue
})

--// 宝箱按钮
MainTab:AddButton({
    Title = "🎁 开启宝箱",
    Desc = "点击复制 Treasure Code",
    Callback = function()

        if setclipboard then
            setclipboard(CopyValue)
        end

        -- 开箱动画通知
        WindUI:Notify({
            Title = "🔓 TREASURE OPENED!",
            Content = "宝藏代码已复制",
            Type = "Success"
        })

        -- 粒子风格通知
        task.spawn(function()
            task.wait(1.5)

            WindUI:Notify({
                Title = "✨ TREASURE COPIED!",
                Content = CopyValue,
                Type = "Info"
            })
        end)
    end
})

--// 随机宝藏按钮
MainTab:AddButton({
    Title = "⚓ 随机宝藏",
    Desc = "生成新的 Sailor Piece Secret",
    Callback = function()

        local Treasures = {
            "DevilFruit_Legendary_2026",
            "SeaKing_Treasure_X99",
            "GrandLine_Secret_Map",
            "MythicFruit_Awakening",
            "PirateKing_Chest_777"
        }

        CopyValue = Treasures[math.random(1,#Treasures)]

        WindUI:Notify({
            Title = "🪙 新宝藏已生成",
            Content = CopyValue,
            Type = "Info"
        })
    end
})

--// 状态
MainTab:AddParagraph({
    Title = "🟢 Treasure Status",
    Desc = "Grand Line Treasure Active"
})

--// 启动通知
WindUI:Notify({
    Title = "Sailor Piece",
    Content = "Treasure Chest Component 已加载",
    Type = "Success"
})
