--// Auto Buso
local Player = game.Players.LocalPlayer
local BusoEnabled = false

local function ToggleBuso()

    if BusoEnabled then

        if not Player.Character:FindFirstChild("HasBuso") then

            local remote = game:GetService("ReplicatedStorage")
                :WaitForChild("Remotes")
                :FindFirstChild("CommF_")

            if remote then
                remote:InvokeServer("Buso")
            end
        end
    end
end

task.spawn(function()

    while true do

        if BusoEnabled then
            pcall(ToggleBuso)
        end

        task.wait(1)
    end
end)

MainTab:CreateToggle({
    Name = "Auto Buso",
    CurrentValue = false,
    Flag = "AutoBuso",

    Callback = function(state)

        BusoEnabled = state

        print("自动武装色状态:", state)
    end
})

--// 玩家ESP
local ESP_Enabled = false

MainTab:CreateToggle({
    Name = "开启玩家透视",
    CurrentValue = false,
    Flag = "PlayerESP",

    Callback = function(State)
        ESP_Enabled = State
    end
})

local function updateESP(player)

    if player == game.Players.LocalPlayer then
        return
    end

    local function setupCharacter(char)

        local root = char:WaitForChild("HumanoidRootPart", 10)
        local hum = char:WaitForChild("Humanoid", 10)

        if not root or not hum then
            return
        end

        local highlight = char:FindFirstChild("WindHighlight")
            or Instance.new("Highlight")

        highlight.Name = "WindHighlight"
        highlight.Parent = char
        highlight.FillColor = Color3.fromRGB(0,255,255)
        highlight.OutlineColor = Color3.fromRGB(255,255,255)

        local head = char:WaitForChild("Head")

        local billboard = head:FindFirstChild("WindESP_Tag")
            or Instance.new("BillboardGui")

        billboard.Name = "WindESP_Tag"
        billboard.Parent = head
        billboard.Size = UDim2.new(0,150,0,70)
        billboard.StudsOffset = Vector3.new(0,3,0)
        billboard.AlwaysOnTop = true

        local infoLabel = billboard:FindFirstChild("Info")
            or Instance.new("TextLabel")

        infoLabel.Name = "Info"
        infoLabel.Parent = billboard
        infoLabel.Size = UDim2.new(1,0,0.4,0)
        infoLabel.BackgroundTransparency = 1
        infoLabel.TextColor3 = Color3.new(1,1,1)
        infoLabel.TextStrokeTransparency = 0
        infoLabel.TextSize = 13
        infoLabel.Font = Enum.Font.GothamBold

        local healthBarBG = billboard:FindFirstChild("HealthBG")
            or Instance.new("Frame")

        healthBarBG.Name = "HealthBG"
        healthBarBG.Parent = billboard
        healthBarBG.Position = UDim2.new(0.25,0,0.5,0)
        healthBarBG.Size = UDim2.new(0.5,0,0.1,0)
        healthBarBG.BackgroundColor3 = Color3.new(0,0,0)
        healthBarBG.BorderSizePixel = 0

        local healthBar = healthBarBG:FindFirstChild("Bar")
            or Instance.new("Frame")

        healthBar.Name = "Bar"
        healthBar.Parent = healthBarBG
        healthBar.Size = UDim2.new(1,0,1,0)
        healthBar.BackgroundColor3 = Color3.new(0,1,0)
        healthBar.BorderSizePixel = 0

        task.spawn(function()

            while char and char.Parent and billboard.Parent do

                if ESP_Enabled then

                    local LocalCharacter = game.Players.LocalPlayer.Character
                    local LocalRoot = LocalCharacter and LocalCharacter:FindFirstChild("HumanoidRootPart")

                    local dist = 0

                    if LocalRoot then
                        dist = (root.Position - LocalRoot.Position).Magnitude
                    end

                    highlight.Enabled = true
                    billboard.Enabled = true

                    infoLabel.Text = string.format(
                        "%s\n[%d m]",
                        player.Name,
                        math.floor(dist)
                    )

                    local hpPercent = hum.Health / hum.MaxHealth

                    healthBar.Size = UDim2.new(hpPercent,0,1,0)

                    healthBar.BackgroundColor3 = Color3.fromHSV(
                        hpPercent * 0.3,
                        1,
                        1
                    )

                else

                    highlight.Enabled = false
                    billboard.Enabled = false
                end

                task.wait(0.1)
            end
        end)
    end

    if player.Character then
        setupCharacter(player.Character)
    end

    player.CharacterAdded:Connect(setupCharacter)
end

for _, p in pairs(game.Players:GetPlayers()) do
    updateESP(p)
end

game.Players.PlayerAdded:Connect(updateESP)

--// 玩家列表系统
local ActiveEntries = {}

local function GetPlayerData(player)

    local stats = player:FindFirstChild("leaderstats")

    local bounty = 0

    if stats then

        local bObj =
            stats:FindFirstChild("Bounty")
            or stats:FindFirstChild("赏金")
            or stats:FindFirstChild("Money")

        if bObj then
            bounty = bObj.Value
        end
    end

    local hp = 0
    local maxHp = 100

    if player.Character and player.Character:FindFirstChild("Humanoid") then

        hp = math.floor(player.Character.Humanoid.Health)

        maxHp = math.floor(player.Character.Humanoid.MaxHealth)
    end

    return bounty, hp, maxHp
end

local function RefreshList()

    -- 删除离开的玩家
    for userId, entry in pairs(ActiveEntries) do

        if not game.Players:GetPlayerByUserId(userId) then

            entry:Destroy()
            ActiveEntries[userId] = nil
        end
    end

    -- 添加/更新玩家
    for _, player in pairs(game.Players:GetPlayers()) do

        local bounty, hp, maxHp = GetPlayerData(player)

        if not ActiveEntries[player.UserId] then

            local thumb, isReady = game.Players:GetUserThumbnailAsync(
                player.UserId,
                Enum.ThumbnailType.HeadShot,
                Enum.ThumbnailSize.Size150x150
            )

            local newEntry = PlayerTab:CreateButton({
                Name = player.DisplayName,

                Callback = function()

                    setclipboard(player.Name)

                    Rayfield:Notify({
                        Title = "系统",
                        Content = "已复制玩家用户名: " .. player.Name,
                        Duration = 2,
                        Image = 4483362458
                    })
                end
            })

            if newEntry.SetImage then
                newEntry:SetImage(isReady and thumb or "rbxassetid://15124031024")
            end

            if newEntry.SetDesc then
                newEntry:SetDesc(string.format(
                    "赏金: 💰%d | 血量: %d/%d",
                    bounty,
                    hp,
                    maxHp
                ))
            end

            ActiveEntries[player.UserId] = newEntry

        else

            local existingEntry = ActiveEntries[player.UserId]

            if existingEntry.SetDesc then

                existingEntry:SetDesc(string.format(
                    "赏金: 💰%d | 血量: %d/%d",
                    bounty,
                    hp,
                    maxHp
                ))
            end
        end
    end
end

