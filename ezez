--// 获取果实
local function GetPlayerFruit(player)

    local char = player.Character

    if char then

        for _, tool in pairs(player.Backpack:GetChildren()) do

            if tool:FindFirstChild("Fruit")
            or string.find(tool.Name, "Fruit") then

                return tool.Name
            end
        end

        local tool = char:FindFirstChildOfClass("Tool")

        if tool and (
            string.find(tool.Name, "Fruit")
            or tool:FindFirstChild("Fruit")
        ) then
            return tool.Name
        end
    end

    return "无果实/未装备"
end

--// 获取赏金
local function GetBounty(player)

    local stats = player:FindFirstChild("leaderstats")

    if stats then

        local b =
            stats:FindFirstChild("Bounty")
            or stats:FindFirstChild("赏金")
            or stats:FindFirstChild("Money")

        return b and b.Value or 0
    end

    return 0
end

--// 创建ESP
local function CreateESP(player)

    if player == game.Players.LocalPlayer then
        return
    end

    local function setup(char)

        local head = char:WaitForChild("Head", 15)
        local hum = char:WaitForChild("Humanoid", 15)

        if not head or not hum then
            return
        end

        -- Billboard
        local billboard =
            head:FindFirstChild("CustomESP")
            or Instance.new("BillboardGui")

        billboard.Name = "CustomESP"
        billboard.Parent = head
        billboard.Size = UDim2.new(0, 200, 0, 100)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true

        -- 文本
        local textLabel =
            billboard:FindFirstChild("Info")
            or Instance.new("TextLabel")

        textLabel.Name = "Info"
        textLabel.Parent = billboard
        textLabel.Size = UDim2.new(1, 0, 0.8, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.TextColor3 = Color3.new(1, 1, 1)
        textLabel.TextStrokeTransparency = 0
        textLabel.TextSize = 14
        textLabel.Font = Enum.Font.GothamBold
        textLabel.TextYAlignment = Enum.TextYAlignment.Bottom
        textLabel.RichText = true

        -- 血条背景
        local barBG =
            billboard:FindFirstChild("BarBG")
            or Instance.new("Frame")

        barBG.Name = "BarBG"
        barBG.Parent = billboard
        barBG.Position = UDim2.new(0.1, 0, 0.85, 0)
        barBG.Size = UDim2.new(0.8, 0, 0.08, 0)
        barBG.BackgroundColor3 = Color3.new(0, 0, 0)
        barBG.BorderSizePixel = 0

        -- 血条
        local bar =
            barBG:FindFirstChild("Bar")
            or Instance.new("Frame")

        bar.Name = "Bar"
        bar.Parent = barBG
        bar.Size = UDim2.new(1, 0, 1, 0)
        bar.BackgroundColor3 = Color3.new(0, 1, 0)
        bar.BorderSizePixel = 0

        -- Highlight
        local highlight =
            char:FindFirstChild("ESPHighlight")
            or Instance.new("Highlight")

        highlight.Name = "ESPHighlight"
        highlight.Parent = char
        highlight.FillTransparency = 0.6
        highlight.OutlineColor = Color3.new(1, 1, 1)

        -- 循环更新
        task.spawn(function()

            while char and char.Parent and billboard.Parent do

                if ESP_Enabled then

                    billboard.Enabled = true
                    highlight.Enabled = true

                    local localChar =
                        game.Players.LocalPlayer.Character

                    local localRoot =
                        localChar
                        and localChar:FindFirstChild("HumanoidRootPart")

                    local root =
                        char:FindFirstChild("HumanoidRootPart")

                    local dist = 0

                    if root and localRoot then
                        dist = math.floor(
                            (root.Position - localRoot.Position).Magnitude
                        )
                    end

                    local fruit = GetPlayerFruit(player)
                    local bounty = GetBounty(player)

                    local hpPercent =
                        hum.Health / hum.MaxHealth

                    textLabel.Text = string.format(
                        "%s\n<font color='rgb(255,255,0)'>果实: %s</font>\n💰赏金: %d\n📏距离: %d studs",
                        player.DisplayName,
                        fruit,
                        bounty,
                        dist
                    )

                    bar.Size = UDim2.new(
                        hpPercent,
                        0,
                        1,
                        0
                    )

                    bar.BackgroundColor3 = Color3.fromHSV(
                        hpPercent * 0.3,
                        1,
                        1
                    )

                else

                    billboard.Enabled = false
                    highlight.Enabled = false
                end

                task.wait(0.1)
            end
        end)
    end

    if player.Character then
        setup(player.Character)
    end

    player.CharacterAdded:Connect(setup)
end

--// 初始化ESP
for _, p in pairs(game.Players:GetPlayers()) do
    CreateESP(p)
end

game.Players.PlayerAdded:Connect(CreateESP)
