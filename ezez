--// WindUI Loader
local WindUI = loadstring(game:HttpGet("https://tree-hub.vercel.app/api/UI/WindUI"))()

pcall(function()
    if game.CoreGui:FindFirstChild("WindUI") then
        game.CoreGui.WindUI:Destroy()
    end
end)

--// 创建窗口
local Window = WindUI:CreateWindow({
    Title = "Sailor Piece Helper",
    Icon = "anchor",
    Author = "OpenAI",
    Folder = "SailorPieceConfig",
    Size = UDim2.fromOffset(520, 380),
    Transparent = true,
    Theme = "Dark"
})

--// 创建 Tab
local Tab = Window:CreateTab("Main", "home")

--// Item Code
local ItemCode = "ITEM_CODE_HERE"

--// 标题
Tab:AddParagraph({
    Title = "⚓ Sailor Piece Helper",
    Desc = "复制 Sailor Piece 物品代码"
})

--// 显示代码
Tab:AddParagraph({
    Title = "📦 当前物品代码",
    Desc = ItemCode
})

--// 复制按钮
Tab:AddButton({
    Title = "📋 复制 Item Code",
    Desc = "点击复制物品代码到剪贴板",
    Callback = function()

        if setclipboard then
            setclipboard(ItemCode)

            WindUI:Notify({
                Title = "复制成功",
                Content = "代码已成功复制到剪贴板！",
                Type = "Success"
            })
        else
            warn("你的执行器不支持 setclipboard 函数")
        end
    end
})

--// 随机代码按钮
Tab:AddButton({
    Title = "🔄 随机生成代码",
    Desc = "刷新新的 Sailor Piece Item Code",
    Callback = function()

        local Codes = {
            "LEGENDARY_SWORD_2026",
            "DEVIL_FRUIT_X99",
            "SEA_SCROLL_SECRET",
            "PIRATE_KING_KEY",
            "MYTHIC_CHEST_DROP"
        }

        ItemCode = Codes[math.random(1,#Codes)]

        WindUI:Notify({
            Title = "代码已更新",
            Content = ItemCode,
            Type = "Info"
        })
    end
})

--// 状态
Tab:AddParagraph({
    Title = "🟢 系统状态",
    Desc = "Sailor Piece Helper Active"
})

--// 加载通知
WindUI:Notify({
    Title = "Sailor Piece Helper",
    Content = "复制物品代码元件已加载",
    Type = "Success"
})
