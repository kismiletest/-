-- Services
local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- 等待角色
local function getHRP()
    local char = player.Character or player.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart")
end

-- TP 坐标
local COFFEE_TP = CFrame.new(-384, 74, 359)
local CURSED_TP = CFrame.new(941, 252, 32900)

-- GUI
local gui = Instance.new("ScreenGui")
gui.Name = "XSY_Hub_GUI"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 280, 0, 220)
frame.Position = UDim2.new(0.5, -140, 0.5, -110)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
frame.Active = true
frame.Draggable = true
frame.Parent = gui

-- 标题（显示你的名字 XSY-hub）
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -40, 0, 40)
title.Position = UDim2.new(0, 10, 0, 0)
title.BackgroundTransparency = 1
title.Text = "XSY-hub"
title.TextColor3 = Color3.new(1,1,1)
title.Font = Enum.Font.GothamBold
title.TextSize = 18
title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = frame

-- 最小化按钮
local miniBtn = Instance.new("TextButton")
miniBtn.Size = UDim2.new(0, 40, 0, 40)
miniBtn.Position = UDim2.new(1, -40, 0, 0)
miniBtn.Text = "-"
miniBtn.Font = Enum.Font.GothamBold
miniBtn.TextSize = 20
miniBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
miniBtn.TextColor3 = Color3.new(1,1,1)
miniBtn.Parent = frame

-- Coffee Shop 按钮
local coffeeBtn = Instance.new("TextButton")
coffeeBtn.Size = UDim2.new(0.85, 0, 0, 40)
coffeeBtn.Position = UDim2.new(0.075, 0, 0.3, 0)
coffeeBtn.Text = "TP Coffee Shop"
coffeeBtn.Font = Enum.Font.Gotham
coffeeBtn.TextSize = 14
coffeeBtn.BackgroundColor3 = Color3.fromRGB(180, 60, 60)
coffeeBtn.TextColor3 = Color3.new(1,1,1)
coffeeBtn.Parent = frame

-- Cursed Ship 按钮
local cursedBtn = Instance.new("TextButton")
cursedBtn.Size = UDim2.new(0.85, 0, 0, 40)
cursedBtn.Position = UDim2.new(0.075, 0, 0.55, 0)
cursedBtn.Text = "TP Cursed Ship"
cursedBtn.Font = Enum.Font.Gotham
cursedBtn.TextSize = 14
cursedBtn.BackgroundColor3 = Color3.fromRGB(180, 60, 60)
cursedBtn.TextColor3 = Color3.new(1,1,1)
cursedBtn.Parent = frame

-- 点击传送事件（单次，不存 ON/OFF）
coffeeBtn.MouseButton1Click:Connect(function()
    local hrp = getHRP()
    hrp.CFrame = COFFEE_TP
end)

cursedBtn.MouseButton1Click:Connect(function()
    local hrp = getHRP()
    hrp.CFrame = CURSED_TP
end)

-- 最小化 GUI
local minimized = false
miniBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    for _, v in ipairs(frame:GetChildren()) do
        if v ~= miniBtn then
            v.Visible = not minimized
        end
    end
    frame.Size = minimized
        and UDim2.new(0, 280, 0, 40)
        or  UDim2.new(0, 280, 0, 220)
end)
