-- [[ ESP 核心逻辑 ]] --
local function CreateESP(obj, color)
    if obj:FindFirstChild("IrukaESP") then return end
    
    local Highlight = Instance.new("Highlight")
    Highlight.Name = "IrukaESP"
    Highlight.Parent = obj
    Highlight.FillTransparency = 0.5
    Highlight.OutlineTransparency = 0
    Highlight.FillColor = color
    Highlight.OutlineColor = Color3.new(1, 1, 1)

    local Billboard = Instance.new("BillboardGui", obj)
    Billboard.Name = "ESP_Tag"
    Billboard.Size = UDim2.new(0, 200, 0, 50)
    Billboard.Adornee = obj:FindFirstChild("Head") or obj.PrimaryPart
    Billboard.AlwaysOnTop = true
    Billboard.ExtentsOffset = Vector3.new(0, 3, 0)

    local TagLabel = Instance.new("TextLabel", Billboard)
    TagLabel.Size = UDim2.new(1, 0, 1, 0)
    TagLabel.BackgroundTransparency = 1
    TagLabel.TextColor3 = color
    TagLabel.TextStrokeTransparency = 0
    TagLabel.Font = Enum.Font.GothamBold
    TagLabel.TextSize = 14
    TagLabel.Text = ""

    return Highlight, TagLabel
end

RS.RenderStepped:Connect(function()
    -- UI 霓虹流光效果
    if Settings.Rainbow_UI then
        MainStroke.Color = Color3.fromHSV(tick() % 5 / 5, 0.8, 1)
        Title.TextColor3 = MainStroke.Color
    end

    if not Settings.ESP_Enabled then
        -- 清理透视
        for _, v in pairs(workspace:GetDescendants()) do
            if v.Name == "IrukaESP" or v.Name == "ESP_Tag" then v:Destroy() end
        end
        return
    end

    -- 遍历 Workspace 寻找目标
    for _, v in pairs(workspace:GetChildren()) do
        local isPlayer = Players:GetPlayerFromCharacter(v)
        local isMonster = v:FindFirstChild("Humanoid") and not isPlayer and not v:SetAttribute("IsNPC", true) -- 根据需要调整过滤条件
        
        local targetValid = false
        local targetColor = Color3.new(1,1,1)

        if isPlayer and Settings.Show_Players and v ~= LocalPlayer.Character then
            targetValid = true
            targetColor = Color3.fromRGB(0, 170, 255)
        elseif isMonster and Settings.Show_Monsters then
            targetValid = true
            targetColor = Color3.fromRGB(255, 40, 40)
        end

        if targetValid and v:FindFirstChild("HumanoidRootPart") then
            local highlight, label = CreateESP(v, targetColor)
            if label then
                local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - v.HumanoidRootPart.Position).Magnitude)
                local nameStr = Settings.Show_Name and v.Name or ""
                local distStr = Settings.Show_Distance and (" [" .. dist .. "m]") or ""
                label.Text = nameStr .. distStr
                label.Visible = true
            end
        else
            if v:FindFirstChild("IrukaESP") then v.IrukaESP:Destroy() end
            if v:FindFirstChild("ESP_Tag") then v.ESP_Tag:Destroy() end
        end
    end
end)

-- 拖动功能
local UserInputService = game:GetService("UserInputService")
local dragging, dragInput, dragStart, startPos

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

-- 隐藏按键
UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.RightControl then
        ScreenGui.Enabled = not ScreenGui.Enabled
    end
end)

