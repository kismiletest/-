-- [[ UI 交互逻辑 ]] --

local function ToggleMenu()
    MainFrame.Visible = not MainFrame.Visible
end

ToggleButton.MouseButton1Click:Connect(ToggleMenu)

-- 手机端面板拖拽实现
local dragging, dragInput, dragStart, startPos
MainFrame.InputBegan:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

UIS.InputEnded:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
        dragging = false
    end
end)

local function CreateToggle(text, settingName)
    local Btn = Instance.new("TextButton", Container)
    Btn.Size = UDim2.new(1, 0, 0, 38)
    Btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    Btn.Text = text .. ": OFF"
    Btn.TextColor3 = Color3.fromRGB(180, 180, 180)
    Btn.Font = Enum.Font.Gotham
    Btn.TextSize = 13
    Instance.new("UICorner", Btn)

    Btn.MouseButton1Click:Connect(function()
        Settings[settingName] = not Settings[settingName]
        Btn.Text = text .. ": " .. (Settings[settingName] and "ON" or "OFF")
        Btn.TextColor3 = Settings[settingName] and Color3.fromRGB(0, 255, 127) or Color3.fromRGB(180, 180, 180)
    end)
end

CreateToggle("启用透视系统", "ESP_Enabled")
CreateToggle("透视傻逼玩家", "Show_Players")
CreateToggle("透视死爹烂妈怪物", "Show_Monsters")
CreateToggle("显示没脑玩家怪物名字", "Show_Name")
CreateToggle("显示傻逼玩家怪物距离", "Show_Distance")

-- [[ ESP 核心逻辑 ]] --

local function CreateESP(obj, color)
    if obj:FindFirstChild("EnESP") then return end
    
    local Highlight = Instance.new("Highlight", obj)
    Highlight.Name = "EnESP"
    Highlight.FillTransparency = 0.6
    Highlight.FillColor = color
    Highlight.OutlineColor = Color3.new(1, 1, 1)

    local Billboard = Instance.new("BillboardGui", obj)
    Billboard.Name = "EnTag"
    Billboard.Size = UDim2.new(0, 100, 0, 20)
    Billboard.Adornee = obj:FindFirstChild("Head") or obj.PrimaryPart
    Billboard.AlwaysOnTop = true
    Billboard.ExtentsOffset = Vector3.new(0, 3, 0)

    local Label = Instance.new("TextLabel", Billboard)
    Label.Size = UDim2.new(1, 0, 1, 0)
    Label.BackgroundTransparency = 1
    Label.TextColor3 = color
    Label.Font = Enum.Font.GothamBold
    Label.TextSize = 12
    Label.Text = ""
end

-- 性能降频：每 0.1 秒处理一次，减少手机发热
local lastTick = 0
RS.RenderStepped:Connect(function()
    if Settings.Rainbow_UI then
        local hue = tick() % 5 / 5
        local col = Color3.fromHSV(hue, 0.7, 1)
        MainStroke.Color = col
        BtnStroke.Color = col
        Title.TextColor3 = col
    end

    if tick() - lastTick < 0.1 then return end
    lastTick = tick()

    if not Settings.ESP_Enabled then
        for _, v in pairs(workspace:GetDescendants()) do
            if v.Name == "EnESP" or v.Name == "EnTag" then v:Destroy() end
        end
        return
    end

    for _, v in pairs(workspace:GetChildren()) do
        local isPlayer = Players:GetPlayerFromCharacter(v)
        local isMonster = v:FindFirstChild("Humanoid") and not isPlayer and v:GetAttribute("IsNPC") ~= true
        
        local valid = false
        local col = Color3.new(1,1,1)

        if isPlayer and Settings.Show_Players and v ~= LocalPlayer.Character then
            valid = true
            col = Color3.fromRGB(0, 170, 255)
        elseif isMonster and Settings.Show_Monsters then
            valid = true
            col = Color3.fromRGB(255, 40, 40)
        end

        if valid and v.PrimaryPart then
            CreateESP(v, col)
            local tag = v:FindFirstChild("EnTag")
            if tag and tag:FindFirstChild("TextLabel") then
                local dist = math.floor((LocalPlayer.Character.PrimaryPart.Position - v.PrimaryPart.Position).Magnitude)
                tag.TextLabel.Text = (Settings.Show_Name and v.Name or "") .. (Settings.Show_Distance and " ["..dist.."m]" or "")
            end
        else
            if v:FindFirstChild("EnESP") then v.EnESP:Destroy() end
            if v:FindFirstChild("EnTag") then v.EnTag:Destroy() end
        end
    end
end)

