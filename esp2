-- 面板开关与拖拽逻辑
ToggleButton.MouseButton1Click:Connect(function() MainFrame.Visible = not MainFrame.Visible end)

local function CreateToggle(text, settingName)
    local Btn = Instance.new("TextButton", Container)
    Btn.Size = UDim2.new(1, 0, 0, 38)
    Btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    Btn.Text = text .. ": OFF"
    Btn.TextColor3 = Color3.fromRGB(180, 180, 180)
    Instance.new("UICorner", Btn)

    Btn.MouseButton1Click:Connect(function()
        Settings[settingName] = not Settings[settingName]
        Btn.Text = text .. ": " .. (Settings[settingName] and "ON" or "OFF")
        Btn.TextColor3 = Settings[settingName] and Color3.fromRGB(0, 255, 127) or Color3.fromRGB(180, 180, 180)
    end)
end

CreateToggle("启用透视系统", "ESP_Enabled")
CreateToggle("透视傻逼玩家", "Show_Players")
CreateToggle("透视所有生物(含NPC)", "Show_Monsters")
CreateToggle("显示没脑名字", "Show_Name")
CreateToggle("显示距离", "Show_Distance")

-- [[ 核心渲染逻辑优化 ]] --

local function CreateESP(obj, color)
    if obj:FindFirstChild("EnESP") then return end
    
    local Highlight = Instance.new("Highlight", obj)
    Highlight.Name = "EnESP"
    Highlight.FillTransparency = 0.5
    Highlight.FillColor = color

    local Billboard = Instance.new("BillboardGui", obj)
    Billboard.Name = "EnTag"
    Billboard.Size = UDim2.new(0, 100, 0, 20)
    -- 适配：防止有些怪物没头，优先绑在 HumanoidRootPart 上
    Billboard.Adornee = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head") or obj.PrimaryPart
    Billboard.AlwaysOnTop = true
    Billboard.ExtentsOffset = Vector3.new(0, 3, 0)

    local Label = Instance.new("TextLabel", Billboard)
    Label.Name = "TagLabel"
    Label.Size = UDim2.new(1, 0, 1, 0)
    Label.BackgroundTransparency = 1
    Label.TextColor3 = color
    Label.Font = Enum.Font.GothamBold
    Label.TextSize = 12
    Label.Text = ""
end

-- 每 0.15 秒扫描一次，防止手机过热，同时保证流畅度
local lastTick = 0
RS.RenderStepped:Connect(function()
    if Settings.Rainbow_UI then
        local hue = tick() % 5 / 5
        local col = Color3.fromHSV(hue, 0.7, 1)
        MainStroke.Color = col
        BtnStroke.Color = col
        Title.TextColor3 = col
    end

    if tick() - lastTick < 0.15 then return end
    lastTick = tick()

    if not Settings.ESP_Enabled then
        for _, v in pairs(workspace:GetDescendants()) do
            if v.Name == "EnESP" or v.Name == "EnTag" then v:Destroy() end
        end
        return
    end

    -- 使用 GetDescendants 以穿透文件夹寻找隐藏的怪物/NPC
    for _, v in pairs(workspace:GetChildren()) do 
        -- 如果怪物在文件夹里，可以把上面一行改为 workspace.Folder:GetChildren() 提高效率
        local isPlayer = Players:GetPlayerFromCharacter(v)
        -- 核心：只要有 Humanoid 就算怪物，不再检查 IsNPC 属性
        local hasHumanoid = v:FindFirstChildOfClass("Humanoid") 
        
        local valid = false
        local col = Color3.new(1,1,1)

        if isPlayer and Settings.Show_Players and v ~= LocalPlayer.Character then
            valid = true
            col = Color3.fromRGB(0, 170, 255) -- 玩家蓝色
        elseif hasHumanoid and not isPlayer and Settings.Show_Monsters then
            valid = true
            col = Color3.fromRGB(255, 40, 40) -- 怪物红色
        end

        if valid and (v:FindFirstChild("HumanoidRootPart") or v.PrimaryPart) then
            CreateESP(v, col)
            local tag = v:FindFirstChild("EnTag")
            if tag and tag:FindFirstChild("TagLabel") then
                local root = v:FindFirstChild("HumanoidRootPart") or v.PrimaryPart
                local dist = math.floor((LocalPlayer.Character.PrimaryPart.Position - root.Position).Magnitude)
                tag.TagLabel.Text = (Settings.Show_Name and v.Name or "") .. (Settings.Show_Distance and " ["..dist.."m]" or "")
            end
        else
            if v:FindFirstChild("EnESP") then v.EnESP:Destroy() end
            if v:FindFirstChild("EnTag") then v.EnTag:Destroy() end
        end
    end
end)

print("1.en Hub Loaded! NPC filtering disabled.")
