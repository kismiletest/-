-- [[ UI 逻辑函数 ]] --

-- 开关面板函数
local function ToggleMenu()
    MainFrame.Visible = not MainFrame.Visible
end

ToggleButton.MouseButton1Click:Connect(ToggleMenu)

-- 创建功能切换项
local function CreateToggle(text, settingName)
    local Btn = Instance.new("TextButton", Container)
    Btn.Size = UDim2.new(1, 0, 0, 35)
    Btn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    Btn.Text = text .. ": OFF"
    Btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    Btn.Font = Enum.Font.Gotham
    Instance.new("UICorner", Btn)

    Btn.MouseButton1Click:Connect(function()
        Settings[settingName] = not Settings[settingName]
        Btn.Text = text .. ": " .. (Settings[settingName] and "ON" or "OFF")
        Btn.TextColor3 = Settings[settingName] and Color3.fromRGB(0, 255, 127) or Color3.fromRGB(200, 200, 200)
    end)
end

CreateToggle("启用透视系统", "ESP_Enabled")
CreateToggle("透视玩家", "Show_Players")
CreateToggle("透视怪物", "Show_Monsters")
CreateToggle("显示名字", "Show_Name")
CreateToggle("显示距离", "Show_Distance")

-- [[ ESP 核心渲染 ]] --

local function GetTargetESP(obj)
    return obj:FindFirstChild("IrukaESP") or obj:FindFirstChild("ESP_Tag")
end

local function CreateESP(obj, color)
    if GetTargetESP(obj) then return end
    
    local Highlight = Instance.new("Highlight", obj)
    Highlight.Name = "IrukaESP"
    Highlight.FillTransparency = 0.5
    Highlight.FillColor = color
    Highlight.OutlineColor = Color3.new(1, 1, 1)

    local Billboard = Instance.new("BillboardGui", obj)
    Billboard.Name = "ESP_Tag"
    Billboard.Size = UDim2.new(0, 150, 0, 30)
    Billboard.Adornee = obj:FindFirstChild("Head") or obj.PrimaryPart
    Billboard.AlwaysOnTop = true
    Billboard.ExtentsOffset = Vector3.new(0, 3, 0)

    local Label = Instance.new("TextLabel", Billboard)
    Label.Size = UDim2.new(1, 0, 1, 0)
    Label.BackgroundTransparency = 1
    Label.TextColor3 = color
    Label.Font = Enum.Font.GothamBold
    Label.TextSize = 13
    Label.Text = ""
end

RS.RenderStepped:Connect(function()
    -- 彩虹 UI 效果
    if Settings.Rainbow_UI then
        local hue = tick() % 5 / 5
        local color = Color3.fromHSV(hue, 0.7, 1)
        MainStroke.Color = color
        BtnStroke.Color = color
        ToggleButton.TextColor3 = color
    end

    -- 全局开关逻辑
    if not Settings.ESP_Enabled then
        for _, v in pairs(workspace:GetDescendants()) do
            if v.Name == "IrukaESP" or v.Name == "ESP_Tag" then v:Destroy() end
        end
        return
    end

    -- 扫描并渲染
    for _, v in pairs(workspace:GetChildren()) do
        local isPlayer = Players:GetPlayerFromCharacter(v)
        -- 修正：只有没有 "NPC" 属性且不是玩家的 Humanoid 才是目标
        local isMonster = v:FindFirstChild("Humanoid") and not isPlayer and v:GetAttribute("IsNPC") ~= true
        
        local valid = false
        local col = Color3.new(1,1,1)

        if isPlayer and Settings.Show_Players and v ~= LocalPlayer.Character then
            valid = true
            col = Color3.fromRGB(0, 170, 255)
        elseif isMonster and Settings.Show_Monsters then
            valid = true
            col = Color3.fromRGB(255, 40, 40)
        end

        if valid and v.PrimaryPart then
            CreateESP(v, col)
            local tag = v:FindFirstChild("ESP_Tag")
            if tag then
                local dist = math.floor((LocalPlayer.Character.PrimaryPart.Position - v.PrimaryPart.Position).Magnitude)
                tag.TextLabel.Text = (Settings.Show_Name and v.Name or "") .. (Settings.Show_Distance and " ["..dist.."m]" or "")
            end
        else
            if v:FindFirstChild("IrukaESP") then v.IrukaESP:Destroy() end
            if v:FindFirstChild("ESP_Tag") then v.ESP_Tag:Destroy() end
        end
    end
end)

-- 快捷键支持
UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.RightControl then
        ToggleMenu()
    end
end)

