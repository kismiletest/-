-- 每秒强制保持 300 FPS
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- ==================== 状态 ====================
local isEnabled = false
local keepTask = nil

-- ==================== 强制保持函数 ====================
local function startKeep300()
	if keepTask then return end
	keepTask = task.spawn(function()
		while isEnabled do
			if setfpscap then
				setfpscap(300) -- 每秒强制设为 300
			end
			task.wait(1) -- 每秒执行一次
		end
		keepTask = nil
	end)
end

local function stopKeep300()
	isEnabled = false
	if keepTask then
		task.cancel(keepTask)
		keepTask = nil
	end
	if setfpscap then
		setfpscap(0) -- 关闭后恢复无限制
	end
end

