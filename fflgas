-- ==================== Blox Fruits 低配优化 ====================
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- ==================== 1. 大幅减低技能画质 ====================
local gfxSettings = {
	["Rendering"] = {
		QualityLevel = 1,
		FRAME_RATE_MANAGER_MAX_FPS = 60,
		EnableFRM = false,
	},
	["Material"] = {
		QualityLevel = 1,
	},
	["Texture"] = {
		QualityLevel = 1,
	},
	["MeshPart"] = {
		QualityLevel = 1,
	},
}

pcall(function()
	local settings = UserSettings()
	local gameSettings = settings.GameSettings
	if gameSettings then
		for category, values in pairs(gfxSettings) do
			pcall(function()
				local cat = gameSettings:FindFirstChild(category)
				if cat then
					for k, v in pairs(values) do
						pcall(function() cat[k] = v end)
					end
				end
			end)
		end
	end
end)

-- 激进取消化：每 0.3 秒扫描并清理所有特效
task.spawn(function()
	while task.wait(0.3) do
		pcall(function()
			for _, obj in ipairs(Workspace:GetDescendants()) do
				if obj:IsA("ParticleEmitter") then
					obj.Enabled = false
					obj.Rate = 0
					obj:Emit(0)
				elseif obj:IsA("Trail") then
					obj.Enabled = false
					obj.Lifetime = 0.01
				elseif obj:IsA("Beam") then
					obj.Enabled = false
				elseif obj:IsA("Explosion") then
					obj.BlastPressure = 0
					obj.BlastRadius = 0
					obj.Visible = false
				elseif obj:IsA("Fire") then
					obj.Enabled = false
					obj.Heat = 0
					obj.Size = 0
				elseif obj:IsA("Smoke") then
					obj.Enabled = false
				elseif obj:IsA("Sparkles") then
					obj.Enabled = false
				elseif obj:IsA("PointLight") then
					obj.Enabled = false
					obj.Brightness = 0
				elseif obj:IsA("SpotLight") then
					obj.Enabled = false
					obj.Brightness = 0
				elseif obj:IsA("SurfaceLight") then
					obj.Enabled = false
					obj.Brightness = 0
				elseif obj:IsA("BillboardGui") then
					obj.Enabled = false
				elseif obj:IsA("Decal") then
					obj.Transparency = 1
				elseif obj:IsA("Texture") then
					obj.Transparency = 1
				end
			end
		end)
	end
end)

