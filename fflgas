graySky.SkyboxDn = grayColor
graySky.SkyboxFt = grayColor
graySky.SkyboxLf = grayColor
graySky.SkyboxRt = grayColor
graySky.SkyboxUp = grayColor
graySky.SunAngularSize = 0
graySky.MoonAngularSize = 0
graySky.StarCount = 0
graySky.SunTextureId = ""
graySky.MoonTextureId = ""
graySky.Parent = Lighting

-- 持续保持灰色天空 (防止被还原)
task.spawn(function()
	while task.wait(3) do
		pcall(function()
			local existingSky = Lighting:FindFirstChild("GraySky")
			if not existingSky or not existingSky:IsA("Sky") then
				local newS = Instance.new("Sky", Lighting)
				newS.Name = "GraySky"
				newS.SkyboxBk = grayColor
				newS.SkyboxDn = grayColor
				newS.SkyboxFt = grayColor
				newS.SkyboxLf = grayColor
				newS.SkyboxRt = grayColor
				newS.SkyboxUp = grayColor
				newS.SunAngularSize = 0
				newS.MoonAngularSize = 0
				newS.StarCount = 0
			end
		end)
		pcall(function()
			local otherSky = Lighting:FindFirstChildWhichIsA("Sky")
			if otherSky and otherSky.Name ~= "GraySky" then otherSky:Destroy() end
		end)
		Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
		Lighting.FogColor = Color3.fromRGB(100, 100, 100)
		Lighting.FogEnd = 500
	end
end)

-- ==================== 3. FPS 显示 UI ====================
local FPS_DISPLAY = nil
if Drawing then
	FPS_DISPLAY = Drawing.new("Text")
	FPS_DISPLAY.Text = "FPS: --"
	FPS_DISPLAY.Size = 22
	FPS_DISPLAY.Color = Color3.fromRGB(0, 255, 100)
	FPS_DISPLAY.Center = false
	FPS_DISPLAY.Outline = true
	FPS_DISPLAY.OutlineColor = Color3.fromRGB(0, 0, 0)
	FPS_DISPLAY.Position = Vector2.new(10, 10)
	FPS_DISPLAY.Visible = true
	FPS_DISPLAY.Font = 2

	local fpsHistory = {}
	local fpsIndex = 0
	task.spawn(function()
		local lastTime = os.clock()
		RunService.RenderStepped:Connect(function()
			local now = os.clock()
			local delta = now - lastTime
			lastTime = now
			if delta > 0 then
				local fps = math.floor(1 / delta + 0.5)
				fpsIndex = fpsIndex + 1
				fpsHistory[fpsIndex] = fps
				if fpsIndex >= 20 then
					local total = 0
					for _, v in pairs(fpsHistory) do total = total + v end
					local avg = math.floor(total / 20)
					FPS_DISPLAY.Text = "FPS: " .. avg .. "  |  低配优化"
					fpsHistory = {}
					fpsIndex = 0
				end
			end
		end)
	end)
else
	-- 备用：ScreenGui FPS
	task.spawn(function()
		local sg = Instance.new("ScreenGui", LocalPlayer:WaitForChild("PlayerGui"))
		sg.Name = "FPS_Display"
		local label = Instance.new("TextLabel", sg)
		label.Name = "FPSLabel"
		label.Size = UDim2.new(0, 180, 0, 28)
		label.Position = UDim2.new(0, 10, 0, 10)
		label.BackgroundTransparency = 0.5
		label.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		label.TextColor3 = Color3.fromRGB(0, 255, 100)
		label.TextSize = 18
		label.TextStrokeTransparency = 0
		label.Font = Enum.Font.SourceSansBold
		label.Text = "FPS: --"
		local lastTime = os.clock()
		RunService.RenderStepped:Connect(function()
			local now = os.clock()
			local delta = now - lastTime
			lastTime = now
			if delta > 0 then
				label.Text = "FPS: " .. math.floor(1 / delta + 0.5) .. "  |  低配优化"
			end
		end)
	end)
end

-- ==================== 4. 人体僵硬 (移除动画) ====================
local removeAnimCharConn, removeAnimTrackConn

local function disableAnim(char)
	local hum = char:WaitForChild("Humanoid", 5)
	if not hum then return end
	local animator = hum:WaitForChild("Animator", 5)
	if not animator then return end
	for _, t in pairs(animator:GetPlayingAnimationTracks()) do t:Stop() end
	if removeAnimTrackConn then removeAnimTrackConn:Disconnect() end
	removeAnimTrackConn = animator.AnimationPlayed:Connect(function(t) t:Stop() end)
end

local function startNoAnim()
	if LocalPlayer.Character then disableAnim(LocalPlayer.Character) end
	if not removeAnimCharConn then
		removeAnimCharConn = LocalPlayer.CharacterAdded:Connect(function(char)
			task.wait(0.5); disableAnim(char)
		end)
	end
end

startNoAnim()

