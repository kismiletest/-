-- ==================== Blox Fruits 低配优化 ====================
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- ==================== 1. 减低技能画质 ====================
local gfxSettings = {
	["Rendering"] = {
		QualityLevel = 1,          -- 1 = 最低画质
		FRAME_RATE_MANAGER_MAX_FPS = 60,
		EnableFRM = false,
	},
	["Material"] = {
		QualityLevel = 1,
	},
	["Texture"] = {
		QualityLevel = 1,
	},
	["MeshPart"] = {
		QualityLevel = 1,
	},
}

-- 应用设置
pcall(function()
	local settings = UserSettings()
	local gameSettings = settings.GameSettings
	if gameSettings then
		for category, values in pairs(gfxSettings) do
			pcall(function()
				local cat = gameSettings:FindFirstChild(category)
				if cat then
					for k, v in pairs(values) do
						pcall(function() cat[k] = v end)
					end
				end
			end)
		end
	end
end)

-- 清理所有粒子/特效
task.spawn(function()
	while task.wait(1) do
		pcall(function()
			for _, obj in ipairs(Workspace:GetDescendants()) do
				if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") then
					obj.Enabled = false
				elseif obj:IsA("Explosion") then
					obj.BlastPressure = 1; obj.BlastRadius = 1
				elseif obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
					obj.Enabled = false
				end
			end
		end)
	end
end)

-- ==================== 2. 天空灰色 ====================
Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)    -- 灰色环境光
Lighting.Ambient = Color3.fromRGB(80, 80, 80)
Lighting.Brightness = 2
Lighting.ClockTime = 12
Lighting.FogColor = Color3.fromRGB(100, 100, 100)
Lighting.FogEnd = 500
Lighting.FogStart = 0
Lighting.ColorShift_Top = Color3.fromRGB(100, 100, 100)
Lighting.ColorShift_Bottom = Color3.fromRGB(80, 80, 80)

-- 删除天空盒
pcall(function()
	if Lighting:FindFirstChild("Sky") then Lighting.Sky:Destroy() end
	if Lighting:FindFirstChild("Atmosphere") then Lighting.Atmosphere:Destroy() end
	if Lighting:FindFirstChild("Bloom") then Lighting.Bloom:Destroy() end
	if Lighting:FindFirstChild("Blur") then Lighting.Blur:Destroy() end
	if Lighting:FindFirstChild("SunRays") then Lighting.SunRays:Destroy() end
	if Lighting:FindFirstChild("ColorCorrection") then Lighting.ColorCorrection:Destroy() end
	if Lighting:FindFirstChild("DepthOfField") then Lighting.DepthOfField:Destroy() end
end)

-- 持续保持灰色
task.spawn(function()
	while task.wait(5) do
		Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
		Lighting.FogColor = Color3.fromRGB(100, 100, 100)
		Lighting.FogEnd = 500
	end
end)

-- ==================== 3. 人体僵硬 (移除动画) ====================
local removeAnimCharConn, removeAnimTrackConn

local function disableAnim(char)
	local hum = char:WaitForChild("Humanoid", 5)
	if not hum then return end
	local animator = hum:WaitForChild("Animator", 5)
	if not animator then return end
	for _, t in pairs(animator:GetPlayingAnimationTracks()) do t:Stop() end
	if removeAnimTrackConn then removeAnimTrackConn:Disconnect() end
	removeAnimTrackConn = animator.AnimationPlayed:Connect(function(t) t:Stop() end)
end

local function startNoAnim()
	if LocalPlayer.Character then disableAnim(LocalPlayer.Character) end
	if not removeAnimCharConn then
		removeAnimCharConn = LocalPlayer.CharacterAdded:Connect(function(char)
			task.wait(0.5); disableAnim(char)
		end)
	end
end

startNoAnim()

