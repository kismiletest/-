-- 初始化 WindUI
local WindUI = loadstring(game:HttpGet("https://tree-hub.vercel.app/api/UI/WindUI"))()
local Window = WindUI:CreateWindow({
    Title = "功能菜单",
    Icon = "shield", -- 也可以用 "heart"
    Author = "User",
    Folder = "AntiOneShotConfig"
})

local MainTab = Window:CreateTab("主要功能", "home")

-- 变量定义
local AntiOneShotEnabled = false
local Player = game.Players.LocalPlayer

-- 核心逻辑函数
local function ApplyAntiOneShot()
    local character = Player.Character or Player.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    
    humanoid.HealthChanged:Connect(function(health)
        if AntiOneShotEnabled and health <= 0 then
            -- 如果开启了防止秒杀，在血量归零的一瞬间强制设为1
            humanoid.Health = 1
            -- 这里可以根据需要添加短暂的无敌时间或提醒
        end
    end)
end

-- 监听角色重生，确保功能持续生效
Player.CharacterAdded:Connect(ApplyAntiOneShot)
if Player.Character then ApplyAntiOneShot() end

-- WindUI 元件绑定
MainTab:AddToggle({
    Title = "防止秒杀 (Anti One Shot)",
    Desc = "当血量即将归零时保留 1 HP",
    Value = false,
    Callback = function(state)
        AntiOneShotEnabled = state
        if state then
            WindUI:Notify({
                Title = "功能已启用",
                Content = "防止秒杀模式已激活",
                Type = "Success"
            })
        end
    end
})
