--// Config: restore saved state immediately, and write current state on every run.

pcall(function()
	Rayfield:LoadConfiguration()
end)

-- Persist whatever is active right now, so a fresh/autoexecute run always has a config file.
task.delay(1, function()
	pcall(function()
		local flag = Rayfield.Flags["KillFireRate"]
		if flag and flag.Set then
			flag:Set(flag.CurrentValue)
		end
	end)
end)

-- Keeps every module alive (including states restored from the config file).
task.spawn(function()
	while task.wait(1) do
		if not isCurrent() then
			return
		end

		if KillAll and KillAll.CurrentValue and loadKillModules() then
			equipKillSlot()
		end

		if AutoQueueToggle and AutoQueueToggle.CurrentValue then
			startQueueLoop()
		end

		if AutoBanToggle and AutoBanToggle.CurrentValue then
			startAutoBanLoops()
		end
	end
end)
