-- AbilityLoop 变量
_ENV.rz_AbilityLoop = false

abilityInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local text = abilityInput.Text:lower()
        local isOpen = text == "true" or text == "1" or text == "on"
        _ENV.rz_AbilityLoop = isOpen
        abilityLabel.Text = "v3 AbilityLoop: " .. tostring(isOpen)
        if isOpen then
            task.wait()
            task.spawn(function()
                while _ENV.rz_AbilityLoop do
                    task.wait(0.1)
                    -- 调用 ActivateAbility
                    if game:GetService("ReplicatedStorage"):FindFirstChild("Remotes") then
                        local remotes = game:GetService("ReplicatedStorage").Remotes
                        if remotes:FindFirstChild("CommE") then
                            remotes.CommE:FireServer("ActivateAbility")
                        end
                    end
                end
            end)
        end
    end
end)

