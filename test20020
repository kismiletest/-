-- ==================== Blox Fruits 极致自动攻击 ====================
local Players = game:GetService("Players")
local VirtualUser = game:GetService("VirtualUser")
local LocalPlayer = Players.LocalPlayer

_G.AutoAttack = false
_G.AttackRange = 120
_G.AttackSpeed = 0.1

-- ==================== WindUI 界面 ====================
local WindUI = WindUI or nil
if not WindUI then
    pcall(function()
        WindUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()
    end)
end

if WindUI then
    local Window = WindUI:CreateWindow({
        Title = "自动攻击",
        Icon = "swords",
        Author = "kiyo",
        Folder = "WindUI_Attack",
        Size = UDim2.fromOffset(400, 250),
        Transparent = true,
        Theme = "Dark",
        Acrylic = false,
        HideSearchBar = true,
        ToggleKey = Enum.KeyCode.RightShift,
    })

    local MainTab = Window:Tab({ Title = "攻击设置", Icon = "swords" })

    MainTab:Slider({
        Title = "攻击范围",
        Value = { Min = 10, Max = 200, Default = 120 },
        Callback = function(v)
            _G.AttackRange = v
        end
    })

    MainTab:Slider({
        Title = "攻击间隔 (秒)",
        Value = { Min = 0.1, Max = 1.0, Default = 0.1, Float = 2 },
        Callback = function(v)
            _G.AttackSpeed = v
        end
    })

    MainTab:Toggle({
        Title = "开启自动攻击 (拿刀即砍)",
        Value = _G.AutoAttack,
        Callback = function(v)
            _G.AutoAttack = v
        end
    })
end

-- ==================== 核心底层攻击逻辑 ====================
local function getClosestPlayer()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    
    local closestPlayer, closestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local targetRoot = p.Character.HumanoidRootPart
            local dist = (root.Position - targetRoot.Position).Magnitude
            
            if dist <= _G.AttackRange and dist < closestDist then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    closestPlayer = p
                    closestDist = dist
                end
            end
        end
    end
    return closestPlayer
end

-- 主循环
task.spawn(function()
    while task.wait(_G.AttackSpeed) do
        if _G.AutoAttack then
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            -- 检测手里是否拿着武器(剑/格斗等)
            local tool = char and char:FindFirstChildOfClass("Tool")
            
            if root and hum and hum.Health > 0 and tool then
                local target = getClosestPlayer()
                if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                    local targetRoot = target.Character.HumanoidRootPart
                    
                    -- 1. 精准面向目标（只转水平方向，不乱转头）
                    root.CFrame = CFrame.lookAt(root.Position, Vector3.new(targetRoot.Position.X, root.Position.Y, targetRoot.Position.Z))
                    
                    -- 2. 防卡刀微操（打破原地攻击的物理死锁）
                    if hum.MoveDirection.Magnitude < 0.1 then
                        root.CFrame = root.CFrame + root.CFrame.LookVector * 0.1
                    end
                    hum:ChangeState(Enum.HumanoidStateType.Running)
                    
                    -- 3. 【硬核模拟点击】
                    -- 先劫持鼠标控制器，再模拟点击屏幕中心(0,0)，这是最不容易被游戏吞掉点击的底层方式
                    VirtualUser:CaptureController()
                    VirtualUser:ClickButton1(Vector2.new(0, 0))
                end
            end
        end
    end
end)

print("极致自动攻击已加载！拿上武器靠近敌人即可。")
