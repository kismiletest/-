---------------------------------------------------
-- PLAYER ESP
---------------------------------------------------

local function AddESP(Player)
    if Player == LocalPlayer then return end

    local function Create(Character)
        if Character:FindFirstChild("IronESP") then
            Character.IronESP:Destroy()
        end

        if not ESP then return end

        local Highlight = Instance.new("Highlight")
        Highlight.Name = "IronESP"
        Highlight.FillTransparency = 0.5
        Highlight.OutlineTransparency = 0
        Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        Highlight.Parent = Character
    end

    if Player.Character then
        Create(Player.Character)
    end

    Player.CharacterAdded:Connect(Create)
end

for _, Player in pairs(Players:GetPlayers()) do
    AddESP(Player)
end

Players.PlayerAdded:Connect(AddESP)

Tabs.Visual:Toggle({
    Title = "Player ESP",
    Value = false,
    Callback = function(v)
        ESP = v

        for _, Player in pairs(Players:GetPlayers()) do
            if Player.Character then
                local Old = Player.Character:FindFirstChild("IronESP")

                if Old then
                    Old:Destroy()
                end

                if v then
                    AddESP(Player)
                end
            end
        end
    end
})

