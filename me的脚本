--------------------------------------------------
-- 地下城主循環
--------------------------------------------------

task.spawn(function()

    while task.wait(CONFIG.CheckInterval) do

        CurrentDungeon = getDungeonLevel()

        pcall(function()
            DungeonLabel:SetDesc("目前關卡 : "..CurrentDungeon)
        end)

        if AutoDungeon then

            if humanoid.Health > 0 then

                local teleporters = getAllExitTeleporters()

                for _, tp in ipairs(teleporters) do

                    local distance =
                        (humanoidRootPart.Position - tp.position).Magnitude

                    if distance <= CONFIG.DetectionRadius then
                        teleportToTarget(tp.rootPart)
                        break
                    end
                end
            end
        end
    end
end)

--------------------------------------------------
-- Boat Kill
--------------------------------------------------

Tabs.BoatKill:Section({
    Title = "Boat Kill"
})

Tabs.BoatKill:Button({
    Title = "移除鬼船傷害",

    Callback = function()

        local count = 0

        for _, v in pairs(Workspace:GetDescendants()) do

            if v:IsA("TouchTransmitter") then

                local p = v.Parent

                if p and (
                    p.Name:find("Damage")
                    or p.Name:find("Death")
                    or p.Name:find("Kill")
                    or p.Name:find("Lava")
                ) then

                    v:Destroy()
                    count += 1
                end
            end
        end

        WindUI:Notify({
            Title = "完成",
            Content = "已移除 "..count.." 個危險物件",
            Duration = 3
        })
    end
})

local playerDropdown = Tabs.BoatKill:Dropdown({
    Title = "選擇玩家",
    Values = GetPlayerList(),

    Callback = function(option)

        for _, plr in ipairs(Players:GetPlayers()) do

            if plr.Name == option then
                TargetPlayer = plr
                break
