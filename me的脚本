--------------------------------------------------
-- REMOVE ESP
--------------------------------------------------

local function RemoveESP(Model)

    local ESP = Model:FindFirstChild("1enESP")

    if ESP then
        ESP:Destroy()
    end

    local Head = Model:FindFirstChild("Head")

    if Head then

        local Billboard = Head:FindFirstChild("1enBillboard")

        if Billboard then
            Billboard:Destroy()
        end
    end
end

--------------------------------------------------
-- CREATE ESP
--------------------------------------------------

local function CreateESP(Model, Name)

    if not ESPEnabled then
        return
    end

    local Humanoid = Model:FindFirstChild("Humanoid")
    local Head = Model:FindFirstChild("Head")
    local HRP = Model:FindFirstChild("HumanoidRootPart")

    if not Humanoid or not Head or not HRP then
        return
    end

    RemoveESP(Model)

    --------------------------------------------------
    -- OUTLINE ONLY
    --------------------------------------------------

    local Highlight = Instance.new("Highlight")
    Highlight.Name = "1enESP"
    Highlight.FillTransparency = 1
    Highlight.OutlineTransparency = 0
    Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    Highlight.Parent = Model

    --------------------------------------------------
    -- NAME + HP + DISTANCE
    --------------------------------------------------

    local Billboard = Instance.new("BillboardGui")
    Billboard.Name = "1enBillboard"
    Billboard.Size = UDim2.new(0,200,0,50)
    Billboard.AlwaysOnTop = true
    Billboard.StudsOffset = Vector3.new(0,2.5,0)
    Billboard.Parent = Head

    local Text = Instance.new("TextLabel")
    Text.Size = UDim2.new(1,0,1,0)
    Text.BackgroundTransparency = 1
    Text.TextScaled = true
    Text.Font = Enum.Font.GothamBold
    Text.TextColor3 = Color3.new(1,1,1)
    Text.TextStrokeTransparency = 0
    Text.Parent = Billboard

    task.spawn(function()

        while Model.Parent and Billboard.Parent and ESPEnabled do
            task.wait(0.2)

            local MyHRP =
                LocalPlayer.Character and
                LocalPlayer.Character:FindFirstChild(
                    "HumanoidRootPart"
                )

            if not MyHRP then
                continue
            end

            local Distance = math.floor(
                (MyHRP.Position - HRP.Position).Magnitude
            )

            Text.Text =
                Name ..
                "\nHP : " ..
                math.floor(Humanoid.Health) ..
                "\nDistance : " ..
                Distance
        end
    end)
end

--------------------------------------------------
-- PLAYER ESP
--------------------------------------------------

local function SetupPlayer(Player)

    if Player == LocalPlayer then
        return
    end

    if Player.Character then
        CreateESP(Player.Character, Player.Name)
    end

    Player.CharacterAdded:Connect(function(Char)
        task.wait(1)
        CreateESP(Char, Player.Name)
    end)
end

for _,Player in pairs(Players:GetPlayers()) do
    SetupPlayer(Player)
end

Players.PlayerAdded:Connect(SetupPlayer)

--------------------------------------------------
-- MOB ESP
--------------------------------------------------

task.spawn(function()

    while task.wait(3) do

        if ESPEnabled and workspace:FindFirstChild("Enemies") then

            for _,Mob in pairs(workspace.Enemies:GetChildren()) do

                if Mob:FindFirstChild("Humanoid") then
                    CreateESP(Mob, Mob.Name)
                end
            end
        end
    end
end)

--------------------------------------------------
-- ESP TOGGLE
--------------------------------------------------

Tabs.Visual:Toggle({
    Title = "Player + Mob ESP",
    Value = false,

    Callback = function(v)

        ESPEnabled = v

        if not v then

            --------------------------------------------------
            -- REMOVE PLAYER ESP
            --------------------------------------------------

            for _,Player in pairs(Players:GetPlayers()) do

                if Player.Character then
                    RemoveESP(Player.Character)
                end
            end

            --------------------------------------------------
            -- REMOVE MOB ESP
            --------------------------------------------------

            if workspace:FindFirstChild("Enemies") then

                for _,Mob in pairs(workspace.Enemies:GetChildren()) do
                    RemoveESP(Mob)
                end
            end
        end
    end
})

--------------------------------------------------
-- KILL AURA FIX
--------------------------------------------------

Tabs.Combat:Toggle({
    Title = "Kill Aura",
    Value = false,

    Callback = function(v)
        KillAura = v
    end
})

task.spawn(function()

    while task.wait(0.1) do

        if KillAura then

            pcall(function()

                local Character =
                    LocalPlayer.Character

                if not Character then
                    return
                end

                local Tool =
                    Character:FindFirstChildOfClass(
                        "Tool"
                    )

                if Tool then
                    Tool:Activate()
                end

            end)
        end
    end
end)

--------------------------------------------------
-- AUTO HAKI
--------------------------------------------------

Tabs.Combat:Toggle({
    Title = "Auto Haki",
    Value = false,

    Callback = function(v)

        if v and not HakiEnabled then

            HakiEnabled = true

            pcall(function()

                ReplicatedStorage.Remotes.CommF_:InvokeServer(
                    "Buso"
                )

            end)

        end

        if not v then
            HakiEnabled = false
        end
    end
})

