--------------------------------------------------
-- CONFIG
--------------------------------------------------

local CONFIG = {
    TargetTeleporterName = "ExitTeleporter",
    CheckInterval = 1,
    TweenTime = 0.8,
    EasingStyle = Enum.EasingStyle.Quad,
    EasingDirection = Enum.EasingDirection.Out,
    DisableMovement = true,
    DetectionRadius = 1000,
    CooldownAfterTeleport = 3
}

local isTeleporting = false
local lastTeleportTime = 0

--------------------------------------------------
-- Character 更新
--------------------------------------------------

local function updateCharacter()
    character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    humanoidRootPart = character:WaitForChild("HumanoidRootPart")
    humanoid = character:WaitForChild("Humanoid")
end

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    updateCharacter()
end)

--------------------------------------------------
-- 地下城關卡檢測
--------------------------------------------------

local function getDungeonLevel()
    local map = Workspace:FindFirstChild("Map")
    if not map then return "未知" end

    local dungeon = map:FindFirstChild("Dungeon")
    if not dungeon then return "未知" end

    local highest = 0

    for _, v in pairs(dungeon:GetChildren()) do
        local num = tonumber(v.Name:match("%d+"))
        if num and num > highest then
            highest = num
        end
    end

    if highest > 0 then
        return tostring(highest)
    end

    return "未知"
end

--------------------------------------------------
-- 取得傳送器
--------------------------------------------------

local function getAllExitTeleporters()
    local teleporters = {}

    local map = Workspace:FindFirstChild("Map")
    if not map then return teleporters end

    local dungeon = map:FindFirstChild("Dungeon")
    if not dungeon then return teleporters end

    for _, levelFolder in pairs(dungeon:GetChildren()) do
        local teleporter = levelFolder:FindFirstChild(CONFIG.TargetTeleporterName)

        if teleporter then
            local root = teleporter:FindFirstChild("Root")

            if root then
                table.insert(teleporters,{
                    rootPart = root,
                    position = root.Position
                })
            end
        end
    end

    return teleporters
end

--------------------------------------------------
-- Tween 傳送
--------------------------------------------------

local function teleportToTarget(rootPart)
    if isTeleporting then return end

    local currentTime = tick()

    if currentTime - lastTeleportTime < CONFIG.CooldownAfterTeleport then
        return
    end

    isTeleporting = true
    lastTeleportTime = currentTime

    if CONFIG.DisableMovement then
        humanoid.WalkSpeed = 0
        humanoid.JumpPower = 0
    end

    local tween = TweenService:Create(
        humanoidRootPart,
        TweenInfo.new(
            CONFIG.TweenTime,
            CONFIG.EasingStyle,
            CONFIG.EasingDirection
        ),
        {
            CFrame = rootPart.CFrame
        }
    )

    tween:Play()

    tween.Completed:Connect(function()

        humanoid.WalkSpeed = 16
        humanoid.JumpPower = 50

        task.wait(0.5)
        isTeleporting = false
    end)
end

--------------------------------------------------
-- 船功能
--------------------------------------------------

local function getMyShip()
    local myChar = LocalPlayer.Character

    if myChar and myChar:FindFirstChild("Humanoid") and myChar.Humanoid.SeatPart then
        local current = myChar.Humanoid.SeatPart
        local seat = myChar.Humanoid.SeatPart

        while current.Parent and not current:IsA("Model") do
            current = current.Parent
        end

        return current, seat
    end

    return nil, nil
end

local function getTargetSeat(ship, mySeat)
    for _, part in pairs(ship:GetDescendants()) do
        if (part:IsA("Seat") or part:IsA("VehicleSeat")) and part ~= mySeat and not part.Occupant then
            return part
        end
    end
    return nil
end

local function teleportToPos(pos)
    local myShip = getMyShip()

    if myShip then
        myShip:SetPrimaryPartCFrame(CFrame.new(pos + Vector3.new(0,10,0)))
    elseif humanoidRootPart then
        humanoidRootPart.CFrame = CFrame.new(pos + Vector3.new(0,5,0))
    end
end

local function GetPlayerList()
    local list = {}

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            table.insert(list, plr.Name)
        end
    end

    return list
end

