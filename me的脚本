--// WIND UI
local WindUI = loadstring(game:HttpGet(
"https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"
))()

--------------------------------------------------
-- SERVICES
--------------------------------------------------

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer

--------------------------------------------------
-- VARIABLES
--------------------------------------------------

local KillAura = false
local HakiEnabled = false

--------------------------------------------------
-- WINDOW
--------------------------------------------------

local Window = WindUI:CreateWindow({
    Title = "1.en Hub",
    Icon = "swords",
    Author = "by 1.en",
    Folder = "1enHub",
    Size = UDim2.fromOffset(540, 420),
    Transparent = true,
    Theme = "Dark",
    SideBarWidth = 170,

    OpenButton = {
        Enabled = true,
        Draggable = true,
        OnlyMobile = false
    }
})

local Tabs = {
    Combat = Window:Tab({
        Title = "Combat",
        Icon = "sword"
    })
}

--------------------------------------------------
-- KILL AURA
--------------------------------------------------

Tabs.Combat:Toggle({
    Title = "Kill Aura",
    Value = false,

    Callback = function(v)
        KillAura = v
    end
})

task.spawn(function()

    while task.wait(0.1) do

        if KillAura then

            pcall(function()

                local Character =
                    LocalPlayer.Character

                if not Character then
                    return
                end

                local Tool =
                    Character:FindFirstChildOfClass(
                        "Tool"
                    )

                if Tool then
                    Tool:Activate()
                end

            end)
        end
    end
end)

--------------------------------------------------
-- AUTO HAKI
--------------------------------------------------

Tabs.Combat:Toggle({
    Title = "Auto Haki",
    Value = false,

    Callback = function(v)

        if v and not HakiEnabled then

            HakiEnabled = true

            pcall(function()

                local Remotes =
                    ReplicatedStorage:
                    FindFirstChild("Remotes")

                if Remotes then

                    local CommF =
                        Remotes:
                        FindFirstChild("CommF_")

                    if CommF then
                        CommF:InvokeServer(
                            "Buso"
                        )
                    end
                end

            end)

        end

        if not v then
            HakiEnabled = false
        end
    end
})

--------------------------------------------------
-- KEYBIND
--------------------------------------------------

Window:SetToggleKey(
    Enum.KeyCode.RightControl
)
