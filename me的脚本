repeat task.wait() until game:IsLoaded()

--// WIND UI
local WindUI = loadstring(game:HttpGet(
"https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"
))()

--------------------------------------------------
-- SERVICES
--------------------------------------------------

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualUser = game:GetService("VirtualUser")

local LocalPlayer = Players.LocalPlayer

--------------------------------------------------
-- VARIABLES
--------------------------------------------------

local AttackAura = false
local AutoV3 = false
local AutoV4 = false
local HakiEnabled = false

--------------------------------------------------
-- WINDOW
--------------------------------------------------

local Window = WindUI:CreateWindow({
    Title = "1.en Hub",
    Icon = "swords",
    Author = "by 1.en",
    Folder = "1enHub",
    Size = UDim2.fromOffset(540,420),
    Transparent = true,
    Theme = "Dark",
    SideBarWidth = 170,

    OpenButton = {
        Enabled = true,
        Draggable = true,
        OnlyMobile = false
    }
})

local Tabs = {
    Combat = Window:Tab({
        Title = "Combat",
        Icon = "sword"
    })
}

--------------------------------------------------
-- ATTACK AURA
--------------------------------------------------

Tabs.Combat:Toggle({
    Title = "Attack Aura",
    Value = false,

    Callback = function(v)
        AttackAura = v
    end
})

task.spawn(function()

    while task.wait(0.08) do

        if AttackAura then

            pcall(function()

                local Character =
                    LocalPlayer.Character

                if not Character then
                    return
                end

                local Tool =
                    Character:
                    FindFirstChildOfClass(
                        "Tool"
                    )

                if Tool then

                    Tool:Activate()

                    VirtualUser:Button1Down(
                        Vector2.new(0,0),
                        workspace.CurrentCamera.CFrame
                    )
                end

            end)
        end
    end
end)

--------------------------------------------------
-- AUTO V3
--------------------------------------------------

Tabs.Combat:Toggle({
    Title = "Auto V3",
    Value = false,

    Callback = function(v)
        AutoV3 = v
    end
})

task.spawn(function()

    while task.wait(0.5) do

        if AutoV3 then

            pcall(function()

                local Remotes =
                    ReplicatedStorage:
                    FindFirstChild("Remotes")

                if Remotes and
                Remotes:FindFirstChild("CommE") then

                    Remotes.CommE:
                    FireServer(
                        "ActivateAbility"
                    )
                end

            end)
        end
    end
end)

--------------------------------------------------
-- AUTO V4
--------------------------------------------------

Tabs.Combat:Toggle({
    Title = "Auto V4",
    Value = false,

    Callback = function(v)
        AutoV4 = v
    end
})

task.spawn(function()

    while task.wait(0.5) do

        if AutoV4 then

            pcall(function()

                local Remotes =
                    ReplicatedStorage:
                    FindFirstChild("Remotes")

                if Remotes and
                Remotes:FindFirstChild("CommF_") then

                    Remotes.CommF_:
                    InvokeServer(
                        "ActivateRace"
                    )
                end

            end)
        end
    end
end)

--------------------------------------------------
-- AUTO HAKI
--------------------------------------------------

Tabs.Combat:Toggle({
    Title = "Auto Haki",
    Value = false,

    Callback = function(v)

        if v and not HakiEnabled then

            HakiEnabled = true

            pcall(function()

                local Remotes =
                    ReplicatedStorage:
                    FindFirstChild("Remotes")

                if Remotes and
                Remotes:FindFirstChild("CommF_") then

                    Remotes.CommF_:
                    InvokeServer(
                        "Buso"
                    )
                end

            end)

        end

        if not v then
            HakiEnabled = false
        end
    end
})

--------------------------------------------------
-- KEYBIND
--------------------------------------------------

Window:SetToggleKey(
    Enum.KeyCode.RightControl
)
