-- DUNGEON
--------------------------------------------------

local character=
LocalPlayer.Character
or LocalPlayer.CharacterAdded:Wait()

local humanoidRootPart=
character:WaitForChild("HumanoidRootPart")

local humanoid=
character:WaitForChild("Humanoid")

local CONFIG={

TargetTeleporterName="ExitTeleporter",
CheckInterval=1,
TweenTime=0.8,
DetectionRadius=1000,
CooldownAfterTeleport=3

}

local isDetecting=false
local isTeleporting=false
local lastTeleport=0

local function updateCharacter()

character=
LocalPlayer.Character
or LocalPlayer.CharacterAdded:Wait()

humanoidRootPart=
character:WaitForChild("HumanoidRootPart")

humanoid=
character:WaitForChild("Humanoid")

end

LocalPlayer.CharacterAdded:Connect(function()

task.wait(1)
updateCharacter()

end)

DungeonTab:CreateToggle({

Name="自动地下城",
CurrentValue=false,

Callback=function(v)

isDetecting=v

end

})

local dungeonInfo=
DungeonTab:CreateParagraph({

Title="当前地下城",
Content="未检测"

})

local function getDungeonLevel()

local map=Workspace:FindFirstChild("Map")
if not map then return "无" end

local dungeon=
map:FindFirstChild("Dungeon")

if not dungeon then
return "无"
end

local highest=0

for _,v in pairs(dungeon:GetChildren()) do

local num=
tonumber(v.Name:match("%d+"))

if num and num>highest then
highest=num
end

end

return tostring(highest)

end

task.spawn(function()

while true do

dungeonInfo:Set({

Title="当前地下城",
Content=getDungeonLevel()

})

task.wait(1)

end

end)

local function teleportTo(root)

if isTeleporting then return end

if tick()-lastTeleport<
CONFIG.CooldownAfterTeleport then
return
end

isTeleporting=true
lastTeleport=tick()

local tween=
TweenService:Create(

humanoidRootPart,

TweenInfo.new(
CONFIG.TweenTime
),

{
CFrame=root.CFrame
}

)

tween:Play()
tween.Completed:Wait()

isTeleporting=false

end

task.spawn(function()

while task.wait(
CONFIG.CheckInterval
) do

if isDetecting
and humanoid.Health>0 then

local map=
Workspace:FindFirstChild("Map")

local dungeon=
map and map:FindFirstChild("Dungeon")

if dungeon then

for _,v in pairs(
dungeon:GetChildren()
) do

local tp=
v:FindFirstChild(
CONFIG.TargetTeleporterName
)

if tp
and tp:FindFirstChild(
"Root"
) then

teleportTo(tp.Root)

break

end
end
end
end
end
end)

--------------------------------------------------
-- ESP
--------------------------------------------------

local ESPEnabled=false
local ESPObjects={}

local function removeESP(player)

if ESPObjects[player] then

ESPObjects[player]:Destroy()
ESPObjects[player]=nil

end

end

local function createESP(player)

if player==LocalPlayer then
return
end

removeESP(player)

local char=
player.Character

if not char then
return
end

local head=
char:FindFirstChild("Head")

local hum=
char:FindFirstChild("Humanoid")

local hrp=
char:FindFirstChild(
"HumanoidRootPart"
)

if not head then
return
end

local bill=
Instance.new(
"BillboardGui"
)

bill.Parent=head
bill.Size=
UDim2.new(0,200,0,50)

bill.AlwaysOnTop=true
bill.StudsOffset=
Vector3.new(0,3,0)

local txt=
Instance.new("TextLabel")

txt.Parent=bill
txt.Size=
UDim2.new(1,0,1,0)

txt.BackgroundTransparency=1
txt.TextColor3=
Color3.new(1,1,1)

txt.TextStrokeTransparency=0

RunService.RenderStepped:
Connect(function()

if not ESPEnabled then

bill.Enabled=false
return

end

bill.Enabled=true

local my=
LocalPlayer.Character

if not my then return end

local myHRP=
my:FindFirstChild(
"HumanoidRootPart"
)

if not myHRP then
return
end

local dist=
math.floor(

(myHRP.Position-
hrp.Position).Magnitude

)

txt.Text=
player.Name..
"\n距离:"..dist..
"\n血量:"..
math.floor(hum.Health)

end)

ESPObjects[player]=bill

end

ESPTab:CreateToggle({

