local Rayfield = loadstring(game:HttpGet(
'https://sirius.menu/rayfield'
))()

local Window = Rayfield:CreateWindow({
    Name = "1.en Hub",
    LoadingTitle = "Loading",
    LoadingSubtitle = "TP Tool",
    ConfigurationSaving = {
        Enabled = false
    }
})

local TP = Window:CreateTab("Teleport",4483362458)

------------------------------------------------
-- SERVICES
------------------------------------------------

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local VirtualUser = game:GetService("VirtualUser")

_G.Teleport=false
_G.Teleport2=false
_G.SelectPly=""

local OffsetX=0
local OffsetY=0
local OffsetZ=0

------------------------------------------------
-- PLAYER LIST
------------------------------------------------

local function GetPlayers()

    local list={}

    for _,v in pairs(Players:GetPlayers()) do
        if v~=LocalPlayer then
            table.insert(list,v.Name)
        end
    end

    return list

end

local Dropdown=
TP:CreateDropdown({

Name="选择玩家",

Options=GetPlayers(),

CurrentOption=nil,

Callback=function(v)

_G.SelectPly=v

end

})

Players.PlayerAdded:Connect(function()
Dropdown:Refresh(GetPlayers())
end)

Players.PlayerRemoving:Connect(function()
Dropdown:Refresh(GetPlayers())
end)

------------------------------------------------
-- OFFSET
------------------------------------------------

TP:CreateInput({

Name="Offset X",

PlaceholderText="0",

Callback=function(v)

OffsetX=tonumber(v) or 0

end

})

TP:CreateInput({

Name="Offset Y",

PlaceholderText="0",

Callback=function(v)

OffsetY=tonumber(v) or 0

end

})

TP:CreateInput({

Name="Offset Z",

PlaceholderText="0",

Callback=function(v)

OffsetZ=tonumber(v) or 0

end

})

------------------------------------------------
-- TP LOCK
------------------------------------------------

TP:CreateToggle({

Name="TP",

CurrentValue=false,

Callback=function(state)

_G.Teleport=state

if state then

task.spawn(function()

while _G.Teleport do

task.wait()

pcall(function()

local target=
Players:FindFirstChild(
_G.SelectPly
)

if not target then return end

local hrp=
target.Character.HumanoidRootPart

LocalPlayer.Character
.HumanoidRootPart.CFrame=

hrp.CFrame+

Vector3.new(
OffsetX,
OffsetY,
OffsetZ
)

VirtualUser:CaptureController()
VirtualUser:Button1Down(
Vector2.new()
)

end)

end

end)

end

end

})

------------------------------------------------
-- LOCK2
------------------------------------------------

TP:CreateToggle({

Name="Lock2",

CurrentValue=false,

Callback=function(state)

_G.Teleport2=state

if state then

task.spawn(function()

while _G.Teleport2 do

task.wait(.05)

pcall(function()

local target=
Players:FindFirstChild(
_G.SelectPly
)

if not target then return end

local hrp=
target.Character.HumanoidRootPart

LocalPlayer.Character
.HumanoidRootPart.CFrame=

hrp.CFrame+
Vector3.new(
OffsetX,
OffsetY,
OffsetZ
)

end)

end

end)

end

end

})

------------------------------------------------
-- REFRESH
------------------------------------------------

TP:CreateButton({

Name="刷新玩家",

Callback=function()

Dropdown:Refresh(
GetPlayers()
)

end

})

Rayfield:Notify({

Title="Loaded",

Content="TP Tool 已启动",

Duration=4

})
