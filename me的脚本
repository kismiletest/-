--------------------------------------------------
-- 帶船循環
--------------------------------------------------

RunService.Heartbeat:Connect(function()

    if not shipTpToggle or not TargetPlayer then
        return
    end

    local myShip, mySeat = getMyShip()

    if not myShip then
        return
    end

    if TargetPlayer.Character then

        local targetHum =
            TargetPlayer.Character:FindFirstChild("Humanoid")

        local targetHRP =
            TargetPlayer.Character:FindFirstChild("HumanoidRootPart")

        if targetHum and not targetHum.SeatPart and targetHRP then

            local emptySeat =
                getTargetSeat(myShip,mySeat)

            if emptySeat then

                local seatOffset =
                    myShip.PrimaryPart.CFrame:Inverse()
                    * emptySeat.CFrame

                myShip:SetPrimaryPartCFrame(
                    targetHRP.CFrame * seatOffset:Inverse()
                )

            else

                myShip:SetPrimaryPartCFrame(
                    targetHRP.CFrame * CFrame.new(0,5,0)
                )
            end
        end
    end
end)

