-- WindUI
local WindUI = loadstring(game:HttpGet(
"https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"
))()

local Window = WindUI:CreateWindow({
    Title = "1.en Hub",
    Icon = "swords",
    Author = "by 1.en",
    Folder = "1enHub",
    Size = UDim2.fromOffset(520,380),
    Transparent = true,
    Theme = "Dark",
    SideBarWidth = 180,
})

local Tabs = {
    Main = Window:Tab({
        Title = "Fast Attack",
        Icon = "zap"
    })
}

Tabs.Main:Section({
    Title = "Fast Attack Settings"
})

-- 自動攻擊開關
Tabs.Main:Toggle({
    Title = "自動攻擊",
    Value = Settings.AutoClick,

    Callback = function(v)
        Settings.AutoClick = v

        if v then
            stopManual()
            startAuto()
        else
            stopAuto()
            startManual()
        end
    end
})

-- 距離滑桿
Tabs.Main:Slider({
    Title = "攻擊距離",
    Step = 1,
    Value = {
        Min = 0,
        Max = 1000,
        Default = Settings.Distance
    },

    Callback = function(v)
        Settings.Distance = math.floor(v)
    end
})

-- 攻速滑桿
Tabs.Main:Slider({
    Title = "攻擊速度",
    Step = 0.01,
    Value = {
        Min = 0.01,
        Max = 1,
        Default = Settings.AttackInterval
    },

    Callback = function(v)
        Settings.AttackInterval = v
    end
})

-- 最大目標
Tabs.Main:Slider({
    Title = "最大目標數",
    Step = 1,
    Value = {
        Min = 1,
        Max = 50,
        Default = Settings.MaxTargets
    },

    Callback = function(v)
        Settings.MaxTargets = math.floor(v)
    end
})

-- 手動攻擊按鈕
Tabs.Main:Button({
    Title = "手動攻擊一次",

    Callback = function()
        PerformAttack()
    end
})

-- 通知
WindUI:Notify({
    Title = "1.en Hub",
    Content = "Fast Attack 已載入",
    Duration = 3
})

Window:SetToggleKey(Enum.KeyCode.RightControl)
