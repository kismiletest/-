}

--------------------------------------------------
-- 自動攻擊
--------------------------------------------------

Tabs.Combat:Toggle({
    Title = "自動攻擊",
    Value = Settings.AutoClick,

    Callback = function(v)

        Settings.AutoClick = v

        if Settings.AutoClick then

            stopManual()
            startAuto()

        else

            stopAuto()
            startManual()
        end
    end
})

