--------------------------------------------------
-- 自动地下城
--------------------------------------------------

Tabs.Main:Toggle({
    Title = "自动地下城",
    Value = false,

    Callback = function(v)
        AutoDungeon = v

        if v then
            task.spawn(function()

                while AutoDungeon do
                    task.wait(1)

                    pcall(function()

                        local character =
                            LocalPlayer.Character or
                            LocalPlayer.CharacterAdded:Wait()

                        local humanoidRootPart =
                            character:WaitForChild("HumanoidRootPart")

                        local map = Workspace:FindFirstChild("Map")
                        if not map then return end

                        local dungeonFolder =
                            map:FindFirstChild("Dungeon")

                        if not dungeonFolder then return end

                        for _, levelFolder in pairs(dungeonFolder:GetChildren()) do

                            local teleporter =
                                levelFolder:FindFirstChild("ExitTeleporter")

                            if teleporter and teleporter:FindFirstChild("Root") then

                                local rootPart = teleporter.Root

                                local distance =
                                    (humanoidRootPart.Position - rootPart.Position).Magnitude

                                if distance <= 1000 then

                                    local tween =
                                        TweenService:Create(
                                            humanoidRootPart,
                                            TweenInfo.new(0.8),
                                            {CFrame = rootPart.CFrame}
                                        )

                                    tween:Play()
                                    tween.Completed:Wait()

                                    break
                                end
                            end
                        end
                    end)
                end
            end)
        end
    end
})

