--------------------------------------------------
-- PLAYER ESP
--------------------------------------------------

local function CreateESP(Player)

    if Player == LocalPlayer then
        return
    end

    local function Setup(Character)

        if Character:FindFirstChild("1enESP") then
            Character:FindFirstChild("1enESP"):Destroy()
        end

        if not ESPEnabled then
            return
        end

        --------------------------------------------------
        -- HIGHLIGHT
        --------------------------------------------------

        local Highlight = Instance.new("Highlight")
        Highlight.Name = "1enESP"
        Highlight.FillTransparency = 0.5
        Highlight.OutlineTransparency = 0
        Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        Highlight.Parent = Character

        --------------------------------------------------
        -- NAME + HP
        --------------------------------------------------

        local Head = Character:FindFirstChild("Head")

        if Head then

            local Billboard = Instance.new("BillboardGui")
            Billboard.Name = "1enBillboard"
            Billboard.Size = UDim2.new(0,200,0,50)
            Billboard.AlwaysOnTop = true
            Billboard.StudsOffset = Vector3.new(0,3,0)
            Billboard.Parent = Head

            local Text = Instance.new("TextLabel")
            Text.Size = UDim2.new(1,0,1,0)
            Text.BackgroundTransparency = 1
            Text.TextScaled = true
            Text.Font = Enum.Font.GothamBold
            Text.TextColor3 = Color3.new(1,0,0)
            Text.TextStrokeTransparency = 0
            Text.Parent = Billboard

            task.spawn(function()

                while Billboard.Parent and ESPEnabled do
                    task.wait(0.1)

                    local Humanoid = Character:FindFirstChild("Humanoid")

                    if Humanoid then
                        Text.Text =
                            Player.Name ..
                            "\nHP : " ..
                            math.floor(Humanoid.Health)
                    end
                end

            end)
        end
    end

    if Player.Character then
        Setup(Player.Character)
    end

    Player.CharacterAdded:Connect(function(Char)
        task.wait(1)
        Setup(Char)
    end)
end

for _,Player in pairs(Players:GetPlayers()) do
    CreateESP(Player)
end

Players.PlayerAdded:Connect(CreateESP)

Tabs.Visual:Toggle({
    Title = "Player ESP",
    Value = false,
    Callback = function(v)

        ESPEnabled = v

        for _,Player in pairs(Players:GetPlayers()) do

            if Player.Character then

                local ESP = Player.Character:FindFirstChild("1enESP")
                local Head = Player.Character:FindFirstChild("Head")

                if ESP then
                    ESP:Destroy()
                end

                if Head and Head:FindFirstChild("1enBillboard") then
                    Head:FindFirstChild("1enBillboard"):Destroy()
                end

                if v then
                    CreateESP(Player)
                end
            end
        end
    end
})

