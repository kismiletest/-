    FeatureA = false,
    FeatureB = false,
    FeatureC = false
}

--------------------------------------------------
-- WINDOW
--------------------------------------------------

local Window = WindUI:CreateWindow({
    Title = "1.en Hub",
    Icon = "swords",
    Author = "by 1.en",
    Folder = "1enHub",
    Size = UDim2.fromOffset(540,420),
    Transparent = true,
    Theme = "Dark",
