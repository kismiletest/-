local Rayfield = loadstring(game:HttpGet(
'https://sirius.menu/rayfield'
))()

local Window = Rayfield:CreateWindow({
    Name = "1.en Hub",
    LoadingTitle = "Loading",
    LoadingSubtitle = "Dungeon UI",

    ConfigurationSaving = {
        Enabled = false
    },

    Discord = {
        Enabled = false
    },

    KeySystem = false
})

------------------------------------------------
-- TAB
------------------------------------------------

local Dungeon =
Window:CreateTab(
"地下城",
4483362458
)

------------------------------------------------
-- 数据
------------------------------------------------

local Dungeons = {

{
id="dg01",
name="艾尔文防线",
level="1-10",
desc="哥布林聚集",
reward="新手剑"
},

{
id="dg02",
name="格兰之森",
level="11-20",
desc="变异猫妖",
reward="魔法长袍"
},

{
id="dg03",
name="天空之城",
level="21-30",
desc="古代傀儡",
reward="光之碎片"
}

}

local Selected=nil

------------------------------------------------
-- 输出
------------------------------------------------

local Current =
Dungeon:CreateParagraph({

Title="当前地下城",

Content="未选择"

})

------------------------------------------------
-- 自动切换函数
------------------------------------------------

local function ChangeDungeon(data)

Selected=data.id

Current:Set({

Title="当前地下城",

Content=
data.name..
"\n等级:"..
data.level..
"\n掉落:"..
data.reward

})

print(
"[系统] 已锁定:",
data.id
)

end

------------------------------------------------
-- 自动默认选第一个
------------------------------------------------

ChangeDungeon(
Dungeons[1]
)

------------------------------------------------
-- 创建按钮
------------------------------------------------

for _,d in pairs(Dungeons) do

Dungeon:CreateButton({

Name=
d.name..
" [Lv."..
d.level..
"]",

Info=
d.desc..
"\n掉落:"..
d.reward,

Callback=function()

ChangeDungeon(d)

Rayfield:Notify({

Title="地下城",

Content=
"已选择 "..d.name,

Duration=3

})

end

})

end
