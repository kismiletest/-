-- Dungeon
--------------------------------------------------

local CONFIG = {
    TargetTeleporterName = "ExitTeleporter",
    CheckInterval = 1,
    TweenTime = 0.8,
    DetectionRadius = 1000
}

local DungeonEnabled = false
local CurrentDungeon = "未检测"

local DungeonLabel = Tabs.Dungeon:Paragraph({
    Title = "地下城层数",
    Desc = CurrentDungeon
})

Tabs.Dungeon:Toggle({
    Title = "自动地下城",
    Value = false,
    Callback = function(v)
        DungeonEnabled = v
    end
})

local function getDungeonLevel()
    local map = Workspace:FindFirstChild("Map")
    if not map then
        return "未检测"
    end

    local dungeon = map:FindFirstChild("Dungeon")
    if not dungeon then
        return "未检测"
    end

    local highest = 0

    for _, v in pairs(dungeon:GetChildren()) do
        local num = tonumber(v.Name:match("%d+"))
        if num and num > highest then
            highest = num
        end
    end

    if highest > 0 then
        return tostring(highest) .. " 层"
    end

    return "未检测"
end

local function getAllExitTeleporters()
    local teleporters = {}

    local map = Workspace:FindFirstChild("Map")
    if not map then
        return teleporters
    end

    local dungeonFolder = map:FindFirstChild("Dungeon")
    if not dungeonFolder then
        return teleporters
    end

    for _, levelFolder in pairs(dungeonFolder:GetChildren()) do
        local teleporter = levelFolder:FindFirstChild(CONFIG.TargetTeleporterName)

        if teleporter then
            local rootPart = teleporter:FindFirstChild("Root")

            if rootPart then
                table.insert(teleporters, rootPart)
            end
        end
    end

    return teleporters
end

local function tweenTeleport(target)
    local tweenInfo = TweenInfo.new(
        CONFIG.TweenTime,
        Enum.EasingStyle.Linear
    )

    local tween = TweenService:Create(
        HumanoidRootPart,
        tweenInfo,
        {CFrame = target.CFrame}
    )

    tween:Play()
end

task.spawn(function()
    while task.wait(1) do
        local level = getDungeonLevel()

        if level ~= CurrentDungeon then
            CurrentDungeon = level

            DungeonLabel:SetDesc(level)
        end
    end
end)

task.spawn(function()
    while task.wait(CONFIG.CheckInterval) do
        if DungeonEnabled then

            local teleporters = getAllExitTeleporters()

            for _, tp in pairs(teleporters) do
                local distance = (HumanoidRootPart.Position - tp.Position).Magnitude

                if distance <= CONFIG.DetectionRadius then
                    tweenTeleport(tp)
                    break
                end
            end
        end
    end
end)

