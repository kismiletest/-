ESPEnabled=v

if v then

for _,p in pairs(
Players:GetPlayers()
) do

createESP(p)

end

else

for _,p in pairs(
Players:GetPlayers()
) do

removeESP(p)

end

end

end

})

Players.PlayerAdded:
Connect(function(p)

p.CharacterAdded:
Connect(function()

task.wait(1)

if ESPEnabled then
createESP(p)
end

end)

end)

