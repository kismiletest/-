--------------------------------------------------
-- 地下城层数显示
--------------------------------------------------

local DungeonLabel = Tabs.Main:Paragraph({
    Title = "当前地下城",
    Desc = "等待检测..."
})

task.spawn(function()
    while task.wait(1) do
        pcall(function()

            local map = workspace:FindFirstChild("Map")
            if not map then return end

            local dungeon = map:FindFirstChild("Dungeon")
            if not dungeon then return end

            local highest = 0

            for _, v in pairs(dungeon:GetChildren()) do
                local num = tonumber(v.Name)

                if num and num > highest then
                    highest = num
                end
            end

            DungeonLabel:SetDesc("当前层数: "..highest)

        end)
    end
end)

--------------------------------------------------
-- 自动地下城核心
--------------------------------------------------

task.spawn(function()

    while task.wait(1) do

        if AutoDungeon then

            pcall(function()

                local map = workspace:FindFirstChild("Map")
                if not map then return end

                local dungeon = map:FindFirstChild("Dungeon")
                if not dungeon then return end

                local highest = nil
                local highestNum = 0

                for _, v in pairs(dungeon:GetChildren()) do
                    local num = tonumber(v.Name)

                    if num and num > highestNum then
                        highestNum = num
                        highest = v
                    end
                end

                if highest then

                    local tp = highest:FindFirstChild("ExitTeleporter")

                    if tp and tp:FindFirstChild("Root") then

                        local char = LocalPlayer.Character
                        if char and char:FindFirstChild("HumanoidRootPart") then

                            char.HumanoidRootPart.CFrame =
                                tp.Root.CFrame + Vector3.new(0,3,0)

                        end
                    end
                end

            end)
        end
    end
end)

