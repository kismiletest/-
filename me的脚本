# Roblox WindUI Combat Hub Template

```lua
-- WindUI
local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local VirtualInputManager = game:GetService("VirtualInputManager")

local LocalPlayer = Players.LocalPlayer

-- Variables
local ESPEnabled = false
local AutoM1 = false
local AutoV3 = false
local AutoV4 = false

--------------------------------------------------
-- WINDOW
--------------------------------------------------

local Window = WindUI:CreateWindow({
    Title = "Iron Hub",
    Icon = "eye",
    Author = "by Iron",
    Folder = "IronHub",
    Size = UDim2.fromOffset(580, 420),
    Transparent = true,
    Theme = "Dark",
    SideBarWidth = 180,
})

local Tabs = {
    Combat = Window:Tab({ Title = "Combat", Icon = "sword" }),
    Visual = Window:Tab({ Title = "Visual", Icon = "eye" }),
    Settings = Window:Tab({ Title = "Settings", Icon = "settings" }),
}

--------------------------------------------------
-- ESP
--------------------------------------------------

local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "ESPFolder"
ESPFolder.Parent = game.CoreGui

local function CreateESP(player)
    if player == LocalPlayer then return end

    local function AddHighlight(char)
        if not ESPEnabled then return end
        if char:FindFirstChild("IronESP") then return end

        local Highlight = Instance.new("Highlight")
        Highlight.Name = "IronESP"
        Highlight.FillTransparency = 0.5
        Highlight.OutlineTransparency = 0
        Highlight.Parent = char
    end

    if player.Character then
        AddHighlight(player.Character)
    end

    player.CharacterAdded:Connect(function(char)
        task.wait(1)
        AddHighlight(char)
    end)
end

for _, plr in ipairs(Players:GetPlayers()) do
    CreateESP(plr)
end

Players.PlayerAdded:Connect(CreateESP)

Tabs.Visual:Toggle({
    Title = "Player ESP",
    Value = false,
    Callback = function(state)
        ESPEnabled = state

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character then
                local old = plr.Character:FindFirstChild("IronESP")
                if old then
                    old:Destroy()
                end

                if state then
                    CreateESP(plr)
                end
            end
        end
    end
})

--------------------------------------------------
-- AUTO M1
--------------------------------------------------

Tabs.Combat:Toggle({
    Title = "Auto M1",
    Value = false,
    Callback = function(state)
        AutoM1 = state
    end
})

RunService.RenderStepped:Connect(function()
    if AutoM1 then
        VirtualInputManager:SendMouseButtonEvent(0,0,0,true,game,0)
        task.wait(0.1)
        VirtualInputManager:SendMouseButtonEvent(0,0,0,false,game,0)
    end
end)

--------------------------------------------------
-- AUTO V3
--------------------------------------------------

Tabs.Combat:Toggle({
    Title = "Auto V3",
    Value = false,
    Callback = function(state)
        AutoV3 = state
    end
})

RunService.Heartbeat:Connect(function()
    if AutoV3 then
        pcall(function()
            game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("ActivateAbility")
        end)
    end
end)

--------------------------------------------------
-- AUTO V4
--------------------------------------------------

Tabs.Combat:Toggle({
    Title = "Auto V4",
    Value = false,
    Callback = function(state)
        AutoV4 = state
    end
})

RunService.Heartbeat:Connect(function()
    if AutoV4 then
        pcall(function()
            game:GetService("VirtualInputManager"):SendKeyEvent(true,"Y",false,game)
            task.wait(0.2)
            game:GetService("VirtualInputManager"):SendKeyEvent(false,"Y",false,game)
        end)
    end
end)

--------------------------------------------------
-- SETTINGS
--------------------------------------------------

Tabs.Settings:Button({
    Title = "Destroy UI",
    Callback = function()
        game.CoreGui:FindFirstChild("WindUI")
        Window:Destroy()
    end
})

Window:SetToggleKey(Enum.KeyCode.RightControl)
```

