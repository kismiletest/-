-- 自动攻击核心
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualUser = game:GetService("VirtualUser")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

-- 设置
local AttackAura = false
local AttackDistance = 60
local AttackDelay = 0.08

-- 检测角色
local function GetCharacter()
    return LocalPlayer.Character
end

-- 获取武器
local function GetTool()
    local Character = GetCharacter()
    if Character then
        return Character:FindFirstChildOfClass("Tool")
    end
end

-- 获取最近敌人
local function GetClosestEnemy()
    local Character = GetCharacter()
    if not Character then return end

    local HRP = Character:FindFirstChild("HumanoidRootPart")
    if not HRP then return end

    local Closest = nil
    local Distance = AttackDistance

    -- NPC
    local Enemies = workspace:FindFirstChild("Enemies")

    if Enemies then
        for _, Enemy in pairs(Enemies:GetChildren()) do
            local EnemyHRP = Enemy:FindFirstChild("HumanoidRootPart")
            local Humanoid = Enemy:FindFirstChild("Humanoid")

            if EnemyHRP and Humanoid and Humanoid.Health > 0 then
                local Magnitude =
                    (HRP.Position - EnemyHRP.Position).Magnitude

                if Magnitude < Distance then
                    Distance = Magnitude
                    Closest = Enemy
                end
            end
        end
    end

    return Closest
end

-- 自动攻击
task.spawn(function()

    while task.wait(AttackDelay) do

        if AttackAura then

            pcall(function()

                local Character = GetCharacter()
                local Tool = GetTool()
                local Enemy = GetClosestEnemy()

                if Character and Tool and Enemy then

                    local EnemyHRP =
                        Enemy:FindFirstChild("HumanoidRootPart")

                    if EnemyHRP then

                        -- 激活武器
                        Tool:Activate()

                        -- 模拟点击
                        VirtualUser:Button1Down(
                            Vector2.new(0,0),
                            workspace.CurrentCamera.CFrame
                        )

                        -- 注册攻击
                        local CombatFramework =
                            require(
                                LocalPlayer.PlayerScripts:
                                WaitForChild("CombatFramework")
                            )

                        local activeController =
                            CombatFramework.activeController

                        if activeController then
                            activeController.hitboxMagnitude = 120
                        end

                        -- 远程攻击
                        local RigController =
                            ReplicatedStorage:
                            FindFirstChild("RigControllerEvent")

                        if RigController then
                            RigController:FireServer(
                                "hit",
                                EnemyHRP,
                                EnemyHRP.Position
                            )
                        end
                    end
                end
            end)
        end
    end
end)

-- 开关
AttackAura = true

print("自动攻击核心已启动")
