    Value = {
        Min = 0,
        Max = 1000,
        Default = Settings.Distance
    },

    Callback = function(v)

        Settings.Distance = math.floor(v)
    end
})

--------------------------------------------------
-- 攻速
--------------------------------------------------

Tabs.Combat:Slider({
    Title = "攻擊速度",

    Value = {
        Min = 0.01,
        Max = 1,
        Default = Settings.AttackInterval
    },

    Callback = function(v)

        Settings.AttackInterval = v
    end
})

--------------------------------------------------
-- 最大目標
--------------------------------------------------

Tabs.Combat:Slider({
    Title = "最大目標數",

    Value = {
        Min = 1,
        Max = 50,
        Default = Settings.MaxTargets
    },

    Callback = function(v)

        Settings.MaxTargets = math.floor(v)
    end
})

--------------------------------------------------
-- 測試攻擊
--------------------------------------------------

Tabs.Combat:Button({
    Title = "測試攻擊",

    Callback = function()

        PerformAttack()
    end
})

--------------------------------------------------
-- 通知
--------------------------------------------------

WindUI:Notify({
    Title = "1.en Hub",
    Content = "Fast Attack 已載入",
    Duration = 3
})

--------------------------------------------------
-- 初始
--------------------------------------------------

