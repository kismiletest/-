-- ==================== 逻辑函数 ====================
local function UpdateStatus()
    if Config.MasterEnabled then
        local list = {}
        if Config.Z_Enabled then table.insert(list, "Z") end
        if Config.X_Enabled then table.insert(list, "X") end
        if Config.C_Enabled then table.insert(list, "C") end
        if Config.F_Enabled then table.insert(list, "F") end
        if Config.FlashStepEnabled then table.insert(list, "瞬步") end
        
        if #list > 0 then
            StatusLabel.Text = "状态：运行中 → " .. table.concat(list, " / ")
            StatusLabel.TextColor3 = Color3.fromRGB(80, 220, 120)
        else
            StatusLabel.Text = "状态：总开关已开，请选择功能"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 180, 60)
        end
    else
        StatusLabel.Text = "状态：未开启"
        StatusLabel.TextColor3 = Color3.fromRGB(150, 150, 170)
    end
end

local function UpdateMasterButton()
    MasterBtn.Text = Config.MasterEnabled and "总开关：开启" or "总开关：关闭"
    MasterBtn.BackgroundColor3 = Config.MasterEnabled and Color3.fromRGB(35, 150, 65) or Color3.fromRGB(45, 45, 65)
    UpdateStatus()
end

local function UpdateFlashButton()
    FlashBtn.Text = Config.FlashStepEnabled and "瞬步自瞄 + 触发X：开启" or "瞬步自瞄 + 触发X：关闭"
    FlashBtn.BackgroundColor3 = Config.FlashStepEnabled and Color3.fromRGB(40, 100, 200) or Color3.fromRGB(45, 45, 65)
    UpdateStatus()
end

local function ToggleSkill(key)
    if key == "Z" then
        Config.Z_Enabled = not Config.Z_Enabled
        ZRow.Toggle.Text = Config.Z_Enabled and "开" or "关"
        ZRow.Toggle.BackgroundColor3 = Config.Z_Enabled and Color3.fromRGB(40, 160, 70) or Color3.fromRGB(55, 55, 75)
    elseif key == "X" then
        Config.X_Enabled = not Config.X_Enabled
        XRow.Toggle.Text = Config.X_Enabled and "开" or "关"
        XRow.Toggle.BackgroundColor3 = Config.X_Enabled and Color3.fromRGB(40, 160, 70) or Color3.fromRGB(55, 55, 75)
    elseif key == "C" then
        Config.C_Enabled = not Config.C_Enabled
        CRow.Toggle.Text = Config.C_Enabled and "开" or "关"
        CRow.Toggle.BackgroundColor3 = Config.C_Enabled and Color3.fromRGB(40, 160, 70) or Color3.fromRGB(55, 55, 75)
    elseif key == "F" then
        Config.F_Enabled = not Config.F_Enabled
        FRow.Toggle.Text = Config.F_Enabled and "开" or "关"
        FRow.Toggle.BackgroundColor3 = Config.F_Enabled and Color3.fromRGB(40, 160, 70) or Color3.fromRGB(55, 55, 75)
    end
    UpdateStatus()
end

local function ChangeDelay(key, amount)
    if key == "Z" then
        Config.Z_Delay = math.clamp(Config.Z_Delay + amount, Config.MinDelay, Config.MaxDelay)
        ZRow.DelayLabel.Text = string.format("间隔: %.2fs", Config.Z_Delay)
    elseif key == "X" then
        Config.X_Delay = math.clamp(Config.X_Delay + amount, Config.MinDelay, Config.MaxDelay)
        XRow.DelayLabel.Text = string.format("间隔: %.2fs", Config.X_Delay)
    elseif key == "C" then
        Config.C_Delay = math.clamp(Config.C_Delay + amount, Config.MinDelay, Config.MaxDelay)
        CRow.DelayLabel.Text = string.format("间隔: %.2fs", Config.C_Delay)
    elseif key == "F" then
        Config.F_Delay = math.clamp(Config.F_Delay + amount, Config.MinDelay, Config.MaxDelay)
        FRow.DelayLabel.Text = string.format("间隔: %.2fs", Config.F_Delay)
    end
end

