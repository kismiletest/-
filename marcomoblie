local ZRow = CreateSkillRow("Z", 50, "Z", Config.Z_Delay)
local XRow = CreateSkillRow("X", 130, "X", Config.X_Delay)
local CRow = CreateSkillRow("C", 210, "C", Config.C_Delay)

-- ==================== 逻辑 ====================
local function UpdateDelayLabel(row, delay)
    row.DelayLabel.Text = string.format("间隔: %.2fs", delay)
end

local function ToggleSkill(key)
    if key == "Z" then
        Config.Z_Enabled = not Config.Z_Enabled
        ZRow.Toggle.Text = Config.Z_Enabled and "开" or "关"
        ZRow.Toggle.BackgroundColor3 = Config.Z_Enabled and Color3.fromRGB(50, 180, 80) or Color3.fromRGB(60, 60, 80)
    elseif key == "X" then
        Config.X_Enabled = not Config.X_Enabled
        XRow.Toggle.Text = Config.X_Enabled and "开" or "关"
        XRow.Toggle.BackgroundColor3 = Config.X_Enabled and Color3.fromRGB(50, 180, 80) or Color3.fromRGB(60, 60, 80)
    elseif key == "C" then
        Config.C_Enabled = not Config.C_Enabled
        CRow.Toggle.Text = Config.C_Enabled and "开" or "关"
        CRow.Toggle.BackgroundColor3 = Config.C_Enabled and Color3.fromRGB(50, 180, 80) or Color3.fromRGB(60, 60, 80)
    end
end

local function ChangeDelay(key, amount)
    if key == "Z" then
        Config.Z_Delay = math.clamp(Config.Z_Delay + amount, Config.MinDelay, Config.MaxDelay)
        UpdateDelayLabel(ZRow, Config.Z_Delay)
    elseif key == "X" then
        Config.X_Delay = math.clamp(Config.X_Delay + amount, Config.MinDelay, Config.MaxDelay)
        UpdateDelayLabel(XRow, Config.X_Delay)
    elseif key == "C" then
        Config.C_Delay = math.clamp(Config.C_Delay + amount, Config.MinDelay, Config.MaxDelay)
        UpdateDelayLabel(CRow, Config.C_Delay)
    end
end

-- 绑定按钮
ZRow.Toggle.MouseButton1Click:Connect(function() ToggleSkill("Z") end)
XRow.Toggle.MouseButton1Click:Connect(function() ToggleSkill("X") end)
CRow.Toggle.MouseButton1Click:Connect(function() ToggleSkill("C") end)

ZRow.MinusBtn.MouseButton1Click:Connect(function() ChangeDelay("Z", -0.1) end)
ZRow.PlusBtn.MouseButton1Click:Connect(function() ChangeDelay("Z", 0.1) end)

XRow.MinusBtn.MouseButton1Click:Connect(function() ChangeDelay("X", -0.1) end)
XRow.PlusBtn.MouseButton1Click:Connect(function() ChangeDelay("X", 0.1) end)

CRow.MinusBtn.MouseButton1Click:Connect(function() ChangeDelay("C", -0.1) end)
CRow.PlusBtn.MouseButton1Click:Connect(function() ChangeDelay("C", 0.1) end)

-- ==================== 自动释放循环 ====================
local function PressKey(key)
    -- 模拟按键（手机端执行器通常支持）
    VirtualUser:CaptureController()
    VirtualUser:SetKeyDown(key)
    task.wait(0.05)
    VirtualUser:SetKeyUp(key)
end

-- Z 循环
task.spawn(function()
    while true do
        if Config.Z_Enabled then
            pcall(function()
                PressKey("Z")
            end)
            task.wait(Config.Z_Delay)
        else
            task.wait(0.2)
        end
    end
end)

