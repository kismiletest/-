--==================== 技能按钮创建 ====================--
local skillButtons = {}
local cooldowns = {Z = 0, X = 0, C = 0}
local isOnCooldown = {Z = false, X = false, C = false}

local function createSkillButton(key, order)
	local config = SkillConfig[key]
	
	local btn = Instance.new("TextButton")
	btn.Name = key .. "Button"
	btn.Size = UDim2.new(0, 70, 0, 70)
	btn.Position = UDim2.new(0, (order - 1) * 75, 0, 0)
	btn.BackgroundColor3 = config.Color
	btn.Text = key
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 28
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = false
	btn.Parent = skillFrame
	
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 16)
	corner.Parent = btn
	
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(255, 255, 255)
	stroke.Thickness = 2
	stroke.Transparency = 0.6
	stroke.Parent = btn
	
	-- 冷却遮罩
	local cdOverlay = Instance.new("Frame")
	cdOverlay.Name = "CooldownOverlay"
	cdOverlay.Size = UDim2.new(1, 0, 1, 0)
	cdOverlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	cdOverlay.BackgroundTransparency = 0.45
	cdOverlay.Visible = false
	cdOverlay.Parent = btn
	
	local cdCorner = Instance.new("UICorner")
	cdCorner.CornerRadius = UDim.new(0, 16)
	cdCorner.Parent = cdOverlay
	
	local cdText = Instance.new("TextLabel")
	cdText.Name = "CDText"
	cdText.Size = UDim2.new(1, 0, 1, 0)
	cdText.BackgroundTransparency = 1
	cdText.Text = ""
	cdText.TextColor3 = Color3.fromRGB(255, 255, 255)
	cdText.Font = Enum.Font.GothamBold
	cdText.TextSize = 22
	cdText.Parent = cdOverlay
	
	skillButtons[key] = {
		Button = btn,
		Overlay = cdOverlay,
		CDText = cdText,
		Config = config
	}
	
	return btn
end

createSkillButton("Z", 1)
createSkillButton("X", 2)
createSkillButton("C", 3)

--==================== 技能释放逻辑 ====================--
local function castSkill(key)
	if isOnCooldown[key] then return end
	
	local config = SkillConfig[key]
	local realCooldown = config.Cooldown * SpeedMultiplier
	
	isOnCooldown[key] = true
	cooldowns[key] = realCooldown
	
	-- 这里写你的真实技能逻辑
	print("[Marco] 释放技能:", config.Name, " | 当前速度倍率:", string.format("%.2f", SpeedMultiplier))
	
	-- 示例：播放特效 / 动画 / 远程事件
	-- 例如：
	-- local character = player.Character
	-- if character then
	--     local humanoid = character:FindFirstChildOfClass("Humanoid")
	--     -- 播放动画、生成特效等
	-- end
	
	-- 也可以 fire RemoteEvent 到服务器
	-- game.ReplicatedStorage.SkillRemote:FireServer(key)
	
	-- 按钮按下反馈
	local btn = skillButtons[key].Button
	local originalSize = btn.Size
	TweenService:Create(btn, TweenInfo.new(0.08), {
		Size = UDim2.new(0, 62, 0, 62)
	}):Play()
	task.wait(0.08)
	TweenService:Create(btn, TweenInfo.new(0.1), {
		Size = originalSize
	}):Play()
end

--==================== 冷却更新 ====================--
RunService.Heartbeat:Connect(function(dt)
	for key, remaining in pairs(cooldowns) do
		if remaining > 0 then
			cooldowns[key] = remaining - dt
			local data = skillButtons[key]
			data.Overlay.Visible = true
			data.CDText.Text = string.format("%.1f", math.max(0, cooldowns[key]))
			
			if cooldowns[key] <= 0 then
				cooldowns[key] = 0
				isOnCooldown[key] = false
				data.Overlay.Visible = false
				data.CDText.Text = ""
			end
		end
	end
end)

--==================== 输入绑定 ====================--
-- 手机按钮点击
for key, data in pairs(skillButtons) do
	data.Button.MouseButton1Click:Connect(function()
		castSkill(key)
	end)
	
	-- 触摸支持（手机）
	data.Button.TouchTap:Connect(function()
		castSkill(key)
	end)
end

-- 键盘支持（PC）
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	
	if input.KeyCode == Enum.KeyCode.Z then
		castSkill("Z")
	elseif input.KeyCode == Enum.KeyCode.X then
		castSkill("X")
	elseif input.KeyCode == Enum.KeyCode.C then
		castSkill("C")
	end
end)

--==================== 速度滑块逻辑 ====================--
local dragging = false

local function updateSpeed(relativeX)
	relativeX = math.clamp(relativeX, 0, 1)
	
	-- 0 ~ 1 映射到 0.4x ~ 2.0x（可自行调整范围）
	SpeedMultiplier = 0.4 + relativeX * 1.6
	
	sliderFill.Size = UDim2.new(relativeX, 0, 1, 0)
	sliderButton.Position = UDim2.new(relativeX, -11, 0.5, -11)
	speedValueLabel.Text = string.format("当前倍率: %.2fx", SpeedMultiplier)
end

sliderButton.MouseButton1Down:Connect(function()
	dragging = true
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not dragging then return end
	
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		local absPos = input.Position.X
		local bgAbsPos = sliderBg.AbsolutePosition.X
		local bgSize = sliderBg.AbsoluteSize.X
		local relative = (absPos - bgAbsPos) / bgSize
		updateSpeed(relative)
	end
end)

-- 点击滑块背景也能跳转
sliderBg.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		local absPos = input.Position.X
		local bgAbsPos = sliderBg.AbsolutePosition.X
		local bgSize = sliderBg.AbsoluteSize.X
		local relative = (absPos - bgAbsPos) / bgSize
		updateSpeed(relative)
		dragging = true
	end
end)

-- 初始化滑块到 1.0x（中间位置）
updateSpeed(0.375) -- (1.0 - 0.4) / 1.6 ≈ 0.375

