-- ==================== 最近玩家 ====================
local function getNearest()
	local nearest, shortest = nil, math.huge
	local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil, 99999 end
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character then
			local hrp = p.Character:FindFirstChild("HumanoidRootPart")
			local hum = p.Character:FindFirstChild("Humanoid")
			if hrp and hum and hum.Health > 0 then
				local d = (myRoot.Position - hrp.Position).Magnitude
				if d < shortest then shortest = d; nearest = p end
			end
		end
	end
	return nearest, shortest
end

-- ==================== Mouse.Hit 自瞄 ====================
local oldIndex
oldIndex = hookmetamethod(game, "__index", function(self, key)
	if getgenv().AutoSoruEnabled and self == Mouse and (key == "Hit" or key == "Target") then
		local nearest = getNearest()
		if nearest and nearest.Character then
			local hrp = nearest.Character:FindFirstChild("HumanoidRootPart")
			if hrp then
				if key == "Hit" then return CFrame.new(hrp.Position)
				elseif key == "Target" then return hrp end
			end
		end
	end
	return oldIndex(self, key)
end)

-- ==================== 冷却检测 + 直接远程发包 (绕过0.5秒延迟) ====================
local function fireSoru()
	-- 方法1: CommE 发包 (Soru 主通道, 无延迟)
	pcall(function()
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end
		local nearest = getNearest()
		if not nearest or not nearest.Character then return end
		local targetHrp = nearest.Character:FindFirstChild("HumanoidRootPart")
		if not targetHrp then return end

		local commE = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommE")
		if commE then
			local startCF = hrp.CFrame
			local targetPos = targetHrp.Position
			local finalCF = CFrame.new(targetPos + Vector3.new(0, hrp.Size.Y * 1.5, 0))
			local id = math.random(1, 999999999)
			commE:FireServer("Soru", startCF, finalCF, Workspace:GetServerTimeNow(), id)
			print("[Soru] 远程发包成功")
		end
	end)

	-- 方法2: VirtualInputManager 按X (备选, 但可能有延迟)
	pcall(function()
		local vim = game:GetService("VirtualInputManager")
		vim:SendKeyEvent(true, Enum.KeyCode.X, false, game)
		task.wait(0.03)
		vim:SendKeyEvent(false, Enum.KeyCode.X, false, game)
	end)
end

task.spawn(function()
	while task.wait(0.15) do
		if not getgenv().AutoSoruEnabled then continue end

		-- 防抖
		if tick() - lastSoruTime < 0.5 then continue end

		-- 只在附近有敌人时触发
		local _, dist = getNearest()
		if dist > 500 then continue end

		-- 检测冷却是否就绪
		local ready = false
		pcall(function()
			local pg = LocalPlayer:FindFirstChild("PlayerGui")
			if not pg then return end

			-- 扫描所有 Cooldown Frame
			for _, frame in ipairs(pg:GetDescendants()) do
				if frame:IsA("Frame") and frame.Name == "Cooldown" then
					local parent = frame.Parent
					if parent then
						local pn = parent.Name:lower()
						-- Soru/Dash/X 按钮冷却
						if pn:find("soru") or pn:find("dash") or pn:find("x") then
							local pObj = frame:FindFirstChild("Percentage")
							local val = 0
							if pObj and pObj:IsA("NumberValue") then val = pObj.Value
							elseif frame:GetAttribute("Percentage") then val = frame:GetAttribute("Percentage")
							else val = tonumber(frame.Percentage) or 0 end
							if val >= 0.95 then ready = true; break end
						end
					end
				end
			end

			-- 兜底: MobileContextButtons 路径
			if not ready then
				local mobilePath = pg:FindFirstChild("MobileContextButtons")
				if mobilePath then
					local cd = mobilePath:FindFirstChild("ContextButtonFrame") and mobilePath.ContextButtonFrame:FindFirstChild("BoundActionSoru") and mobilePath.ContextButtonFrame.BoundActionSoru:FindFirstChild("Button") and mobilePath.ContextButtonFrame.BoundActionSoru.Button:FindFirstChild("Cooldown")
					if cd then
						local pObj = cd:FindFirstChild("Percentage")
						local val = 0
						if pObj and pObj:IsA("NumberValue") then val = pObj.Value
						elseif cd:GetAttribute("Percentage") then val = cd:GetAttribute("Percentage")
						else val = tonumber(cd.Percentage) or 0 end
						if val >= 0.95 then ready = true end
					end
				end
			end
		end)

		if ready then
			fireSoru()
			lastSoruTime = tick()
		end
	end
end)

print("[Soru自动] 已加载 | 远程发包绕过0.5秒延迟")
