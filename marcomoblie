-----------------------------------
-- 2. 获取最近的玩家
-----------------------------------
local function getNearestPlayer()
    local nearestPlayer = nil
    local shortestDistance = math.huge
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

    if not myRoot then return nil end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local humanoid = player.Character:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local distance = (myRoot.Position - player.Character.HumanoidRootPart.Position).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    nearestPlayer = player
                end
            end
        end
    end
    return nearestPlayer
end

-----------------------------------
-- 3. 拦截 Mouse.Hit (Aimbot)
-----------------------------------
local oldIndex
oldIndex = hookmetamethod(game, "__index", function(self, key)
    if getgenv().AutoSoruEnabled and self == Mouse then
        if key == "Hit" or key == "Target" then
            local nearest = getNearestPlayer()
            if nearest and nearest.Character and nearest.Character:FindFirstChild("HumanoidRootPart") then
                if key == "Hit" then
                    -- 拦截 Hit 返回最近玩家的 CFrame
                    return nearest.Character.HumanoidRootPart.CFrame
                elseif key == "Target" then
                    -- 拦截 Target 返回最近玩家的 BasePart
                    return nearest.Character.HumanoidRootPart
                end
            end
        end
    end
    return oldIndex(self, key)
end)

-----------------------------------
-- 4. 循环检测 UI 冷却并触发 X 键
-----------------------------------
task.spawn(function()
    while task.wait() do
        if getgenv().AutoSoruEnabled then
            -- 使用 pcall 防止因为玩家未加载 UI 或路径不存在导致的脚本报错中断
            pcall(function()
                local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
                if not PlayerGui then return end
                
                -- 根据您提供的路径寻找目标 UI
                local CooldownUI = PlayerGui.MobileContextButtons.ContextButtonFrame.BoundActionSoru.Button.Cooldown
                
                -- 兼容不同游戏的属性类型 (可能是直接属性、NumberValue 或者是 Attribute)
                local percentageVal = 0
                if CooldownUI:FindFirstChild("Percentage") and CooldownUI.Percentage:IsA("NumberValue") then
                    percentageVal = CooldownUI.Percentage.Value
                elseif CooldownUI:GetAttribute("Percentage") then
                    percentageVal = CooldownUI:GetAttribute("Percentage")
                else
                    percentageVal = CooldownUI.Percentage
                end

                -- 当 Percentage 大于等于 0.98 时触发
                if type(percentageVal) == "number" and percentageVal >= 0.98 then
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.X, false, game)
                    task.wait() 
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.X, false, game)
                    
                    -- 添加一个短暂的防抖延迟，防止同一瞬间触发几十次
                    task.wait(0.1) 
                end
            end)
        end
    end
end)
