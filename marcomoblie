-- ==================== 按键模拟 ====================
local function PressKey(keyCode)
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
        task.wait(0.03)
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    end)
end

local function GetActualDelay(base)
    if Config.UseRandomDelay then
        return math.max(Config.MinDelay, base + (math.random() * 2 - 1) * Config.RandomRange)
    end
    return base
end

-- ==================== 瞬步自瞄核心 ====================
local function GetNearestEnemy()
    local nearest = nil
    local shortest = Config.FlashStepRange
    local myPos = humanoidRootPart.Position
    
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local dist = (plr.Character.HumanoidRootPart.Position - myPos).Magnitude
                if dist < shortest then
                    shortest = dist
                    nearest = plr.Character
                end
            end
        end
    end
    
    local enemiesFolder = workspace:FindFirstChild("Enemies") or workspace:FindFirstChild("NPCs")
    if enemiesFolder then
        for _, enemy in pairs(enemiesFolder:GetChildren()) do
            if enemy:FindFirstChild("HumanoidRootPart") then
                local hum = enemy:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local dist = (enemy.HumanoidRootPart.Position - myPos).Magnitude
                    if dist < shortest then
                        shortest = dist
                        nearest = enemy
                    end
                end
            end
        end
    end
    
    return nearest, shortest
end

local function FaceTarget(targetRoot)
    if not targetRoot or not humanoidRootPart then return end
    local direction = (targetRoot.Position - humanoidRootPart.Position) * Vector3.new(1, 0, 1)
    if direction.Magnitude > 0.1 then
        humanoidRootPart.CFrame = CFrame.lookAt(humanoidRootPart.Position, humanoidRootPart.Position + direction)
    end
end

local function FlashToTarget(targetRoot)
    if not targetRoot or not humanoidRootPart then return end
    local now = tick()
    if now - Config.LastFlashStep < Config.FlashStepCooldown then return end
    
    local offset = targetRoot.CFrame.LookVector * -3 + Vector3.new(0, 1.5, 0)
    humanoidRootPart.CFrame = targetRoot.CFrame + offset
    Config.LastFlashStep = now
end

RunService.Heartbeat:Connect(function()
    if not Config.MasterEnabled or not Config.FlashStepEnabled then
        TargetLabel.Text = "目标：无"
        Config.CurrentTarget = nil
        return
    end
    
    if not humanoidRootPart or not humanoidRootPart.Parent then return end
    
    local target, dist = GetNearestEnemy()
    
    if target and target:FindFirstChild("HumanoidRootPart") then
        Config.CurrentTarget = target
        local root = target.HumanoidRootPart
        TargetLabel.Text = string.format("目标：%s  |  距离：%.1f", target.Name, dist)
        
        FaceTarget(root)
        
        if dist > Config.TriggerDistance + 2 then
            FlashToTarget(root)
        end
        
        if dist <= Config.TriggerDistance then
            PressKey(Enum.KeyCode.X)
        end
    else
        TargetLabel.Text = "目标：无（范围内无敌人）"
        Config.CurrentTarget = nil
    end
end)

