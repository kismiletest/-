-- ==================== 自动放技能核心 ====================
local function PressKey(keyCode)
    -- 更稳定的手机端按键模拟
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
        task.wait(0.03)
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    end)
end

local function GetActualDelay(baseDelay)
    if Config.UseRandomDelay then
        local offset = (math.random() * 2 - 1) * Config.RandomRange
        return math.max(Config.MinDelay, baseDelay + offset)
    end
    return baseDelay
end

-- Z 自动循环
task.spawn(function()
    while true do
        if Config.MasterEnabled and Config.Z_Enabled then
            PressKey(Enum.KeyCode.Z)
            task.wait(GetActualDelay(Config.Z_Delay))
        else
            task.wait(0.15)
        end
    end
end)

