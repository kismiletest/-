-- ==================== 最近玩家 ====================
local function getNearest()
	local nearest, shortest = nil, math.huge
	local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil, 99999 end
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character then
			local hrp = p.Character:FindFirstChild("HumanoidRootPart")
			local hum = p.Character:FindFirstChild("Humanoid")
			if hrp and hum and hum.Health > 0 then
				local d = (myRoot.Position - hrp.Position).Magnitude
				if d < shortest then shortest = d; nearest = p end
			end
		end
	end
	return nearest, shortest
end

-- ==================== Mouse.Hit 自瞄 ====================
local oldIndex
oldIndex = hookmetamethod(game, "__index", function(self, key)
	if getgenv().AutoSoruEnabled and self == Mouse and (key == "Hit" or key == "Target") then
		local nearest = getNearest()
		if nearest and nearest.Character then
			local hrp = nearest.Character:FindFirstChild("HumanoidRootPart")
			if hrp then
				if key == "Hit" then return CFrame.new(hrp.Position)
				elseif key == "Target" then return hrp end
			end
		end
	end
	return oldIndex(self, key)
end)

-- ==================== 冷却检测 ====================
local function getCooldownPercent()
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if not pg then return 0 end

	-- 路径1: Main > Skills (PC端)
	local main = pg:FindFirstChild("Main")
	if main then
		for _, frame in ipairs(main:GetDescendants()) do
			if frame:IsA("Frame") and frame.Name == "Cooldown" then
				local parent = frame.Parent
				if parent then
					local pn = parent.Name:lower()
					if pn:find("soru") or pn:find("dash") or pn:find("x") then
						local pObj = frame:FindFirstChild("Percentage")
						if pObj and pObj:IsA("NumberValue") then return pObj.Value end
						if frame:GetAttribute("Percentage") then return frame:GetAttribute("Percentage") end
						return tonumber(frame.Percentage) or 0
					end
				end
			end
		end
	end

	-- 路径2: 移动端 MobileContextButtons
	local mobilePath = pg:FindFirstChild("MobileContextButtons")
	if mobilePath then
		local cd = mobilePath:FindFirstChild("ContextButtonFrame") and mobilePath.ContextButtonFrame:FindFirstChild("BoundActionSoru") and mobilePath.ContextButtonFrame.BoundActionSoru:FindFirstChild("Button") and mobilePath.ContextButtonFrame.BoundActionSoru.Button:FindFirstChild("Cooldown")
		if cd then
			local pObj = cd:FindFirstChild("Percentage")
			if pObj and pObj:IsA("NumberValue") then return pObj.Value end
			if cd:GetAttribute("Percentage") then return cd:GetAttribute("Percentage") end
			return tonumber(cd.Percentage) or 0
		end
	end

	-- 路径3: 全局扫描
	for _, obj in ipairs(pg:GetDescendants()) do
		if obj:IsA("Frame") and obj.Name == "Cooldown" then
			local pn = obj.Parent and obj.Parent.Name:lower() or ""
			if pn:find("soru") or pn:find("dash") or pn:find("x") then
				local pObj = obj:FindFirstChild("Percentage")
				if pObj and pObj:IsA("NumberValue") then return pObj.Value end
				if obj:GetAttribute("Percentage") then return obj:GetAttribute("Percentage") end
				return tonumber(obj.Percentage) or 0
			end
		end
	end

	return 0
end

-- ==================== 主循环: 冷却好了就按X ====================
task.spawn(function()
	while task.wait(0.12) do
		if not getgenv().AutoSoruEnabled then continue end

		-- 防抖
		if tick() - lastSoruTime < 0.6 then continue end

		-- 只在有敌人时触发
		local _, dist = getNearest()
		if dist > 500 then continue end

		local cd = getCooldownPercent()
		if cd >= 0.95 then
			-- 方法1: CommF 发包 (标准入口)
			pcall(function()
				local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
				if commF then
					commF:InvokeServer("Soru")
				end
			end)

			-- 方法2: VirtualInputManager 按X
			pcall(function()
				VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.X, false, game)
				task.wait(0.03)
				VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.X, false, game)
			end)

			lastSoruTime = tick()
			print("[Soru] X键已触发")
		end
	end
end)

print("[自动瞬步X] 已加载 | CommF + VIM 双通道 | 有敌人才触发")
