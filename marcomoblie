-- ==================== 逻辑部分 ====================
local function UpdateStatus()
    if Config.MasterEnabled then
        local active = {}
        if Config.Z_Enabled then table.insert(active, "Z") end
        if Config.X_Enabled then table.insert(active, "X") end
        if Config.C_Enabled then table.insert(active, "C") end
        
        if #active > 0 then
            StatusLabel.Text = "状态：自动中 → " .. table.concat(active, " / ")
            StatusLabel.TextColor3 = Color3.fromRGB(80, 220, 120)
        else
            StatusLabel.Text = "状态：总开关已开，但未选择技能"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 180, 60)
        end
    else
        StatusLabel.Text = "状态：未开启自动"
        StatusLabel.TextColor3 = Color3.fromRGB(160, 160, 180)
    end
end

local function UpdateMasterButton()
    if Config.MasterEnabled then
        MasterBtn.Text = "总开关：开启"
        MasterBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 70)
    else
        MasterBtn.Text = "总开关：关闭"
        MasterBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
    end
    UpdateStatus()
end

local function ToggleSkill(key)
    if key == "Z" then
        Config.Z_Enabled = not Config.Z_Enabled
        ZRow.Toggle.Text = Config.Z_Enabled and "开" or "关"
        ZRow.Toggle.BackgroundColor3 = Config.Z_Enabled and Color3.fromRGB(45, 170, 75) or Color3.fromRGB(55, 55, 75)
    elseif key == "X" then
        Config.X_Enabled = not Config.X_Enabled
        XRow.Toggle.Text = Config.X_Enabled and "开" or "关"
        XRow.Toggle.BackgroundColor3 = Config.X_Enabled and Color3.fromRGB(45, 170, 75) or Color3.fromRGB(55, 55, 75)
    elseif key == "C" then
        Config.C_Enabled = not Config.C_Enabled
        CRow.Toggle.Text = Config.C_Enabled and "开" or "关"
        CRow.Toggle.BackgroundColor3 = Config.C_Enabled and Color3.fromRGB(45, 170, 75) or Color3.fromRGB(55, 55, 75)
    end
    UpdateStatus()
end

local function ChangeDelay(key, amount)
    if key == "Z" then
        Config.Z_Delay = math.clamp(Config.Z_Delay + amount, Config.MinDelay, Config.MaxDelay)
        ZRow.DelayLabel.Text = string.format("间隔: %.2fs", Config.Z_Delay)
    elseif key == "X" then
        Config.X_Delay = math.clamp(Config.X_Delay + amount, Config.MinDelay, Config.MaxDelay)
        XRow.DelayLabel.Text = string.format("间隔: %.2fs", Config.X_Delay)
    elseif key == "C" then
        Config.C_Delay = math.clamp(Config.C_Delay + amount, Config.MinDelay, Config.MaxDelay)
        CRow.DelayLabel.Text = string.format("间隔: %.2fs", Config.C_Delay)
    end
end

