<Page
    x:Class="BananaCatApp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BananaCatApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <!-- 浅色背景图片 -->
        <Image
            Source="/Assets/banana-cat-background.png"
            Stretch="UniformToFill"
            Opacity="0.65" />

        <!-- 浅色叠加层，让背景更柔和明亮 -->
        <Rectangle>
            <Rectangle.Fill>
                <SolidColorBrush Color="White" Opacity="0.45"/>
            </Rectangle.Fill>
        </Rectangle>

        <!-- 主内容区域 -->
        <Grid Padding="40">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="24">
                
                <!-- 标题 -->
                <TextBlock 
                    Text="🍌 Cat Banana Kitchen" 
                    FontSize="48" 
                    FontWeight="Bold" 
                    HorizontalAlignment="Center"
                    Foreground="#1F1F1F"
                    TextAlignment="Center"/>

                <!-- 副标题 -->
                <TextBlock 
                    Text="今天也要开心做饭呀～"
                    FontSize="24" 
                    HorizontalAlignment="Center"
                    Foreground="#555555"
                    TextAlignment="Center"/>

                <!-- 卡片示例 -->
                <Border 
                    Background="White"
                    CornerRadius="16"
                    Padding="32"
                    MaxWidth="420"
                    Shadow="0 8 32 #22000000">
                    <StackPanel Spacing="16">
                        <TextBlock 
                            Text="今日菜单" 
                            FontSize="22" 
                            FontWeight="SemiBold"
                            Foreground="#1F1F1F"/>
                        
                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Text="🥚" FontSize="32" Grid.Row="0" Grid.Column="0"/>
                            <TextBlock Text="香煎猫咪蛋" FontSize="18" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"/>
                            
                            <TextBlock Text="🍌" FontSize="32" Grid.Row="1" Grid.Column="0"/>
                            <TextBlock Text="香蕉猫特调" FontSize="18" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"/>
                            
                            <TextBlock Text="🥣" FontSize="32" Grid.Row="2" Grid.Column="0"/>
                            <TextBlock Text="猫咪爱心早餐" FontSize="18" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 操作按钮 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                    <Button 
                        Content="开始做饭" 
                        Style="{StaticResource AccentButtonStyle}"
                        FontSize="18"
                        Padding="32,16"
                        CornerRadius="12"/>
                    
                    <Button 
                        Content="保存配方" 
                        FontSize="18"
                        Padding="32,16"
                        CornerRadius="12"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
