v3Btn.MouseButton1Click:Connect(function()
    _ENV.rz_AbilityLoop = not _ENV.rz_AbilityLoop
    v3Btn.Text = _ENV.rz_AbilityLoop and "v3能力：开启" or "v3能力：关闭"

    if _ENV.rz_AbilityLoop then
        task.spawn(function()
            while _ENV.rz_AbilityLoop do
                task.wait(0.1)
                pcall(function()
                    game:GetService("ReplicatedStorage")
                        .Remotes
                        .CommE
                        :FireServer("ActivateAbility")
                end)
            end
        end)
    end
end)

