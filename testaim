-- 自动重进 (冷却后)
task.spawn(function()
	while task.wait(5) do
		if not _G.AutoRejoinCD then continue end
		pcall(function()
			local leviParts = findLeviParts()
			-- 有利维坦就跳过
			if #leviParts > 0 then return end
			local seaBeasts = Workspace:FindFirstChild("SeaBeasts")
			local seaEvents = Workspace:FindFirstChild("SeaEvents")
			local hasEnemy = (seaBeasts and #seaBeasts:GetChildren() > 0) or (seaEvents and #seaEvents:GetChildren() > 0)
			if hasEnemy then return end

			local hasCooldown = false
			for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
				local n = obj.Name:lower()
				if n:find("cooldown") or n:find("levi") then
					local val = tonumber(obj:GetAttribute("Value") or obj:GetAttribute("Cooldown") or obj.Value)
					if val and val > 0 then hasCooldown = true; break end
				end
			end
			if hasCooldown then
				print("[冷却] 检测到利维坦冷却, 重进服务器...")
				task.wait(2)
				pcall(function() game:GetService("TeleportService"):Teleport(game.PlaceId, LocalPlayer) end)
				pcall(function()
					local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
					if commF then commF:InvokeServer("Rejoin") end
				end)
			end
		end)
	end
end)

