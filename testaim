-- ==================== 工具函数 ====================
local function isLeviPart(obj)
	local name = obj.Name:lower()
	local parentName = obj.Parent and obj.Parent.Name:lower() or ""
	local grandName = obj.Parent and obj.Parent.Parent and obj.Parent.Parent.Name:lower() or ""
	for _, kw in ipairs(leviNames) do
		if name:find(kw:lower()) or parentName:find(kw:lower()) or grandName:find(kw:lower()) then
			return true
		end
	end
	return false
end

local function findLeviParts()
	local parts = {}
	local seen = {}

	local function scan(folder)
		if not folder then return end
		for _, child in ipairs(folder:GetChildren()) do
			if not seen[child] and isLeviPart(child) then
				seen[child] = true
				if child:IsA("BasePart") or child:IsA("Model") then
					local hum = child:FindFirstChildOfClass("Humanoid") or child:FindFirstChild("Humanoid")
					local root = child:IsA("BasePart") and child or child:FindFirstChildWhichIsA("BasePart")
					if root then
						table.insert(parts, {
							obj = child,
							part = root,
							hum = hum,
							name = child.Name,
						})
					end
				end
			end
			if child:IsA("Model") or child:IsA("Folder") then
				scan(child)
			end
		end
	end

	scan(Workspace:FindFirstChild("SeaBeasts"))
	scan(Workspace:FindFirstChild("SeaEvents"))
	scan(Workspace:FindFirstChild("Bosses"))
	scan(Workspace) -- 兜底

	return parts
end

-- 初始化远程
local function getRemotes()
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local mods = ReplicatedStorage:FindFirstChild("Modules")
	local net = mods and mods:FindFirstChild("Net")
	return remotes, mods, net
end

-- ==================== 攻击逻辑 ====================
task.spawn(function()
	while task.wait(0.15) do
		if not _G.AutoLeviathan then continue end

		pcall(function()
			local leviParts = findLeviParts()
			if #leviParts == 0 then
				-- 没有利维坦: 尝试召唤船出海
				if _G.AutoSpawnBoat then
					spawnBoat()
				end
				return
			end

			local char = LocalPlayer.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if not root then return end

			local _, mods, net = getRemotes()
			if not net then return end

			local RA = net:FindFirstChild("RE/RegisterAttack") or net:FindFirstChild("RegisterAttack")
			local RH = net:FindFirstChild("RE/RegisterHit") or net:FindFirstChild("RegisterHit")
			if not RA or not RH then return end

			-- 找到最近的利维坦部位
			local nearestPart = nil
			local nearestDist = math.huge
			for _, lp in ipairs(leviParts) do
				local d = (lp.part.Position - root.Position).Magnitude
				if d < nearestDist then
					nearestDist = d
					nearestPart = lp
				end
			end

			if nearestPart then
				-- 传送到部位附近
				if nearestDist > 100 then
					local boat = findMyBoat()
					if boat then
						-- 控制船只靠近
						local boatRoot = boat:FindFirstChild("VehicleSeat") or boat:FindFirstChildWhichIsA("BasePart")
						if boatRoot then
							boatRoot.CFrame = CFrame.new(nearestPart.part.Position + Vector3.new(0, 20, -30))
						end
					else
						-- 直接传送角色
						root.CFrame = CFrame.new(nearestPart.part.Position + Vector3.new(0, 20, -30))
					end
				end

				-- 构建攻击列表 (攻击所有利维坦部位)
				local hitList = {}
				for _, lp in ipairs(leviParts) do
					local part = lp.part
					local model = lp.obj:IsA("Model") and lp.obj or lp.obj.Parent
					if model then
						table.insert(hitList, {model, part})
					end
				end

				-- 发包攻击
				if #hitList > 0 then
					RA:FireServer(0.3)
					RH:FireServer(nearestPart.part, hitList)
				end

				-- 心脏优先逻辑
				for _, lp in ipairs(leviParts) do
					if lp.name:lower():find("heart") or lp.name:lower():find("心脏") then
						local hum = lp.obj:FindFirstChildOfClass("Humanoid") or lp.obj.Parent and lp.obj.Parent:FindFirstChildOfClass("Humanoid")
						if hum and hum.Health > 0 then
							RA:FireServer(0.3)
							RH:FireServer(lp.part, {{lp.obj:IsA("Model") and lp.obj or lp.obj.Parent, lp.part}})
						end
					end
				end
			end
		end)
	end
end)

-- ==================== 获取我的船 ====================
local function findMyBoat()
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("Model") and obj.Name:lower():find("boat") then
			local seat = obj:FindFirstChild("VehicleSeat")
			if seat and seat.Occupant == LocalPlayer.Character and LocalPlayer.Character then
				return obj
			end
		end
	end
	-- 也搜索 BoatModel / PirateBoat 等
	for _, obj in ipairs(Workspace:GetChildren()) do
		if obj:IsA("Model") then
			local seat = obj:FindFirstChildWhichIsA("VehicleSeat")
			if seat and seat.Occupant and seat.Occupant:IsDescendantOf(LocalPlayer.Character or Instance.new("Model")) then
				return obj
			end
		end
	end
	return nil
end

local function spawnBoat()
	local _, _, net = getRemotes()
	if not net then return end

	-- 尝试各种召唤船的远程
	local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
	if commF then
		pcall(function() commF:InvokeServer("Boat") end)
	end

	-- 或者直接点屏幕上的船按钮
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if pg then
		for _, btn in ipairs(pg:GetDescendants()) do
			if btn:IsA("TextButton") or btn:IsA("ImageButton") then
				local t = (btn:IsA("TextButton") and btn.Text or btn.Name):lower()
				if t:find("boat") or t:find("船") or t:find("spawn") then
					pcall(function()
						local vim = game:GetService("VirtualInputManager")
						local absPos = btn.AbsolutePosition
						local absSize = btn.AbsoluteSize
						vim:SendMouseButtonEvent(absPos.X + absSize.X/2, absPos.Y + absSize.Y/2, 0, true, game, 0)
						task.wait(0.05)
						vim:SendMouseButtonEvent(absPos.X + absSize.X/2, absPos.Y + absSize.Y/2, 0, false, game, 0)
					end)
					return
				end
			end
		end
	end
end

