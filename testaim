-- ==================== Remote 扫描 ====================
local summonRemotes = {}
local function scanForSummonRemotes()
    summonRemotes = {}
    local summonKeywords = { "summon", "roll", "pull", "spin", "gacha", "luck", "banner", "wish", "召唤", "抽卡", "抽取", "许愿" }
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") or obj:IsA("BindableEvent") or obj:IsA("BindableFunction") then
            local name = obj.Name:lower()
            local parentName = obj.Parent and obj.Parent.Name:lower() or ""
            local fullPath = obj:GetFullName():lower()
            for _, kw in ipairs(summonKeywords) do
                if name:find(kw) or parentName:find(kw) or fullPath:find(kw) then
                    table.insert(summonRemotes, { obj = obj, name = obj.Name, path = obj:GetFullName(), type = obj.ClassName })
                    break
                end
            end
        end
    end
    table.sort(summonRemotes, function(a, b) return a.path < b.path end)
end

function printAllRemotes()
    scanForSummonRemotes()
    print("========== 抽卡相关 Remote ==========")
    if #summonRemotes == 0 then
        print("  未找到抽卡 Remote, 开启 Remote 监控后手动抽一次卡试试")
        print("  提示: 检查 ReplicatedStorage 中 Remotes/Events/Functions 文件夹")
        print("  常见名字: Summon, Roll, Pull, Spin, Gacha, Banner, Wish")
    else
        for i, r in ipairs(summonRemotes) do
            print("  [" .. i .. "] " .. r.type .. " | " .. r.path)
        end
    end
    print("======================================")
end

scanForSummonRemotes()
task.spawn(function() task.wait(3); printAllRemotes() end)

-- ==================== __namecall 拦截 (x100 幸运核心) ====================
local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    -- Remote 监控 (可选)
    if _G.RemoteSpy and (method == "FireServer" or method == "InvokeServer") then
        local argPreview = {}
        for i, v in ipairs(args) do
            if i > 5 then argPreview[#argPreview + 1] = "..."; break end
            if typeof(v) == "table" then
                argPreview[#argPreview + 1] = "table[" .. #v .. "]"
            elseif typeof(v) == "string" then
                argPreview[#argPreview + 1] = '"' .. v .. '"'
            elseif typeof(v) == "number" then
                argPreview[#argPreview + 1] = tostring(v)
            else
                argPreview[#argPreview + 1] = typeof(v)
            end
        end
        print("[Remote] " .. tostring(self) .. " > " .. method .. "(" .. table.concat(argPreview, ", ") .. ")")
    end

    -- x100 幸运逻辑: 修改召唤参数中的倍率
    if _G.X100Luck and (method == "FireServer" or method == "InvokeServer") then
        -- 检查是否是目标 Remote
        local isSummon = false
        for _, r in ipairs(summonRemotes) do
            if self == r.obj then isSummon = true; break end
        end

        -- 如果精准匹配到了召唤 Remote
        if isSummon then
            local newArgs = {}
            for i, v in ipairs(args) do
                -- 找到倍率/luck 参数并乘上倍率
                if typeof(v) == "number" and (v < 1000) then
                    -- 小数值可能是 luck/bonus 参数
                    newArgs[i] = v * _G.LuckMultiplier
                elseif typeof(v) == "table" and v.luck then
                    -- 如果参数是 table 且有 luck 字段
                    local t = {}
                    for k, val in pairs(v) do
                        if k == "luck" or k == "multiplier" or k == "bonus" then
                            t[k] = val * _G.LuckMultiplier
                        else
                            t[k] = val
                        end
                    end
                    newArgs[i] = t
                else
                    newArgs[i] = v
                end
            end

            print("[x" .. _G.LuckMultiplier .. " 幸运] 修改发包: " .. tostring(self))
            return oldNamecall(self, unpack(newArgs))
        end
    end

    -- 泛用拦截: 如果第一个参数是数字且疑似倍率(小数值)
    if _G.X100Luck and not next(summonRemotes) and (method == "FireServer" or method == "InvokeServer") then
        local selfName = tostring(self):lower()
        if selfName:find("summon") or selfName:find("roll") or selfName:find("pull") or selfName:find("spin") or selfName:find("gacha") then
            local newArgs = {}
            for i, v in ipairs(args) do
                if typeof(v) == "number" then
                    newArgs[i] = v * _G.LuckMultiplier
                else
                    newArgs[i] = v
                end
            end
            return oldNamecall(self, unpack(newArgs))
        end
    end

    return oldNamecall(self, ...)
end)
setreadonly(mt, true)

-- ==================== 自动抽卡 ====================
task.spawn(function()
    while task.wait(2) do
        if not _G.AutoSummon then continue end

        -- 找 ProximityPrompt 中的抽卡按钮
        local found = false
        pcall(function()
            local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
            if not playerGui then return end
            for _, obj in ipairs(playerGui:GetDescendants()) do
                if obj:IsA("TextButton") or obj:IsA("ImageButton") then
                    local name = obj.Name:lower()
                    local text = (obj:IsA("TextButton") and obj.Text or ""):lower()
                    if name:find("summon") or name:find("roll") or name:find("pull") or name:find("spin")
                       or text:find("summon") or text:find("roll") or text:find("pull") or text:find("召唤") then
                        -- 模拟点击
                        local guiService = game:GetService("GuiService")
                        guiService.SelectedObject = obj
                        pcall(function()
                            local clicks = {
                                Enum.UserInputType.MouseButton1,
                                Enum.UserInputType.Touch,
                            }
                            for _, inputType in ipairs(clicks) do
                                game:GetService("VirtualInputManager"):SendMouseButtonEvent(
                                    obj.AbsolutePosition.X + obj.AbsoluteSize.X / 2,
                                    obj.AbsolutePosition.Y + obj.AbsoluteSize.Y / 2,
                                    0, true, game, inputType
                                )
                                task.wait(0.05)
                                game:GetService("VirtualInputManager"):SendMouseButtonEvent(
                                    obj.AbsolutePosition.X + obj.AbsoluteSize.X / 2,
                                    obj.AbsolutePosition.Y + obj.AbsoluteSize.Y / 2,
                                    0, false, game, inputType
                                )
                            end
                        end)
                        found = true
                        break
                    end
                end
            end
        end)

        if not found then
            -- 如果没有找到 UI 按钮，尝试遍历所有召唤 Remote 发包
            for _, r in ipairs(summonRemotes) do
                if r.obj:IsA("RemoteEvent") then
                    pcall(function() r.obj:FireServer() end)
                elseif r.obj:IsA("RemoteFunction") then
                    pcall(function() r.obj:InvokeServer() end)
                end
            end
        end
    end
end)

