-- ==================== Roblox 飞行脚本 ====================
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

-- ==================== 状态 ====================
_G.Fly = _G.Fly or false
_G.FlySpeed = _G.FlySpeed or 50
_G.FlyMode = _G.FlyMode or "BodyVelocity"

local flying = false
local flyBodyGyro, flyBodyVel
local keys = { W = false, A = false, S = false, D = false, Space = false, LeftShift = false }

-- ==================== GUI ====================
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "FlyGUI"
screenGui.Parent = pcall(function() return game:GetService("CoreGui") end) and game:GetService("CoreGui") or LocalPlayer:WaitForChild("PlayerGui")

