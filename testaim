-- 手机自瞄脚本 (静默自瞄版)
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera
local Mouse = LocalPlayer:GetMouse()

local state = {
	enabled = false,
	fov = 200,
	part = "Head",
	teamCheck = true,
	showFOV = true,
}

-- ==================== GUI (手机触屏兼容) ====================
local sgui = Instance.new("ScreenGui")
sgui.Parent = pcall(function() return game:GetService("CoreGui") end) and game:GetService("CoreGui") or LocalPlayer.PlayerGui
sgui.Name = "MobileAimbot"

local frame = Instance.new("Frame", sgui)
frame.Size = UDim2.new(0, 180, 0, 70)
frame.Position = UDim2.new(0, 10, 0, 100)
frame.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
frame.BorderSizePixel = 0
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)

-- 拖动条
local dragBar = Instance.new("TextButton", frame)
dragBar.Size = UDim2.new(1, 0, 0, 24)
dragBar.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
dragBar.Text = "手机自瞄"
dragBar.TextColor3 = Color3.new(1, 1, 1)
dragBar.TextSize = 13
dragBar.Font = Enum.Font.GothamBold
dragBar.AutoButtonColor = false
Instance.new("UICorner", dragBar).CornerRadius = UDim.new(0, 10)

-- 拖动
local drag = { on = false }
dragBar.InputBegan:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
		drag.on = true; drag.start = i.Position; drag.pos = frame.Position
	end
end)
game:GetService("UserInputService").InputChanged:Connect(function(i)
	if not drag.on then return end
	local dt = drag.start and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch)
	if dt then
		local d = i.Position - drag.start
		frame.Position = UDim2.new(drag.pos.X.Scale, drag.pos.X.Offset + d.X, drag.pos.Y.Scale, drag.pos.Y.Offset + d.Y)
	end
end)
game:GetService("UserInputService").InputEnded:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
		drag.on = false
	end
end)

-- 开关按钮
local btn = Instance.new("TextButton", frame)
btn.Size = UDim2.new(0, 70, 0, 30)
btn.Position = UDim2.new(0, 10, 0, 32)
btn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
btn.Text = "OFF"
btn.TextColor3 = Color3.new(1, 1, 1)
btn.TextSize = 13
btn.Font = Enum.Font.GothamBold
btn.AutoButtonColor = false
Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

-- 部位切换
local partBtn = Instance.new("TextButton", frame)
partBtn.Size = UDim2.new(0, 90, 0, 30)
partBtn.Position = UDim2.new(1, -100, 0, 32)
partBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 58)
partBtn.Text = "Head"
partBtn.TextColor3 = Color3.new(0.9, 0.9, 0.9)
partBtn.TextSize = 12
partBtn.Font = Enum.Font.GothamBold
partBtn.AutoButtonColor = false
Instance.new("UICorner", partBtn).CornerRadius = UDim.new(0, 6)

local parts = { "Head", "Torso", "HumanoidRootPart" }
local partIdx = 1

-- 事件 (用 Activated 兼容手机触屏)
btn.Activated:Connect(function()
	state.enabled = not state.enabled
	if state.enabled then
		btn.Text = "ON"
		btn.BackgroundColor3 = Color3.fromRGB(45, 180, 85)
	else
		btn.Text = "OFF"
		btn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
	end
end)

partBtn.Activated:Connect(function()
	partIdx = partIdx % #parts + 1
	state.part = parts[partIdx]
	partBtn.Text = state.part
end)

-- ==================== FOV 圈 (手机屏幕) ====================
local fovCircle
if Drawing then
	fovCircle = Drawing.new("Circle")
	fovCircle.Visible = state.showFOV
	fovCircle.Color = Color3.fromRGB(255, 40, 40)
	fovCircle.Radius = state.fov
	fovCircle.Thickness = 2
	fovCircle.Filled = false
	fovCircle.NumSides = 48
end

-- ==================== 目标检测 ====================
local function isEnemy(player)
	if not player or player == LocalPlayer then return false end
	if not state.teamCheck then return true end
	if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then return false end
	return true
end

local function getAlivePart(player)
	local char = player.Character
	if not char then return nil end
	local hum = char:FindFirstChildOfClass("Humanoid") or char:FindFirstChild("Humanoid")
	if not hum or hum.Health <= 0 then return nil end
	return char:FindFirstChild(state.part) or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
end

local function findBestTarget()
	local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
	local best, bestDist = nil, state.fov

	for _, player in ipairs(Players:GetPlayers()) do
		if not isEnemy(player) then continue end
		local part = getAlivePart(player)
		if not part then continue end
		local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
		if not onScreen then continue end
		local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
		if dist < bestDist then bestDist = dist; best = part end
	end
	return best
end

-- ==================== 静默自瞄 Hook ====================
local oldIndex
pcall(function()
	oldIndex = hookmetamethod(game, "__index", function(self, key)
		if state.enabled and self == Mouse then
			local target = findBestTarget()
			if target then
				if key == "Hit" then return CFrame.new(target.Position)
				elseif key == "Target" then return target end
			end
		end
		return oldIndex(self, key)
	end)
end)

-- FOV 圈
if fovCircle then
	RunService.RenderStepped:Connect(function()
		fovCircle.Visible = state.showFOV and state.enabled
		fovCircle.Radius = state.fov
		fovCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
	end)
end

print("[手机自瞄] 已加载 | 静默自瞄 | 点 ON 开启")
