task.spawn(function()
    while task.wait(0.5) do
        if not _G.Auto_NextLevel then continue end

        -- 优先收集物品
        if _G.Auto_Collect then
            local item = findNearest(function(o, pp, cd)
                local p = o.Parent; if p and p:FindFirstChild("Humanoid") then return false end
                return matchKW(o.Name, itemNames) or matchKW(o.Name, itemKw)
            end)
            if item then
                if _G.TargetObjective then teleportTo(item) end
                interact(item)
            end
        end

        -- 自动开门
        if _G.Auto_OpenDoors then
            local door = findNearest(function(o) return matchKW(o.Name, doorKw) end)
            if door then
                if _G.TargetObjective then teleportTo(door) end
                interact(door)
            end
        end

        -- 核心: 找下一关出口
        local nextLevelObj = nil

        -- 优先查新生成物体
        for i, obj in ipairs(newSpawnedExits) do
            if obj and obj.Parent then
                nextLevelObj = obj
                table.remove(newSpawnedExits, i)
                break
            end
        end

        -- 全量扫描出口
        if not nextLevelObj then
            local exits = scanAllExits()
            if #exits > 0 then nextLevelObj = exits[1] end
        end

        if nextLevelObj then
            print("[通关] 找到下一关入口: " .. nextLevelObj:GetFullName() .. " | 传送中...")
            -- 多点传送 (对出口区域上下左右都试试)
            local part = nextLevelObj:IsA("BasePart") and nextLevelObj or nextLevelObj:FindFirstChildWhichIsA("BasePart")
            if part and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = LocalPlayer.Character.HumanoidRootPart
                -- 尝试多个位置
                local positions = {
                    part.CFrame + Vector3.new(0, 3, 0),
                    part.CFrame + Vector3.new(0, 5, -3),
                    part.CFrame + Vector3.new(0, 3, 3),
                    part.Position + Vector3.new(0, 5, 0),
                }
                for _, cf in ipairs(positions) do
                    hrp.CFrame = cf
                    interact(nextLevelObj)
                    task.wait(0.15)
                end
            end
            interact(nextLevelObj)
        end
    end
end)

