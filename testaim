-- 拖动
Frame.Active = true
local dragInfo = { on = false }
Frame.InputBegan:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 then
		dragInfo.on = true; dragInfo.start = i.Position; dragInfo.pos = Frame.Position
	end
end)
