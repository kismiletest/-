-- 获取所有怪物模型 (带 Humanoid 的非玩家 Character)
local function getMonsterModels()
    local monsters = {}
    local seen = {}
    -- 优先查 Enemy/Monster/NPC 文件夹
    local function scanFolder(folder)
        if not folder then return end
        for _, child in ipairs(folder:GetChildren()) do
            if child:IsA("Model") and not seen[child] then
                seen[child] = true
                local hum = child:FindFirstChildOfClass("Humanoid") or child:FindFirstChild("Humanoid")
                local root = child:FindFirstChild("HumanoidRootPart")
                if hum and hum.Health > 0 and root then
                    local isPlayer = Players:GetPlayerFromCharacter(child)
                    if not isPlayer then
                        table.insert(monsters, {model = child, hum = hum, root = root})
                    end
                end
            end
        end
    end
    scanFolder(Workspace:FindFirstChild("Enemies"))
    scanFolder(Workspace:FindFirstChild("Enemy"))
    scanFolder(Workspace:FindFirstChild("NPCs"))
    scanFolder(Workspace:FindFirstChild("Monsters"))
    scanFolder(Workspace:FindFirstChild("Monster"))
    scanFolder(Workspace:FindFirstChild("Spawned"))
    scanFolder(Workspace:FindFirstChild("Mobs"))
    scanFolder(Workspace:FindFirstChild("Live"))
    scanFolder(Workspace:FindFirstChild("Characters")) -- 有些游戏把怪物放这里
    scanFolder(Workspace) -- 兜底扫描 Workspace 顶层
    return monsters
end

-- 是否是模仿者特定怪物
local function isMimicType(name)
    name = name:lower()
    return name:find("mimic") or name:find("模仿") or name:find("jealous") or name:find("revenge")
        or name:find("vengeful") or name:find("control") or name:find("witch")
        or name:find("samurai") or name:find("wrath") or name:find("abandon")
end
local function matchKW(name, kwList)
    name = name:lower()
    for _, kw in ipairs(kwList) do if name:find(kw) then return true end end
    return false
end

-- ==================== 优化版 ESP (缓存 + 距离过滤 + 节流) ====================
local espPool = {} -- 对象池复用 Drawing 对象
local function getESPText()
    if not Drawing then return nil end
    for _, t in ipairs(espPool) do
        if not t.Visible then return t end
    end
    local d = Drawing.new("Text")
    d.Size = 13; d.Center = true; d.Outline = true; d.OutlineColor = Color3.new(); d.Font = 2
    table.insert(espPool, d)
    return d
end

local tracerPool = {}
local function getTracer()
    if not Drawing then return nil end
    for _, t in ipairs(tracerPool) do
        if not t.Visible then return t end
    end
    local l = Drawing.new("Line"); l.Thickness = 1; l.Transparency = 0.5
    table.insert(tracerPool, l)
    return l
end

-- 缓存扫描结果, 降低 GetDescendants 调用频率
local cachedDescendants = {}
local lastCacheTime = 0
local function getCachedDescendants()
    if tick() - lastCacheTime > 0.5 then
        cachedDescendants = Workspace:GetDescendants()
        lastCacheTime = tick()
    end
    return cachedDescendants
end

local lastESPUpdate = 0
local ESP_LIMIT = 60 -- 最多显示 60 个 ESP 标签
task.spawn(function()
    while task.wait() do
        if not Drawing then continue end
        local now = tick()
        if now - lastESPUpdate < 0.15 then continue end
        lastESPUpdate = now

        -- 隐藏所有
        for _, t in ipairs(espPool) do t.Visible = false end
        for _, l in ipairs(tracerPool) do l.Visible = false end
        local espCount = 0

        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local myPos = myRoot and myRoot.Position
        local vpSize = Camera.ViewportSize
        local screenCenter = Vector2.new(vpSize.X / 2, vpSize.Y)
        local maxDist = _G.ESP_MaxDistance or 500
        local showTracers = _G.ShowTracers

        -- 玩家 ESP
        if _G.ESP_Players and espCount < ESP_LIMIT then
            for _, player in ipairs(Players:GetPlayers()) do
                if player == LocalPlayer then continue end
                local char = player.Character
                local head = char and char:FindFirstChild("Head")
                local hum = char and char:FindFirstChild("Humanoid")
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if not head or not hum or not root then continue end
                if myPos and (root.Position - myPos).Magnitude > maxDist then continue end

                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if not onScreen then continue end

                local parts = {}
                if _G.ShowPlayerNames then parts[#parts+1] = player.Name end
                if _G.ShowDistance and myPos then parts[#parts+1] = " " .. math.floor((root.Position - myPos).Magnitude) .. "m" end

                local txt = getESPText(); if not txt then break end
                txt.Text = table.concat(parts); txt.Color = Color3.fromRGB(255,255,0)
                txt.Position = Vector2.new(pos.X, pos.Y); txt.Visible = true; espCount = espCount + 1

                if showTracers then
                    local tr = getTracer(); tr.Color = Color3.fromRGB(255,255,0)
                    tr.From = screenCenter; tr.To = Vector2.new(pos.X, pos.Y); tr.Visible = true
                end
            end
        end

        -- 怪物 ESP (直接扫描 Humanoid 模型)
        if _G.ESP_Monsters and espCount < ESP_LIMIT then
            for _, m in ipairs(getMonsterModels()) do
                if espCount >= ESP_LIMIT then break end
                if myPos and (m.root.Position - myPos).Magnitude > maxDist then continue end

                local head = m.model:FindFirstChild("Head")
                local pos, onScreen
                if head then
                    pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                else
                    pos, onScreen = Camera:WorldToViewportPoint(m.root.Position + Vector3.new(0,3,0))
                end
                if not onScreen then continue end

                local healthPercent = math.floor(m.hum.Health / m.hum.MaxHealth * 100)
                local tag = "[怪物] "
                if isMimicType(m.model.Name) then tag = "[模仿者] " end
                local label = tag .. m.model.Name .. " " .. healthPercent .. "%"

                local txt = getESPText(); if not txt then break end
                txt.Text = label; txt.Color = Color3.fromRGB(255,60,60)
                txt.Position = Vector2.new(pos.X, pos.Y); txt.Visible = true
                espCount = espCount + 1

                if showTracers then
                    local tr = getTracer(); tr.Color = Color3.fromRGB(255,60,60)
                    tr.From = screenCenter; tr.To = Vector2.new(pos.X, pos.Y); tr.Visible = true
                end
            end
        end
    end
end)

-- ==================== 自动找物体 (优化: 用缓存) ====================
local function findNearest(filterFn)
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local myPos, nearest, nd = root.Position, nil, _G.CollectRange
    for _, obj in ipairs(getCachedDescendants()) do
        local pp = obj:FindFirstChildWhichIsA("ProximityPrompt")
        if pp and pp.Enabled == false then continue end
        local cd = obj:FindFirstChildWhichIsA("ClickDetector")
        if not pp and not cd then continue end
        if filterFn and not filterFn(obj, pp, cd) then continue end
        local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
        if not part then continue end
        local d = (part.Position - myPos).Magnitude
        if d < nd then nd = d; nearest = obj end
    end
    return nearest
end

local function interact(obj)
    if not obj then return end
    local pp = obj:FindFirstChildWhichIsA("ProximityPrompt")
    if pp and pp.Enabled ~= false then fireproximityprompt(pp); return end
    local cd = obj:FindFirstChildWhichIsA("ClickDetector")
    if cd then fireclickdetector(cd); return end
    for _, c in ipairs(obj:GetChildren()) do
        if c:IsA("TouchTransmitter") then pcall(function() c:TouchInterest(obj) end) end
    end
end

local function teleportTo(obj)
    local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
    if part and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character.HumanoidRootPart.CFrame = part.CFrame + Vector3.new(0, 3, 0)
    end
end

-- ==================== 自动通关: 检测下一关传送 ====================
-- 监听新生成物体 (某些游戏通关后才生成出口)
local newSpawnedExits = {}
Workspace.ChildAdded:Connect(function(child)
    task.wait(0.3)
    if matchKW(child.Name, nextLevelKw) then
        table.insert(newSpawnedExits, child)
    end
    -- 也检查子物体
    for _, obj in ipairs(child:GetDescendants()) do
        if matchKW(obj.Name, nextLevelKw) then
            table.insert(newSpawnedExits, obj)
        end
    end
end)

task.spawn(function()
    while task.wait(0.3) do
        if not _G.Auto_NextLevel then continue end

        -- 优先收集当前关卡物品
        if _G.Auto_Collect then
            local item = findNearest(function(o, pp, cd)
                local p = o.Parent; if p and p:FindFirstChild("Humanoid") then return false end
                return matchKW(o.Name, itemNames) or matchKW(o.Name, itemKw)
            end)
            if item then
                if _G.TargetObjective then teleportTo(item) end
                interact(item)
            end
        end

        if _G.Auto_OpenDoors then
            local door = findNearest(function(o, pp, cd) return matchKW(o.Name, doorKw) end)
            if door then
                if _G.TargetObjective then teleportTo(door) end
                interact(door)
            end
        end

        -- 核心: 检测下一关入口 (多策略)
        local nextLevelObj = nil

        -- 优先查新生成的物体
        for _, obj in ipairs(newSpawnedExits) do
            if obj and obj.Parent then nextLevelObj = obj; break end
        end

        if not nextLevelObj then
            for _, obj in ipairs(getCachedDescendants()) do
                local name = obj.Name:lower()
                local parentName = obj.Parent and obj.Parent.Name:lower() or ""

                -- 匹配下一关关键词
                if matchKW(obj.Name, nextLevelKw) then
                    nextLevelObj = obj; break
                end
                -- 也匹配父级名
                if matchKW(parentName, nextLevelKw) then
                    nextLevelObj = obj; break
                end

                -- 门类 + 下一关提示
                if matchKW(obj.Name, doorKw) then
                    local surface = obj:FindFirstChildOfClass("SurfaceGui") or obj:FindFirstChildWhichIsA("BillboardGui")
                    if surface then
                        local tl = surface:FindFirstChildOfClass("TextLabel")
                        if tl and matchKW(tl.Text, nextLevelKw) then nextLevelObj = obj; break end
                    end
                end

                -- 透明或半透明 Part (可能是传送门)
                if (name:find("teleport") or name:find("tp") or parentName:find("teleport") or parentName:find("tp") or name:find("portal") or name:find("传送")) then
                    local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                    if part then nextLevelObj = obj; break end
                end

                -- 带 ProximityPrompt 且 ActionText 含通过关键词
                local pp = obj:FindFirstChildWhichIsA("ProximityPrompt")
                if pp and pp.Enabled ~= false then
                    local txt = (pp.ActionText or ""):lower()
                    local objTxt = (pp.ObjectText or ""):lower()
                    if txt:find("enter") or txt:find("open") or txt:find("next") or txt:find("进入") or txt:find("下一")
                       or objTxt:find("exit") or objTxt:find("leave") or objTxt:find("escape") then
                        nextLevelObj = obj; break
                    end
                end

                -- 检测 Region3/Trigger 类型物体 (碰撞触发传送)
                if (name:find("trigger") or name:find("region") or name:find("finish") or name:find("end") or name:find("clear")) then
                    if obj:IsA("BasePart") and obj.Transparency > 0.5 then
                        nextLevelObj = obj; break
                    end
                end
            end
        end

        if nextLevelObj then
            -- 传送到下一关入口并交互
            teleportTo(nextLevelObj)
            interact(nextLevelObj)
            task.wait(0.5)
            interact(nextLevelObj)
            -- 清理已用的出口记录
            newSpawnedExits = {}
        end
    end
end)

