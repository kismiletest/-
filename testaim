local function isLeviPart(obj)
	local name = obj.Name:lower()
	local pn = obj.Parent and obj.Parent.Name:lower() or ""
	local gn = obj.Parent and obj.Parent.Parent and obj.Parent.Parent.Name:lower() or ""
	for _, kw in ipairs(leviNames) do
		local l = kw:lower()
		if name:find(l) or pn:find(l) or gn:find(l) then return true end
	end
	return false
end

local function findLeviParts()
	local parts, seen = {}, {}
	local function scan(f)
		if not f then return end
		for _, c in ipairs(f:GetChildren()) do
			if not seen[c] and isLeviPart(c) then
				seen[c] = true
				if c:IsA("BasePart") or c:IsA("Model") then
					local root = c:IsA("BasePart") and c or c:FindFirstChildWhichIsA("BasePart")
					if root then
						table.insert(parts, {obj=c, part=root, hum=c:FindFirstChildOfClass("Humanoid") or c:FindFirstChild("Humanoid"), name=c.Name})
					end
				end
			end
			if c:IsA("Model") or c:IsA("Folder") then scan(c) end
		end
	end
	scan(Workspace:FindFirstChild("SeaBeasts"))
	scan(Workspace:FindFirstChild("SeaEvents"))
	scan(Workspace:FindFirstChild("Bosses"))
	scan(Workspace)
	return parts
end

local function getRemotes()
	local m = ReplicatedStorage:FindFirstChild("Modules")
	local n = m and m:FindFirstChild("Net")
	return ReplicatedStorage:FindFirstChild("Remotes"), m, n
end

local function findMyBoat()
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("Model") then
			local seat = obj:FindFirstChildWhichIsA("VehicleSeat")
			if seat and seat.Occupant == LocalPlayer.Character then return obj end
		end
	end
end

local function spawnBoat()
	local _, _, net = getRemotes()
	local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
	if commF then pcall(function() commF:InvokeServer("Boat") end) end
end

-- 攻击逻辑
task.spawn(function()
	local lastAttack = 0
	while task.wait() do
		if not _G.AutoLeviathan then task.wait(0.5); continue end
		local elapsed = tick() - lastAttack
		if elapsed < 0.15 then task.wait(0.15 - elapsed) end
		lastAttack = tick()

		pcall(function()
			local leviParts = findLeviParts()
			if #leviParts == 0 then
				if _G.AutoSpawnBoat then spawnBoat() end
				return
			end
			local char = LocalPlayer.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if not root then return end
			local _, _, net = getRemotes()
			if not net then return end
			local RA = net:FindFirstChild("RE/RegisterAttack") or net:FindFirstChild("RegisterAttack")
			local RH = net:FindFirstChild("RE/RegisterHit") or net:FindFirstChild("RegisterHit")
			if not RA or not RH then return end

			local nearest, nd = nil, math.huge
			for _, lp in ipairs(leviParts) do
				local d = (lp.part.Position - root.Position).Magnitude
				if d < nd then nd = d; nearest = lp end
			end
			if not nearest then return end

			if nd > 100 then
				local boat = findMyBoat()
				local seat = boat and boat:FindFirstChildWhichIsA("VehicleSeat")
				if seat then
					seat.CFrame = CFrame.new(nearest.part.Position + Vector3.new(0,20,-30))
				else
					root.CFrame = CFrame.new(nearest.part.Position + Vector3.new(0,20,-30))
				end
			end

			local hitList = {}
			for _, lp in ipairs(leviParts) do
				local model = lp.obj:IsA("Model") and lp.obj or lp.obj.Parent
				if model then table.insert(hitList, {model, lp.part}) end
			end
			if #hitList > 0 then
				RA:FireServer(0.3)
				RH:FireServer(nearest.part, hitList)
			end

			for _, lp in ipairs(leviParts) do
				local n = lp.name:lower()
				if n:find("heart") or n:find("心脏") then
					local model = lp.obj:IsA("Model") and lp.obj or lp.obj.Parent
					if model then
						RA:FireServer(0.3)
						RH:FireServer(lp.part, {{model, lp.part}})
					end
				end
			end
		end)
	end
end)

