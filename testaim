-- ==================== Blox Fruits 自动攻击核心 ====================
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer
local Heartbeat = RunService.Heartbeat

-- ==================== 全局变量 ====================
_G.FastAttack = _G.FastAttack ~= true
_G.FastAttackDelay = _G.FastAttackDelay or 0.15
_G.AttackMobs = _G.AttackMobs ~= true
_G.AttackPlayers = _G.AttackPlayers ~= true
_G.FruitM1 = _G.FruitM1 or false
_G.GunM1 = _G.GunM1 or false
_G.AutoBuso = _G.AutoBuso or false
_G.KillAuraRange = _G.KillAuraRange or 350
_G.AttackPart = _G.AttackPart or "HumanoidRootPart"

-- ==================== 工具函数 ====================
local function isValidTarget(model)
    if not model then return false end
    if model == LocalPlayer.Character then return false end
    local hum = model:FindFirstChildOfClass("Humanoid") or model:FindFirstChild("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart")
    return hum and root and hum.Health > 0
end

local function isAlly(player)
    if not player or not player.Team or not LocalPlayer.Team then return false end
    return player.Team == LocalPlayer.Team
end

local function getAttackPart(target)
    return target:FindFirstChild(_G.AttackPart) or target:FindFirstChild("HumanoidRootPart") or target:FindFirstChild("Head") or target:FindFirstChild("Torso")
end

local function getNearbyTargets()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return {} end

    local targets = {}
    local myPos = root.Position
    local range = _G.KillAuraRange

    if _G.AttackMobs then
        for _, folderName in ipairs({"Enemies", "Enemy", "NPCs", "Mobs"}) do
            local folder = Workspace:FindFirstChild(folderName)
            if folder then
                for _, model in ipairs(folder:GetChildren()) do
                    if isValidTarget(model) then
                        local part = getAttackPart(model)
                        if part and (part.Position - myPos).Magnitude <= range then
                            table.insert(targets, {model, part})
                        end
                    end
                end
            end
        end
    end

    if _G.AttackPlayers then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                if not isAlly(player) and isValidTarget(player.Character) then
                    local part = getAttackPart(player.Character)
                    if part and (part.Position - myPos).Magnitude <= range then
                        table.insert(targets, {player.Character, part})
                    end
                end
            end
        end
    end

    return targets
end

-- ==================== 远程引用缓存 ====================
local Net, RegisterAttack, RegisterHit, CommF, CommE

local function initRemotes()
    if Net then return true end
    local modules = ReplicatedStorage:FindFirstChild("Modules")
    Net = modules and modules:FindFirstChild("Net")
    if Net then
        RegisterAttack = Net:FindFirstChild("RE/RegisterAttack") or Net:FindFirstChild("RegisterAttack")
        RegisterHit = Net:FindFirstChild("RE/RegisterHit") or Net:FindFirstChild("RegisterHit")
    end
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes then
        CommF = remotes:FindFirstChild("CommF_") or remotes:FindFirstChild("CommF")
        CommE = remotes:FindFirstChild("CommE") or remotes:FindFirstChild("CommE")
    end
    return Net and RegisterAttack and RegisterHit
end

-- ==================== 快速攻击 (M1 近战) ====================
local lastM1Attack = 0
task.spawn(function()
    while task.wait() do
        if not _G.FastAttack then continue end
        if not _G.AttackMobs and not _G.AttackPlayers then continue end

        local char = LocalPlayer.Character
        if not char or not isValidTarget(char) then continue end

        -- 枪模式跳过 M1
        local tool = char:FindFirstChildOfClass("Tool")
        if tool and tool.ToolTip == "Gun" then continue end

        local targets = getNearbyTargets()
        if #targets == 0 then continue end

        -- 节流
        local elapsed = tick() - lastM1Attack
        local minDelay = _G.FastAttackDelay
        if elapsed < minDelay then
            task.wait(minDelay - elapsed)
        end

        if not initRemotes() then continue end

        local mainTarget = targets[1]
        local hitList = {}
        for _, t in ipairs(targets) do
            table.insert(hitList, {t[1], t[2]})
        end

        pcall(function()
            RegisterAttack:FireServer(0.3)
            RegisterHit:FireServer(mainTarget[2], hitList)
        end)

        lastM1Attack = tick()
    end
end)

-- ==================== 果实 M1 ====================
task.spawn(function()
    local function getFruitTool()
        local char = LocalPlayer.Character
        if char then
            for _, tool in ipairs(char:GetChildren()) do
                if tool:IsA("Tool") and tool.ToolTip == "Blox Fruit" then return tool end
            end
        end
        local bp = LocalPlayer:FindFirstChild("Backpack")
        if bp then
            for _, tool in ipairs(bp:GetChildren()) do
                if tool:IsA("Tool") and tool.ToolTip == "Blox Fruit" then return tool end
            end
        end
    end

    while task.wait(0.12) do
        if not _G.FruitM1 then continue end
        if not _G.AttackMobs and not _G.AttackPlayers then continue end

        pcall(function()
            local fruit = getFruitTool()
            if not fruit then return end
            local remote = fruit:FindFirstChild("LeftClickRemote")
            if not remote then return end

            local char = LocalPlayer.Character
            local myHRP = char and char:FindFirstChild("HumanoidRootPart")
            if not myHRP then return end

            local targets = getNearbyTargets()
            for _, t in ipairs(targets) do
                local dir = (t[2].Position - myHRP.Position).Unit
                remote:FireServer(Vector3.new(dir.X, dir.Y, dir.Z), 1, true)
            end
        end)
    end
end)

-- ==================== 枪械 M1 ====================
task.spawn(function()
    local ShootGunEvent, Validator2

    local function initGunRemotes()
        if ShootGunEvent then return true end
        local modules = ReplicatedStorage:FindFirstChild("Modules")
        local dragonNet = modules and modules:WaitForChild("Net")
        if dragonNet then
            ShootGunEvent = dragonNet:FindFirstChild("RE/ShootGunEvent")
        end
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        if remotes then
            Validator2 = remotes:FindFirstChild("Validator2")
        end
        return ShootGunEvent and Validator2
    end

    -- 过验证器
    local ShootFunction
    local function getValidator()
        if not ShootFunction then
            local ok, controller = pcall(require, ReplicatedStorage:WaitForChild("Controllers"):WaitForChild("CombatController"))
            if ok and controller and controller.Attack then
                ShootFunction = debug.getupvalue(controller.Attack, 9)
            end
        end
        if not ShootFunction then return 0, 0 end
        local upvals = debug.getupvalues(ShootFunction)
        if not upvals then return 0, 0 end
        -- 标准 upvalue 索引 (可能因更新变动)
        local idx = {21, 22, 23, 24, 25, 26, 27}
        for i = 1, 10 do
            if upvals[i] == 727595 then
                local o = i - 15
                idx = {12+o, 13+o, 16+o, 17+o, 14+o, 12+o, 18+o}
                break
            end
        end
        local v1, v2, v3, v4, v5, v6, v7 = upvals[15], upvals[13], upvals[16], upvals[17], upvals[14], upvals[12], upvals[18]
        if not v1 then return 0, 0 end
        local v8 = v6 * v2
        local v9 = (v5 * v2 + v6 * v1) % v3
        v9 = (v9 * v3 + v8) % v4
        v5 = math.floor(v9 / v3); v6 = v9 - v5 * v3; v7 = v7 + 1
        debug.setupvalue(ShootFunction, 14, v5); debug.setupvalue(ShootFunction, 12, v6); debug.setupvalue(ShootFunction, 18, v7)
        return math.floor(v9 / v4 * 16777215), v7
    end

    while task.wait(0.085) do
        if not _G.GunM1 then continue end
        if not initGunRemotes() then continue end

        pcall(function()
            local char = LocalPlayer.Character
            local tool = char and char:FindFirstChildOfClass("Tool")
            if not tool or tool.ToolTip ~= "Gun" then return end

            local targets = getNearbyTargets()
            if #targets == 0 then return end

            local valCode, valCount = getValidator()
            if valCode ~= 0 then Validator2:FireServer(valCode, valCount) end

            tool:SetAttribute("LocalOverheat", 0)
            tool:SetAttribute("LocalTotalShots", (tool:GetAttribute("LocalTotalShots") or 0) + 1)

            local targetPos = targets[1][2].Position
            ShootGunEvent:FireServer(targetPos, { targets[1][2] })
        end)
    end
end)

