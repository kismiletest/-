-- ==================== Auto FPS Lock for Sanguine Art Z ====================
-- Fixed: 兼容平板/移动端, 12 FPS + 备用降帧方案
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local isEnabled = false
local isLocked = false
local currentTask = nil
local frameBlocker = nil  -- 移动端备用降帧连接

-- ==================== FPS 控制 ====================
local function lockFps()
	if not isEnabled then return end
	if isLocked then return end
	isLocked = true

	-- 方案1: setfpscap (PC执行器)
	if setfpscap then
		pcall(function() setfpscap(12) end)
	end

	-- 方案2: 移动端用 RenderStepped 空循环占满帧
	frameBlocker = RunService.RenderStepped:Connect(function()
		if not isLocked then return end
		-- 每帧空转大量运算, 强制降帧
		local x = 0
		for _ = 1, 500 do
			x = (x * 2 + 1) % 999999
		end
	end)
end

local function unlockFps()
	if currentTask then
		task.cancel(currentTask)
		currentTask = nil
	end
	if frameBlocker then
		frameBlocker:Disconnect()
		frameBlocker = nil
	end
	if isLocked then
		if setfpscap then
			pcall(function() setfpscap(0) end)
		end
		isLocked = false
	end
end

local function unlockFpsWithDelay()
	if isLocked and not currentTask then
		currentTask = task.spawn(function()
			task.wait(0.2)       -- 锁帧 0.2 秒后恢复 (原 0.3)
			unlockFps()
		end)
	end
end

