-- ==================== Drawing 库初始化 ====================
local function createESP(name, color)
    if not Drawing then return nil end
    local d = Drawing.new("Text")
    d.Text = name
    d.Color = color or Color3.fromRGB(255, 255, 255)
    d.Size = 14
    d.Center = true
    d.Outline = true
    d.OutlineColor = Color3.fromRGB(0, 0, 0)
    d.Visible = false
    d.Font = 2
    return d
end

local function createTracer(color)
    if not Drawing then return nil end
    local l = Drawing.new("Line")
    l.Color = color
    l.Thickness = 1
    l.Transparency = 0.5
    l.Visible = false
    return l
end

-- ==================== 通用物品分类 ====================
local itemKeywords = { "Key", "钥匙", "GateKey", "Lockpick", "Card", "RustyKey", "GoldenKey", "SilverKey", "MasterKey", "Keycard" }
local doorKeywords = { "Door", "门", "Gate", "Exit", "Entrance", "Portal" }
local monsterKeywords = { "Monster", "怪物", "Enemy", "Killer", "Ghost", "鬼", "Spider", "Zombie", "Slend", "Granny", "Neighbor", "Piggy", "Huggy", "Bendy" }
local itemNames = { "Battery", "电池", "Fuel", "燃料", "Fuse", "保险丝", "Plank", "木板", "Gear", "齿轮", "Wrench", "Screw", "Tool", "Cog", "Lever", "拉杆", "Handle", "Valve", "阀门", "Note", "纸条", "Tape", "磁带", "Flashlight", "手电", "Med", "Pill", "Bandage", "Hammer" }

local function isKey(name)
    name = name:lower()
    for _, kw in ipairs(itemKeywords) do
        if name:find(kw:lower()) then return true end
    end
    return false
end

local function isDoor(name)
    name = name:lower()
    for _, kw in ipairs(doorKeywords) do
        if name:find(kw:lower()) then return true end
    end
    return false
end

local function isMonster(name)
    name = name:lower()
    for _, kw in ipairs(monsterKeywords) do
        if name:find(kw:lower()) then return true end
    end
    return false
end

local function isItem(name, className)
    name = name:lower()
    if className == "ProximityPrompt" or className == "ClickDetector" then return true end
    for _, kw in ipairs(itemNames) do
        if name:find(kw:lower()) then return true end
    end
    return false
end

-- ==================== ESP 对象管理 ====================
local espObjects = {}

local function clearESP(typeName)
    if not espObjects[typeName] then return end
    for _, obj in pairs(espObjects[typeName]) do
        if obj.text then obj.text:Remove() end
        if obj.tracer then obj.tracer:Remove() end
    end
    espObjects[typeName] = {}
end

local function addESP(typeName, text, tracer)
    if not Drawing then return end
    if not espObjects[typeName] then espObjects[typeName] = {} end
    table.insert(espObjects[typeName], { text = text, tracer = tracer })
end

-- ==================== ESP 更新循环 ====================
task.spawn(function()
    while task.wait(0.1) do
        if not Drawing then continue end

        -- 玩家 ESP
        clearESP("players")
        if _G.ESP_Players then
            for _, player in ipairs(Players:GetPlayers()) do
                if player == LocalPlayer then continue end
                local char = player.Character
                local head = char and char:FindFirstChild("Head")
                local hum = char and char:FindFirstChild("Humanoid")
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if not head or not hum or not root then continue end

                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if not onScreen then continue end

                local parts = {}
                if _G.ShowPlayerNames then parts[#parts + 1] = player.Name end
                if _G.ShowDistance and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    parts[#parts + 1] = " [" .. math.floor((root.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude) .. "m]"
                end
                if _G.ShowHealth then
                    parts[#parts + 1] = " HP:" .. math.floor((hum.Health / hum.MaxHealth) * 100) .. "%"
                end

                local txt = createESP(table.concat(parts), Color3.fromRGB(255, 255, 0))
                txt.Position = Vector2.new(pos.X, pos.Y)
                txt.Visible = true

                local tracer = nil
                if _G.ShowTracers then
                    tracer = createTracer(Color3.fromRGB(255, 255, 0))
                    tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    tracer.To = Vector2.new(pos.X, pos.Y)
                    tracer.Visible = true
                end
                addESP("players", txt, tracer)
            end
        end

        -- 物品/钥匙/门/怪物 ESP
        local typeMap = {
            items = { enabled = _G.ESP_Items, check = isItem, color = Color3.fromRGB(0, 255, 100) },
            keys = { enabled = _G.ESP_Keys, check = isKey, color = Color3.fromRGB(255, 215, 0) },
            doors = { enabled = _G.ESP_Doors, check = isDoor, color = Color3.fromRGB(0, 180, 255) },
            monsters = { enabled = _G.ESP_Monsters, check = isMonster, color = Color3.fromRGB(255, 60, 60) },
        }

        for typeName, cfg in pairs(typeMap) do
            clearESP(typeName)
            if cfg.enabled then
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    local pp = obj:FindFirstChildWhichIsA("ProximityPrompt")
                    local cd = obj:FindFirstChildWhichIsA("ClickDetector")
                    local isInteractable = (pp and pp.Enabled ~= false) or (cd and cd.MaxActivationDistance > 0)

                    local matches = cfg.check(obj.Name, (pp or cd) and (pp or cd).ClassName or obj.ClassName)

                    if not matches and not (typeName == "items" and isInteractable) then continue end
                    if typeName == "keys" and not isKey(obj.Name) then continue end
                    if typeName == "doors" and not isDoor(obj.Name) then continue end
                    if typeName == "monsters" and not isMonster(obj.Name) then continue end

                    local part = obj:IsA("BasePart") and obj or (obj:FindFirstChildWhichIsA("BasePart"))
                    if not part then continue end

                    local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if not onScreen then continue end

                    local displayText = obj.Name
                    if isInteractable then displayText = "[互动] " .. displayText end
                    if isKey(obj.Name) then displayText = "[钥匙] " .. displayText end

                    local txt = createESP(displayText, cfg.color)
                    txt.Position = Vector2.new(pos.X, pos.Y)
                    txt.Visible = true

                    local tracer = nil
                    if _G.ShowTracers then
                        tracer = createTracer(cfg.color)
                        tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        tracer.To = Vector2.new(pos.X, pos.Y)
                        tracer.Visible = true
                    end
                    addESP(typeName, txt, tracer)
                end
            end
        end
    end
end)

-- ==================== 自动收集 / 开门 / 交互 ====================
local function findNearbyInteractable(range, matchFunc)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local nearest, nearestDist = nil, range
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local pp = obj:FindFirstChildWhichIsA("ProximityPrompt")
        local cd = obj:FindFirstChildWhichIsA("ClickDetector")
        if not pp and not cd then continue end
        if pp and pp.Enabled == false then continue end

        local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
        if not part then continue end

        if matchFunc and not matchFunc(obj, pp, cd) then continue end

        local dist = (part.Position - root.Position).Magnitude
        if dist < nearestDist then
            nearestDist = dist
            nearest = obj
        end
    end
    return nearest
end

local function interactWith(obj)
    if not obj then return end
    local pp = obj:FindFirstChildWhichIsA("ProximityPrompt")
    if pp then
        fireproximityprompt(pp)
        return
    end
    local cd = obj:FindFirstChildWhichIsA("ClickDetector")
    if cd then
        fireclickdetector(cd)
        return
    end
    -- 尝试触发 TouchInterest
    for _, child in ipairs(obj:GetChildren()) do
        if child:IsA("TouchTransmitter") then
            pcall(function() child:TouchInterest(obj) end)
        end
    end
end

local lastCollectTime = 0
task.spawn(function()
    while task.wait(0.2) do
        if _G.Auto_Collect then
            local item = findNearbyInteractable(_G.CollectRange, function(obj, pp, cd)
                local parent = obj.Parent
                if parent and parent:FindFirstChild("Humanoid") then return false end
                return isItem(obj.Name, (pp or cd).ClassName) or isKey(obj.Name)
            end)
            if item then
                -- 如果目标在收集范围内，传送到旁边再交互
                if _G.TargetObjective then
                    local part = item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart")
                    if part and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        LocalPlayer.Character.HumanoidRootPart.CFrame = part.CFrame + Vector3.new(0, 3, 0)
                    end
                end
                interactWith(item)
                lastCollectTime = tick()
            end
        end

        if _G.Auto_OpenDoors then
            local door = findNearbyInteractable(_G.CollectRange, function(obj)
                return isDoor(obj.Name)
            end)
            if door then
                if _G.TargetObjective then
                    local part = door:IsA("BasePart") and door or door:FindFirstChildWhichIsA("BasePart")
                    if part and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        LocalPlayer.Character.HumanoidRootPart.CFrame = part.CFrame + Vector3.new(0, 3, 0)
                    end
                end
                interactWith(door)
            end
        end

        if _G.Auto_Interact then
            local obj = findNearbyInteractable(_G.CollectRange, function(o, pp, cd)
                if isMonster(o.Name) then return false end
                if isDoor(o.Name) then return false end
                return true
            end)
            if obj then
                if _G.TargetObjective then
                    local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                    if part and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        LocalPlayer.Character.HumanoidRootPart.CFrame = part.CFrame + Vector3.new(0, 3, 0)
                    end
                end
                interactWith(obj)
            end
        end
    end
end)

