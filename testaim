toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255); toggleBtn.TextSize = 14
toggleBtn.Font = Enum.Font.GothamBold; toggleBtn.AutoButtonColor = false
local btnCorner = Instance.new("UICorner", toggleBtn); btnCorner.CornerRadius = UDim.new(0, 6)

local speedLabel = Instance.new("TextLabel", frame)
speedLabel.Size = UDim2.new(0, 100, 0, 20); speedLabel.Position = UDim2.new(0, 15, 0, 82)
speedLabel.BackgroundTransparency = 1; speedLabel.Text = "速度: 50"; speedLabel.TextColor3 = Color3.fromRGB(200,200,200)
speedLabel.TextSize = 13; speedLabel.Font = Enum.Font.Gotham; speedLabel.TextXAlignment = Enum.TextXAlignment.Left

local fasterBtn = Instance.new("TextButton", frame)
fasterBtn.Size = UDim2.new(0, 40, 0, 28); fasterBtn.Position = UDim2.new(1, -100, 0, 78)
fasterBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70); fasterBtn.Text = "+"
fasterBtn.TextColor3 = Color3.fromRGB(255,255,255); fasterBtn.TextSize = 18; fasterBtn.Font = Enum.Font.GothamBold; fasterBtn.AutoButtonColor = false
Instance.new("UICorner", fasterBtn).CornerRadius = UDim.new(0, 6)

local slowerBtn = Instance.new("TextButton", frame)
slowerBtn.Size = UDim2.new(0, 40, 0, 28); slowerBtn.Position = UDim2.new(1, -50, 0, 78)
slowerBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70); slowerBtn.Text = "-"
slowerBtn.TextColor3 = Color3.fromRGB(255,255,255); slowerBtn.TextSize = 18; slowerBtn.Font = Enum.Font.GothamBold; slowerBtn.AutoButtonColor = false
Instance.new("UICorner", slowerBtn).CornerRadius = UDim.new(0, 6)

local modeLabel = Instance.new("TextLabel", frame)
modeLabel.Size = UDim2.new(1, -20, 0, 18); modeLabel.Position = UDim2.new(0, 10, 0, 115)
modeLabel.BackgroundTransparency = 1; modeLabel.Text = "WASD 移动 | Space 上升 | Shift 下降"
modeLabel.TextColor3 = Color3.fromRGB(140, 140, 150); modeLabel.TextSize = 11
modeLabel.Font = Enum.Font.Gotham; modeLabel.TextXAlignment = Enum.TextXAlignment.Left

-- ==================== 飞行逻辑 ====================
local function updateUI()
    if flying then
        toggleBtn.Text = "ON"; toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 90)
    else
        toggleBtn.Text = "OFF"; toggleBtn.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
    end
    speedLabel.Text = "速度: " .. _G.FlySpeed
end

local function setupCharacter(char)
    local hum = char:FindFirstChildOfClass("Humanoid") or char:FindFirstChild("Humanoid")
    if not hum then return end
    hum.PlatformStand = true
end

local function cleanupCharacter(char)
    if flyBodyGyro and flyBodyGyro.Parent then flyBodyGyro:Destroy(); flyBodyGyro = nil end
    if flyBodyVel and flyBodyVel.Parent then flyBodyVel:Destroy(); flyBodyVel = nil end
    local hum = char:FindFirstChildOfClass("Humanoid") or char:FindFirstChild("Humanoid")
    if hum then hum.PlatformStand = false end
end

local function startBodyVelocityMode()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
    local root = char:WaitForChild("HumanoidRootPart", 5)
    if not hum or not root then return end

    hum.PlatformStand = true

    flyBodyGyro = Instance.new("BodyGyro", root)
    flyBodyGyro.MaxTorque = Vector3.new(1, 1, 1) * 40000
    flyBodyGyro.CFrame = Camera.CFrame
    flyBodyGyro.P = 30000

    flyBodyVel = Instance.new("BodyVelocity", root)
    flyBodyVel.MaxForce = Vector3.new(1, 1, 1) * 40000
    flyBodyVel.Velocity = Vector3.new()

    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not flying or not hum or not hum.Parent then
            if conn then conn:Disconnect() end
            return
        end

        local speed = _G.FlySpeed
        local moveDir = Vector3.new()
        local camCF = Camera.CFrame

        if keys.W then moveDir += camCF.LookVector end
        if keys.S then moveDir -= camCF.LookVector end
        if keys.D then moveDir += camCF.RightVector end
        if keys.A then moveDir -= camCF.RightVector end
        if keys.Space then moveDir += Vector3.new(0, 1, 0) end
        if keys.LeftShift then moveDir -= Vector3.new(0, 1, 0) end

        if flyBodyVel and flyBodyVel.Parent then
            flyBodyVel.Velocity = moveDir.Unit * speed * (moveDir.Magnitude > 0 and 1 or 0)
        end
        if flyBodyGyro and flyBodyGyro.Parent then
            flyBodyGyro.CFrame = camCF
        end

        -- 防止被打落
        hum.PlatformStand = true
        -- Noclip
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end)
end

local function stopFly()
    flying = false
    pcall(function() cleanupCharacter(LocalPlayer.Character) end)
    updateUI()
end

local function startFly()
    if flying then return end
    flying = true
    updateUI()
    pcall(function() setupCharacter(LocalPlayer.Character) end)
    startBodyVelocityMode()
end

-- ==================== 输入监听 ====================
UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if not flying then return end

    if input.UserInputType == Enum.UserInputType.Keyboard then
        local keyName = input.KeyCode.Name
        if keys[keyName] ~= nil then keys[keyName] = true end
    end
end)

UIS.InputEnded:Connect(function(input)
    if not flying then return end
    if input.UserInputType == Enum.UserInputType.Keyboard then
        local keyName = input.KeyCode.Name
        if keys[keyName] ~= nil then keys[keyName] = false end
    end
end)

-- ==================== 按钮事件 ====================
toggleBtn.MouseButton1Click:Connect(function()
    if flying then stopFly() else startFly() end
end)

fasterBtn.MouseButton1Click:Connect(function()
    _G.FlySpeed = math.min(_G.FlySpeed + 10, 300)
    updateUI()
end)

slowerBtn.MouseButton1Click:Connect(function()
    _G.FlySpeed = math.max(_G.FlySpeed - 10, 10)
    updateUI()
end)

-- 键盘快捷键 F 开关飞行
UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Enum.KeyCode.F then
        if flying then stopFly() else startFly() end
    end
end)

-- 角色重生时清理
LocalPlayer.CharacterAdded:Connect(function(char)
    if flying then
        flying = false
        task.wait(0.5)
        startFly()
    end
end)

-- 禁止角色被踢飞 (Anti-fling)
LocalPlayer.CharacterAdded:Connect(function(char)
    local root = char:WaitForChild("HumanoidRootPart", 10)
    if root then
        root:GetPropertyChangedSignal("CFrame"):Connect(function()
            if flying and root.AssemblyLinearVelocity.Magnitude > 200 then
                root.AssemblyLinearVelocity = Vector3.new()
            end
        end)
    end
end)

-- ==================== 初始化 ====================
updateUI()
if _G.Fly then startFly() end

print("========== 飞行脚本已加载 ==========")
print("  按 F 或点击 ON/OFF 开关飞行")
print("  WASD 移动 | Space 上升 | Shift 下降")
print("  当前速度: " .. _G.FlySpeed)
print("======================================")
