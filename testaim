		local d = i.Position - dragInfo.start
		Frame.Position = UDim2.new(dragInfo.pos.X.Scale, dragInfo.pos.X.Offset + d.X, dragInfo.pos.Y.Scale, dragInfo.pos.Y.Offset + d.Y)
	end
end)

local function updateUI()
	if isEnabled then
		ToggleBtn.Text = "ON"; ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 90)
