-- ==================== 拖动 ====================
local dragging, dragStart, startPos = false
Frame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true; dragStart = input.Position; startPos = Frame.Position
	end
end)
Frame.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)
game:GetService("UserInputService").InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		Frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

-- ==================== UI 更新 ====================
local function updateUI()
	if isEnabled then
		ToggleBtn.Text = "ON"; ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 90)
		ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		StatusLabel.Text = "已开启 (12FPS)"; StatusLabel.TextColor3 = Color3.fromRGB(80, 220, 120)
	else
		ToggleBtn.Text = "OFF"; ToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
		ToggleBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
		StatusLabel.Text = "已关闭"; StatusLabel.TextColor3 = Color3.fromRGB(160, 160, 170)
		unlockFps()
	end
end

ToggleBtn.MouseButton1Click:Connect(function()
	isEnabled = not isEnabled
	updateUI()
end)

-- ==================== 核心: 检测 Sanguine Z 冷却 ====================
task.spawn(function()
	while task.wait(0.3) do
		if not isEnabled then continue end
		pcall(function()
			local pg = LocalPlayer:FindFirstChild("PlayerGui")
			if not pg then return end
			local main = pg:FindFirstChild("Main")
			if not main then return end
			local skills = main:FindFirstChild("Skills")
			if not skills then return end
			local sanguine = skills:FindFirstChild("Sanguine Art")
			if not sanguine then return end
			local zSkill = sanguine:FindFirstChild("Z")
			if not zSkill then return end
			local cooldown = zSkill:FindFirstChild("Cooldown")
			if not cooldown then return end

			local fullCdSize = UDim2.new(1, 0, 1, -1)

			if not cooldown:GetAttribute("AutoFpsBound") then
				cooldown:SetAttribute("AutoFpsBound", true)

				-- 初始状态判断
				if cooldown.Size == fullCdSize then
					lockFps()
				else
					unlockFpsWithDelay()
				end

				-- 监听冷却变化
				cooldown:GetPropertyChangedSignal("Size"):Connect(function()
					if not isEnabled then return end
					if cooldown.Size == fullCdSize then
						if currentTask then
							task.cancel(currentTask)
							currentTask = nil
						end
						lockFps()
					else
						unlockFpsWithDelay()
					end
				end)
			end
		end)
	end
end)

