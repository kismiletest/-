-- ==================== 利维坦 ESP ====================
if Drawing then
	task.spawn(function()
		while task.wait(0.3) do
			if not _G.ESP_Leviathan then continue end

			local leviParts = findLeviParts()
			local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			local myPos = myRoot and myRoot.Position

			for _, lp in ipairs(leviParts) do
				local pos, onScreen = Camera:WorldToViewportPoint(lp.part.Position)
				if not onScreen then continue end

				local dist = myPos and math.floor((lp.part.Position - myPos).Magnitude) or 0
				local hpText = ""
				if lp.hum then
					local hp = lp.hum.MaxHealth > 0 and math.floor(lp.hum.Health/lp.hum.MaxHealth*100) or 0
					hpText = " HP:" .. hp .. "%"
				end

				local d = Drawing.new("Text")
				d.Text = lp.name .. " | " .. dist .. "m" .. hpText
				d.Color = Color3.fromRGB(255, 80, 80)
				d.Size = 14; d.Center = true; d.Outline = true; d.Visible = true
				d.Position = Vector2.new(pos.X, pos.Y)
				d.Font = 2

				task.delay(0.35, function() pcall(function() d:Remove() end) end)
			end
		end
	end)
end

-- ==================== 船只速度控制 ====================
task.spawn(function()
	while task.wait(0.5) do
		if not _G.AutoLeviathan then continue end
		pcall(function()
			local boat = findMyBoat()
			if not boat then return end
			local seat = boat:FindFirstChildWhichIsA("VehicleSeat")
			if not seat then return end

			-- 压制船只速度属性
			for _, v in ipairs(boat:GetDescendants()) do
				if v:IsA("BodyVelocity") or v:IsA("BodyMover") or v:IsA("RocketPropulsion") then
					if v.MaxForce then v.MaxForce = Vector3.new(1,1,1) * 1e6 end
				end
			end

			-- 检测并修复 AngularVelocity
			local rootPart = boat:FindFirstChildWhichIsA("BasePart")
			if rootPart then
				rootPart.AssemblyAngularVelocity = Vector3.zero
			end
		end)
	end
end)

-- ==================== 自动重进 (冷却后) ====================
task.spawn(function()
	while task.wait(5) do
		if not _G.AutoRejoinCD then continue end
		pcall(function()
			local leviParts = findLeviParts()
			if #leviParts > 0 then
				-- 有利维坦: 记下并继续打
				continue
			end

			-- 检查是否在新战斗中 (看是否有 SeaBeast/SeaEvent 存活)
			local seaBeasts = Workspace:FindFirstChild("SeaBeasts")
			local seaEvents = Workspace:FindFirstChild("SeaEvents")
			local hasEnemy = (seaBeasts and #seaBeasts:GetChildren() > 0) or (seaEvents and #seaEvents:GetChildren() > 0)

			if not hasEnemy then
				-- 没有利维坦也没有其他海怪, 判定已打完
				-- 等冷却: 检测 ReplicatedStorage 中的冷却计时
				local hasCooldown = false
				for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
					if obj.Name:lower():find("cooldown") or obj.Name:lower():find("levi") then
						local val = tonumber(obj:GetAttribute("Value") or obj:GetAttribute("Cooldown") or obj.Value)
						if val and val > 0 then hasCooldown = true; break end
					end
				end

				if hasCooldown then
					print("[冷却] 检测到利维坦冷却中, 重进服务器...")
					task.wait(2)
					-- 重进服务器
					local ts = game:GetService("TeleportService")
					pcall(function()
						ts:Teleport(game.PlaceId, LocalPlayer)
					end)
					-- 备选方案
					pcall(function()
						local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
						if commF then
							commF:InvokeServer("Rejoin")
						end
					end)
				end
			end
		end)
	end
end)

