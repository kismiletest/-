-- ==================== Auto FPS Lock for Sanguine Art Z ====================
-- Fixed: 强制降帧, 平板/移动端兼容
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local isEnabled = false
local isLocked = false
local blockerTask = nil

-- ==================== FPS 控制 ====================
local function lockFps()
	if not isEnabled then return end
	if isLocked then return end
	isLocked = true

	-- 方案1: setfpscap
	if setfpscap then
		pcall(function() setfpscap(12) end)
	end

	-- 方案2: task.spawn 死循环占满帧 (移动端核心方案)
	-- 疯狂创建/销毁 task 来挤占帧时间
	blockerTask = task.spawn(function()
		while isLocked do
			-- 每 0.001 秒阻塞一次, 主线程被无限 task 切换占满
			-- 结果: 帧率暴跌
			for _ = 1, 2000 do
				local a = math.random()
				math.sqrt(a * 9999)
			end
			task.wait()
		end
	end)
end

local function unlockFps()
	isLocked = false
	if blockerTask then
		task.cancel(blockerTask)
		blockerTask = nil
	end
	if setfpscap then
		pcall(function() setfpscap(0) end)
	end
end

local function unlockFpsWithDelay()
	task.spawn(function()
		task.wait(0.15)
		unlockFps()
	end)
end

