-- ==================== 工具函数 ====================
local function isEnemy(player)
	if not player or player == LocalPlayer then return false end
	if _G.AimbotTeamCheck then
		if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then return false end
		local char = player.Character
		if char then
			local teamTag = char:GetAttribute("Team") or char:FindFirstChild("Team")
			if teamTag then
				local myTag = LocalPlayer.Character and LocalPlayer.Character:GetAttribute("Team")
				if myTag and tostring(teamTag) == tostring(myTag) then return false end
			end
		end
	end
	return true
end

local function isAlive(player)
	local char = player.Character
	if not char then return false end
	local hum = char:FindFirstChildOfClass("Humanoid") or char:FindFirstChild("Humanoid")
	return hum and hum.Health > 0
end

local function isVisible(targetPart)
	if not _G.AimbotWallCheck then return true end
	local camPos = Camera.CFrame.Position
	local dir = (targetPart.Position - camPos).Unit * (targetPart.Position - camPos).Magnitude
	local ray = Ray.new(camPos, dir)
	local hit = Workspace:FindPartOnRayWithIgnoreList(ray, {LocalPlayer.Character}, false, true)
	return not hit or hit:IsDescendantOf(targetPart.Parent)
end

-- ==================== 自瞄逻辑 ====================
local lastAimTime = 0
RunService.RenderStepped:Connect(function()
	if not _G.Aimbot then return end

	local mousePos = UIS:GetMouseLocation()
	if mousePos.X <= 0 or mousePos.Y <= 0 then return end

	local fov = _G.AimbotFOV
	local closest, closestDist = nil, fov
	local camPos = Camera.CFrame.Position

	for _, player in ipairs(Players:GetPlayers()) do
		if not isEnemy(player) then continue end
		if not isAlive(player) then continue end

		local targetPart = player.Character:FindFirstChild(_G.AimbotPart)
		if not targetPart then continue end

		-- 屏幕坐标
		local pos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
		if not onScreen then continue end

		local screenPoint = Vector2.new(pos.X, pos.Y)
		local dist = (screenPoint - mousePos).Magnitude
		if dist < closestDist then
			-- 穿墙检测
			if not isVisible(targetPart) then continue end
			closestDist = dist
			closest = targetPart
		end
	end

	if closest then
		local targetPos = Camera:WorldToViewportPoint(closest.Position)
		local targetScreen = Vector2.new(targetPos.X, targetPos.Y)
		local smooth = _G.AimbotSmooth

		if smooth <= 0 then
			-- 直接锁定
			mousemoverel(targetScreen.X - mousePos.X, targetScreen.Y - mousePos.Y)
		else
			-- 平滑移动
			local deltaX = (targetScreen.X - mousePos.X) * (1 - smooth)
			local deltaY = (targetScreen.Y - mousePos.Y) * (1 - smooth)
			mousemoverel(deltaX, deltaY)
		end
	end
end)

