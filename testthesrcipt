-- ==================== Blox Fruits 毁号脚本 ====================
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

-- ==================== 白屏遮罩 ====================
local overlay = Instance.new("Frame")
overlay.Size = UDim2.new(1, 0, 1, 0)
overlay.BackgroundColor3 = Color3.new(1, 1, 1)
overlay.BorderSizePixel = 0
overlay.Visible = true
overlay.ZIndex = 1000

local whiteGui = Instance.new("ScreenGui")
whiteGui.Name = "DestroyOverlay"
whiteGui.ResetOnSpawn = false
whiteGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
whiteGui.Parent = pcall(function() return game:GetService("CoreGui") end) and game:GetService("CoreGui") or LocalPlayer.PlayerGui
overlay.Parent = whiteGui

-- ==================== 远程 ====================
local function getCommF()
	local r = ReplicatedStorage:FindFirstChild("Remotes")
	if not r then return nil end
	return r:FindFirstChild("CommF_") or r:FindFirstChild("CommF")
end

local function getCommE()
	local r = ReplicatedStorage:FindFirstChild("Remotes")
	if not r then return nil end
	return r:FindFirstChild("CommE")
end

-- ==================== 毁果实 ====================
task.spawn(function()
	while true do
		task.wait(0.3)
		pcall(function()
			local bp = LocalPlayer:FindFirstChild("Backpack")
			if not bp then return end

			local fruits = {}
			for _, t in ipairs(bp:GetChildren()) do
				if t:IsA("Tool") and t.ToolTip == "Blox Fruit" then
					table.insert(fruits, t)
				end
			end

			local char = LocalPlayer.Character
			if char then
				for _, t in ipairs(char:GetChildren()) do
					if t:IsA("Tool") and t.ToolTip == "Blox Fruit" then
						table.insert(fruits, t)
					end
				end
			end

			if #fruits == 0 then
				print("[毁果实] 已完成, 背包空了")
				return
			end

			local fruit = fruits[1]
			local hum = char and char:FindFirstChild("Humanoid")

			-- 装备
			if hum and fruit.Parent ~= char then
				pcall(function() hum:EquipTool(fruit) end)
				task.wait(0.2)
			end

			-- 丢到 Workspace 再删除
			pcall(function() fruit.Parent = Workspace end)
			task.wait(0.05)
			pcall(function() fruit:Destroy() end)

			print("[毁果实] 删除了: " .. fruit.Name)
		end)
	end
end)

-- ==================== 自动买船 (消耗 Beli) ====================
task.spawn(function()
	while true do
		task.wait(0.8)
		pcall(function()
			local commF = getCommF()
			if not commF then return end

			commF:InvokeServer("BuyBoat")
			commF:InvokeServer("Boat", "Buy")
			pcall(function() commF:InvokeServer("BuyBoat", "Enforcer") end)
			pcall(function() commF:InvokeServer("BuyBoat", "Destroyer") end)
			print("[买船] 购买船只消耗 Beli")
		end)
	end
end)

-- ==================== 毁碎片 ====================
task.spawn(function()
	while true do
		task.wait(0.8)
		pcall(function()
			local commF = getCommF()
			local commE = getCommE()

			if commF then
				pcall(function() commF:InvokeServer("Awakening", "Buy") end)
			end
			if commE then
				pcall(function() commE:FireServer("RaceV2", "Roll") end)
			end

			print("[碎片] 消耗碎片")
		end)
	end
end)

