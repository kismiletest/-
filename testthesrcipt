-- ==================== 自动连点脚本 ====================
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

_G.AutoClicker = _G.AutoClicker or false
_G.ClicksPerSec = _G.ClicksPerSec or 20

local clicking = false
local clickTask = nil

-- ==================== GUI ====================
local gui = Instance.new("ScreenGui", pcall(function() return game:GetService("CoreGui") end) and game:GetService("CoreGui") or LocalPlayer.PlayerGui)
gui.Name = "AutoClickerUI"

local f = Instance.new("Frame", gui)
f.Size = UDim2.new(0, 180, 0, 80)
f.Position = UDim2.new(1, -200, 0, 20)
f.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
f.BorderSizePixel = 0
f.Active = true; f.Draggable = true
Instance.new("UICorner", f).CornerRadius = UDim.new(0, 8)

local t = Instance.new("TextLabel", f)
t.Size = UDim2.new(1, -20, 0, 22); t.Position = UDim2.new(0, 10, 0, 5)
t.BackgroundTransparency = 1; t.TextColor3 = Color3.new(1,1,1)
t.Text = "自动连点 (" .. _G.ClicksPerSec .. "cps)"
t.TextSize = 14; t.Font = Enum.Font.GothamBold; t.TextXAlignment = 0

local btn = Instance.new("TextButton", f)
btn.Size = UDim2.new(0, 70, 0, 26); btn.Position = UDim2.new(0, 15, 0, 32)
btn.BackgroundColor3 = Color3.fromRGB(255,55,55); btn.Text = "OFF"
btn.TextColor3 = Color3.new(1,1,1); btn.TextSize = 13
btn.Font = Enum.Font.GothamBold; btn.AutoButtonColor = false
Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

local faster = Instance.new("TextButton", f)
faster.Size = UDim2.new(0, 32, 0, 26); faster.Position = UDim2.new(1, -90, 0, 32)
faster.BackgroundColor3 = Color3.fromRGB(55,55,65); faster.Text = "+"
faster.TextColor3 = Color3.new(1,1,1); faster.Font = Enum.Font.GothamBold; faster.AutoButtonColor = false
Instance.new("UICorner", faster).CornerRadius = UDim.new(0, 5)

local slower = Instance.new("TextButton", f)
slower.Size = UDim2.new(0, 32, 0, 26); slower.Position = UDim2.new(1, -52, 0, 32)
slower.BackgroundColor3 = Color3.fromRGB(55,55,65); slower.Text = "-"
slower.TextColor3 = Color3.new(1,1,1); slower.Font = Enum.Font.GothamBold; slower.AutoButtonColor = false
Instance.new("UICorner", slower).CornerRadius = UDim.new(0, 5)

local hint = Instance.new("TextLabel", f)
hint.Size = UDim2.new(1, -20, 0, 14); hint.Position = UDim2.new(0, 10, 0, 60)
hint.BackgroundTransparency = 1; hint.Text = "G 开关 | 左键触发 | 点击速度 +/-"
hint.TextColor3 = Color3.new(0.45, 0.45, 0.45); hint.TextSize = 10
hint.Font = Enum.Font.GothamBold; hint.TextXAlignment = 0

local function updateUI()
	if clicking then
		btn.Text = "ON"; btn.BackgroundColor3 = Color3.fromRGB(45, 170, 85)
	else
		btn.Text = "OFF"; btn.BackgroundColor3 = Color3.fromRGB(255, 55, 55)
	end
	t.Text = "自动连点 (" .. _G.ClicksPerSec .. "cps)"
end

btn.MouseButton1Click:Connect(function()
	if clicking then stopClick() else startClick() end
end)
faster.MouseButton1Click:Connect(function()
	_G.ClicksPerSec = math.min(_G.ClicksPerSec + 5, 100); updateUI()
end)
slower.MouseButton1Click:Connect(function()
	_G.ClicksPerSec = math.max(_G.ClicksPerSec - 5, 1); updateUI()
end)

-- ==================== 连点逻辑 ====================
function stopClick()
	clicking = false
	if clickTask then task.cancel(clickTask); clickTask = nil end
	updateUI()
end

function startClick()
	if clicking then return end
	clicking = true
	updateUI()

	clickTask = task.spawn(function()
		while clicking do
			local interval = 1 / _G.ClicksPerSec
			local mousePos = UIS:GetMouseLocation()

			-- 方法1: VirtualInputManager 模拟点击
			pcall(function()
				local vim = game:GetService("VirtualInputManager")
				vim:SendMouseButtonEvent(mousePos.X, mousePos.Y, 0, true, game, 0)
				vim:SendMouseButtonEvent(mousePos.X, mousePos.Y, 0, false, game, 0)
			end)

			-- 方法2: 触发 ProximityPrompt / ClickDetector (兼容各类点击游戏)
			if interval > 0.02 then
				pcall(function()
					local target = LocalPlayer:GetMouse().Target
					if target then
						local cd = target:FindFirstChildWhichIsA("ClickDetector")
						if cd then fireclickdetector(cd) end
						local pp = target.Parent and target.Parent:FindFirstChildWhichIsA("ProximityPrompt")
						if pp then fireproximityprompt(pp) end
					end
				end)
			end

			task.wait(interval)
		end
	end)
end

-- ==================== 快捷键 ====================
UIS.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.UserInputType == Enum.UserInputType.Keyboard then
		if input.KeyCode == Enum.KeyCode.G then
			if clicking then stopClick() else startClick() end
		end
	end
end)

updateUI()
print("自动连点就绪 | G 开关 | " .. _G.ClicksPerSec .. " cps")
