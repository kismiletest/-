-- ==================== Blox Fruits Remote 快捷面板 ====================
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- WindUI
local WindUI
pcall(function() WindUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))() end)
if not WindUI then return warn("WindUI 加载失败") end

local Window = WindUI:CreateWindow({
	Title = "Blox Fruits Remotes",
	Icon = "", Author = "", Folder = "WindUI",
	Size = UDim2.fromOffset(450, 440), Transparent = true, Theme = "Dark",
	Acrylic = false, HideSearchBar = false, SideBarWidth = 160, ToggleKey = Enum.KeyCode.G,
})

local Tab = Window:Tab({ Title = "Remote 面板", Icon = "terminal" })

local function invoke(cmd, ...)
	pcall(function()
		local commF = ReplicatedStorage.Remotes.CommF_
		commF:InvokeServer(cmd, ...)
		print("[Remote] " .. cmd)
	end)
end

Tab:Section({ Title = "战斗 & 技能" })
Tab:Button({ Title = "武装色 (Buso)", Callback = function() invoke("Buso") end })
Tab:Button({ Title = "瞬步 (Soru)", Callback = function() invoke("Soru") end })
Tab:Button({ Title = "激活种族技能", Callback = function() invoke("ActivateAbility") end })
Tab:Button({ Title = "觉醒购买", Callback = function() invoke("Awakening", "Buy") end })

Tab:Section({ Title = "购买 & 交易" })
Tab:Button({ Title = "果实商人购买", Callback = function() invoke("Cousin", "Buy") end })
Tab:Button({ Title = "买船", Callback = function() invoke("BuyBoat") end })
Tab:Button({ Title = "买船(备选)", Callback = function() invoke("Boat", "Buy") end })
Tab:Button({ Title = "买利维坦票", Callback = function() invoke("BuyLeviTicket") end })

Tab:Section({ Title = "服务器" })
Tab:Button({ Title = "重进服务器", Callback = function() invoke("Rejoin") end })
Tab:Button({ Title = "请求传送 (输入坐标)", Callback = function()
	local pos = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character.HumanoidRootPart.Position
	if pos then invoke("requestEntrance", pos) end
end })

print("Blox Fruits Remote 面板已加载 | 按 G 打开")
