-- ==================== 找大亨区域 ====================
local function findTycoon()
	-- 指定名字
	if _G.TycoonName ~= "" then
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj:IsA("Model") and obj.Name:lower():find(_G.TycoonName:lower()) then
				return obj
			end
		end
	end

	-- 自动找: 名含 Tycoon/Mansion/豪宅 且属玩家
	local owner = LocalPlayer.Name:lower()
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("Model") then
			local n = obj.Name:lower()
			if n:find("tycoon") or n:find("mansion") or n:find("豪宅") or n:find("plot") or n:find("基地") then
				-- 检查是否属于当前玩家
				if n:find(owner) then return obj end
				-- 检查 Owner 标签
				local ownerVal = obj:FindFirstChild("Owner")
				if ownerVal and tostring(ownerVal.Value):lower():find(owner) then return obj end
				-- 检查 BillboardGui 中是否含玩家名
				for _, bg in ipairs(obj:GetDescendants()) do
					if bg:IsA("BillboardGui") or bg:IsA("SurfaceGui") then
						for _, tl in ipairs(bg:GetDescendants()) do
							if tl:IsA("TextLabel") and tl.Text:lower():find(owner) then return obj end
						end
					end
				end
			end
		end
	end

	-- 兜底: 找最近的含 Button 且名字像大亨的模型
	return nil
end

-- ==================== 找可交互物体 ====================
local function findButtons(tycoon)
	local buttons = {}
	if not tycoon then return buttons end

	for _, obj in ipairs(tycoon:GetDescendants()) do
		-- 按钮类
		if obj:IsA("TextButton") or obj:IsA("ImageButton") then
			table.insert(buttons, {obj=obj, type="gui", name=obj.Name})
		end
		-- ProximityPrompt (3D 交互按钮)
		local pp = obj:FindFirstChildWhichIsA("ProximityPrompt")
		if pp and pp.Enabled ~= false then
			local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
			if part then
				table.insert(buttons, {obj=obj, type="prompt", name=obj.Name, pp=pp, part=part})
			end
		end
		-- ClickDetector
		local cd = obj:FindFirstChildWhichIsA("ClickDetector")
		if cd and cd.MaxActivationDistance > 0 then
			local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
			if part then
				table.insert(buttons, {obj=obj, type="clickdetector", name=obj.Name, cd=cd, part=part})
			end
		end
	end
	return buttons
end

