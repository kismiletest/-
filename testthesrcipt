-- ==================== 自动收集金钱 ====================
local collectorKeywords = { "collect", "money", "cash", "coin", "gold", "gem", "收集", "金币", "钱", "drop", "income", "diamond" }
local function isCollector(obj)
	local n = obj.Name:lower()
	local pn = obj.Parent and obj.Parent.Name:lower() or ""
	for _, kw in ipairs(collectorKeywords) do
		if n:find(kw) or pn:find(kw) then return true end
	end

	-- 掉在地上的钱/物品
	if obj:IsA("BasePart") then
		if n:find("money") or n:find("cash") or n:find("coin") or n:find("bill") or n:find("gold") then
			return true
		end
		if obj.BrickColor == BrickColor.new("Bright yellow") or obj.BrickColor == BrickColor.new("Gold") then
			if obj.Size.Magnitude < 5 then return true end
		end
	end
	return false
end

task.spawn(function()
	while task.wait(0.3) do
		if not _G.AutoCollect then continue end
		pcall(function()
			local char = LocalPlayer.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if not root then return end

			-- 找最近的金币/收集物
			local nearest, nd = nil, _G.CollectRadius
			for _, obj in ipairs(Workspace:GetDescendants()) do
				if isCollector(obj) then
					local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
					if part then
						local d = (part.Position - root.Position).Magnitude
						if d < nd then nd = d; nearest = obj end
					end
				end
			end

			if nearest then
				local part = nearest:IsA("BasePart") and nearest or nearest:FindFirstChildWhichIsA("BasePart")
				if part then
					-- 先触摸收集
					root.CFrame = part.CFrame + Vector3.new(0, 2, 0)
					task.wait(0.1)

					-- 尝试 fireproximityprompt 如果有
					local pp = nearest:FindFirstChildWhichIsA("ProximityPrompt") or nearest.Parent and nearest.Parent:FindFirstChildWhichIsA("ProximityPrompt")
					if pp and pp.Enabled ~= false then fireproximityprompt(pp) end
				end
			end
		end)
	end
end)

-- ==================== 自动任务 ====================
task.spawn(function()
	local lastTask = nil
	while task.wait(0.5) do
		if not _G.AutoTask then continue end
		pcall(function()
			-- 方法1: 点 PlayerGui 中的任务按钮
			local pg = LocalPlayer:FindFirstChild("PlayerGui")
			if pg then
				for _, obj in ipairs(pg:GetDescendants()) do
					if obj:IsA("TextButton") or obj:IsA("ImageButton") then
						local n = obj.Name:lower()
						local t = (obj:IsA("TextButton") and obj.Text or ""):lower()
						if n:find("task") or n:find("quest") or n:find("任务") or n:find("mission") or n:find("claim")
						   or t:find("claim") or t:find("collect") or t:find("reward") or t:find("领取") or t:find("完成") then
							local ax = obj.AbsolutePosition.X + obj.AbsoluteSize.X/2
							local ay = obj.AbsolutePosition.Y + obj.AbsoluteSize.Y/2
							local vim = game:GetService("VirtualInputManager")
							vim:SendMouseButtonEvent(ax, ay, 0, true, game, 0)
							task.wait(0.05)
							vim:SendMouseButtonEvent(ax, ay, 0, false, game, 0)
							lastTask = n
						end
					end
				end
			end

			-- 方法2: 发包完成所有任务 (尝试常用 Remote)
			pcall(function()
				local remotes = ReplicatedStorage:FindFirstChild("Remotes")
				if remotes then
					for _, evt in ipairs({"CompleteTask","ClaimQuest","FinishMission","CollectReward","CompleteAllQuests","ClaimAll"}) do
						local remote = remotes:FindFirstChild(evt)
						if remote then pcall(function() remote:FireServer() end) end
					end
				end
			end)
		end)
	end
end)

