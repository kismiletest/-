-- 这是一个简化的测试版本，因为不同游戏的结构完全不同，你需要先告诉我你在哪个游戏（发游戏链接），我才能精准适配。


-- 你可以先用这个通用脚本来试试：
-- 功能：自动帮你点击你眼前的按钮（Buy/Build/Upgrade/Collect/Claim 等）


local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local UIS = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

-- 点击交互的函数
local function clickButton(btn)
	if btn:IsA("TextButton") or btn:IsA("ImageButton") then
		local ax = btn.AbsolutePosition.X + btn.AbsoluteSize.X / 2
		local ay = btn.AbsolutePosition.Y + btn.AbsoluteSize.Y / 2
		local vim = game:GetService("VirtualInputManager")
		vim:SendMouseButtonEvent(ax, ay, 0, true, game, 0)
		task.wait(0.02)
		vim:SendMouseButtonEvent(ax, ay, 0, false, game, 0)
	end
end

local function interactPart(obj)
	local pp = obj:FindFirstChildWhichIsA("ProximityPrompt")
	if pp and pp.Enabled ~= false then fireproximityprompt(pp); return end
	local cd = obj:FindFirstChildWhichIsA("ClickDetector")
	if cd then fireclickdetector(cd); return end
end

-- 自动建造循环：找所有 Buy/Build/Upgrade 按钮
task.spawn(function()
	while task.wait(0.5) do
		pcall(function()
			-- 点屏幕上的按钮
			local pg = LocalPlayer:FindFirstChild("PlayerGui")
			if pg then
				for _, btn in ipairs(pg:GetDescendants()) do
					if btn:IsA("TextButton") or btn:IsA("ImageButton") then
						local t = btn:IsA("TextButton") and btn.Text or btn.Name
						local n = btn.Name
						if t:find("Buy") or t:find("购买") or t:find("建造") then
							clickButton(btn); task.wait(0.1)
						elseif t:find("Upgrade") or t:find("升级") then
							clickButton(btn); task.wait(0.1)
						elseif t:find("Collect") or t:find("收集") or t:find("领取") or t:find("Claim") then
							clickButton(btn); task.wait(0.1)
						end
					end
				end
			end

			-- 传送到范围内的 3D 交互物体并触发
			local char = LocalPlayer.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if root then
				for _, obj in ipairs(Workspace:GetDescendants()) do
					local pp = obj:FindFirstChildWhichIsA("ProximityPrompt")
					local n = obj.Name
					if pp and pp.Enabled ~= false and (n:find("Buy") or n:find("Build") or n:find("Upgrade") or n:find("购买") or n:find("建造")) then
						local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
						if part and (part.Position - root.Position).Magnitude < 50 then
							root.CFrame = part.CFrame + Vector3.new(0, 2, 3)
							fireproximityprompt(pp); task.wait(0.15)
						end
					end
				end
			end
		end)
	end
end)

print("豪宅大亨通用脚本已加载 | 正在自动点击 Buy/Build/Upgrade/Collect 按钮")
