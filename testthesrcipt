-- ==================== Blox Fruits 自动清背包 / 毁果实 / 用完钱 ====================
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

-- ==================== 全局变量 ====================
_G.DestroyFruits = _G.DestroyFruits or false
_G.AutoBuyBoat = _G.AutoBuyBoat or false
_G.DestroyFrags = _G.DestroyFrags or false

-- ==================== 工具函数 ====================
local function getRemotes()
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local commF = remotes and remotes:FindFirstChild("CommF_")
	local commE = remotes and remotes:FindFirstChild("CommE")
	return remotes, commF, commE
end

local function getBackpackFruits()
	local fruits = {}
	local bp = LocalPlayer:FindFirstChild("Backpack")
	if bp then
		for _, tool in ipairs(bp:GetChildren()) do
			if tool:IsA("Tool") and tool.ToolTip == "Blox Fruit" then
				table.insert(fruits, tool)
			end
		end
	end
	-- 手上的果实
	local char = LocalPlayer.Character
	if char then
		local held = char:FindFirstChildOfClass("Tool")
		if held and held.ToolTip == "Blox Fruit" then
			table.insert(fruits, held)
		end
	end
	return fruits
end

-- ==================== 毁掉背包所有果实 ====================
task.spawn(function()
	while task.wait(0.3) do
		if not _G.DestroyFruits then continue end

		local fruits = getBackpackFruits()
		if #fruits == 0 then
			print("[毁果实] 背包已空，停止。")
			_G.DestroyFruits = false
			continue
		end

		pcall(function()
			for _, fruit in ipairs(fruits) do
				local char = LocalPlayer.Character
				local hum = char and char:FindFirstChild("Humanoid")

				-- 装备果实
				if hum then
					hum:EquipTool(fruit)
					task.wait(0.1)
				end

				-- 方法1: 丢掉 (Drop 到 Workspace)
				if fruit.Parent == char then
					fruit.Parent = Workspace
					print("[丢] 已扔掉: " .. fruit.Name)
					task.wait(0.1)
				end

				-- 方法2: 摧毁果实对象
				if fruit.Parent then
					pcall(function() fruit:Destroy() end)
					print("[毁] 已删除: " .. fruit.Name)
				end
			end
		end)
	end
end)

-- ==================== 自动买船 (消耗 Beli) ====================
task.spawn(function()
	while task.wait(1) do
		if not _G.AutoBuyBoat then continue end

		pcall(function()
			local _, commF, _ = getRemotes()
			if not commF then return end

			-- 购买船只 (Beli 消耗核心)
			commF:InvokeServer("BuyBoat")
			commF:InvokeServer("Boat", "Buy")
			commF:InvokeServer("PurchaseBoat")
			print("[买船] 已尝试购买船只 (-Beli)")

			-- 备选: 直接买最贵的船
			pcall(function()
				commF:InvokeServer("BuyBoat", "Luxury")
				commF:InvokeServer("BuyBoat", "Destroyer")
				commF:InvokeServer("BuyBoat", "Enforcer")
			end)

			task.wait(0.5)
		end)
	end
end)

-- ==================== 用掉所有碎片 (觉醒 / 重置等) ====================
task.spawn(function()
	while task.wait(0.6) do
		if not _G.DestroyFrags then continue end

		pcall(function()
			local _, commF, commE = getRemotes()

			-- 方法1: 去觉醒(消耗碎片)
			if commF then
				commF:InvokeServer("Awakening", "Buy")
			end

			-- 方法2: 种族抽奖 (消耗碎片)
			if commE then
				commE:FireServer("RaceV2", "Roll")
			end

			-- 方法3: 刷新能力
			if commF then
				commF:InvokeServer("Fragments", "Spend")
			end

			task.wait(0.3)
		end)
	end
end)

-- ==================== 自动换果实 (买+丢循环清仓库) ====================
task.spawn(function()
	while task.wait(0.3) do
		if not _G.AutoRollFruit then continue end

		-- 先丢掉当前手上果实
		local char = LocalPlayer.Character
		if char then
			local held = char:FindFirstChildOfClass("Tool")
			if held and held.ToolTip == "Blox Fruit" then
				held.Parent = Workspace
				task.wait(0.1)
				pcall(function() held:Destroy() end)
			end
		end

		-- 再买一个新的 (消耗 Beli)
		pcall(function()
			local _, commF, _ = getRemotes()
			if commF then
				commF:InvokeServer("Cousin", "Buy")
				print("[换果实] 已购买新果实")
			end
		end)

		-- 点 GUI 上的抽果实按钮 (如果游戏改版了远程)
		pcall(function()
			local pg = LocalPlayer:FindFirstChild("PlayerGui")
			if pg then
				for _, btn in ipairs(pg:GetDescendants()) do
					if btn:IsA("TextButton") then
						local t = btn.Text:lower()
						if t:find("roll") or t:find("spin") or t:find("buy") or t:find("抽") or t:find("购买") or t:find("refresh") then
							local ax = btn.AbsolutePosition.X + btn.AbsoluteSize.X/2
							local ay = btn.AbsolutePosition.Y + btn.AbsoluteSize.Y/2
							local vim = game:GetService("VirtualInputManager")
							vim:SendMouseButtonEvent(ax, ay, 0, true, game, 0)
							task.wait(0.03)
							vim:SendMouseButtonEvent(ax, ay, 0, false, game, 0)
						end
					end
				end
			end
		end)
	end
end)

