-- ================= 构建 WindUI 界面 =================
local FOVSection = FOVTab:Section({ Title = "自瞄范围设置" })

FOVSection:Toggle({
    Title = "显示 FOV 范围",
    Value = _G.G_SilentAimShowFOV,
    Callback = function(v)
        c.Visible = v
        _G.G_SilentAimShowFOV = v
    end
})

FOVSection:Dropdown({
    Title = "FOV 位置",
    Values = {"跟随鼠标", "屏幕中心"},
    Value = _G.FOVMode,
    Callback = function(v)
        _G.FOVMode = v
    end
})

FOVSection:Slider({
    Title = "FOV 半径大小",
    Value = {
        Min = 10,
        Max = 1500,
        Default = _G.G_SilentAimFOV
    },
    Callback = function(value)
        c.Radius = value
        _G.G_SilentAimFOV = value
    end
})

FOVSection:Colorpicker({
    Title = "FOV 范围颜色",
    Default = Color3.fromRGB(255, 0, 0),
    Callback = function(v)
        c.Color = v
    end
})

FOVTab:Divider()

local AimSection = FOVTab:Section({ Title = "自瞄设置" })

AimSection:Toggle({
    Title = "M1 R 自瞄",
    Value = _G.G_SilentAimM1R,
    Callback = function(v) _G.G_SilentAimM1R = v end
})

AimSection:Toggle({
    Title = "技能自瞄",
    Value = _G.G_SilentAimSkill,
    Callback = function(v) _G.G_SilentAimSkill = v end
})

AimSection:Dropdown({
    Title = "静默瞄准方法",
    Values = {"鼠标最近的玩家", "最近的玩家", "选择玩家"},
    Value = _G.G_SilentAimMethod,
    Callback = function(v) _G.G_SilentAimMethod = v end
})

AimSection:Toggle({
    Title = "瞄准玩家",
    Value = _G.G_SilentAimTargetPlayers,
    Callback = function(v) _G.G_SilentAimTargetPlayers = v end
})

AimSection:Toggle({
    Title = "瞄准 NPC",
    Value = _G.G_SilentAimTargetMobs,
    Callback = function(v) _G.G_SilentAimTargetMobs = v end
})

AimSection:Toggle({
    Title = "团队检测",
    Value = _G.G_SilentAimTeamCheck,
    Callback = function(v) _G.G_SilentAimTeamCheck = v end
})

AimSection:Toggle({
    Title = "显示锁定红线",
    Value = _G.G_SilentAimShowLine,
    Callback = function(v) _G.G_SilentAimShowLine = v end
})

AimSection:Dropdown({
    Title = "瞄准部位",
    Values = {"HumanoidRootPart", "Head", "Torso", "UpperTorso", "LowerTorso"},
    Value = _G.G_SilentAimPart,
    Callback = function(v) _G.G_SilentAimPart = v end
})

FOVTab:Divider()

local SilentAimPlayerDropdown = FOVTab:Dropdown({
    Title = "选择瞄准玩家",
    Values = GetPlayerList(),
    Value = _G.G_SilentAimSelectedPlayer,
    Callback = function(v) _G.G_SilentAimSelectedPlayer = v or "" end
})

FOVTab:Button({
    Title = "刷新玩家列表",
    Callback = function()
        local newPlayerList = GetPlayerList()
        if SilentAimPlayerDropdown and SilentAimPlayerDropdown.Refresh then
            SilentAimPlayerDropdown:Refresh(newPlayerList, true)
        end
        if _G.G_SilentAimSelectedPlayer ~= "" and SilentAimPlayerDropdown and SilentAimPlayerDropdown.SetValue then
            pcall(function() SilentAimPlayerDropdown:SetValue(_G.G_SilentAimSelectedPlayer) end)
        end
    end
})

FOVTab:Toggle({
    Title = "快捷键锁人(按键h)",
    Value = _G.G_LockHotkey,
    Callback = function(v)
        _G.G_LockHotkey = v
        if v then StartLockHotkey() else StopLockHotkey() end
    end
})

FOVTab:Dropdown({
    Title = "锁人模式",
    Values = {"锁人1", "锁人2"},
    Value = _G.G_LockHotkeyMode,
    Callback = function(v) _G.G_LockHotkeyMode = v end
})

if _G.G_LockHotkey then StartLockHotkey() end

FOVTab:Divider()

FOVTab:Toggle({
    Title = "自动瞬步",
    Desc = "每15秒强制打你2500血你气不气😂",
    Value = _G.G_AutoSoru,
    Callback = function(v)
        _G.G_AutoSoru = v
        if v then StartAutoSoru() else StopAutoSoru() end
    end
})

if _G.G_AutoSoru then StartAutoSoru() end

-- ================= ESP 界面 =================
ESPTab:Toggle({
    Title = "ESP 开关",
    Value = _G.G_ESPEnabled,
    Callback = function(state)
        _G.G_ESPEnabled = state
        if state then EnableESP() else DisableESP() end
    end
})

ESPTab:Toggle({ Title = "显示玩家名字", Value = _G.G_ESP_Name, Callback = function(v) _G.G_ESP_Name = v end })
ESPTab:Toggle({ Title = "显示玩家等级", Value = _G.G_ESP_Level, Callback = function(v) _G.G_ESP_Level = v end })
ESPTab:Toggle({ Title = "显示玩家赏金", Value = _G.G_ESP_Bounty, Callback = function(v) _G.G_ESP_Bounty = v end })
ESPTab:Toggle({ Title = "显示恶魔果实", Value = _G.G_ESP_Fruit, Callback = function(v) _G.G_ESP_Fruit = v end })
ESPTab:Toggle({ Title = "显示距离", Value = _G.G_ESP_Distance, Callback = function(v) _G.G_ESP_Distance = v end })
ESPTab:Toggle({ Title = "显示血量", Value = _G.G_ESP_HP, Callback = function(v) _G.G_ESP_HP = v end })

ESPTab:Toggle({
    Title = "高亮显示玩家",
    Value = _G.G_ESP_Highlight,
    Callback = function(v) _G.G_ESP_Highlight = v end
})

ESPTab:Colorpicker({
    Title = "高亮颜色",
    Default = hexToColor3(_G.G_ESP_HighlightColor),
    Transparency = 0,
    Callback = function(color)
        _G.G_ESP_HighlightColor = string.format("%02X%02X%02X",
            math.floor(color.R * 255 + 0.5),
            math.floor(color.G * 255 + 0.5),
            math.floor(color.B * 255 + 0.5))
    end
})

ESPTab:Slider({
    Title = "ESP 字体大小",
    Value = {
        Min = 8,
        Max = 32,
        Default = _G.G_ESP_TextSize
    },
    Callback = function(v)
        _G.G_ESP_TextSize = v
    end
})

