local function GetNearestEntranceToTarget(targetPos, myPos)
    local bestName, bestPos = nil, nil
    local bestDist = (targetPos - myPos).Magnitude  
    for name, pos in pairs(TeleportLocations) do
        local d = (targetPos - pos).Magnitude
        if d < bestDist then bestDist = d; bestName = name; bestPos = pos end
    end
    return bestName, bestPos
end

-- ================= 快捷键锁人 =================
local LockHotkeyLabel
local LockHotkeyConn
local LockHotkeyLoopConn
local lockHotkeyActive = false
local lockHotkeyTarget = nil
local Lock2EntranceTick = 0

local function LockHotkeyUpdateUI()
    if LockHotkeyLabel then
        if lockHotkeyActive and lockHotkeyTarget then
            LockHotkeyLabel.Text = "正在锁人: " .. lockHotkeyTarget.Name
            LockHotkeyLabel.Visible = true
        elseif lockHotkeyActive then
            LockHotkeyLabel.Text = "正在锁人..."
            LockHotkeyLabel.Visible = true
        else
            LockHotkeyLabel.Visible = false
        end
    end
end

local function LockHotkeyStartLoop()
    lockHotkeyTarget = nil
    local firstTarget = GetClosestTargetToMouse()
    if firstTarget then
        local tc = firstTarget.Parent
        if tc and tc:IsA("Model") then
            lockHotkeyTarget = Players:GetPlayerFromCharacter(tc)
        end
    end
    if not lockHotkeyTarget then return end

    if LockHotkeyLoopConn then LockHotkeyLoopConn:Disconnect(); LockHotkeyLoopConn = nil end
    lockHotkeyActive = true
    LockHotkeyUpdateUI()
    Lock2EntranceTick = 0
    local VirtualUser = game:GetService("VirtualUser")

    LockHotkeyLoopConn = RunService.Stepped:Connect(function()
        if not lockHotkeyActive then
            if LockHotkeyLoopConn then LockHotkeyLoopConn:Disconnect(); LockHotkeyLoopConn = nil end
            return
        end
        pcall(function()
            local tPlayer = lockHotkeyTarget
            if not tPlayer or not tPlayer.Character then
                lockHotkeyActive = false; StopTween(); lockHotkeyTarget = nil; LockHotkeyUpdateUI(); return
            end
            local tHRP = tPlayer.Character:FindFirstChild("HumanoidRootPart")
            local myChar = LocalPlayer.Character
            local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if not tHRP or not myHRP then return end

            local targetCFrame = GetPredictedCFrame(tHRP) + Vector3.new(_G.G_TeleportOffsetX, _G.G_TeleportOffsetY, _G.G_TeleportOffsetZ)

            if _G.G_LockHotkeyMode == "锁人2" then
                local targetPos = targetCFrame.Position
                local myPos = myHRP.Position
                local distance = (targetPos - myPos).Magnitude
            
                if math.abs(myPos.Y - targetPos.Y) > 0.5 then
                    myHRP.CFrame = CFrame.new(myPos.X, targetPos.Y, myPos.Z)
                end
      
                if distance > 1000 and tick() - Lock2EntranceTick > 3 then
                    local entName, entPos = GetNearestEntranceToTarget(targetPos, myPos)
                    if entName and entPos then
                        requestEntrance(entPos)
                        Lock2EntranceTick = tick()
                        return
                    end
                end
                if distance > 300 then
                    topos(targetCFrame)
                else
                    StopTween()
                    myHRP.CFrame = targetCFrame
                end
            else
                myHRP.CFrame = targetCFrame
                VirtualUser:CaptureController()
                VirtualUser:Button1Down(Vector2.new(1280, 672))
            end
        end)
    end)
end

local function LockHotkeyStopLoop()
    lockHotkeyActive = false
    if LockHotkeyLoopConn then LockHotkeyLoopConn:Disconnect(); LockHotkeyLoopConn = nil end
    StopTween()
    lockHotkeyTarget = nil
    LockHotkeyUpdateUI()
end

local function StartLockHotkey()
    if LockHotkeyConn then return end
    pcall(function()
        local old = LocalPlayer:FindFirstChild("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("LockHotkeyGui")
        if old then old:Destroy() end
    end)
    pcall(function()
        local old = game:GetService("CoreGui"):FindFirstChild("LockHotkeyGui")
        if old and old ~= LockHotkeyLabel then old:Destroy() end
    end)
    if not LockHotkeyLabel then
        local sgui = Instance.new("ScreenGui")
        sgui.Name = "LockHotkeyGui"
        sgui.Parent = LocalPlayer:FindFirstChild("PlayerGui") or game:GetService("CoreGui")
        LockHotkeyLabel = Instance.new("TextLabel")
        LockHotkeyLabel.Parent = sgui
        LockHotkeyLabel.AnchorPoint = Vector2.new(0.5, 0)
        LockHotkeyLabel.Position = UDim2.new(0.5, 0, 0, 5)
        LockHotkeyLabel.Size = UDim2.new(0, 300, 0, 30)
        LockHotkeyLabel.BackgroundTransparency = 1
        LockHotkeyLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        LockHotkeyLabel.TextStrokeTransparency = 0
        LockHotkeyLabel.Font = Enum.Font.SourceSansBold
        LockHotkeyLabel.TextSize = 20
    end

    LockHotkeyConn = game:GetService("UserInputService").InputBegan:Connect(function(input, gameProcessed)
        if not _G.G_LockHotkey or gameProcessed then return end
        if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode.Name == "H" then
            if lockHotkeyActive then LockHotkeyStopLoop() else LockHotkeyStartLoop() end
        end
    end)
end

local function StopLockHotkey()
    LockHotkeyStopLoop()
    if LockHotkeyConn then LockHotkeyConn:Disconnect(); LockHotkeyConn = nil end
    if LockHotkeyLabel then LockHotkeyLabel.Visible = false end
end

-- ================= 自动瞬步 =================
local AutoSoruConn = nil
local function SoruTo(targetPosition)
    local Character = LocalPlayer.Character
    if not Character then return end
    local HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")
    local Humanoid = Character:FindFirstChild("Humanoid")
    if not HumanoidRootPart or not Humanoid or Humanoid.Health <= 0 then return end
    local startCFrame = HumanoidRootPart.CFrame
    local finalCFrame = (startCFrame - startCFrame.Position) + targetPosition + Vector3.new(0, HumanoidRootPart.Size.Y * 1.5, 0)
    local randomId = math.random(1, 999999999)
    pcall(function()
        ReplicatedStorage.Remotes.CommE:FireServer("Soru", startCFrame, finalCFrame, workspace:GetServerTimeNow(), randomId)
    end)
end

local function StartAutoSoru()
    if AutoSoruConn then return end
    AutoSoruConn = task.spawn(function()
        while _G.G_AutoSoru do
            pcall(function()
                local closestPlayer, shortestDistance = nil, math.huge
                local myChar = LocalPlayer.Character
                if myChar and myChar:FindFirstChild("HumanoidRootPart") then
                    local myPos = myChar.HumanoidRootPart.Position
                    for _, player in pairs(Players:GetPlayers()) do
                        if player ~= LocalPlayer then
                            local oChar = player.Character
                            if oChar and oChar:FindFirstChild("Humanoid") and oChar.Humanoid.Health > 0 and oChar:FindFirstChild("HumanoidRootPart") then
                                local dist = (oChar.HumanoidRootPart.Position - myPos).Magnitude
                                if dist < shortestDistance then shortestDistance = dist; closestPlayer = player end
                            end
                        end
                    end
                    if closestPlayer and closestPlayer.Character then
                        SoruTo((closestPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)).Position)
                    end
                end
            end)
            task.wait(1)
        end
    end)
end

local function StopAutoSoru()
    AutoSoruConn = nil
end

