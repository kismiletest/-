    local success, data = pcall(function() return HttpService:JSONDecode(readfile(CONFIG_FILE)) end)
    if not success then return end
    for section, values in pairs(data) do
        for k, v in pairs(values) do
            local key = "G_" .. k
            if section == "FOV" and (k == "FOVMode" or k == "SilentAimSelectedPlayer") then
                _G[k] = v
            elseif _G[key] ~= nil then
                _G[key] = v
