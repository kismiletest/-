local function fpsUnlockWithDelay()
    if fpsLocked and not fpsUnlockTask then
        fpsUnlockTask = task.spawn(function()
            task.wait(0.3)
            if setfpscap then
                setfpscap(0)
            end
            fpsLocked = false
            fpsUnlockTask = nil
        end)
    end
end

local function fpsForceUnlock()
    if fpsUnlockTask then
        task.cancel(fpsUnlockTask)
        fpsUnlockTask = nil
    end
    if fpsLocked and setfpscap then
        setfpscap(0)
        fpsLocked = false
    end
end

