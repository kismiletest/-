-- Observation Style ESP

local Players = game:GetService("Players")
local player = Players.LocalPlayer

------------------------------------------------
-- 创建显示UI
------------------------------------------------

local function createBillboard(root)

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(0,180,0,60)
	gui.StudsOffset = Vector3.new(0,3,0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 10000
	gui.Parent = root

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1,0,1,0)
	label.BackgroundTransparency = 1
	label.TextStrokeTransparency = 0
	label.Font = Enum.Font.SourceSansBold
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(0,255,255)
	label.Parent = gui

	return label
end

------------------------------------------------
-- 见闻色ESP
------------------------------------------------

local function createObservation(target)

	if target == player then return end

	local function apply(char)

		local root = char:FindFirstChild("HumanoidRootPart")
		local humanoid = char:FindFirstChild("Humanoid")

		if not root or not humanoid then return end
		if char:FindFirstChild("ObservationESP") then return end

		-- 高亮（墙后可见）

		local highlight = Instance.new("Highlight")
		highlight.Name = "ObservationESP"
		highlight.FillTransparency = 0.5
		highlight.OutlineColor = Color3.fromRGB(0,255,255)
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Parent = char

		local label = createBillboard(root)

		task.spawn(function()

			while char.Parent do

				if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then

					local dist =
						(root.Position -
						player.Character.HumanoidRootPart.Position).Magnitude

					local hp = humanoid.Health
					local maxhp = humanoid.MaxHealth
					local percent = hp / maxhp

					local color = Color3.fromRGB(0,255,255)

					if percent < 0.6 then
						color = Color3.fromRGB(255,170,0)
					end

					if percent < 0.3 then
						color = Color3.fromRGB(255,0,0)
					end

					highlight.FillColor = color
					label.TextColor3 = color

					label.Text =
						target.Name..
						"\nHP: "..math.floor(hp)..
						"\nDistance: "..math.floor(dist).."m"

				end

				task.wait(0.1)

			end

		end)

	end

	if target.Character then
		apply(target.Character)
	end

	target.CharacterAdded:Connect(function(char)
		task.wait(1)
		apply(char)
	end)

end

------------------------------------------------
-- 扫描玩家
------------------------------------------------

for _,p in pairs(Players:GetPlayers()) do
	createObservation(p)
end

Players.PlayerAdded:Connect(function(p)
	createObservation(p)
end)
