-- [[ 1.en Hub: 稳定流·全自动无限刀 ]] --

local Players = game:GetService("Players")
local Player = Players.LocalPlayer

local Settings = {
    AutoAttack = false,
    AttackRange = 300,
    AttackSpeed = 0.3,   -- 稍微放慢速度，增加稳定性
    Offset = 3.5,        -- 站在怪物前方 3.5 码
}

-- UI
local ScreenGui = Instance.new("ScreenGui", Player.PlayerGui)
local ToggleBtn = Instance.new("TextButton", ScreenGui)
ToggleBtn.Size = UDim2.new(0, 150, 0, 50)
ToggleBtn.Position = UDim2.new(0.05, 0, 0.4, 0)
ToggleBtn.Text = "自动斩击: 关闭"
ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
ToggleBtn.TextColor3 = Color3.new(1,1,1)

ToggleBtn.MouseButton1Click:Connect(function()
    Settings.AutoAttack = not Settings.AutoAttack
    ToggleBtn.Text = Settings.AutoAttack and "自动斩击: 运行中" or "自动斩击: 关闭"
    ToggleBtn.BackgroundColor3 = Settings.AutoAttack and Color3.fromRGB(150, 0, 0) or Color3.fromRGB(50, 50, 50)
end)

-- 自动拿刀
local function EquipWeapon()
    local char = Player.Character
    if char and not char:FindFirstChildOfClass("Tool") then
        local tool = Player.Backpack:FindFirstChildOfClass("Tool")
        if tool then
            char.Humanoid:EquipTool(tool)
        end
    end
end

-- 获取最近的怪
local function GetClosestTarget()
    local closest = nil
    local maxDist = Settings.AttackRange
    local char = Player.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    
    if not myRoot then return nil end

    -- 扫描 Workspace 里的所有模型
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Humanoid") and obj.Parent ~= char and obj.Health > 0 then
            local tRoot = obj.Parent:FindFirstChild("HumanoidRootPart")
            if tRoot then
                local dist = (myRoot.Position - tRoot.Position).Magnitude
                if dist < maxDist then
                    maxDist = dist
                    closest = tRoot
                end
            end
        end
    end
    return closest
end

task.spawn(function()
    while true do
        task.wait(Settings.AttackSpeed)
        
        if Settings.AutoAttack then
            local char = Player.Character
            local myRoot = char and char:FindFirstChild("HumanoidRootPart")
            
            if myRoot then
                EquipWeapon()
                
                local target = GetClosestTarget() -- 每次只锁定一个最近的目标
                
                if target then
                    -- 瞬移到目标面前并看向它
                    local targetPos = target.CFrame * CFrame.new(0, 0, Settings.Offset).Position
                    myRoot.CFrame = CFrame.lookAt(targetPos, target.Position)
                    
                    -- 挥刀
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then 
                        tool:Activate() 
                    end
                    
                    -- 【关键】：停留更长一点点，确保伤害触发
                    task.wait(0.1) 
                else
                    -- 如果范围内没怪了，才考虑停下来或者回原位
                    -- 这里留空，让角色停在最后一个怪的位置，防止一直“往返瞬移”
                end
            end
        end
    end
end)
