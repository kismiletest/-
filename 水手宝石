-- [[ 1.en Hub: 水手宝石 整合优化版 ]] --

local Players = game:GetService("Players")
local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

-- 状态配置
local Settings = {
    RangeEnabled = false,
    MagnetEnabled = false,
    InfiniteRange = 999999,
    MagnetRadius = 50, -- 吸怪感应范围
    AttackSpeed = 0.15 -- 自动攻击/同步频率
}

local Character = Player.Character or Player.CharacterAdded:Wait()
local RootPart = Character:WaitForChild("HumanoidRootPart")

-- ========== UI 面板 ==========
local Gui = Instance.new("ScreenGui", PlayerGui)
Gui.Name = "SailorHub_Optimized"

local Frame = Instance.new("Frame", Gui)
Frame.Size = UDim2.new(0, 180, 0, 130)
Frame.Position = UDim2.new(0.05, 0, 0.3, 0)
Frame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
Instance.new("UICorner", Frame)

local function CreateBtn(name, pos, color)
    local btn = Instance.new("TextButton", Frame)
    btn.Size = UDim2.new(0.9, 0, 0, 35)
    btn.Position = pos
    btn.BackgroundColor3 = color
    btn.Text = name .. " [关]"
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothamBold
    Instance.new("UICorner", btn)
    return btn
end

local BtnRange = CreateBtn("无限范围", UDim2.new(0.05, 0, 0.15, 0), Color3.fromRGB(50, 50, 60))
local BtnMagnet = CreateBtn("吸怪功能", UDim2.new(0.05, 0, 0.55, 0), Color3.fromRGB(50, 50, 60))

-- UI 更新函数
local function UpdateUI()
    BtnRange.Text = "无限范围 [" .. (Settings.RangeEnabled and "开" or "关") .. "]"
    BtnRange.BackgroundColor3 = Settings.RangeEnabled and Color3.fromRGB(0, 170, 127) or Color3.fromRGB(50, 50, 60)
    
    BtnMagnet.Text = "吸怪功能 [" .. (Settings.MagnetEnabled and "开" or "关") .. "]"
    BtnMagnet.BackgroundColor3 = Settings.MagnetEnabled and Color3.fromRGB(0, 120, 215) or Color3.fromRGB(50, 50, 60)
end

-- ========== 核心优化逻辑 ==========

-- 1. 无限范围 (低频扫描防止卡顿)
task.spawn(function()
    while true do
        task.wait(3) -- 范围修改后不消失，没必要 0.1 秒扫一次
        if Settings.RangeEnabled then
            pcall(function()
                local gc = getgc(true)
                for i = 1, #gc do
                    local v = gc[i]
                    if type(v) == "table" and rawget(v, "Range") then
                        v.Range = Settings.InfiniteRange
                    end
                end
            end)
        end
    end
end)

-- 2. 自动攻击 + 吸怪 (整合逻辑)
task.spawn(function()
    while true do
        task.wait(Settings.AttackSpeed)
        
        if Settings.MagnetEnabled or Settings.RangeEnabled then
            local myChar = Player.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if not myRoot then continue end
            
            -- 自动装备刀
            if not myChar:FindFirstChildOfClass("Tool") then
                local tool = Player.Backpack:FindFirstChildOfClass("Tool")
                if tool then myChar.Humanoid:EquipTool(tool) end
            end

            -- 遍历周边怪物/玩家
            for _, obj in pairs(workspace:GetChildren()) do
                -- 优化：只检查 Workspace 第一层模型，不使用 GetDescendants
                if obj:IsA("Model") and obj ~= myChar then
                    local hum = obj:FindFirstChildOfClass("Humanoid")
                    local hrp = obj:FindFirstChild("HumanoidRootPart")
                    
                    if hum and hrp and hum.Health > 0 then
                        local dist = (myRoot.Position - hrp.Position).Magnitude
                        
                        -- 执行吸怪 (将怪拉到面前)
                        if Settings.MagnetEnabled and dist <= Settings.MagnetRadius then
                            hrp.CFrame = myRoot.CFrame * CFrame.new(0, 0, -Settings.MagnetRadius/10)
                            hrp.Velocity = Vector3.new(0, 0, 0) -- 防止怪飞走
                        end
                        
                        -- 如果开启了无限范围，配合自动挥刀
                        if Settings.RangeEnabled and dist <= Settings.MagnetRadius then
                            local tool = myChar:FindFirstChildOfClass("Tool")
                            if tool then tool:Activate() end
                        end
                    end
                end
            end
        end
    end
end)

-- ========== 事件绑定 ==========
BtnRange.MouseButton1Click:Connect(function()
    Settings.RangeEnabled = not Settings.RangeEnabled
    UpdateUI()
end)

BtnMagnet.MouseButton1Click:Connect(function()
    Settings.MagnetEnabled = not Settings.MagnetEnabled
    UpdateUI()
end)

Player.CharacterAdded:Connect(function(newChar)
    Character = newChar
    RootPart = Character:WaitForChild("HumanoidRootPart")
end)

UpdateUI()
print("✅ 水手宝石｜优化整合版加载完成")
