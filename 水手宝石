local Players = game:GetService("Players")
local Player = Players.LocalPlayer
local UIS = game:GetService("UserInputService")

-- 配置
local Settings = {
    AutoAttack = false,
    AttackRange = 300,
    MaxRange = 3000,
    AttackSpeed = 0.15, -- 微调至0.15防止抽搐过快
    WeaponName = ""     -- 留空则自动拿背包里第一把刀
}

-- [[ UI 部分 (沿用并简化) ]] --
