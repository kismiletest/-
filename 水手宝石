-- [[ 核心功能逻辑 ]] --

-- 1. 自动拿刀逻辑
local function AutoEquipWeapon()
    local char = Player.Character
    if not char then return end
    
    -- 如果手里已经有东西了，就不重复拿
    if char:FindFirstChildOfClass("Tool") then return end
    
    -- 查找背包
    local backpack = Player:WaitForChild("Backpack")
    local tool = backpack:FindFirstChildOfClass("Tool") -- 寻找背包里任何工具
    
    if tool then
        -- 装备工具
        char.Humanoid:EquipTool(tool)
    end
end

-- 2. 斩击循环
task.spawn(function()
    while true do
        task.wait(Settings.AttackSpeed)
        
        if Settings.AutoAttack then
            local char = Player.Character
            local myRoot = char and char:FindFirstChild("HumanoidRootPart")
            
            if myRoot then
                -- 自动拿刀
                AutoEquipWeapon()
                
                local oldCFrame = myRoot.CFrame
                local foundTarget = false
                
                -- 扫描敌人
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= Player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        local tRoot = p.Character.HumanoidRootPart
                        local tHum = p.Character:FindFirstChildOfClass("Humanoid")
                        
                        -- 存活判定 + 距离
                        if tHum and tHum.Health > 0 then
                            local dist = (myRoot.Position - tRoot.Position).Magnitude
                            if dist <= Settings.AttackRange then
                                foundTarget = true
                                
                                -- 瞬移背刺
                                myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3)
                                
                                -- 触发攻击
                                local tool = char:FindFirstChildOfClass("Tool")
                                if tool then tool:Activate() end
                                
                                task.wait(0.02)
                            end
                        end
                    end
                    if not Settings.AutoAttack then break end
                end
                
                -- 关键点：只有找到了目标才回原位。如果没有目标，不要乱瞬移。
                if foundTarget then
                    myRoot.CFrame = oldCFrame
                end
            end
        end
    end
end)

ToggleBtn.MouseButton1Click:Connect(function()
    Settings.AutoAttack = not Settings.AutoAttack
    ToggleBtn.Text = Settings.AutoAttack and "运行中..." or "开启自动斩击"
    ToggleBtn.BackgroundColor3 = Settings.AutoAttack and Color3.fromRGB(0, 150, 100) or Color3.fromRGB(40, 40, 50)
end)

