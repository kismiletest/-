-- Auto V3 Logic (Key Simulation)
local AutoV3 = { 
    Enabled = false, -- 已改為 false
    _task = nil 
}

local function StartAutoV3()
    if AutoV3._task then return end
    AutoV3._task = task.spawn(function()
        while AutoV3.Enabled do
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.T, false, game)
            task.wait(1)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.T, false, game)
            task.wait(1)
        end
        AutoV3._task = nil
    end)
end

local function StopAutoV3() 
    AutoV3.Enabled = false 
end

-- Auto V4 Logic (Backpack Remote)
local AutoV4 = false -- 已改為 false
local autoV4Connection = nil

local function getAwakeningRemote()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        local awakening = backpack:FindFirstChild("Awakening")
        if awakening then 
            return awakening:FindFirstChild("RemoteFunction") 
        end
    end
    return nil
end

local function startV4Loop()
    if autoV4Connection then autoV4Connection:Disconnect() end
    
    -- 初始觸發一次
    pcall(function() 
        local r = getAwakeningRemote()
        if r then r:InvokeServer(true) end 
    end)

    autoV4Connection = RunService.Heartbeat:Connect(function()
        if not AutoV4 then return end
        local r = getAwakeningRemote()
        if r then 
            pcall(function() r:InvokeServer(true) end) 
        end
    end)
end

