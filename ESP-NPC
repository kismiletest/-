-- ===== ESP 逻辑 =====
local espEnabled = false
local espFolder = Instance.new("Folder")
espFolder.Name = "ESP_FOLDER"
espFolder.Parent = workspace

-- 创建 ESP
local function createESP(npc)
	if npc:FindFirstChild("ESP_HIGHLIGHT") then return end

	local h = Instance.new("Highlight")
	h.Name = "ESP_HIGHLIGHT"
	h.Adornee = npc
	h.FillColor = Color3.fromRGB(255, 0, 0)
	h.OutlineColor = Color3.fromRGB(255, 255, 255)
	h.FillTransparency = 0.5
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Parent = npc
end

-- 移除 ESP
local function removeAllESP()
	for _, obj in pairs(workspace:GetDescendants()) do
		if obj:IsA("Highlight") and obj.Name == "ESP_HIGHLIGHT" then
			obj:Destroy()
		end
	end
end

-- 扫描 NPC
local function scanNPC()
	for _, model in pairs(workspace:GetChildren()) do
		if model:IsA("Model") and model:FindFirstChild("Humanoid") then
			createESP(model)
		end
	end
end

-- ===== 按钮逻辑 =====
toggleBtn.MouseButton1Click:Connect(function()
	espEnabled = not espEnabled

	if espEnabled then
		toggleBtn.Text = "ESP : ON"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(60, 200, 60)
		scanNPC()
	else
		toggleBtn.Text = "ESP : OFF"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
		removeAllESP()
	end
end)
