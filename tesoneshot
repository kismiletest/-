local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer

-- ==========================================
-- 1. 設定與狀態管理
-- ==========================================
local Config = {
    AutoKill = false,
    AttackInterval = 0.12,
    TridentAutoKill = true,
    LightningAutoKill = true,
    SaishiAutoKill = true,
    BuddhaAutoKill = true,
}

local autoKillTask = nil
local addedConn = nil

-- 請確認或修改為目標遊戲對應的傷害 Remote
local NetEvents = {
    RegisterHit = ReplicatedStorage:FindFirstChild("RigControllerEvent", true) 
        or (ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Hit"))
}

-- ==========================================
-- 2. 目標搜尋與傳送邏輯 (TP to 0,0,0)
-- ==========================================
local function GetClosestTarget()
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end

    local enemyContainer = Workspace:FindFirstChild("Enemies") 
        or Workspace:FindFirstChild("NPCs") 
        or Workspace:FindFirstChild("DungeonEnemies") 
        or Workspace

    for _, entity in ipairs(enemyContainer:GetChildren()) do
        if entity:IsA("Model") and entity ~= char then
            local humanoid = entity:FindFirstChildOfClass("Humanoid")
            local hrp = entity:FindFirstChild("HumanoidRootPart")
            
            if humanoid and humanoid.Health > 0 and hrp then
                return { Model = entity, Humanoid = humanoid, RootPart = hrp }
            end
        end
    end
    return nil
end

-- 傳送到 (0,0,0) 並觸發打擊
local function AttackTarget(target)
    local char = player.Character
    if not char then return end
    local myHrp = char:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end

    -- 將玩家座標改為 (0,0,0)
    myHrp.CFrame = CFrame.new(0, 0, 0)

    -- 發送打擊 Remote
    if target and target.RootPart and NetEvents.RegisterHit then
        NetEvents.RegisterHit:FireServer(target.Model, target.RootPart)
    end
end

-- ==========================================
-- 3. 攻擊任務處理器
-- ==========================================
local function ExecuteKillRoutine(duration)
    if autoKillTask then return end

    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local originalCFrame = char.HumanoidRootPart.CFrame

    autoKillTask = task.spawn(function()
        local startTime = tick()
        
        while (duration and (tick() - startTime < duration)) or (not duration and Config.AutoKill) do
            local target = GetClosestTarget()
            AttackTarget(target)
            task.wait(Config.AttackInterval)
        end

        -- 攻擊結束後傳回原位
        if duration and char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = originalCFrame
        end
        
        autoKillTask = nil
    end)
end

-- ==========================================
-- 4. 技能 Sound 監聽
-- ==========================================
local function setAddConn()
    if addedConn then addedConn:Disconnect() end
    
    local char = player.Character or player.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    if not hrp then return end

    addedConn = hrp.ChildAdded:Connect(function(child)
        if child:IsA("Sound") then
            if child.Name == "TridentDoughZ2" and Config.TridentAutoKill then
                task.delay(0.8, function() ExecuteKillRoutine(0.15) end)
            elseif child.Name == "BF_Thunder_C_DragonGrab_Release_01" and Config.LightningAutoKill then
                task.delay(0.5, function() ExecuteKillRoutine(0.15) end)
            elseif child.Name == "SwordDanceAttack" and Config.SaishiAutoKill then
                ExecuteKillRoutine(0.15)
            elseif child.Name == "Buddha2Pickup" and Config.BuddhaAutoKill then
                task.delay(1.2, function() ExecuteKillRoutine(0.15) end)
            end
        end
    end)
end

if player.Character then setAddConn() end
player.CharacterAdded:Connect(setAddConn)

-- ==========================================
-- 5. Rayfield UI 介面
-- ==========================================
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Auto-Kill Suite",
   LoadingTitle = "Loading Script...",
   LoadingSubtitle = "TP Vector3(0,0,0)",
   ConfigurationSaving = { Enabled = false }
})

local MainTab = Window:CreateTab("Main", 4483362458)

MainTab:CreateToggle({
   Name = "Auto Kill Loop (傳送至 0,0,0 攻擊)",
   CurrentValue = Config.AutoKill,
   Flag = "AutoKillToggle",
   Callback = function(Value)
      Config.AutoKill = Value
      if Value then
          ExecuteKillRoutine(nil)
      elseif autoKillTask then
          task.cancel(autoKillTask)
          autoKillTask = nil
      end
   end,
})

MainTab:CreateSlider({
   Name = "Attack Delay (秒)",
   Range = {0.05, 0.5},
   Increment = 0.01,
   Suffix = "s",
   CurrentValue = Config.AttackInterval,
   Flag = "AttackDelaySlider",
   Callback = function(Value)
      Config.AttackInterval = Value
   end,
})

local SkillsSection = MainTab:CreateSection("Skill Sound Triggers")

MainTab:CreateToggle({
   Name = "Trident Auto Kill (Z)",
   CurrentValue = Config.TridentAutoKill,
   Callback = function(Value) Config.TridentAutoKill = Value end,
})

MainTab:CreateToggle({
   Name = "Lightning Auto Kill (Z Hold)",
   CurrentValue = Config.LightningAutoKill,
   Callback = function(Value) Config.LightningAutoKill = Value end,
})

MainTab:CreateToggle({
   Name = "Saishi Auto Kill (Z)",
   CurrentValue = Config.SaishiAutoKill,
   Callback = function(Value) Config.SaishiAutoKill = Value end,
})

MainTab:CreateToggle({
   Name = "Buddha Auto Kill (F)",
   CurrentValue = Config.BuddhaAutoKill,
   Callback = function(Value) Config.BuddhaAutoKill = Value end,
})
