--[[
    手动 R → 自动秒按 X 技能
    ------------------------------------------------------------------
    · 你手动按 R (瞬步) 的同一瞬间, 立即自动按 X 技能 (不等待)
    · 保留 Mouse.Hit / Mouse.Target 自瞄: X 技能自动锁最近敌人
    · 面板开关, 可拖动
]]

local Players            = game:GetService("Players")
local UserInputService   = game:GetService("UserInputService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local LocalPlayer        = Players.LocalPlayer
local Mouse              = LocalPlayer:GetMouse()

getgenv().AutoXOnR = true   -- 默认开启

-- ==================== 最近敌人 ====================
local function getNearest()
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil, 99999 end
    local nearest, shortest = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (myRoot.Position - hrp.Position).Magnitude
                if d < shortest then
                    shortest = d
                    nearest = p
                end
            end
        end
    end
    return nearest, shortest
end

-- ==================== 自瞄: Mouse.Hit / Mouse.Target ====================
do
    local ok = pcall(function()
        local oldIndex
        oldIndex = hookmetamethod(game, "__index", function(self, key)
            if getgenv().AutoXOnR and self == Mouse and (key == "Hit" or key == "Target") then
                local nearest = getNearest()
                if nearest and nearest.Character then
                    local hrp = nearest.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        if key == "Hit" then return CFrame.new(hrp.Position) end
                        if key == "Target" then return hrp end
                    end
                end
            end
            return oldIndex(self, key)
        end)
    end)
    if not ok then warn("[R→X] Mouse 自瞄 hook 失败, 仅自动按键") end
end

-- ==================== 按 X ====================
local function PressX()
    local ok = pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.X, false, game)
        task.wait(0.03)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.X, false, game)
    end)
    if not ok and type(keypress) == "function" then
        pcall(function()
            keypress(Enum.KeyCode.X)
            task.wait(0.03)
            keyrelease(Enum.KeyCode.X)
        end)
    end
    print("[R→X] 已自动按 X")
end

-- ==================== 监听手动 R ====================
local lastTrigger = 0
UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode ~= Enum.KeyCode.R then return end
    if not getgenv().AutoXOnR then return end
    if UserInputService:GetFocusedTextBox() then return end
    if tick() - lastTrigger < 0.1 then return end   -- 防连发
    lastTrigger = tick()
    PressX()   -- 按下 R 的同一瞬间立即按 X
end)

-- ==================== 面板 ====================
local parent = LocalPlayer:WaitForChild("PlayerGui")

local gui = Instance.new("ScreenGui")
gui.Name = "RToXGui"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = parent

local Frame = Instance.new("Frame")
Frame.Size = UDim2.fromOffset(180, 50)
Frame.Position = UDim2.fromOffset(60, 140)
Frame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
Frame.BorderSizePixel = 0
Frame.Active = true
Frame.Parent = gui
Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 8)

local ToggleButton = Instance.new("TextButton")
ToggleButton.Size = UDim2.new(1, 0, 1, 0)
ToggleButton.BackgroundColor3 = Color3.fromRGB(65, 255, 65)
ToggleButton.Text = "手动R→自动X: 开"
ToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleButton.Font = Enum.Font.GothamBold
ToggleButton.TextSize = 14
ToggleButton.Parent = Frame
Instance.new("UICorner", ToggleButton).CornerRadius = UDim.new(0, 8)

ToggleButton.MouseButton1Click:Connect(function()
    getgenv().AutoXOnR = not getgenv().AutoXOnR
    if getgenv().AutoXOnR then
        ToggleButton.BackgroundColor3 = Color3.fromRGB(65, 255, 65)
        ToggleButton.Text = "手动R→自动X: 开"
    else
        ToggleButton.BackgroundColor3 = Color3.fromRGB(255, 65, 65)
        ToggleButton.Text = "手动R→自动X: 关"
    end
end)

-- 拖动
local drag, dragStart, startPos
ToggleButton.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        drag = true
        dragStart = i.Position
        startPos = Frame.Position
    end
end)
UserInputService.InputChanged:Connect(function(i)
    if drag and i.UserInputType == Enum.UserInputType.MouseMovement then
        local d = i.Position - dragStart
        Frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                                   startPos.Y.Scale, startPos.Y.Offset + d.Y)
    end
end)
UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end
end)

print("[手动R→自动X] 已加载 | 按 R 瞬步后自动放 X")
