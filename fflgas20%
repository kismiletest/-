-- ==================== Blox Fruits 低配优化 ====================
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- ==================== 1. 大幅减低技能画质 ====================
local gfxSettings = {
	["Rendering"] = {
		QualityLevel = 1,
		FRAME_RATE_MANAGER_MAX_FPS = 60,
		EnableFRM = false,
	},
	["Material"] = {
		QualityLevel = 1,
	},
	["Texture"] = {
		QualityLevel = 1,
	},
	["MeshPart"] = {
		QualityLevel = 1,
	},
}

pcall(function()
	local settings = UserSettings()
	local gameSettings = settings.GameSettings
	if gameSettings then
		for category, values in pairs(gfxSettings) do
			pcall(function()
				local cat = gameSettings:FindFirstChild(category)
				if cat then
					for k, v in pairs(values) do
						pcall(function() cat[k] = v end)
					end
				end
			end)
		end
	end
end)

-- 激进取消化：每 0.3 秒扫描并清理所有特效
task.spawn(function()
	while task.wait(0.3) do
		pcall(function()
			for _, obj in ipairs(Workspace:GetDescendants()) do
				if obj:IsA("ParticleEmitter") then
					obj.Enabled = false
					obj.Rate = 0
					obj:Emit(0)
				elseif obj:IsA("Trail") then
					obj.Enabled = false
					obj.Lifetime = 0.01
				elseif obj:IsA("Beam") then
					obj.Enabled = false
				elseif obj:IsA("Explosion") then
					obj.BlastPressure = 0
					obj.BlastRadius = 0
					obj.Visible = false
				elseif obj:IsA("Fire") then
					obj.Enabled = false
					obj.Heat = 0
					obj.Size = 0
				elseif obj:IsA("Smoke") then
					obj.Enabled = false
				elseif obj:IsA("Sparkles") then
					obj.Enabled = false
				elseif obj:IsA("PointLight") then
					obj.Enabled = false
					obj.Brightness = 0
				elseif obj:IsA("SpotLight") then
					obj.Enabled = false
					obj.Brightness = 0
				elseif obj:IsA("SurfaceLight") then
					obj.Enabled = false
					obj.Brightness = 0
				elseif obj:IsA("BillboardGui") then
					obj.Enabled = false
				elseif obj:IsA("Decal") then
					obj.Transparency = 1
				elseif obj:IsA("Texture") then
					obj.Transparency = 1
				end
			end
		end)
	end
end)

-- ==================== 2. FPS 显示 UI ====================
task.spawn(function()
	local function createFPS()
		-- 优先使用 Drawing
		local success = pcall(function()
			local d = Drawing.new("Text")
			d.Text = "FPS: --"
			d.Size = 22
			d.Color = Color3.fromRGB(0, 255, 100)
			d.Center = false
			d.Outline = true
			d.OutlineColor = Color3.fromRGB(0, 0, 0)
			d.Position = Vector2.new(10, 10)
			d.Visible = true
			d.Font = 2

			local lastTime = os.clock()
			local smoothFPS = 0
			RunService.RenderStepped:Connect(function()
				local now = os.clock()
				local delta = now - lastTime
				lastTime = now
				if delta > 0 then
					local fps = 1 / delta
					smoothFPS = smoothFPS * 0.9 + fps * 0.1
					d.Text = "FPS: " .. math.floor(smoothFPS + 0.5) .. "  |  低配优化"
				end
			end)
		end)
		if success then return end

		-- 备用：ScreenGui (用 CoreGui 避免 PlayerGui 未加载)
		local sg = Instance.new("ScreenGui")
		sg.Name = "FPS_Display"
		sg.Parent = game:GetService("CoreGui")

		local label = Instance.new("TextLabel")
		label.Name = "FPSLabel"
		label.Size = UDim2.new(0, 180, 0, 28)
		label.Position = UDim2.new(0, 10, 0, 10)
		label.BackgroundTransparency = 0.5
		label.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		label.TextColor3 = Color3.fromRGB(0, 255, 100)
		label.TextSize = 18
		label.TextStrokeTransparency = 0
		label.Font = Enum.Font.SourceSansBold
		label.Text = "FPS: --"
		label.Parent = sg

		local lastTime = os.clock()
		local smoothFPS = 0
		RunService.RenderStepped:Connect(function()
			local now = os.clock()
			local delta = now - lastTime
			lastTime = now
			if delta > 0 then
				local fps = 1 / delta
				smoothFPS = smoothFPS * 0.9 + fps * 0.1
				label.Text = "FPS: " .. math.floor(smoothFPS + 0.5) .. "  |  低配优化"
			end
		end)
	end
	createFPS()
end)

-- ==================== 3. 人体僵硬 (移除动画) ====================
local removeAnimCharConn, removeAnimTrackConn

local function disableAnim(char)
	local hum = char:WaitForChild("Humanoid", 5)
	if not hum then return end
	local animator = hum:WaitForChild("Animator", 5)
	if not animator then return end
	for _, t in pairs(animator:GetPlayingAnimationTracks()) do t:Stop() end
	if removeAnimTrackConn then removeAnimTrackConn:Disconnect() end
	removeAnimTrackConn = animator.AnimationPlayed:Connect(function(t) t:Stop() end)
end

local function startNoAnim()
	if LocalPlayer.Character then disableAnim(LocalPlayer.Character) end
	if not removeAnimCharConn then
		removeAnimCharConn = LocalPlayer.CharacterAdded:Connect(function(char)
			task.wait(0.5); disableAnim(char)
		end)
	end
end

startNoAnim()

