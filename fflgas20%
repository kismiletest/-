-- ==================== Blox Fruits 跟随锁定玩家 ====================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

_G.FollowPlayer = false
_G.TargetPlayerName = nil
_G.FollowHeight = 90
_G.FollowSpeed = 250
_G.AutoSword = false 
_G.EscapeMode = false
_G.RandomFollow = false -- 新增：随机锁人开关

local savedPosBeforeEscape = nil
local hasTeleportedUp = false 
local escapeTween = nil 

-- 获取当前服务器其他玩家列表
local function getPlayerNames()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(list, p.Name)
        end
    end
    return list
end

-- ==================== 工具函数：精准识别剑 ====================
local function isSword(tool)
    if not tool or not tool:IsA("Tool") then return false end
    if tool.ToolTip and string.lower(tool.ToolTip):find("melee") then
        return true
    end
    return false
end

local function findSword()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer.Backpack
    if backpack then
        for _, v in ipairs(backpack:GetChildren()) do
            if isSword(v) then return v end
        end
    end
    if char then
        for _, v in ipairs(char:GetChildren()) do
            if isSword(v) then return v end
        end
    end
    return nil
end

