-- Script modificado: SIN eliminación de hotbars + BLOQUEO de notificaciones de Blox Fruits
-- Uso: Ejecutar en el cliente (Blox Fruits)

local player = game:GetService("Players").LocalPlayer

-- ================== BLOQUEO DE NOTIFICACIONES ==================
local function blockNotifications()
-- Bloquear notificaciones emergentes (Main/Notificaciones)
local gui = player:WaitForChild("PlayerGui")
local main = gui:FindFirstChild("Main")
if main then
local notifFrame = main:FindFirstChild("Notificaciones") or main:FindFirstChild("Notification")
if notifFrame then
notifFrame.Visible = false
notifFrame:Destroy() -- Eliminar para que no reaparezca
end
end

-- Bloquear el Remote de notificaciones (CommF_ "Notification")
local replicatedStorage = game:GetService("ReplicatedStorage")
local remotes = replicatedStorage:WaitForChild("Remotes")
local commF = remotes:WaitForChild("CommF_")

local oldInvoke = commF.InvokeServer
commF.InvokeServer = function(self, ...)
local args = {...}
if args[1] == "Notification" then
return nil -- No enviar notificación al servidor
end
return oldInvoke(self, ...)
end

-- Bloquear creación de nuevas notificaciones en GUI
gui.DescendantAdded:Connect(function(desc)
if desc.Name == "Notificaciones" or desc.Name == "Notification" then
desc:Destroy()
end
end)
end

task.spawn(blockNotifications)

-- ================== NO COOLDOWN (SIN TOCAR HOTBARS) ==================
local noSkillCDConnection = nil
local state = true
do
if state then
noSkillCDConnection = player.CharacterAdded:Connect(function(character)
character:SetAttribute("AllCooldown", 3)
end)
if player.Character then
player.Character:SetAttribute("AllCooldown", 3)
end
else
if noSkillCDConnection then
noSkillCDConnection:Disconnect()
noSkillCDConnection = nil
end
if player.Character then
player.Character:SetAttribute("AllCooldown", 0)
end
end
end

local function isInCombat()
local gui = player:FindFirstChild("PlayerGui")
if not gui then return false end
local main = gui:FindFirstChild("Main")
if not main then return false end
local hud = main:FindFirstChild("BottomHUDList")
if not hud then return false end
local combat = hud:FindFirstChild("InCombat")
if not combat then return false end
return combat.Visible == true
end

local permanentFruits = {}
task.spawn(function()
while task.wait(10) do
local result = game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("GetFruits", false)
permanentFruits = {}
for _,fruit in pairs(result) do
if fruit.HasPermanent then
table.insert(permanentFruits,fruit.Name)
end
end
end
end)

local CommF = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("CommF_")
function executeNoCooldown()
for _, item in player.Character:GetChildren() do
if item:IsA("Tool") then
if item.ToolTip == "Sword" or item.ToolTip == "Gun" or item.ToolTip == "Blox Fruit" then
task.wait(.01)
if item.ToolTip == "Blox Fruit" and not table.find(permanentFruits, item.Name) then
return
end
executingNoCD = true
-- ELIMINADO: No se tocan las hotbars (Backpack.Enabled ni Skills.Visible)
local result
repeat
task.wait()
result = CommF:InvokeServer(table.unpack({
[1] = item.ToolTip == "Blox Fruit" and "SwitchFruit" or "LoadItem",
[2] = item.Name,
}))
until result == true or isInCombat()

if isInCombat() then
player.Character:SetAttribute("AllCooldown", 0)
task.spawn(function()
repeat
task.wait(.1)
until not isInCombat()
player.Character:SetAttribute("AllCooldown", 3)
end)
end
executingNoCD = false
-- ELIMINADO: Re-habilitar hotbars (ya no se deshabilitaron)
player.Backpack[item.Name].Parent = player.Character
break
end
end
end
end

pcall(function()
task.spawn(function()
local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall

if setreadonly then setreadonly(mt, false) else make_writeable(mt) end

mt.__namecall = newcclosure(function(self, ...)
if checkcaller() then
return oldNamecall(self, ...)
end

local method = getnamecallmethod()

if (method == "InvokeServer" and tostring(self) == "") then
task.spawn(executeNoCooldown)
end

return oldNamecall(self, ...)
end)

if setreadonly then setreadonly(mt, true) else make_readonly(mt) end
end)
end)
