-- ==================== 锁定与防掉落逻辑 ====================
local noclipConnection
local followConnection
local platform

local function createPlatform()
	if not platform or not platform.Parent then
		platform = Instance.new("Part")
		platform.Name = "FollowPlatform_Kiyo"
		platform.Size = Vector3.new(10, 1, 10)
		platform.Transparency = 1
		platform.Anchored = true
		platform.CanCollide = true
		platform.Parent = Workspace
	end
	return platform
end

local function enableFollow()
	if noclipConnection then noclipConnection:Disconnect() end
	if followConnection then followConnection:Disconnect() end

	-- 开启无碰撞，防止卡在建筑或玩家身上
	noclipConnection = RunService.Stepped:Connect(function()
		if _G.FollowPlayer then
			local char = LocalPlayer.Character
			if char then
				for _, v in ipairs(char:GetDescendants()) do
					if v:IsA("BasePart") and v.CanCollide and v.Name ~= "FollowPlatform_Kiyo" then
						v.CanCollide = false
					end
				end
			end
		end
	end)

	-- 平滑跟随与垫板逻辑
	followConnection = RunService.Heartbeat:Connect(function(dt)
		if _G.FollowPlayer and _G.TargetPlayerName then
			local target = Players:FindFirstChild(_G.TargetPlayerName)
			if target and target.Character and target.Character:FindFirstChild("Head") then
				local char = LocalPlayer.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				if root then
					local headPos = target.Character.Head.Position
					local targetPos = headPos + Vector3.new(0, _G.FollowHeight, 0)
					
					-- 1. 保持玩家视角的旋转，不锁死面向，解决“直接锁打不到”的问题
					local currentRot = root.CFrame - root.Position
					
					-- 2. 平滑移动 (跟随效果)
					local dist = (targetPos - root.Position).Magnitude
					local speed = 150 -- 跟随速度
					
					if dist > 2 then
						local moveDist = math.min(speed * dt, dist)
						local dir = (targetPos - root.Position).Unit
						root.CFrame = CFrame.new(root.Position + dir * moveDist) * currentRot
					else
						root.CFrame = CFrame.new(targetPos) * currentRot
					end
					
					-- 速度归零
					root.Velocity = Vector3.new(0, 0, 0)
					root.RotVelocity = Vector3.new(0, 0, 0)
					
					-- 3. 脚下生成透明垫板：让游戏判定你处于“站立”状态，这样所有技能和普攻(M1)才能正常释放
					local p = createPlatform()
					p.CFrame = CFrame.new(root.Position - Vector3.new(0, 3.2, 0))
				end
			end
		else
			-- 关闭跟随或失去目标时，清理垫板
			if platform then
				platform:Destroy()
				platform = nil
			end
		end
	end)
end

enableFollow()

print("跟随锁定玩家脚本已加载！")
