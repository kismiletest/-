-- ==================== G键 快捷开关逻辑 ====================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.G then
        _G.FollowPlayer = not _G.FollowPlayer
        if followToggle and followToggle.SetValue then
            pcall(function() followToggle:SetValue(_G.FollowPlayer) end)
        end
        local stateText = _G.FollowPlayer and "已开启" or "已关闭"
        if WindUI and WindUI.Notify then
            WindUI:Notify({
                Title = "快捷键 [G]",
                Description = "跟随锁定状态: " .. stateText,
                Duration = 2
            })
        end
    end
end)

-- ==================== 锁定与防掉落逻辑 ====================
local noclipConnection
local followConnection
local platform

local function createPlatform()
    if not platform or not platform.Parent then
        platform = Instance.new("Part")
        platform.Name = "FollowPlatform_Kiyo"
        platform.Size = Vector3.new(10, 1, 10)
        platform.Transparency = 1
        platform.Anchored = true
        platform.CanCollide = true
        platform.Parent = Workspace
    end
    return platform
end

local function enableFollow()
    if noclipConnection then noclipConnection:Disconnect() end
    if followConnection then followConnection:Disconnect() end
    if platform then platform:Destroy() platform = nil end

    local currentTween = nil
    local lastTweenDest = nil
    local recalcThreshold = 25

    -- 物理维护循环（拆分了跟随专属逻辑和全局防掉落逻辑）
    noclipConnection = RunService.Stepped:Connect(function()
        local char = LocalPlayer.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        
        -- 1. 跟随模式下的专属处理
        if _G.FollowPlayer and root then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.AutoRotate = false end
            
            -- 抵消Tween间隙的重力下坠
            if root.AssemblyLinearVelocity.Y < 0 then
                root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z)
            end
            
            -- 跟随时全身无碰撞
            for _, v in ipairs(char:GetDescendants()) do
                if v:IsA("BasePart") and v.CanCollide and v.Name ~= "FollowPlatform_Kiyo" then
                    v.CanCollide = false
                end
            end
        end
        
        -- 2. 独立的防掉下来模式（无论是否跟随都生效）
        if _G.AntiFallMode and root then
            if root.Position.Y < SAFE_Y_HEIGHT then
                -- 暴力拉回安全高度并清空向下速度，保持水平位置不变
                root.CFrame = CFrame.new(root.Position.X, SAFE_Y_HEIGHT + 5, root.Position.Z) * root.CFrame.Rotation
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end)

    followConnection = RunService.Heartbeat:Connect(function()
        if _G.FollowPlayer and _G.TargetPlayerName then
            local target = Players:FindFirstChild(_G.TargetPlayerName)
            if target and target.Character and target.Character:FindFirstChild("Head") then
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root then
                    local headPos = target.Character.Head.Position
                    local targetY = headPos.Y + _G.FollowHeight
                    
                    -- 【防掉下来模式智能干预】
                    -- 如果目标掉进了海里/虚空，且开启了防掉落，则放弃跟随他的Y轴，只跟随X/Z轴
                    if _G.AntiFallMode and targetY < SAFE_Y_HEIGHT then
                        targetY = SAFE_Y_HEIGHT + 5
                    end
                    
                    local targetPos = Vector3.new(headPos.X, targetY, headPos.Z)
                    
                    local distToTarget = (targetPos - root.Position).Magnitude
                    local distFromLastDest = lastTweenDest and (targetPos - lastTweenDest).Magnitude or math.huge
                    
                    local shouldCreateTween = false
                    
                    if distToTarget > 1 then
                        if distFromLastDest > recalcThreshold then
                            shouldCreateTween = true
                        elseif not currentTween or not currentTween.Playing then
                            shouldCreateTween = true
                        end
                    end
                    
                    if shouldCreateTween then
                        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        local duration = math.max(0.01, distToTarget / _G.FollowSpeed)
                        local myRotation = root.CFrame.Rotation
                        local goalCFrame = CFrame.new(targetPos) * myRotation
                        
                        if currentTween then currentTween:Cancel() end
                        
                        local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
                        currentTween = TweenService:Create(root, tweenInfo, {CFrame = goalCFrame})
                        
                        currentTween.Completed:Connect(function(playbackState)
                            if playbackState == Enum.PlaybackState.Completed then
                                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                            end
                        end)
                        
                        currentTween:Play()
                        lastTweenDest = targetPos
                    else
                        if not currentTween or not currentTween.Playing then
                            local myRotation = root.CFrame.Rotation
                            root.CFrame = CFrame.new(targetPos) * myRotation
                            root.AssemblyLinearVelocity = Vector3.zero
                        end
                    end
                    
                    local p = createPlatform()
                    p.CFrame = CFrame.new(root.Position - Vector3.new(0, 3.2, 0))
                end
            end
        else
            if currentTween then currentTween:Cancel() currentTween = nil end
            lastTweenDest = nil
            
            if platform then platform:Destroy() platform = nil end
            
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then hum.AutoRotate = true end
            end
        end
    end)
end

enableFollow()

print("跟随锁定玩家脚本已加载！(已加入防掉下来模式)")
