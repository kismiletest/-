-- ==================== Blox Fruits 跟随锁定玩家 ====================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

_G.FollowPlayer = false
_G.TargetPlayerName = nil
_G.FollowHeight = 90
_G.FollowSpeed = 250
_G.AntiFallMode = false
_G.AutoSword = false -- 新增：跟随时自动拿刀开关

local SAFE_Y_HEIGHT = 10 

-- 获取当前服务器其他玩家列表
local function getPlayerNames()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(list, p.Name)
        end
    end
    return list
end

-- ==================== 工具函数：识别与寻找刀剑 ====================
local function isSword(tool)
    if not tool or not tool:IsA("Tool") then return false end
    
    -- 1. 最精准的判断：Blox Fruits 的近战武器 ToolTip 标签都是 "Melee"
    if tool.ToolTip and tool.ToolTip:find("Melee") then
        return true
    end
    
    -- 2. 兜底判断：通过名字关键词匹配（防止某些特殊武器没有标签）
    local name = tool.Name:lower()
    local keywords = {"sword", "katana", "saber", "sabre", "blade", "cutlass", "剑", "刀", "刃", "斧", "棍"}
    for _, kw in ipairs(keywords) do
        if name:find(kw) then return true end
    end
    
    return false
end

local function findSword()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer.Backpack
    -- 优先从背包找（避免卸下手里正在用的其他东西）
    if backpack then
        for _, v in ipairs(backpack:GetChildren()) do
            if isSword(v) then return v end
        end
    end
    -- 背包没有再从身上找
    if char then
        for _, v in ipairs(char:GetChildren()) do
            if isSword(v) then return v end
        end
    end
    return nil
end

