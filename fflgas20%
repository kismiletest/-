-- 获取当前服务器其他玩家列表
local function getPlayerNames()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(list, p.Name)
        end
    end
    return list
end

-- ==================== 工具函数：精准识别剑 ====================
local function isSword(tool)
    if not tool or not tool:IsA("Tool") then return false end
    if tool.ToolTip and string.lower(tool.ToolTip):find("melee") then
        return true
    end
    return false
end

local function findSword()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer.Backpack
    if backpack then
        for _, v in ipairs(backpack:GetChildren()) do
            if isSword(v) then return v end
        end
    end
    if char then
        for _, v in ipairs(char:GetChildren()) do
            if isSword(v) then return v end
        end
    end
    return nil
end

-- ==================== 新增工具函数：检测是否开启PVP (排除非战斗/安全区) ====================
local function isPVPEnabled(player)
    if not player or not player.Character then return false end
    local head = player.Character:FindFirstChild("Head")
    if not head then return false end
    
    -- Blox Fruits 机制：开启PVP后，Head下会生成一个名为 "PVP" 的对象
    local pvpTag = head:FindFirstChild("PVP")
    if pvpTag then
        -- 兼容不同版本：可能是布尔值 true，或者是字符串 "1"
        if pvpTag:IsA("BoolValue") then return pvpTag.Value end
        if pvpTag:IsA("StringValue") then return pvpTag.Value == "1" end
    end
    return false
end

