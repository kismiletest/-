-- Auto FPS Lock for Sanguine Art Z (with Toggle UI)
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- ==================== 状态 ====================
local isEnabled = false          -- 总开关
local isLocked = false
local currentTask = nil

-- ==================== FPS 控制函数 ====================
local function lockFps()
	if not isEnabled then return end
	if not isLocked and setfpscap then
		isLocked = true
		setfpscap(22)
	end
end

local function unlockFpsWithDelay()
	if isLocked and not currentTask then
		currentTask = task.spawn(function()
			task.wait(0.3)
			if setfpscap then
				setfpscap(0)
			end
			isLocked = false
			currentTask = nil
		end)
	end
end

